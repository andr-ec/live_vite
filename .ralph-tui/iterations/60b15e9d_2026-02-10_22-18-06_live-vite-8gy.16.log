> deepEqual((f as any)._options, options))\n   276→    if (existing) return existing as ReactFormField<V>\n   277→\n   278→    const keys = parsePath(path)\n   279→    const fieldId = sanitizeId(path) + (options.value !== undefined ? `_${sanitizeId(String(options.value))}` : \"\")\n   280→\n   281→    const field: ReactFormField<V> = {\n   282→      get value(): V {\n   283→        return getValueByPath(store.currentValues, keys)\n   284→      },\n   285→\n   286→      get errors(): string[] {\n   287→        const errs = getValueByPath(store.currentErrors, keys)\n   288→        return Array.isArray(errs) ? errs : []\n   289→      },\n   290→\n   291→      get errorMessage(): string | undefined {\n   292→        const errs = field.errors\n   293→        return errs.length > 0 ? errs[0] : undefined\n   294→      },\n   295→\n   296→      get isValid(): boolean {\n   297→        return field.errors.length === 0\n   298→      },\n   299→\n   300→      get isDirty(): boolean {\n   301→        const initialVal = getValueByPath(store.initialValues, keys)\n   302→        return JSON.stringify(field.value) !== JSON.stringify(initialVal)\n   303→      },\n   304→\n   305→      get isTouched(): boolean {\n   306→        return store.submitCount > 0 || store.touchedFields.has(path)\n   307→      },\n   308→\n   309→      setValue(newValue: V) {\n   310→        setValueByPath(store.currentValues, keys, newValue)\n   311→        debouncedSendChanges()\n   312→        rerender()\n   313→      },\n   314→\n   315→      blur() {\n   316→        store.touchedFields.add(path)\n   317→        rerender()\n   318→      },\n   319→\n   320→      get inputProps() {\n   321→        const isMultiCheckbox = options.type === \"checkbox\" && Array.isArray(field.value)\n   322→\n   323→        const baseProps = {\n   324→          name: path,\n   325→          id: fieldId,\n   326→          type: options.type,\n   327→          onBlur: () => field.blur(),\n   328→          \"aria-invalid\": !field.isValid as boolean,\n   329→          ...(field.errors.length > 0 ? { \"aria-describedby\": `${fieldId}-error` } : {}),\n   330→        }\n   331→\n   332→        if (isMultiCheckbox) {\n   333→          return {\n   334→            ...baseProps,\n   335→            value: options.value,\n   336→            checked: ((field.value as any[]) || []).includes(options.value),\n   337→            onChange: (event: any) => {\n   338→              const target = event.target as HTMLInputElement\n   339→              const currentArray = [...((field.value as any[]) || [])]\n   340→              const idx = currentArray.indexOf(options.value)\n   341→              if (target.checked && idx === -1) {\n   342→                currentArray.push(options.value)\n   343→              } else if (!target.checked && idx !== -1) {\n   344→                currentArray.splice(idx, 1)\n   345→              }\n   346→              field.setValue(currentArray as any)\n   347→            },\n   348→          }\n   349→        } else if (options.type === \"checkbox\") {\n   350→          const optionsValue = options.value !== undefined ? options.value : true\n   351→          return {\n   352→            ...baseProps,\n   353→            value: options.value,\n   354→            checked: field.value === optionsValue,\n   355→            onChange: (event: any) => {\n   356→              const target = event.target as HTMLInputElement\n   357→              field.setValue((target.checked ? optionsValue : null) as any)\n   358→            },\n   359→          }\n   360→        } else {\n   361→          return {\n   362→            ...baseProps,\n   363→            value: field.value,\n   364→            onChange: (event: any) => {\n   365→              const target = event.target as HTMLInputElement\n   366→              field.setValue(target.value as any)\n   367→            },\n   368→          }\n   369→        }\n   370→      },\n   371→\n   372→      field(key: any, opts?: FieldOptions) {\n   373→        const subPath = path ? `${path}.${String(key)}` : String(key)\n   374→        return createFormField(subPath, opts) as any\n   375→      },\n   376→\n   377→      fieldArray(key: any) {\n   378→        const subPath = path ? `${path}.${String(key)}` : String(key)\n   379→        return createFormFieldArray(subPath) as any\n   380→      },\n   381→    }\n   382→\n   383→    // Store options for cache comparison\n   384→    ;(field as any)._options = options\n   385→    fieldsForPath.push(field)\n   386→\n   387→    return field\n   388→  }\n   389→\n   390→  function createFormFieldArray<V>(path: string): ReactFormFieldArray<V> {\n   391→    if (store.fieldArrayCache.has(path)) {\n   392→      return store.fieldArrayCache.get(path) as ReactFormFieldArray<V>\n   393→    }\n   394→\n   395→    const baseField = createFormField<V[]>(path)\n   396→    const keys = parsePath(path)\n   397→\n   398→    const updateArray = (newArray: V[]) => {\n   399→      setValueByPath(store.currentValues, keys, newArray)\n   400→      debouncedSendChanges()\n   401→      rerender()\n   402→      return Promise.resolve()\n   403→    }\n   404→\n   405→    const fieldArray: ReactFormFieldArray<V> = {\n   406→      get value() { return baseField.value },\n   407→      get errors() { return baseField.errors },\n   408→      get errorMessage() { return baseField.errorMessage },\n   409→      get isValid() { return baseField.isValid },\n   410→      get isDirty() { return baseField.isDirty },\n   411→      get isTouched() { return baseField.isTouched },\n   412→      setValue: baseField.setValue,\n   413→      blur: baseField.blur,\n   414→      get inputProps() { return baseField.inputProps },\n   415→\n   416→      add(item?: Partial<V>) {\n   417→        const currentArray = baseField.value || []\n   418→        return updateArray([...currentArray, item as V])\n   419→      },\n   420→\n   421→      remove(index: number) {\n   422→        const currentArray = baseField.value || []\n   423→        return updateArray(currentArray.filter((_: any, i: number) => i !== index))\n   424→      },\n   425→\n   426→      move(from: number, to: number) {\n   427→        const currentArray = [...(baseField.value || [])]\n   428→        if (from >= 0 && from < currentArray.length && to >= 0 && to < currentArray.length) {\n   429→          const item = currentArray.splice(from, 1)[0]\n   430→          currentArray.splice(to, 0, item)\n   431→          return updateArray(currentArray)\n   432→        }\n   433→        return Promise.resolve()\n   434→      },\n   435→\n   436→      get fields(): ReactFormField<V>[] {\n   437→        const array = baseField.value || []\n   438→        return array.map((_: any, index: number) => createFormField<V>(`${path}[${index}]`))\n   439→      },\n   440→\n   441→      field(pathOrIndex: any, options?: FieldOptions) {\n   442→        if (typeof pathOrIndex === \"number\") {\n   443→          return createFormField(`${path}[${pathOrIndex}]`, options)\n   444→        }\n   445→        return createFormField(`${path}${pathOrIndex}`, options)\n   446→      },\n   447→\n   448→      fieldArray(pathOrIndex: any) {\n   449→        if (typeof pathOrIndex === \"number\") {\n   450→          return createFormFieldArray(`${path}[${pathOrIndex}]`)\n   451→        }\n   452→        return createFormFieldArray(`${path}${pathOrIndex}`)\n   453→      },\n   454→    }\n   455→\n   456→    store.fieldArrayCache.set(path, fieldArray)\n   457→    return fieldArray\n   458→  }\n   459→\n   460→  // ─── Form actions ───\n   461→\n   462→  function submit(): Promise<any> {\n   463→    store.submitCount += 1\n   464→    rerender()\n   465→\n   466→    if (store.live) {\n   467→      const data = store.prepareData(deepClone(store.currentValues))\n   468→\n   469→      return new Promise<any>(resolve => {\n   470→        store.live!.pushEvent(store.submitEvent, { [store.formName]: data }, (result: any) => {\n   471→          if (result && result.reset) {\n   472→            setTimeout(() => {\n   473→              Object.assign(store.initialValues, deepClone(store.currentValues))\n   474→              Object.assign(store.currentValues, deepClone(store.initialValues))\n   475→              store.touchedFields.clear()\n   476→              store.submitCount = 0\n   477→              rerender()\n   478→            }, 0)\n   479→          }\n   480→          resolve(result)\n   481→        })\n   482→      })\n   483→    } else {\n   484→      console.warn(\"LiveView hook not available, form submission skipped\")\n   485→      return Promise.resolve(undefined)\n   486→    }\n   487→  }\n   488→\n   489→  function reset(): void {\n   490→    Object.assign(store.currentValues, deepClone(store.initialValues))\n   491→    store.touchedFields.clear()\n   492→    store.submitCount = 0\n   493→    rerender()\n   494→  }\n   495→\n   496→  // ─── Build return value ───\n   497→\n   498→  return {\n   499→    get isValid() { return !hasAnyErrors(store.currentErrors) },\n   500→    get isDirty() { return JSON.stringify(store.currentValues) !== JSON.stringify(store.initialValues) },\n   501→    get isTouched() { return store.submitCount > 0 || store.touchedFields.size > 0 },\n   502→    get isValidating() { return store.isValidating },\n   503→    get submitCount() { return store.submitCount },\n   504→    get initialValues() { return store.initialValues as Readonly<T> },\n   505→\n   506→    field(path: string, options?: FieldOptions) {\n   507→      return createFormField(path, options)\n   508→    },\n   509→\n   510→    fieldArray(path: string) {\n   511→      return createFormFieldArray(path)\n   512→    },\n   513→\n   514→    submit,\n   515→    reset,\n   516→  }\n   517→}\n   518→\n   519→// ─── Child-component hooks ───\n   520→\n   521→export function useField<T = any>(path: string, options?: FieldOptions): ReactFormField<T> {\n   522→  const form = useContext(LiveFormContext)\n   523→  if (!form) {\n   524→    throw new Error(\n   525→      \"useField() can only be used inside components where a LiveFormContext.Provider is rendered. \" +\n   526→        \"Make sure to use useLiveForm() in a parent component and wrap children with LiveFormContext.Provider.\"\n   527→    )\n   528→  }\n   529→  return form.field(path, options) as ReactFormField<T>\n   530→}\n   531→\n   532→export function useArrayField<T = any>(path: string): ReactFormFieldArray<T> {\n   533→  const form = useContext(LiveFormContext)\n   534→  if (!form) {\n   535→    throw new Error(\n   536→      \"useArrayField() can only be used inside components where a LiveFormContext.Provider is rendered. \" +\n   537→        \"Make sure to use useLiveForm() in a parent component and wrap children with LiveFormContext.Provider.\"\n   538→    )\n   539→  }\n   540→  return form.fieldArray(path) as ReactFormFieldArray<T>\n   541→}\n   542→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"8cfcad3f-3a06-41f0-92cb-a7a9566506cd","uuid":"a8d4d4f2-70f1-407b-8716-bb5455b938f7","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/useLiveFormReact.ts","content":"import {\n  createContext,\n  useContext,\n  useEffect,\n  useRef,\n  useState,\n} from \"react\"\nimport { useLive } from \"./useReact.js\"\nimport {\n  parsePath,\n  getValueByPath,\n  setValueByPath,\n  sanitizeId,\n} from \"./utils.js\"\nimport type { Form, FormErrors, FormOptions, FieldOptions } from \"./useLiveForm.js\"\n\n// Deep clone utility (framework-agnostic)\nfunction deepClone<T>(obj: T): T {\n  if (typeof structuredClone === \"function\") {\n    return structuredClone(obj)\n  }\n  return JSON.parse(JSON.stringify(obj))\n}\n\n// Deep equality comparison\nfunction deepEqual(a: any, b: any): boolean {\n  if (a === b) return true\n  if (a == null || b == null) return false\n  if (typeof a !== \"object\" || typeof b !== \"object\") return false\n\n  const keysA = Object.keys(a).sort()\n  const keysB = Object.keys(b).sort()\n\n  if (keysA.length !== keysB.length) return false\n\n  for (let i = 0; i < keysA.length; i++) {\n    if (keysA[i] !== keysB[i]) return false\n    if (!deepEqual(a[keysA[i]], b[keysB[i]])) return false\n  }\n\n  return true\n}\n\n// Helper to check if any errors exist in nested error structure\nfunction hasAnyErrors(errors: any): boolean {\n  if (Array.isArray(errors)) {\n    if (errors.length === 0) return false\n    if (typeof errors[0] === \"string\") return errors.length > 0\n    return errors.some((item: any) => hasAnyErrors(item))\n  }\n  if (typeof errors === \"object\" && errors !== null) {\n    return Object.values(errors).some((value: any) => hasAnyErrors(value))\n  }\n  return false\n}\n\n// ─── React FormField interface (mirrors Vue but without Refs) ───\n\nexport interface ReactFormField<T> {\n  value: T\n  errors: string[]\n  errorMessage: string | undefined\n  isValid: boolean\n  isDirty: boolean\n  isTouched: boolean\n  setValue: (newValue: T) => void\n  blur: () => void\n\n  inputProps: {\n    value: any\n    onChange: (event: any) => void\n    onBlur: () => void\n    name: string\n    id: string\n    type?: string\n    checked?: boolean\n    \"aria-invalid\": boolean\n    \"aria-describedby\"?: string\n  }\n\n  field<K extends keyof T>(\n    key: K,\n    options?: FieldOptions\n  ): T[K] extends readonly (infer U)[] ? ReactFormFieldArray<U> : ReactFormField<T[K]>\n\n  fieldArray<K extends keyof T>(\n    key: K\n  ): T[K] extends readonly (infer U)[] ? ReactFormFieldArray<U> : never\n}\n\nexport interface ReactFormFieldArray<T> extends Omit<ReactFormField<T[]>, \"field\" | \"fieldArray\"> {\n  add: (item?: Partial<T>) => Promise<any>\n  remove: (index: number) => Promise<any>\n  move: (from: number, to: number) => Promise<any>\n  fields: ReactFormField<T>[]\n\n  field: <P extends string | number>(path: P, options?: FieldOptions) => ReactFormField<any>\n  fieldArray: <P extends string | number>(path: P) => ReactFormFieldArray<any>\n}\n\nexport interface UseLiveFormReactReturn<T extends object> {\n  isValid: boolean\n  isDirty: boolean\n  isTouched: boolean\n  isValidating: boolean\n  submitCount: number\n  initialValues: Readonly<T>\n\n  field<P extends string>(path: P, options?: FieldOptions): ReactFormField<any>\n  fieldArray<P extends string>(path: P): ReactFormFieldArray<any>\n\n  submit: () => Promise<any>\n  reset: () => void\n}\n\n// ─── React Context for form injection into children ───\n\nexport const LiveFormContext = createContext<{\n  field: (path: string, options?: FieldOptions) => ReactFormField<any>\n  fieldArray: (path: string) => ReactFormFieldArray<any>\n} | null>(null)\n\n// ─── Main hook ───\n\nexport function useLiveForm<T extends object>(\n  form: Form<T>,\n  options: FormOptions = {}\n): UseLiveFormReactReturn<T> {\n  const {\n    changeEvent = null,\n    submitEvent = \"submit\",\n    debounceInMiliseconds = 300,\n    prepareData = (data: any) => data,\n  } = options\n\n  // Get LiveView hook — may not be available (e.g. tests without LiveContext)\n  let live: ReturnType<typeof useLive> | null = null\n  try {\n    live = useLive()\n  } catch {\n    // Not inside a LiveVite context — form still works for local state\n  }\n\n  // Version counter to trigger re-renders when mutable refs change\n  const [, setVersion] = useState(0)\n  const rerender = () => setVersion(v => v + 1)\n\n  // ─── Mutable state stored in refs ───\n\n  // Use a single \"store\" ref to hold all mutable form state.\n  // This avoids stale closures and ensures field getters always\n  // see the latest state without needing useCallback dependencies.\n  const storeRef = useRef<{\n    initialValues: T\n    currentValues: T\n    currentErrors: FormErrors<T>\n    touchedFields: Set<string>\n    submitCount: number\n    debounceTimer: ReturnType<typeof setTimeout> | null\n    isValidating: boolean\n    fieldCache: Map<string, ReactFormField<any>[]>\n    fieldArrayCache: Map<string, ReactFormFieldArray<any>>\n    live: ReturnType<typeof useLive> | null\n    formName: string\n    changeEvent: string | null\n    submitEvent: string\n    debounceMs: number\n    prepareData: (data: any) => any\n  } | null>(null)\n\n  // Initialize store on first render only\n  if (storeRef.current === null) {\n    storeRef.current = {\n      initialValues: deepClone(form.values),\n      currentValues: deepClone(form.values),\n      currentErrors: deepClone(form.errors),\n      touchedFields: new Set(),\n      submitCount: 0,\n      debounceTimer: null,\n      isValidating: false,\n      fieldCache: new Map(),\n      fieldArrayCache: new Map(),\n      live,\n      formName: form.name,\n      changeEvent,\n      submitEvent,\n      debounceMs: debounceInMiliseconds,\n      prepareData,\n    }\n  }\n\n  // Keep live reference and options up-to-date\n  const store = storeRef.current\n  store.live = live\n  store.formName = form.name\n  store.changeEvent = changeEvent\n  store.submitEvent = submitEvent\n  store.debounceMs = debounceInMiliseconds\n  store.prepareData = prepareData\n\n  // ─── Server update handling ───\n\n  const prevFormRef = useRef(form)\n  useEffect(() => {\n    if (prevFormRef.current === form) return\n    prevFormRef.current = form\n\n    // Always update errors\n    store.currentErrors = deepClone(form.errors)\n\n    // Only update values if no validation is in progress\n    if (!store.isValidating) {\n      store.currentValues = deepClone(form.values)\n    }\n\n    rerender()\n  })\n\n  // Cleanup debounce timer on unmount\n  useEffect(() => {\n    return () => {\n      if (store.debounceTimer !== null) {\n        clearTimeout(store.debounceTimer)\n      }\n    }\n  }, [])\n\n  // ─── Send changes to server (debounced) ───\n\n  function sendChanges(): Promise<any> {\n    if (!store.changeEvent || !store.live) return Promise.resolve(null)\n\n    const values = deepClone(store.currentValues)\n    const data = store.prepareData(values)\n\n    return new Promise(resolve => {\n      store.live!.pushEvent(store.changeEvent!, { [store.formName]: data }, (result: any) => {\n        resolve(result)\n      })\n    })\n  }\n\n  function debouncedSendChanges(): void {\n    if (!store.changeEvent) return\n\n    const wait = store.live && store.changeEvent ? store.debounceMs : 0\n    if (wait <= 0) {\n      store.isValidating = true\n      sendChanges().finally(() => {\n        store.isValidating = false\n      })\n      return\n    }\n\n    if (store.debounceTimer !== null) {\n      clearTimeout(store.debounceTimer)\n    }\n\n    store.isValidating = true\n    store.debounceTimer = setTimeout(() => {\n      store.debounceTimer = null\n      sendChanges().finally(() => {\n        store.isValidating = false\n      })\n    }, wait)\n  }\n\n  // ─── Field creation (plain functions, close over storeRef) ───\n\n  function createFormField<V>(path: string, options: FieldOptions = {}): ReactFormField<V> {\n    if (!store.fieldCache.has(path)) {\n      store.fieldCache.set(path, [])\n    }\n    const fieldsForPath = store.fieldCache.get(path)!\n    const existing = fieldsForPath.find(f => deepEqual((f as any)._options, options))\n    if (existing) return existing as ReactFormField<V>\n\n    const keys = parsePath(path)\n    const fieldId = sanitizeId(path) + (options.value !== undefined ? `_${sanitizeId(String(options.value))}` : \"\")\n\n    const field: ReactFormField<V> = {\n      get value(): V {\n        return getValueByPath(store.currentValues, keys)\n      },\n\n      get errors(): string[] {\n        const errs = getValueByPath(store.currentErrors, keys)\n        return Array.isArray(errs) ? errs : []\n      },\n\n      get errorMessage(): string | undefined {\n        const errs = field.errors\n        return errs.length > 0 ? errs[0] : undefined\n      },\n\n      get isValid(): boolean {\n        return field.errors.length === 0\n      },\n\n      get isDirty(): boolean {\n        const initialVal = getValueByPath(store.initialValues, keys)\n        return JSON.stringify(field.value) !== JSON.stringify(initialVal)\n      },\n\n      get isTouched(): boolean {\n        return store.submitCount > 0 || store.touchedFields.has(path)\n      },\n\n      setValue(newValue: V) {\n        setValueByPath(store.currentValues, keys, newValue)\n        debouncedSendChanges()\n        rerender()\n      },\n\n      blur() {\n        store.touchedFields.add(path)\n        rerender()\n      },\n\n      get inputProps() {\n        const isMultiCheckbox = options.type === \"checkbox\" && Array.isArray(field.value)\n\n        const baseProps = {\n          name: path,\n          id: fieldId,\n          type: options.type,\n          onBlur: () => field.blur(),\n          \"aria-invalid\": !field.isValid as boolean,\n          ...(field.errors.length > 0 ? { \"aria-describedby\": `${fieldId}-error` } : {}),\n        }\n\n        if (isMultiCheckbox) {\n          return {\n            ...baseProps,\n            value: options.value,\n            checked: ((field.value as any[]) || []).includes(options.value),\n            onChange: (event: any) => {\n              const target = event.target as HTMLInputElement\n              const currentArray = [...((field.value as any[]) || [])]\n              const idx = currentArray.indexOf(options.value)\n              if (target.checked && idx === -1) {\n                currentArray.push(options.value)\n              } else if (!target.checked && idx !== -1) {\n                currentArray.splice(idx, 1)\n              }\n              field.setValue(currentArray as any)\n            },\n          }\n        } else if (options.type === \"checkbox\") {\n          const optionsValue = options.value !== undefined ? options.value : true\n          return {\n            ...baseProps,\n            value: options.value,\n            checked: field.value === optionsValue,\n            onChange: (event: any) => {\n              const target = event.target as HTMLInputElement\n              field.setValue((target.checked ? optionsValue : null) as any)\n            },\n          }\n        } else {\n          return {\n            ...baseProps,\n            value: field.value,\n            onChange: (event: any) => {\n              const target = event.target as HTMLInputElement\n              field.setValue(target.value as any)\n            },\n          }\n        }\n      },\n\n      field(key: any, opts?: FieldOptions) {\n        const subPath = path ? `${path}.${String(key)}` : String(key)\n        return createFormField(subPath, opts) as any\n      },\n\n      fieldArray(key: any) {\n        const subPath = path ? `${path}.${String(key)}` : String(key)\n        return createFormFieldArray(subPath) as any\n      },\n    }\n\n    // Store options for cache comparison\n    ;(field as any)._options = options\n    fieldsForPath.push(field)\n\n    return field\n  }\n\n  function createFormFieldArray<V>(path: string): ReactFormFieldArray<V> {\n    if (store.fieldArrayCache.has(path)) {\n      return store.fieldArrayCache.get(path) as ReactFormFieldArray<V>\n    }\n\n    const baseField = createFormField<V[]>(path)\n    const keys = parsePath(path)\n\n    const updateArray = (newArray: V[]) => {\n      setValueByPath(store.currentValues, keys, newArray)\n      debouncedSendChanges()\n      rerender()\n      return Promise.resolve()\n    }\n\n    const fieldArray: ReactFormFieldArray<V> = {\n      get value() { return baseField.value },\n      get errors() { return baseField.errors },\n      get errorMessage() { return baseField.errorMessage },\n      get isValid() { return baseField.isValid },\n      get isDirty() { return baseField.isDirty },\n      get isTouched() { return baseField.isTouched },\n      setValue: baseField.setValue,\n      blur: baseField.blur,\n      get inputProps() { return baseField.inputProps },\n\n      add(item?: Partial<V>) {\n        const currentArray = baseField.value || []\n        return updateArray([...currentArray, item as V])\n      },\n\n      remove(index: number) {\n        const currentArray = baseField.value || []\n        return updateArray(currentArray.filter((_: any, i: number) => i !== index))\n      },\n\n      move(from: number, to: number) {\n        const currentArray = [...(baseField.value || [])]\n        if (from >= 0 && from < currentArray.length && to >= 0 && to < currentArray.length) {\n          const item = currentArray.splice(from, 1)[0]\n          currentArray.splice(to, 0, item)\n          return updateArray(currentArray)\n        }\n        return Promise.resolve()\n      },\n\n      get fields(): ReactFormField<V>[] {\n        const array = baseField.value || []\n        return array.map((_: any, index: number) => createFormField<V>(`${path}[${index}]`))\n      },\n\n      field(pathOrIndex: any, options?: FieldOptions) {\n        if (typeof pathOrIndex === \"number\") {\n          return createFormField(`${path}[${pathOrIndex}]`, options)\n        }\n        return createFormField(`${path}${pathOrIndex}`, options)\n      },\n\n      fieldArray(pathOrIndex: any) {\n        if (typeof pathOrIndex === \"number\") {\n          return createFormFieldArray(`${path}[${pathOrIndex}]`)\n        }\n        return createFormFieldArray(`${path}${pathOrIndex}`)\n      },\n    }\n\n    store.fieldArrayCache.set(path, fieldArray)\n    return fieldArray\n  }\n\n  // ─── Form actions ───\n\n  function submit(): Promise<any> {\n    store.submitCount += 1\n    rerender()\n\n    if (store.live) {\n      const data = store.prepareData(deepClone(store.currentValues))\n\n      return new Promise<any>(resolve => {\n        store.live!.pushEvent(store.submitEvent, { [store.formName]: data }, (result: any) => {\n          if (result && result.reset) {\n            setTimeout(() => {\n              Object.assign(store.initialValues, deepClone(store.currentValues))\n              Object.assign(store.currentValues, deepClone(store.initialValues))\n              store.touchedFields.clear()\n              store.submitCount = 0\n              rerender()\n            }, 0)\n          }\n          resolve(result)\n        })\n      })\n    } else {\n      console.warn(\"LiveView hook not available, form submission skipped\")\n      return Promise.resolve(undefined)\n    }\n  }\n\n  function reset(): void {\n    Object.assign(store.currentValues, deepClone(store.initialValues))\n    store.touchedFields.clear()\n    store.submitCount = 0\n    rerender()\n  }\n\n  // ─── Build return value ───\n\n  return {\n    get isValid() { return !hasAnyErrors(store.currentErrors) },\n    get isDirty() { return JSON.stringify(store.currentValues) !== JSON.stringify(store.initialValues) },\n    get isTouched() { return store.submitCount > 0 || store.touchedFields.size > 0 },\n    get isValidating() { return store.isValidating },\n    get submitCount() { return store.submitCount },\n    get initialValues() { return store.initialValues as Readonly<T> },\n\n    field(path: string, options?: FieldOptions) {\n      return createFormField(path, options)\n    },\n\n    fieldArray(path: string) {\n      return createFormFieldArray(path)\n    },\n\n    submit,\n    reset,\n  }\n}\n\n// ─── Child-component hooks ───\n\nexport function useField<T = any>(path: string, options?: FieldOptions): ReactFormField<T> {\n  const form = useContext(LiveFormContext)\n  if (!form) {\n    throw new Error(\n      \"useField() can only be used inside components where a LiveFormContext.Provider is rendered. \" +\n        \"Make sure to use useLiveForm() in a parent component and wrap children with LiveFormContext.Provider.\"\n    )\n  }\n  return form.field(path, options) as ReactFormField<T>\n}\n\nexport function useArrayField<T = any>(path: string): ReactFormFieldArray<T> {\n  const form = useContext(LiveFormContext)\n  if (!form) {\n    throw new Error(\n      \"useArrayField() can only be used inside components where a LiveFormContext.Provider is rendered. \" +\n        \"Make sure to use useLiveForm() in a parent component and wrap children with LiveFormContext.Provider.\"\n    )\n  }\n  return form.fieldArray(path) as ReactFormFieldArray<T>\n}\n","numLines":542,"startLine":1,"totalLines":542}}}
