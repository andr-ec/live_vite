mber>(pathOrIndex: P): ArrayFieldArrayPath<V, P> {\n   493→        // Handle number shortcut: convert 0 to \"[0]\"\n   494→        if (typeof pathOrIndex === \"number\") {\n   495→          return createFormFieldArray(`${path}[${pathOrIndex}]`) as ArrayFieldArrayPath<V, P>\n   496→        }\n   497→        // Handle string path: use as-is, could be \"[0]\", \"[0].tags\", etc.\n   498→        return createFormFieldArray(`${path}${pathOrIndex}`) as ArrayFieldArrayPath<V, P>\n   499→      },\n   500→    }\n   501→\n   502→    // Cache the field array instance\n   503→    fieldArrayCache.set(path, fieldArray)\n   504→    return fieldArray\n   505→  }\n   506→\n   507→  // Method to update form state from server\n   508→  function updateFromServer(newForm: Form<T>) {\n   509→    // Always update errors, we don't want to lose them\n   510→    replaceReactiveObject(currentErrors, deepClone(newForm.errors))\n   511→\n   512→    // Only apply value updates if no validation is in progress\n   513→    // Otherwise we could overwrite local client data with server data\n   514→    if (!isValidatingChanges.value) {\n   515→      Object.assign(currentValues, deepClone(newForm.values))\n   516→    }\n   517→  }\n   518→\n   519→  // Watch for server updates to the form\n   520→  // setTimeout ensures updates are processed after current execution cycle\n   521→  const stopWatchingForm = watch(\n   522→    () => toValue(form),\n   523→    () => setTimeout(() => updateFromServer(toValue(form)), 0),\n   524→    { deep: true }\n   525→  )\n   526→\n   527→  const reset = () => {\n   528→    Object.assign(currentValues, deepClone(initialValues))\n   529→    touchedFields.clear()\n   530→    submitCount.value = 0\n   531→  }\n   532→\n   533→  const submit = async () => {\n   534→    // Increment submit count to mark all fields as touched\n   535→    submitCount.value += 1\n   536→\n   537→    if (live) {\n   538→      const data = prepareData(deepToRaw(currentValues))\n   539→\n   540→      return await new Promise<Form<T>>(resolve => {\n   541→        // Send submit event to LiveView\n   542→        live.pushEvent(submitEvent, { [initialForm.name]: data }, (result: any) => {\n   543→          // if it was successful, we want to reset the form, but it's hard to determine if it was successfull or not in an automated way\n   544→          // because eg initial form might have errors\n   545→          // so, user should reset his form manually if it was successfull\n   546→          // we provide a shortcut: if there's a reply with {reset: true},\n   547→          // it means it should be resetted on the client side as well\n   548→          if (result && result.reset) {\n   549→            setTimeout(() => {\n   550→              // let's wait for update from the server to be processed\n   551→              Object.assign(initialValues, deepClone(currentValues))\n   552→              reset()\n   553→            }, 0)\n   554→          }\n   555→          resolve(result)\n   556→        })\n   557→      })\n   558→    } else {\n   559→      // Fallback when not in LiveView context\n   560→      console.warn(\"LiveView hook not available, form submission skipped\")\n   561→      return Promise.resolve(undefined as any)\n   562→    }\n   563→  }\n   564→\n   565→  // Clean up watchers when component unmounts\n   566→  onScopeDispose(() => {\n   567→    stopWatchingForm()\n   568→  })\n   569→\n   570→  const formInstance = {\n   571→    isValid,\n   572→    isDirty,\n   573→    isTouched,\n   574→    isValidating: readonly(isValidatingChanges) as Readonly<Ref<boolean>>,\n   575→    submitCount: readonly(submitCount),\n   576→    initialValues: readonly(initialValues) as Readonly<T>,\n   577→    submit: submit,\n   578→    reset: reset,\n   579→    field<P extends PathsToStringProps<T>>(path: P, options?: FieldOptions): FormField<PathValue<T, P>> {\n   580→      return createFormField<PathValue<T, P>>(path as string, options)\n   581→    },\n   582→\n   5