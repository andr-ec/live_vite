wait page.goto(\"/upload/manual\")","+    await syncLV(page)"," ","-    const progress = await page.locator(\".file-progress\").textContent().catch(() => \"no progress element\")","-    console.log(\"Progress:\", progress)","+    // Select a file","+    await page.setInputFiles('input[type=\"file\"]', {","+      name: \"test-manual.txt\",","+      mimeType: \"text/plain\",","+      buffer: Buffer.from(\"test content\"),","+    })"," ","-    // Check for any errors in the browser console","-    const consoleMessages = []","-    page.on(\"console\", msg => consoleMessages.push(msg.text()))","+    await syncLV(page)"," ","-    // Check phx-submit-loading","-    const loadingCount = await page.locator(\".phx-submit-loading\").count()","-    console.log(\"phx-submit-loading count:\", loadingCount)","+    // Check the input element state","+    const inputState = await page.evaluate(() => {","+      const input = document.querySelector('input[type=\"file\"]')","+      if (!input) return \"no input found\"","+      return {","+        id: input.id,","+        'data-phx-active-refs': input.getAttribute('data-phx-active-refs'),","+        'data-phx-done-refs': input.getAttribute('data-phx-done-refs'),","+        'data-phx-preflighted-refs': input.getAttribute('data-phx-preflighted-refs'),","+      }","+    })","+    console.log(\"Vue Input state:\", JSON.stringify(inputState, null, 2))","   })"," })"]}],"originalFile":"import { test, expect } from \"@playwright/test\"\nimport { syncLV } from \"../../utils.js\"\n\ntest.describe(\"React useLiveUpload Debug\", () => {\n  test(\"debug manual upload flow\", async ({ page }) => {\n    await page.goto(\"/react-upload/manual\")\n    await syncLV(page)\n\n    // Select a file\n    await page.setInputFiles('input[type=\"file\"]', {\n      name: \"test-manual.txt\",\n      mimeType: \"text/plain\",\n      buffer: Buffer.from(\"test content\"),\n    })\n\n    await syncLV(page)\n\n    // Check the upload state before submitting\n    await expect(page.locator(\"#selected-count\")).toContainText(\"1\")\n\n    // Inspect the DOM structure\n    const formHtml = await page.evaluate(() => {\n      const forms = document.querySelectorAll('form')\n      return Array.from(forms).map(f => ({\n        html: f.outerHTML.substring(0, 200),\n        parent: f.parentElement?.tagName + '#' + f.parentElement?.id,\n        classList: Array.from(f.classList),\n      }))\n    })\n    console.log(\"Forms on page:\", JSON.stringify(formHtml, null, 2))\n\n    // Check upload input state\n    const inputState = await page.evaluate(() => {\n      const input = document.querySelector('input[type=\"file\"]')\n      if (!input) return \"no input found\"\n      return {\n        id: input.id,\n        name: input.name,\n        'data-phx-hook': input.getAttribute('data-phx-hook'),\n        'data-phx-upload-ref': input.getAttribute('data-phx-upload-ref'),\n        'data-phx-active-refs': input.getAttribute('data-phx-active-refs'),\n        'data-phx-done-refs': input.getAttribute('data-phx-done-refs'),\n        'data-phx-preflighted-refs': input.getAttribute('data-phx-preflighted-refs'),\n        files: input.files?.length,\n      }\n    })\n    console.log(\"Input state:\", JSON.stringify(inputState, null, 2))\n\n    // Click upload - but don't use syncLV, use waitForTimeout instead\n    await page.click(\"#upload-btn\")\n    await page.waitForTimeout(3000)\n\n    // Check what happened\n    const uploadedCount = await page.locator(\"#uploaded-count\").textContent()\n    console.log(\"Uploaded count after 3s:\", uploadedCount)\n\n    const fileStatus = await page.locator(\".file-done\").textContent().catch(() => \"no file-done element\")\n    console.log(\"File status:\", fileStatus)\n\n    const progress = await page.locator(\".file-progress\").textContent().catch(() => \"no progress element\")\n    console.log(\"Progress:\", progress)\n\n    // Check for any errors in the browser console\n    const consoleMessages = []\n    page.on(\"console\", msg => consoleMessages.push(msg.text()))\n\n    // Check phx-submit-loading\n    const loadingCount = await page.locator(\".phx-submit-loading\").count()\n    console.log(\"phx-submit-loading count:\", loadingCount)\n  })\n})\n"}}
