data-testid=\"name-input\"]', \"\")\n   150→    await page.fill('[data-testid=\"description-input\"]', \"Description only\")\n   151→\n   152→    page.on(\"dialog\", async dialog => {\n   153→      expect(dialog.message()).toBe(\"Please enter a name for the item\")\n   154→      await dialog.accept()\n   155→    })\n   156→\n   157→    await page.click('[data-testid=\"add-button\"]')\n   158→\n   159→    await syncLV(page)\n   160→    const itemsHeading = page.locator('h3:has-text(\"Items\")')\n   161→    await expect(itemsHeading).toHaveText(\"Items (3)\")\n   162→  })\n   163→\n   164→  test(\"maintains item order during operations\", async ({ page }) => {\n   165→    const item1Name = await page.locator('[data-testid=\"item-1\"] [data-testid=\"item-name\"]').textContent()\n   166→    const item2Name = await page.locator('[data-testid=\"item-2\"] [data-testid=\"item-name\"]').textContent()\n   167→    const item3Name = await page.locator('[data-testid=\"item-3\"] [data-testid=\"item-name\"]').textContent()\n   168→\n   169→    expect(item1Name).toBe(\"Item 1\")\n   170→    expect(item2Name).toBe(\"Item 2\")\n   171→    expect(item3Name).toBe(\"Item 3\")\n   172→\n   173→    await page.fill('[data-testid=\"name-input\"]', \"Item 4\")\n   174→    await page.fill('[data-testid=\"description-input\"]', \"Fourth item\")\n   175→    await page.click('[data-testid=\"add-button\"]')\n   176→    await syncLV(page)\n   177→\n   178→    const item4Name = await page.locator('[data-testid=\"item-4\"] [data-testid=\"item-name\"]').textContent()\n   179→    expect(item4Name).toBe(\"Item 4\")\n   180→\n   181→    await page.click('[data-testid=\"remove-2\"]')\n   182→    await syncLV(page)\n   183→\n   184→    await expect(page.locator('[data-testid=\"item-1\"] [data-testid=\"item-name\"]')).toHaveText(\"Item 1\")\n   185→    await expect(page.locator('[data-testid=\"item-3\"] [data-testid=\"item-name\"]')).toHaveText(\"Item 3\")\n   186→    await expect(page.locator('[data-testid=\"item-4\"] [data-testid=\"item-name\"]')).toHaveText(\"Item 4\")\n   187→  })\n   188→\n   189→  test(\"maintains correct item order after stream reset\", async ({ page }) => {\n   190→    await page.fill('[data-testid=\"name-input\"]', \"Extra Item\")\n   191→    await page.fill('[data-testid=\"description-input\"]', \"Extra description\")\n   192→    await page.click('[data-testid=\"add-button\"]')\n   193→    await syncLV(page)\n   194→\n   195→    await page.click('[data-testid=\"reset-button\"]')\n   196→    await syncLV(page)\n   197→\n   198→    const allItems = await page.locator('[data-testid=\"item-name\"]').allTextContents()\n   199→    expect(allItems).toEqual([\"Item 1\", \"Item 2\", \"Item 3\"])\n   200→\n   201→    await page.click('[data-testid=\"reset-button-at-0\"]')\n   202→    await syncLV(page)\n   203→\n   204→    const allReversedItems = await page.locator('[data-testid=\"item-name\"]').allTextContents()\n   205→    expect(allReversedItems).toEqual([\"Item 3\", \"Item 2\", \"Item 1\"])\n   206→  })\n   207→\n   208→  // Limit operation tests\n   209→  test.describe(\"Limit Operations\", () => {\n   210→    test.beforeEach(async ({ page }) => {\n   211→      await page.goto(\"/react-streams\")\n   212→      await syncLV(page)\n   213→    })\n   214→\n   215→    test(\"adds multiple items at start with positive limit\", async ({ page }) => {\n   216→      await expect(page.locator('h3:has-text(\"Items\")')).toHaveText(\"Items (3)\")\n   217→\n   218→      await page.click('[data-testid=\"add-multiple-start-button\"]')\n   219→      await syncLV(page)\n   220→\n   221→      await expect(page.locator('h3:has-text(\"Items\")')).toHaveText(\"Items (5)\")\n   222→\n   223→      await expect(page.locator('[data-testid=\"item-6\"] [data-testid=\"item-name\"]')).toHaveText(\"Start Item C\")\n   224→      await expect(page.locator('[data-testid=\"item-5\"] [data-testid=\"item-name\"]')).toHaveText(\"Start Item B\")\n   225→      await expect(page.locator('[data-testid=\"item-4\"] [data-testid=\"item-name\"]')).toHaveText(\"Start Item A\")\n   226→      await expect(page.locator('[data-testid=\"item-1\"] [data-testid=\"item-name\"]')).toHaveText(\"Item 1\")\n   227→      await expect(page.locator('[data-testid=\"item-2\"] [data-testid=\"item-name\"]')).toHaveText(\"Item 2\")\n   228→\n   229→      await expect(page.locator('[data-testid=\"item-3\"]')).not.toBeVisible()\n   230→    })\n   231→\n   232→    test(\"adds multiple items at end with negative limit\", async ({ page }) => {\n   233→      await expect(page.locator('h3:has-text(\"Items\")')).toHaveText(\"Items (3)\")\n   234→\n   235→      await page.click('[data-testid=\"add-multiple-end-button\"]')\n   236→      await syncLV(page)\n   237→\n   238→      await expect(page.locator('h3:has-text(\"Items\")')).toHaveText(\"Items (5)\")\n   239→\n   240→      await expect(page.locator('[data-testid=\"item-1\"]')).not.toBeVisible()\n   241→      await expect(page.locator('[data-testid=\"item-2\"] [data-testid=\"item-name\"]')).toHaveText(\"Item 2\")\n   242→      await expect(page.locator('[data-testid=\"item-3\"] [data-testid=\"item-name\"]')).toHaveText(\"Item 3\")\n   243→      await expect(page.locator('[data-testid=\"item-4\"] [data-testid=\"item-name\"]')).toHaveText(\"End Item X\")\n   244→      await expect(page.locator('[data-testid=\"item-5\"] [data-testid=\"item-name\"]')).toHaveText(\"End Item Y\")\n   245→      await expect(page.locator('[data-testid=\"item-6\"] [data-testid=\"item-name\"]')).toHaveText(\"End Item Z\")\n   246→    })\n   247→\n   248→    test(\"adds single item with custom positive limit\", async ({ page }) => {\n   249→      await page.fill('[data-testid=\"positive-limit-input\"]', \"2\")\n   250→\n   251→      await page.click('[data-testid=\"add-positive-limit-button\"]')\n   252→      await syncLV(page)\n   253→\n   254→      await expect(page.locator('h3:has-text(\"Items\")')).toHaveText(\"Items (2)\")\n   255→\n   256→      aw