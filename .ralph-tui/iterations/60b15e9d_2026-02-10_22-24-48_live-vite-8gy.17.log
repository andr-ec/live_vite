ohn\", { delay: 50 })\n   285→\n   286→    // Should not trigger validation immediately\n   287→    await page.waitForTimeout(100)\n   288→\n   289→    // Continue typing\n   290→    await nameInput.pressSequentially(\" Doe\", { delay: 50 })\n   291→\n   292→    // Wait for debounce period (300ms) plus some buffer\n   293→    await page.waitForTimeout(400)\n   294→    await syncLV(page)\n   295→\n   296→    // Should have final value and validation should have occurred\n   297→    await expect(nameInput).toHaveValue(\"John Doe\")\n   298→    await expect(page.locator(\"[data-pw-is-dirty]\")).toHaveText(\"Dirty: true\")\n   299→  })\n   300→\n   301→  test(\"accessibility attributes are properly set\", async ({ page }) => {\n   302→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   303→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   304→\n   305→    // Fill invalid data to trigger errors\n   306→    await nameInput.fill(\"A\")\n   307→    await emailInput.fill(\"invalid\")\n   308→    await nameInput.blur()\n   309→    await emailInput.blur()\n   310→    await syncLV(page)\n   311→\n   312→    // Check aria-invalid attributes\n   313→    await expect(nameInput).toHaveAttribute(\"aria-invalid\", \"true\")\n   314→    await expect(emailInput).toHaveAttribute(\"aria-invalid\", \"true\")\n   315→\n   316→    // Check aria-describedby attributes\n   317→    await expect(nameInput).toHaveAttribute(\"aria-describedby\")\n   318→    await expect(emailInput).toHaveAttribute(\"aria-describedby\")\n   319→\n   320→    // Fix the errors\n   321→    await nameInput.fill(\"John Doe\")\n   322→    await emailInput.fill(\"john@example.com\")\n   323→    await nameInput.blur()\n   324→    await emailInput.blur()\n   325→    await syncLV(page)\n   326→\n   327→    // Aria-invalid should be false\n   328→    await expect(nameInput).toHaveAttribute(\"aria-invalid\", \"false\")\n   329→    await expect(emailInput).toHaveAttribute(\"aria-invalid\", \"false