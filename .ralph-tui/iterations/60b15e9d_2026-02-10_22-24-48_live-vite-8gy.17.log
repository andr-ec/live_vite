t expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: false\")\n   416→\n   417→    // Check accept terms\n   418→    await acceptTermsCheckbox.check()\n   419→    await syncLV(page)\n   420→\n   421→    // Form should now be valid\n   422→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: true\")\n   423→    await expect(acceptTermsCheckbox).toBeChecked()\n   424→    await expect(newsletterCheckbox).not.toBeChecked()\n   425→\n   426→    // Check newsletter (optional)\n   427→    await newsletterCheckbox.check()\n   428→    await syncLV(page)\n   429→\n   430→    // Form should still be valid, both checkboxes checked\n   431→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: true\")\n   432→    await expect(acceptTermsCheckbox).toBeChecked()\n   433→    await expect(newsletterCheckbox).toBeChecked()\n   434→\n   435→    // Uncheck accept terms - form should become invalid\n   436→    await acceptTermsCheckbox.uncheck()\n   437→    await syncLV(page)\n   438→\n   439→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: false\")\n   440→    await expect(acceptTermsCheckbox).not.toBeChecked()\n   441→    await expect(newsletterCheckbox).toBeChecked()\n   442→\n   443→    // Should show error message for accept terms\n   444→    await expect(page.locator(\"[data-pw-accept-terms-error]\")).toBeVisible()\n   445→  })\n   446→\n   447→  test(\"multi-checkbox array functionality\", async ({ page }) => {\n   448→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   449→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   450→    const acceptTermsCheckbox = page.locator(\"[data-pw-accept-terms]\")\n   451→    const emailPrefCheckbox = page.locator(\"[data-pw-preferences-email]\")\n   452→    const smsPrefCheckbox = page.locator(\"[data-pw-preferences-sms]\")\n   453→    const pushPrefCheckbox = page.locator(\"[data-pw-preferences-push]\")\n   454→\n   455→    // Fill r