{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017pQCD3Vkt2f7hh1AjTY8Bx","type":"tool_result","content":"     1→import { test, expect } from \"@playwright/test\"\n     2→import { syncLV } from \"../../utils.js\"\n     3→\n     4→test.describe(\"React useLiveForm E2E Tests\", () => {\n     5→  test.beforeEach(async ({ page }) => {\n     6→    await page.goto(\"/react-form-test\")\n     7→    await syncLV(page)\n     8→  })\n     9→\n    10→  test(\"form initializes with empty state and is invalid\", async ({ page }) => {\n    11→    await expect(page.locator(\"[data-pw-form]\")).toBeVisible()\n    12→\n    13→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: false\")\n    14→    await expect(page.locator(\"[data-pw-is-dirty]\")).toHaveText(\"Dirty: false\")\n    15→    await expect(page.locator(\"[data-pw-is-touched]\")).toHaveText(\"Touched: false\")\n    16→\n    17→    await expect(page.locator(\"[data-pw-submit]\")).toBeDisabled()\n    18→  })\n    19→\n    20→  test(\"basic field validation and form state tracking\", async ({ page }) => {\n    21→    const nameInput = page.locator(\"[data-pw-name-input]\")\n    22→    const emailInput = page.locator(\"[data-pw-email-input]\")\n    23→    const acceptTermsCheckbox = page.locator(\"[data-pw-accept-terms]\")\n    24→\n    25→    // Fill name field (but not enough characters)\n    26→    await nameInput.type(\"A\")\n    27→    await nameInput.blur()\n    28→    await page.waitForTimeout(500)\n    29→    await syncLV(page)\n    30→\n    31→    // Form should be touched and dirty but not valid\n    32→    await expect(page.locator(\"[data-pw-is-touched]\")).toHaveText(\"Touched: true\")\n    33→    await expect(page.locator(\"[data-pw-is-dirty]\")).toHaveText(\"Dirty: true\")\n    34→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: false\")\n    35→\n    36→    // Should show validation error after server validation\n    37→    await expect(page.locator(\"[data-pw-name-error]\")).toBeVisible()\n    38→\n    39→    // Fill valid data\n    40→    await nameInput.clear()\n    41→    await nameInput.type(\"John Doe\")\n    42→    await emailInput.type(\"john@example.com\")\n    43→    await acceptTermsCheckbox.check()\n    44→    await page.waitForTimeout(500)\n    45→    await syncLV(page)\n    46→\n    47→    // Form should now be valid\n    48→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: true\")\n    49→    await expect(page.locator(\"[data-pw-submit]\")).toBeEnabled()\n    50→  })\n    51→\n    52→  test(\"nested field validation (profile bio)\", async ({ page }) => {\n    53→    const nameInput = page.locator(\"[data-pw-name-input]\")\n    54→    const emailInput = page.locator(\"[data-pw-email-input]\")\n    55→    const bioInput = page.locator(\"[data-pw-bio-input]\")\n    56→    const acceptTermsCheckbox = page.locator(\"[data-pw-accept-terms]\")\n    57→\n    58→    // Fill required fields first\n    59→    await nameInput.fill(\"John Doe\")\n    60→    await emailInput.fill(\"john@example.com\")\n    61→    await acceptTermsCheckbox.check()\n    62→\n    63→    // Fill bio with insufficient content\n    64→    await bioInput.fill(\"Short\")\n    65→    await bioInput.blur()\n    66→    await syncLV(page)\n    67→\n    68→    // Should show bio validation error\n    69→    await expect(page.locator(\"[data-pw-bio-error]\")).toBeVisible()\n    70→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: false\")\n    71→\n    72→    // Fill with valid bio\n    73→    await bioInput.fill(\"This is a valid bio with enough characters to pass validation\")\n    74→    await bioInput.blur()\n    75→    await syncLV(page)\n    76→\n    77→    // Form should be valid now\n    78→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: true\")\n    79→  })\n    80→\n    81→  test(\"array field operations - skills\", async ({ page }) => {\n    82→    const nameInput = page.locator(\"[data-pw-name-input]\")\n    83→    const emailInput = page.locator(\"[data-pw-email-input]\")\n    84→\n    85→    // Fill required fields\n    86→    await nameInput.fill(\"John Doe\")\n    87→    await emailInput.fill(\"john@example.com\")\n    88→\n    89→    // Initially no skills\n    90→    await expect(page.locator(\"[data-pw-skill-item]\")).toHaveCount(0)\n    91→\n    92→    // Add a skill\n    93→    await page.locator(\"[data-pw-add-skill]\").click()\n    94→    await expect(page.locator(\"[data-pw-skill-item]\")).toHaveCount(1)\n    95→\n    96→    // Fill the skill\n    97→    await page.locator('[data-pw-skill-input=\"0\"]').fill(\"JavaScript\")\n    98→    await syncLV(page)\n    99→\n   100→    // Add another skill\n   101→    await page.locator(\"[data-pw-add-skill]\").click()\n   102→    await expect(page.locator(\"[data-pw-skill-item]\")).toHaveCount(2)\n   103→\n   104→    // Fill second skill\n   105→    await page.locator('[data-pw-skill-input=\"1\"]').fill(\"TypeScript\")\n   106→    await syncLV(page)\n   107→\n   108→    // Remove first skill\n   109→    await page.locator('[data-pw-remove-skill=\"0\"]').click()\n   110→    await expect(page.locator(\"[data-pw-skill-item]\")).toHaveCount(1)\n   111→\n   112→    // Remaining skill should be TypeScript\n   113→    await expect(page.locator('[data-pw-skill-input=\"0\"]')).toHaveValue(\"TypeScript\")\n   114→  })\n   115→\n   116→  test(\"nested array field operations - items with tags\", async ({ page }) => {\n   117→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   118→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   119→\n   120→    // Fill required fields\n   121→    await nameInput.fill(\"John Doe\")\n   122→    await emailInput.fill(\"john@example.com\")\n   123→\n   124→    // Add an item\n   125→    await page.locator(\"[data-pw-add-item]\").click()\n   126→    await expect(page.locator(\"[data-pw-item]\")).toHaveCount(1)\n   127→\n   128→    // Fill item title\n   129→    await page.locator('[data-pw-item-title=\"0\"]').fill(\"First Item\")\n   130→\n   131→    // Add tags to the item\n   132→    await page.locator('[data-pw-add-tag=\"0\"]').click()\n   133→    await page.locator('[data-pw-add-tag=\"0\"]').click()\n   134→    await expect(page.locator(\"[data-pw-tag-item]\")).toHaveCount(2)\n   135→\n   136→    // Fill tags\n   137→    await page.locator('[data-pw-tag-input=\"0-0\"]').fill(\"important\")\n   138→    await page.locator('[data-pw-tag-input=\"0-1\"]').fill(\"urgent\")\n   139→\n   140→    // Add second item\n   141→    await page.locator(\"[data-pw-add-item]\").click()\n   142→    await expect(page.locator(\"[data-pw-item]\")).toHaveCount(2)\n   143→\n   144→    // Fill second item\n   145→    await page.locator('[data-pw-item-title=\"1\"]').fill(\"Second Item\")\n   146→    await page.locator('[data-pw-add-tag=\"1\"]').click()\n   147→    await page.locator('[data-pw-tag-input=\"1-0\"]').fill(\"normal\")\n   148→\n   149→    // Remove first tag from first item\n   150→    await page.locator('[data-pw-remove-tag=\"0-0\"]').click()\n   151→\n   152→    // Should have one tag left in first item\n   153→    const firstItemTags = page.locator('[data-pw-item=\"0\"] [data-pw-tag-item]')\n   154→    await expect(firstItemTags).toHaveCount(1)\n   155→    await expect(page.locator('[data-pw-tag-input=\"0-0\"]')).toHaveValue(\"urgent\")\n   156→\n   157→    // Remove first item entirely\n   158→    await page.locator('[data-pw-remove-item=\"0\"]').click()\n   159→    await expect(page.locator(\"[data-pw-item]\")).toHaveCount(1)\n   160→\n   161→    // Remaining item should be \"Second Item\"\n   162→    await expect(page.locator('[data-pw-item-title=\"0\"]')).toHaveValue(\"Second Item\")\n   163→  })\n   164→\n   165→  test(\"form validation lifecycle with server errors\", async ({ page }) => {\n   166→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   167→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   168→    const acceptTermsCheckbox = page.locator(\"[data-pw-accept-terms]\")\n   169→\n   170→    // Fill invalid data that will trigger server validation\n   171→    await nameInput.fill(\"A\") // Too short\n   172→    await emailInput.fill(\"invalid-email\") // Invalid format\n   173→    await nameInput.blur()\n   174→    await emailInput.blur()\n   175→    await acceptTermsCheckbox.check()\n   176→    await syncLV(page)\n   177→\n   178→    // Should show validation errors\n   179→    await expect(page.locator(\"[data-pw-name-error]\")).toBeVisible()\n   180→    await expect(page.locator(\"[data-pw-email-error]\")).toBeVisible()\n   181→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: false\")\n   182→\n   183→    // Fix the name\n   184→    await nameInput.fill(\"John Doe\")\n   185→    await nameInput.blur()\n   186→    await syncLV(page)\n   187→\n   188→    // Name error should be gone, email error should remain\n   189→    await expect(page.locator(\"[data-pw-name-error]\")).not.toBeVisible()\n   190→    await expect(page.locator(\"[data-pw-email-error]\")).toBeVisible()\n   191→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: false\")\n   192→\n   193→    // Fix the email\n   194→    await emailInput.fill(\"john@example.com\")\n   195→    await emailInput.blur()\n   196→    await syncLV(page)\n   197→\n   198→    // All errors should be gone\n   199→    await expect(page.locator(\"[data-pw-name-error]\")).not.toBeVisible()\n   200→    await expect(page.locator(\"[data-pw-email-error]\")).not.toBeVisible()\n   201→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: true\")\n   202→  })\n   203→\n   204→  test(\"form submission with valid data\", async ({ page }) => {\n   205→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   206→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   207→    const ageInput = page.locator(\"[data-pw-age-input]\")\n   208→    const bioInput = page.locator(\"[data-pw-bio-input]\")\n   209→    const acceptTermsCheckbox = page.locator(\"[data-pw-accept-terms]\")\n   210→\n   211→    // Fill valid form data\n   212→    await nameInput.fill(\"John Doe\")\n   213→    await emailInput.fill(\"john@example.com\")\n   214→    await ageInput.fill(\"30\")\n   215→    await bioInput.fill(\"This is a comprehensive bio with sufficient content for validation\")\n   216→    await acceptTermsCheckbox.check()\n   217→    await page.waitForTimeout(150)\n   218→    await syncLV(page)\n   219→\n   220→    // Add some skills\n   221→    await page.locator(\"[data-pw-add-skill]\").click()\n   222→    await page.locator('[data-pw-skill-input=\"0\"]').fill(\"JavaScript\")\n   223→    await page.locator(\"[data-pw-add-skill]\").click()\n   224→    await page.locator('[data-pw-skill-input=\"1\"]').fill(\"React\")\n   225→\n   226→    // Add an item with tags\n   227→    await page.locator(\"[data-pw-add-item]\").click()\n   228→    await page.locator('[data-pw-item-title=\"0\"]').fill(\"Build awesome apps\")\n   229→    await page.locator('[data-pw-add-tag=\"0\"]').click()\n   230→    await page.locator('[data-pw-tag-input=\"0-0\"]').fill(\"development\")\n   231→\n   232→    await syncLV(page)\n   233→\n   234→    // Form should be valid\n   235→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: true\")\n   236→    await expect(page.locator(\"[data-pw-submit]\")).toBeEnabled()\n   237→\n   238→    // Submit the form\n   239→    await page.locator(\"[data-pw-submit]\").click()\n   240→    await syncLV(page)\n   241→\n   242→    // Form should be reset after successful submission\n   243→    await expect(page.locator(\"[data-pw-name-input]\")).toHaveValue(\"\")\n   244→    await expect(page.locator(\"[data-pw-email-input]\")).toHaveValue(\"\")\n   245→    await expect(page.locator(\"[data-pw-is-dirty]\")).toHaveText(\"Dirty: false\")\n   246→    await expect(page.locator(\"[data-pw-is-touched]\")).toHaveText(\"Touched: false\")\n   247→  })\n   248→\n   249→  test(\"form reset functionality\", async ({ page }) => {\n   250→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   251→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   252→\n   253→    // Fill some data\n   254→    await nameInput.fill(\"John Doe\")\n   255→    await emailInput.fill(\"john@example.com\")\n   256→    await page.locator(\"[data-pw-add-skill]\").click()\n   257→    await page.locator('[data-pw-skill-input=\"0\"]').fill(\"JavaScript\")\n   258→\n   259→    await syncLV(page)\n   260→\n   261→    // Form should be dirty\n   262→    await expect(page.locator(\"[data-pw-is-dirty]\")).toHaveText(\"Dirty: true\")\n   263→\n   264→    // Reset the form\n   265→    await page.locator(\"[data-pw-reset]\").click()\n   266→\n   267→    // Form should be clean\n   268→    await expect(page.locator(\"[data-pw-name-input]\")).toHaveValue(\"\")\n   269→    await expect(page.locator(\"[data-pw-email-input]\")).toHaveValue(\"\")\n   270→    await expect(page.locator(\"[data-pw-skill-item]\")).toHaveCount(0)\n   271→    await expect(page.locator(\"[data-pw-is-dirty]\")).toHaveText(\"Dirty: false\")\n   272→    await expect(page.locator(\"[data-pw-is-touched]\")).toHaveText(\"Touched: false\")\n   273→  })\n   274→\n   275→  test(\"debounced validation events\", async ({ page }) => {\n   276→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   277→\n   278→    // Type rapidly to test debouncing\n   279→    await nameInput.focus()\n   280→    await nameInput.pressSequentially(\"John\", { delay: 50 })\n   281→\n   282→    // Should not trigger validation immediately\n   283→    await page.waitForTimeout(100)\n   284→\n   285→    // Continue typing\n   286→    await nameInput.pressSequentially(\" Doe\", { delay: 50 })\n   287→\n   288→    // Wait for debounce period (300ms) plus some buffer\n   289→    await page.waitForTimeout(400)\n   290→    await syncLV(page)\n   291→\n   292→    // Should have final value and validation should have occurred\n   293→    await expect(nameInput).toHaveValue(\"John Doe\")\n   294→    await expect(page.locator(\"[data-pw-is-dirty]\")).toHaveText(\"Dirty: true\")\n   295→  })\n   296→\n   297→  test(\"accessibility attributes are properly set\", async ({ page }) => {\n   298→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   299→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   300→\n   301→    // Fill invalid data to trigger errors\n   302→    await nameInput.fill(\"A\")\n   303→    await emailInput.fill(\"invalid\")\n   304→    await nameInput.blur()\n   305→    await emailInput.blur()\n   306→    await syncLV(page)\n   307→\n   308→    // Check aria-invalid attributes\n   309→    await expect(nameInput).toHaveAttribute(\"aria-invalid\", \"true\")\n   310→    await expect(emailInput).toHaveAttribute(\"aria-invalid\", \"true\")\n   311→\n   312→    // Check aria-describedby attributes\n   313→    await expect(nameInput).toHaveAttribute(\"aria-describedby\")\n   314→    await expect(emailInput).toHaveAttribute(\"aria-describedby\")\n   315→\n   316→    // Fix the errors\n   317→    await nameInput.fill(\"John Doe\")\n   318→    await emailInput.fill(\"john@example.com\")\n   319→    await nameInput.blur()\n   320→    await emailInput.blur()\n   321→    await syncLV(page)\n   322→\n   323→    // Aria-invalid should be false\n   324→    await expect(nameInput).toHaveAttribute(\"aria-invalid\", \"false\")\n   325→    await expect(emailInput).toHaveAttribute(\"aria-invalid\", \"false\")\n   326→  })\n   327→\n   328→  test(\"form maintains state during LiveView updates\", async ({ page }) => {\n   329→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   330→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   331→\n   332→    // Start filling the form\n   333→    await nameInput.focus()\n   334→    await nameInput.fill(\"John\")\n   335→\n   336→    // Trigger a server action that might update the form\n   337→    await emailInput.fill(\"john@example.com\")\n   338→    await emailInput.blur()\n   339→    await syncLV(page)\n   340→\n   341→    // Continue editing the name field while server processes\n   342→    await nameInput.focus()\n   343→    await nameInput.fill(\"John Doe\")\n   344→\n   345→    // The name field should retain the user's input\n   346→    await expect(nameInput).toHaveValue(\"John Doe\")\n   347→    await expect(emailInput).toHaveValue(\"john@example.com\")\n   348→  })\n   349→\n   350→  test(\"complex nested validation with items and tags\", async ({ page }) => {\n   351→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   352→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   353→    const acceptTermsCheckbox = page.locator(\"[data-pw-accept-terms]\")\n   354→\n   355→    // Fill required fields\n   356→    await nameInput.fill(\"John Doe\")\n   357→    await emailInput.fill(\"john@example.com\")\n   358→    await acceptTermsCheckbox.check()\n   359→\n   360→    // Add item with invalid title (too short)\n   361→    await page.locator(\"[data-pw-add-item]\").click()\n   362→    await page.locator('[data-pw-item-title=\"0\"]').fill(\"Hi\") // Too short\n   363→    await page.locator('[data-pw-item-title=\"0\"]').blur()\n   364→    await syncLV(page)\n   365→\n   366→    // Form should be invalid due to item validation\n   367→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: false\")\n   368→\n   369→    // Fix the item title\n   370→    await page.locator('[data-pw-item-title=\"0\"]').fill(\"Valid Item Title\")\n   371→    await page.locator('[data-pw-item-title=\"0\"]').blur()\n   372→    await syncLV(page)\n   373→\n   374→    // Form should be valid now\n   375→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: true\")\n   376→\n   377→    // Add a short tag (which should be invalid)\n   378→    await page.locator('[data-pw-add-tag=\"0\"]').click()\n   379→    await page.locator('[data-pw-tag-input=\"0-0\"]').fill(\"a\")\n   380→    await page.locator('[data-pw-tag-input=\"0-0\"]').blur()\n   381→    await syncLV(page)\n   382→\n   383→    // Form should be invalid due to short tag\n   384→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: false\")\n   385→\n   386→    // Fill the tag\n   387→    await page.locator('[data-pw-tag-input=\"0-0\"]').fill(\"valid-tag\")\n   388→    await page.locator('[data-pw-tag-input=\"0-0\"]').blur()\n   389→    await syncLV(page)\n   390→\n   391→    // Form should be valid again\n   392→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: true\")\n   393→  })\n   394→\n   395→  test(\"single checkbox functionality\", async ({ page }) => {\n   396→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   397→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   398→    const acceptTermsCheckbox = page.locator(\"[data-pw-accept-terms]\")\n   399→    const newsletterCheckbox = page.locator(\"[data-pw-newsletter]\")\n   400→\n   401→    // Fill required fields first\n   402→    await nameInput.fill(\"John Doe\")\n   403→    await emailInput.fill(\"john@example.com\")\n   404→    await syncLV(page)\n   405→\n   406→    // Initially checkboxes should be unchecked\n   407→    await expect(acceptTermsCheckbox).not.toBeChecked()\n   408→    await expect(newsletterCheckbox).not.toBeChecked()\n   409→\n   410→    // Form should be invalid because acceptTerms is required\n   411→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: false\")\n   412→\n   413→    // Check accept terms\n   414→    await acceptTermsCheckbox.check()\n   415→    await syncLV(page)\n   416→\n   417→    // Form should now be valid\n   418→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: true\")\n   419→    await expect(acceptTermsCheckbox).toBeChecked()\n   420→    await expect(newsletterCheckbox).not.toBeChecked()\n   421→\n   422→    // Check newsletter (optional)\n   423→    await newsletterCheckbox.check()\n   424→    await syncLV(page)\n   425→\n   426→    // Form should still be valid, both checkboxes checked\n   427→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: true\")\n   428→    await expect(acceptTermsCheckbox).toBeChecked()\n   429→    await expect(newsletterCheckbox).toBeChecked()\n   430→\n   431→    // Uncheck accept terms - form should become invalid\n   432→    await acceptTermsCheckbox.uncheck()\n   433→    await syncLV(page)\n   434→\n   435→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: false\")\n   436→    await expect(acceptTermsCheckbox).not.toBeChecked()\n   437→    await expect(newsletterCheckbox).toBeChecked()\n   438→\n   439→    // Should show error message for accept terms\n   440→    await expect(page.locator(\"[data-pw-accept-terms-error]\")).toBeVisible()\n   441→  })\n   442→\n   443→  test(\"multi-checkbox array functionality\", async ({ page }) => {\n   444→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   445→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   446→    const acceptTermsCheckbox = page.locator(\"[data-pw-accept-terms]\")\n   447→    const emailPrefCheckbox = page.locator(\"[data-pw-preferences-email]\")\n   448→    const smsPrefCheckbox = page.locator(\"[data-pw-preferences-sms]\")\n   449→    const pushPrefCheckbox = page.locator(\"[data-pw-preferences-push]\")\n   450→\n   451→    // Fill required fields\n   452→    await nameInput.fill(\"John Doe\")\n   453→    await emailInput.fill(\"john@example.com\")\n   454→    await acceptTermsCheckbox.check()\n   455→    await syncLV(page)\n   456→\n   457→    // Initially all preference checkboxes should be unchecked\n   458→    await expect(emailPrefCheckbox).not.toBeChecked()\n   459→    await expect(smsPrefCheckbox).not.toBeChecked()\n   460→    await expect(pushPrefCheckbox).not.toBeChecked()\n   461→\n   462→    // Check email preference\n   463→    await emailPrefCheckbox.check()\n   464→    await syncLV(page)\n   465→\n   466→    await expect(emailPrefCheckbox).toBeChecked()\n   467→    await expect(smsPrefCheckbox).not.toBeChecked()\n   468→    await expect(pushPrefCheckbox).not.toBeChecked()\n   469→\n   470→    // Check SMS preference as well\n   471→    await smsPrefCheckbox.check()\n   472→    await syncLV(page)\n   473→\n   474→    await expect(emailPrefCheckbox).toBeChecked()\n   475→    await expect(smsPrefCheckbox).toBeChecked()\n   476→    await expect(pushPrefCheckbox).not.toBeChecked()\n   477→\n   478→    // Check all preferences\n   479→    await pushPrefCheckbox.check()\n   480→    await syncLV(page)\n   481→\n   482→    await expect(emailPrefCheckbox).toBeChecked()\n   483→    await expect(smsPrefCheckbox).toBeChecked()\n   484→    await expect(pushPrefCheckbox).toBeChecked()\n   485→\n   486→    // Uncheck middle one (SMS)\n   487→    await smsPrefCheckbox.uncheck()\n   488→    await syncLV(page)\n   489→\n   490→    await expect(emailPrefCheckbox).toBeChecked()\n   491→    await expect(smsPrefCheckbox).not.toBeChecked()\n   492→    await expect(pushPrefCheckbox).toBeChecked()\n   493→\n   494→    // Uncheck all\n   495→    await emailPrefCheckbox.uncheck()\n   496→    await pushPrefCheckbox.uncheck()\n   497→    await syncLV(page)\n   498→\n   499→    await expect(emailPrefCheckbox).not.toBeChecked()\n   500→    await expect(smsPrefCheckbox).not.toBeChecked()\n   501→    await expect(pushPrefCheckbox).not.toBeChecked()\n   502→  })\n   503→\n   504→  test(\"checkbox state persistence during form operations\", async ({ page }) => {\n   505→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   506→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   507→    const acceptTermsChec