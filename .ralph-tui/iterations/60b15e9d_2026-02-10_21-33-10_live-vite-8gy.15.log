{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012K6zyoVPLkjikdXJ2prDGF","type":"tool_result","content":"     1→import { isProxy, isReactive, isRef, toRaw } from \"vue\"\n     2→import type { ComponentMap, ComponentOrComponentPromise } from \"./types.js\"\n     3→\n     4→/**\n     5→ * Maps the values of an object using a callback function and returns a new object with the mapped values.\n     6→ * @returns A new object with the mapped values.\n     7→ */\n     8→export const mapValues = <T, U>(\n     9→  object: Record<string, T>,\n    10→  cb: (value: T, key: string, object: Record<string, T>) => U\n    11→): Record<string, U> =>\n    12→  Object.entries(object).reduce((acc, [key, value]) => {\n    13→    acc[key] = cb(value, key, object)\n    14→    return acc\n    15→  }, {} as Record<string, U>)\n    16→\n    17→/**\n    18→ * Flattens the keys of an object using a callback function and returns a new object with the flattened keys.\n    19→ * @returns A new object with the flattened keys.\n    20→ */\n    21→export const flatMapKeys = <T>(\n    22→  object: Record<string, T>,\n    23→  cb: (key: string, value: any, object: Record<string, T>) => string[]\n    24→): Record<string, T> =>\n    25→  Object.entries(object).reduce((acc, [key, value]) => {\n    26→    const newKeys = cb(key, value, object)\n    27→    for (const newKey of newKeys) acc[newKey] = value\n    28→    return acc\n    29→  }, {} as Record<string, T>)\n    30→\n    31→/**\n    32→ * Finds a component by name or path suffix.\n    33→ * @returns The component if found, otherwise throws an error with a list of available components.\n    34→ */\n    35→export const findComponent = (components: ComponentMap, name: string): ComponentOrComponentPromise => {\n    36→  const nameParts = name.replace(/\\.vue$/, '').split('/').filter(part => part !== 'index')\n    37→  const matches: [string, ComponentOrComponentPromise][] = []\n    38→\n    39→  for (const [key, value] of Object.entries(components)) {\n    40→    let keyParts = key.split('/')\n    41→    \n    42→    if (keyParts[keyParts.length - 1] === 'index.vue') {\n    43→      keyParts = keyParts.slice(0, -1)\n    44→    } else {\n    45→      keyParts[keyParts.length - 1] = keyParts[keyParts.length - 1].replace(/\\.vue$/, '')\n    46→    }\n    47→    \n    48→    if (nameParts.length <= keyParts.length) {\n    49→      let isMatch = true\n    50→      for (let i = 0; i < nameParts.length; i++) {\n    51→        const keyPart = keyParts[keyParts.length - nameParts.length + i]\n    52→        if (nameParts[i] !== keyPart) {\n    53→          isMatch = false\n    54→          break\n    55→        }\n    56→      }\n    57→      \n    58→      if (isMatch) {\n    59→        matches.push([key, value])\n    60→      }\n    61→    }\n    62→  }\n    63→\n    64→  if (matches.length === 1) return matches[0][1]\n    65→\n    66→  if (matches.length > 1) {\n    67→    const matchList = matches.map(([key]) => key).join('\\n')\n    68→    throw new Error(`Component '${name}' is ambiguous. Found multiple matches:\\n\\n${matchList}\\n\\n`)\n    69→  }\n    70→\n    71→  // a helpful message for the user\n    72→\n    73→  const availableComponents = Object.keys(components)\n    74→    .map(key => key.replace(\"../../lib/\", \"\").replace(\"/index.vue\", \"\").replace(\".vue\", \"\").replace(\"./\", \"\"))\n    75→    .filter(key => !key.startsWith(\"_build\"))\n    76→    .join(\"\\n\")\n    77→\n    78→  throw new Error(`Component '${name}' not found! Available components:\\n\\n${availableComponents}\\n\\n`)\n    79→}\n    80→\n    81→export function deepToRaw<T>(sourceObj: T): T {\n    82→  const objectIterator = (input: any): any => {\n    83→    if (Array.isArray(input)) {\n    84→      return input.map(item => objectIterator(item))\n    85→    }\n    86→    if (isRef(input) || isReactive(input) || isProxy(input)) {\n    87→      return objectIterator(toRaw(input))\n    88→    }\n    89→ 