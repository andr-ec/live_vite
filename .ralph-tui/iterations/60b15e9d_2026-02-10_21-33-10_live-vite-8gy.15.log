t(\"Valid: true\")\n   205→  })\n   206→\n   207→  test(\"form submission with valid data\", async ({ page }) => {\n   208→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   209→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   210→    const ageInput = page.locator(\"[data-pw-age-input]\")\n   211→    const bioInput = page.locator(\"[data-pw-bio-input]\")\n   212→    const acceptTermsCheckbox = page.locator(\"[data-pw-accept-terms]\")\n   213→\n   214→    // Fill valid form data\n   215→    await nameInput.fill(\"John Doe\")\n   216→    await emailInput.fill(\"john@example.com\")\n   217→    await ageInput.fill(\"30\")\n   218→    await bioInput.fill(\"This is a comprehensive bio with sufficient content for validation\")\n   219→    await acceptTermsCheckbox.check()\n   220→    // let's wait for the debounce to finish\n   221→    await page.waitForTimeout(150)\n   222→    await syncLV(page)\n   223→\n   224→    // Add some skills\n   225→    await page.locator(\"[data-pw-add-skill]\").click()\n   226→    await page.locator('[data-pw-skill-input=\"0\"]').fill(\"JavaScript\")\n   227→    await page.locator(\"[data-pw-add-skill]\").click()\n   228→    await page.locator('[data-pw-skill-input=\"1\"]').fill(\"Vue.js\")\n   229→\n   230→    // Add an item with tags\n   231→    await page.locator(\"[data-pw-add-item]\").click()\n   232→    await page.locator('[data-pw-item-title=\"0\"]').fill(\"Build awesome apps\")\n   233→    await page.locator('[data-pw-add-tag=\"0\"]').click()\n   234→    await page.locator('[data-pw-tag-input=\"0-0\"]').fill(\"development\")\n   235→\n   236→    await syncLV(page)\n   237→\n   238→    // Form should be valid\n   239→    await expect(page.locator(\"[data-pw-is-valid]\")).toHaveText(\"Valid: true\")\n   240→    await expect(page.locator(\"[data-pw-submit]\")).toBeEnabled()\n   241→\n   242→    // Submit the form\n   243→    await page.locator(\"[data-pw-submit]\").click()\n   244→    await syncLV(page)\n   245→\n   246→    // Form should be reset after successful submission\n   247→    await expect(page.locator(\"[data-pw-name-input]\")).toHaveValue(\"\")\n   248→    await expect(page.locator(\"[data-pw-email-input]\")).toHaveValue(\"\")\n   249→    await expect(page.locator(\"[data-pw-is-dirty]\")).toHaveText(\"Dirty: false\")\n   250→    await expect(page.locator(\"[data-pw-is-touched]\")).toHaveText(\"Touched: false\")\n   251→  })\n   252→\n   253→  test(\"form reset functionality\", async ({ page }) => {\n   254→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   255→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   256→\n   257→    // Fill some data\n   258→    await nameInput.fill(\"John Doe\")\n   259→    await emailInput.fill(\"john@example.com\")\n   260→    await page.locator(\"[data-pw-add-skill]\").click()\n   261→    await page.locator('[data-pw-skill-input=\"0\"]').fill(\"JavaScript\")\n   262→\n   263→    await syncLV(page)\n   264→\n   265→    // Form should be dirty\n   266→    await expect(page.locator(\"[data-pw-is-dirty]\")).toHaveText(\"Dirty: true\")\n   267→\n   268→    // Reset the form\n   269→    await page.locator(\"[data-pw-reset]\").click()\n   270→\n   271→    // Form should be clean\n   272→    await expect(page.locator(\"[data-pw-name-input]\")).toHaveValue(\"\")\n   273→    await expect(page.locator(\"[data-pw-email-input]\")).toHaveValue(\"\")\n   274→    await expect(page.locator(\"[data-pw-skill-item]\")).toHaveCount(0)\n   275→    await expect(page.locator(\"[data-pw-is-dirty]\")).toHaveText(\"Dirty: false\")\n   276→    await expect(page.locator(\"[data-pw-is-touched]\")).toHaveText(\"Touched: false\")\n   277→  })\n   278→\n   279→  test(\"debounced validation events\", async ({ page }) => {\n   280→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   281→\n   282→    // Type rapidly to test debouncing\n   283→    await nameInput.focus()\n   284→    await nameInput.pressSequentially(\"John\", { delay: 50 })\n   285→\n   286→    // Should not trigger validation immediately\n   287→    await page.waitForTimeout(100)\n   288→\n   289→    // Continue typing\n   290→    await nameInput.pressSequentially(\" Doe\", { delay: 50 })\n   291→\n   292→    // Wait for debounce period (300ms) plus some buffer\n   293→    await page.waitForTimeout(400)\n   294→    await syncLV(page)\n   295→\n   296→    // Should have final value and validation should have occurred\n   297→    await expect(nameInput).toHaveValue(\"John Doe\")\n   298→    await expect(page.locator(\"[data-pw-is-dirty]\")).toHaveText(\"Dirty: true\")\n   299→  })\n   300→\n   301→  test(\"accessibility attributes are properly set\", async ({ page }) => {\n   302→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   303→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   304→\n   305→    // Fill invalid data to trigger errors\n   306→    await nameInput.fill(\"A\")\n   307→    await emailInput.fill(\"invalid\")\n   308→    await nameInput.blur()\n   309→    await emailInput.blur()\n   310→    await syncLV(page)\n   311→\n   312→    // Check aria-invalid attributes\n   313→    await expect(nameInput).toHaveAttribute(\"aria-invalid\", \"true\")\n   314→    await expect(emailInput).toHaveAttribute(\"aria-invalid\", \"true\")\n   315→\n   316→    // Check aria-describedby attributes\n   317→    await expect(nameInput).toHaveAttribute(\"aria-describedby\")\n   318→    await expect(emailInput).toHaveAttribute(\"aria-describedby\")\n   319→\n   320→    // Fix the errors\n   321→    await nameInput.fill(\"John Doe\")\n   322→    await emailInput.fill(\"john@example.com\")\n   323→    await nameInput.blur()\n   324→    await emailInput.blur()\n   325→    await syncLV(page)\n   326→\n   327→    // Aria-invalid should be false\n   328→    await expect(nameInput).toHaveAttribute(\"aria-invalid\", \"false\")\n   329→    await expect(emailInput).toHaveAttribute(\"aria-invalid\", \"false