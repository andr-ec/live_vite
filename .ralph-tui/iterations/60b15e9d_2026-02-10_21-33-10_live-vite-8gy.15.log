fToken = document.querySelector(\"meta[name='csrf-token']\")?.getAttribute(\"content\")\nlet liveSocket = new LiveSocket(\"/live\", Socket, {\n  params: { _csrf_token: csrfToken },\n  hooks: { VueHook },\n})\n\n// connect if there are any LiveViews on the page\nliveSocket.connect()\nwindow.liveSocket = liveSocket\n","structuredPatch":[{"oldStart":34,"oldLines":7,"newStart":34,"newLines":10,"lines":["   },","   react: {","     renderer: reactRenderer,","-    resolve: name => findComponent(reactComponents, name),","+    resolve: name => {","+      const mod = findComponent(reactComponents, name)","+      return mod && mod.default ? mod.default : mod","+    },","   },"," })"," "]}],"userModified":false,"replaceAll":false}}
