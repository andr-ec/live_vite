{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AoWufzmk93JjakiDn4eKib","type":"tool_result","content":"     1→import { migrateToLiveViteApp } from \"./app.js\"\n     2→import type { ComponentMap, LiveViteApp, LiveViteOptions, Hook } from \"./types.js\"\n     3→import { mapValues, fromUtf8Base64 } from \"./utils.js\"\n     4→import type { Operation } from \"./jsonPatch.js\"\n     5→import type { FrameworkRenderer } from \"./renderer.js\"\n     6→import { createVueRenderer, type VueSetupFn } from \"./renderers/vue.js\"\n     7→\n     8→/**\n     9→ * Parses the JSON object from the element's attribute and returns them as an object.\n    10→ */\n    11→const getAttributeJson = (el: HTMLElement, attributeName: string): Record<string, any> | null => {\n    12→  const data = el.getAttribute(attributeName)\n    13→  return data ? JSON.parse(data) : null\n    14→}\n    15→\n    16→/**\n    17→ * Parses raw slot data from the element's attributes.\n    18→ * Returns slot name -> decoded HTML string pairs (framework-agnostic).\n    19→ */\n    20→const getRawSlots = (el: HTMLElement): Record<string, string> => {\n    21→  const dataSlots = getAttributeJson(el, \"data-slots\") || {}\n    22→  return mapValues(dataSlots, base64 => fromUtf8Base64(base64))\n    23→}\n    24→\n    25→const getDiff = (el: HTMLElement, attributeName: string): Operation[] => {\n    26→  const dataPropsDiff = getAttributeJson(el, attributeName) || []\n    27→  return dataPropsDiff.map(([op, path, value]: [string, string, any]) => ({\n    28→    op,\n    29→    path,\n    30→    value,\n    31→  }))\n    32→}\n    33→\n    34→/**\n    35→ * Parses the event handlers from the element's attributes and returns them as a record.\n    36→ * The handlers are parsed from the \"data-handlers\" attribute.\n    37→ * The handlers are converted to snake case and returned as a record.\n    38→ * A special case is made for the \"JS.push\" event, where the event is replaced with $event.\n    39→ * @param el - The element to parse the handlers from.\n    40→ * @param liveSocket - The LiveSocket instance.\n    41→ * @returns The handlers as an object.\n    42→ */\n    43→const getHandlers = (el: HTMLElement, liveSocket: any): Record<string, (event: any) => void> => {\n    44→  const handlers = getAttributeJson(el, \"data-handlers\") || {}\n    45→  const result: Record<string, (event: any) => void> = {}\n    46→  for (const handlerName in handlers) {\n    47→    const ops = handlers[handlerName]\n    48→    const snakeCaseName = `on${handlerName.charAt(0).toUpperCase() + handlerName.slice(1)}`\n    49→    result[snakeCaseName] = event => {\n    50→      // a little bit of magic to replace the event with the value of the input\n    51→      const parsedOps = JSON.parse(ops)\n    52→      const replacedOps = parsedOps.map(([op, args, ...other]: [string, any, ...any[]]) => {\n    53→        if (op === \"push\" && !args.value) args.value = event\n    54→        return [op, args, ...other]\n    55→      })\n    56→      liveSocket.execJS(el, JSON.stringify(replacedOps))\n    57→    }\n    58→  }\n    59→  return result\n    60→}\n    61→\n    62→/**\n    63→ * Parses the props from the element's attributes and returns them as an object.\n    64→ * The props are parsed from the \"data-props\" attribute.\n    65→ * The props are merged with the event handlers from the \"data-handlers\" attribute.\n    66→ * @param el - The element to parse the props from.\n    67→ * @param liveSocket - The LiveSocket instance.\n    68→ * @returns The props as an object.\n    69→ */\n    70→const getProps = (el: HTMLElement, liveSocket: any): Record<string, any> => ({\n    71→  ...(getAttributeJson(el, \"data-props\") || {}),\n    72→  ...getHandlers(el, liveSocket),\n    73→})\n    74→\n    75→/**\n    76→ * A registered renderer entry: a framework renderer paired with its component resolver.\n    77→ */\n    78→export interface RendererEntry {\n    79→  renderer: FrameworkRenderer\n    80→  resolve: (name: string) => Promise<unknown> | unknown\n    81→}\n    82→\n    83→/**\n    84→ * Creates a framework-agnostic LiveView hook using the given renderer.\n    85→ *\n    86→ * This is a convenience for single-renderer setups. For multi-framework support,\n    87→ * use `getMultiRendererHook` instead.\n    88→ */\n    89→export const getRendererHook = (\n    90→  renderer: FrameworkRenderer,\n    91→  resolve: (name: string) => Promise<unknown> | unknown,\n    92→): Hook => getMultiRendererHook({ [renderer.name]: { renderer, resolve } })\n    93→\n    94→/**\n    95→ * Creates a LiveView hook that dispatches to the correct renderer\n    96→ * based on the `data-framework` attribute on the component element.\n    97→ *\n    98→ * This is the primary way to support multiple frameworks in the same project.\n    99→ * The hook handles DOM attribute parsing, prop diffing, and stream patches\n   100→ * (all framework-agnostic), while delegating framework-specific operations\n   101→ * to the resolved renderer.\n   102→ *\n   103→ * If only one renderer is registered, the `data-framework` attribute is optional\n   104→ * and the single renderer is used as a fallback.\n   105→ */\n   106→export const getMultiRendererHook = (\n   107→  renderers: Record<string, RendererEntry>,\n   108→): Hook => {\n   109→  const rendererNames = Object.keys(renderers)\n   110→\n   111→  const resolveRenderer = (el: HTMLElement): RendererEntry => {\n   112→    const framework = el.getAttribute(\"data-framework\")\n   113→\n   114→    if (framework && renderers[framework]) {\n   115→      return renderers[framework]\n   116→    }\n   117→\n   118→    // Fallback: if only one renderer is registered, use it regardless of attribute\n   119→    if (!framework && rendererNames.length === 1) {\n   120→      return renderers[rendererNames[0]]\n   121→    }\n   122→\n   123→    const available = rendererNames.join(\", \")\n   124→    throw new Error(\n   125→      framework\n   126→        ? `Unknown framework \"${framework}\". Registered renderers: ${available}`\n   127→        : `Missing data-framework attribute. Registered renderers: ${available}`\n   128→    )\n   129→  }\n   130→\n   131→  return {\n   132→    async mounted() {\n   133→      const { renderer, resolve } = resolveRenderer(this.el)\n   134→      const componentName = this.el.getAttribute(\"data-name\") as string\n   135→      const component = await resolve(componentName)\n   136→      const ssr = this.el.getAttribute(\"data-ssr\") === \"true\"\n   137→\n   138→      const props = getProps(this.el, this.liveSocket)\n   139→      const slots = getRawSlots(this.el)\n   140→\n   141→      const state = await renderer.mount({\n   142→        component,\n   143→        props,\n   144→        slots,\n   145→        el: this.el,\n   146→        ssr,\n   147→        hook: this,\n   148→      })\n   149→\n   150→      // apply initial stream diff after mount, since all stream changes are sent in that attribute\n   151→      renderer.patchProps(state, getDiff(this.el, \"data-streams-diff\"))\n   152→\n   153→      this.vue = state\n   154→      // Store the renderer name for use in updated/destroyed\n   155→      this.__renderer = renderer\n   156→    },\n   157→    updated() {\n   158→      const renderer = this.__renderer as FrameworkRenderer\n   159→      if (this.el.getAttribute(\"data-use-diff\") === \"true\") {\n   160→        renderer.patchProps(this.vue, getDiff(this.el, \"data-props-diff\"))\n   161→      } else {\n   162→        renderer.updateProps(this.vue, getProps(this.el, this.liveSocket))\n   163→      }\n   164→      // we're always applying streams diff, since all stream changes are sent in that attribute\n   165→      renderer.patchProps(this.vue, getDiff(this.el, \"data-streams-diff\"))\n   166→      renderer.updateSlots(this.vue, getRawSlots(this.el))\n   167→    },\n   168→    destroyed() {\n   169→      const renderer = this.__renderer as FrameworkRenderer\n   170→      renderer.unmount(this.vue)\n   171→    },\n   172→  }\n   173→}\n   174→\n   175→export const getVueHook = ({ resolve, setup }: LiveViteApp): Hook => {\n   176→  // Adapt the LiveViteApp setup (object arg) to the VueSetupFn (positional args)\n   177→  const vueSetup: VueSetupFn = (makeApp, component, props, slots, plugin, el, ssr) =>\n   178→    setup({ createApp: makeApp, component, props, slots, plugin, el, ssr })\n   179→\n   180→  const renderer = createVueRenderer({ setup: vueSetup })\n   181→  return getRendererHook(renderer, resolve)\n   182→}\n   183→\n   184→/**\n   185→ * Returns the hooks for the LiveVite app.\n   186→ * @param components - The components to use in the app.\n   187→ * @param options - The options for the LiveVite app.\n   188→ * @returns The hooks for the LiveVite app.\n   189→ */\n   190→type VueHooks = { VueHook: Hook }\n   191→type getHooksAppFn = (app: LiveViteApp) => VueHooks\n   192→type getHooksComponentsOptions = { initializeApp?: LiveViteOptions[\"setup\"] }\n   193→type getHooksComponentsFn = (components: ComponentMap, options?: getHooksComponentsOptions) => VueHooks\n   194→\n   195→export const getHooks: getHooksComponentsFn | getHooksAppFn = (\n   196→  componentsOrApp: ComponentMap | LiveViteApp,\n   197→  options?: getHooksComponentsOptions\n   198→) => {\n   199→  const app = migrateToLiveViteApp(componentsOrApp, options ?? {})\n   200→  return { VueHook: getVueHook(app) }\n   201→}\n   202→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01SRAYcugjF8V87a6iUDUTu3","session_id":"d5cbf92b-6106-41f2-ab9b-5f76d18aa231","uuid":"6fd1374b-caa3-447d-aa60-9c82cbf66734"}
