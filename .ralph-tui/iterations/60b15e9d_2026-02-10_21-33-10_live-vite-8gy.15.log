{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012v5tdW8Ta285j6icjhufpt","type":"tool_result","content":"     1→import { describe, it, expect, vi, beforeEach, afterEach } from \"vitest\"\n     2→import { createElement, act } from \"react\"\n     3→import { createRoot, type Root } from \"react-dom/client\"\n     4→import { LiveContext } from \"./useReact\"\n     5→import { useLiveUpload, type UseLiveUploadReactReturn } from \"./useLiveUploadReact\"\n     6→import type { UploadConfig, UploadOptions } from \"./types\"\n     7→\n     8→// Enable React act() environment for jsdom\n     9→globalThis.IS_REACT_ACT_ENVIRONMENT = true\n    10→\n    11→function createMockHook(overrides: Record<string, any> = {}) {\n    12→  const el = document.createElement(\"div\")\n    13→  document.body.appendChild(el)\n    14→  return {\n    15→    el,\n    16→    liveSocket: {\n    17→      socket: { connectionState: () => \"open\" },\n    18→      pushHistoryPatch: vi.fn(),\n    19→      historyRedirect: vi.fn(),\n    20→    },\n    21→    pushEvent: vi.fn(() => Promise.resolve(0)),\n    22→    pushEventTo: vi.fn(() => Promise.resolve([])),\n    23→    handleEvent: vi.fn((_event: string, callback: (payload: any) => void) => ({\n    24→      event: _event,\n    25→      callback,\n    26→    })),\n    27→    removeHandleEvent: vi.fn(),\n    28→    upload: vi.fn(),\n    29→    uploadTo: vi.fn(),\n    30→    js: vi.fn(),\n    31→    ...overrides,\n    32→  }\n    33→}\n    34→\n    35→function createUploadConfig(overrides: Partial<UploadConfig> = {}): UploadConfig {\n    36→  return {\n    37→    ref: \"phx-upload-ref-1\",\n    38→    name: \"avatar\",\n    39→    accept: \".jpg,.png\",\n    40→    max_entries: 1,\n    41→    auto_upload: false,\n    42→    entries: [],\n    43→    errors: [],\n    44→    ...overrides,\n    45→  }\n    46→}\n    47→\n    48→const defaultOptions: UploadOptions = {\n    49→  changeEvent: \"validate\",\n    50→  submitEvent: \"save\",\n    51→}\n    52→\n    53→describe(\"useLiveUpload (React)\", () => {\n    54→  let container: HTMLDivElement\n    55→  let root: Root\n    56→  let mockHook: ReturnType<typeof createMockHook>\n    57→\n    58→  beforeEach(() => {\n    59→    container = document.createElement(\"div\")\n    60→    document.body.appendChild(container)\n    61→    mockHook = createMockHook()\n    62→  })\n    63→\n    64→  afterEach(() => {\n    65→    act(() => {\n    66→      root?.unmount()\n    67→    })\n    68→    if (container.parentNode) {\n    69→      document.body.removeChild(container)\n    70→    }\n    71→    if (mockHook.el.parentNode) {\n    72→      document.body.removeChild(mockHook.el)\n    73→    }\n    74→  })\n    75→\n    76→  // The mount helper returns an object whose `result` property is a getter\n    77→  // that always returns the latest captured hook result. Do NOT destructure\n    78→  // `result` if you need to read updated values after a rerender.\n    79→  function mountUpload(\n    80→    config: UploadConfig,\n    81→    options: UploadOptions = defaultOptions\n    82→  ): {\n    83→    readonly result: UseLiveUploadReactReturn\n    84→    rerender: (newConfig: UploadConfig) => void\n    85→  } {\n    86→    let capturedResult: UseLiveUploadReactReturn\n    87→\n    88→    function TestComponent({ config: cfg }: { config: UploadConfig }) {\n    89→      capturedResult = useLiveUpload(cfg, options)\n    90→      return createElement(\"div\", null, \"test\")\n    91→    }\n    92→\n    93→    act(() => {\n    94→      root = createRoot(container)\n    95→      root.render(\n    96→        createElement(\n    97→          LiveContext.Provider,\n    98→          { value: mockHook as any },\n    99→          createElement(TestComponent, { config })\n   100→        )\n   101→      )\n   102→    })\n   103→\n   104→    return {\n   105→      get result() {\n   106→        return capturedResult!\n   107→      },\n   108→      rerender: (newConfig: UploadConfig) => {\n   109→        act(() => {\n   110→          root.render(\n   111→            createElement(\n   112→              LiveContext.Provider,\n   113→              { value: mockHook as any },\n   114→              createElement(TestComponent, { config: newConfig })\n   115→            )\n   116→          )\n   117→        })\n   118→      },\n   119→    }\n   120→  }\n   121→\n   122→  describe(\"initialization\", () => {\n   123→    it(\"should create a hidden file input in the LiveView element\", () => {\n   124→      mountUpload(createUploadConfig())\n   125→\n   126→      const form = mockHook.el.querySelector(\"form\")\n   127→      expect(form).not.toBeNull()\n   128→      expect(form!.style.display).toBe(\"none\")\n   129→      expect(form!.getAttribute(\"phx-change\")).toBe(\"validate\")\n   130→      expect(form!.getAttribute(\"phx-submit\")).toBe(\"save\")\n   131→\n   132→      const input = form!.querySelector(\"input[type='file']\")\n   133→      expect(input).not.toBeNull()\n   134→      expect(input!.getAttribute(\"data-phx-hook\")).toBe(\"Phoenix.LiveFileUpload\")\n   135→      expect(input!.getAttribute(\"data-phx-update\")).toBe(\"ignore\")\n   136→      expect(input!.getAttribute(\"data-phx-upload-ref\")).toBe(\"phx-upload-ref-1\")\n   137→    })\n   138→\n   139→    it(\"should set accept attribute from config\", () => {\n   140→      mountUpload(createUploadConfig({ accept: \".jpg,.png,.gif\" }))\n   141→\n   142→      const input = mockHook.el.querySelector(\"input[type='file']\") as HTMLInputElement\n   143→      expect(input.accept).toBe(\".jpg,.png,.gif\")\n   144→    })\n   145→\n   146→    it(\"should set multiple attribute when max_entries > 1\", () => {\n   147→      mountUpload(createUploadConfig({ max_entries: 5 }))\n   148→\n   149→      const input = mockHook.el.querySelector(\"input[type='file']\") as HTMLInputElement\n   150→      expect(input.multiple).toBe(true)\n   151→    })\n   152→\n   153→    it(\"should not set multiple attribute when max_entries is 1\", () => {\n   154→      mountUpload(createUploadConfig({ max_entries: 1 }))\n   155→\n   156→      const input = mockHook.el.querySelector(\"input[type='file']\") as HTMLInputElement\n   157→      expect(input.multiple).toBe(false)\n   158→    })\n   159→\n   160→    it(\"should set auto_upload attribute when enabled\", () => {\n   161→      mountUpload(createUploadConfig({ auto_upload: true }))\n   162→\n   163→      const input = mockHook.el.querySelector(\"input[type='file']\") as HTMLInputElement\n   164→      expect(input.getAttribute(\"data-phx-auto-upload\")).toBe(\"true\")\n   165→    })\n   166→\n   167→    it(\"should not set auto_upload attribute when disabled\", () => {\n   168→      mountUpload(createUploadConfig({ auto_upload: false }))\n   169→\n   170→      const input = mockHook.el.querySelector(\"input[type='file']\") as HTMLInputElement\n   171→      expect(input.getAttribute(\"data-phx-auto-upload\")).toBeNull()\n   172→    })\n   173→\n   174→    it(\"should omit phx-change when changeEvent is not provided\", () => {\n   175→      mountUpload(createUploadConfig(), { submitEvent: \"save\" })\n   176→\n   177→      const form = mockHook.el.querySelector(\"form\")\n   178→      expect(form!.getAttribute(\"phx-change\")).toBeNull()\n   179→      expect(form!.getAttribute(\"phx-submit\")).toBe(\"save\")\n   180→    })\n   181→\n   182→    it(\"should set input name and id from config\", () => {\n   183→      mountUpload(createUploadConfig({ ref: \"my-ref\", name: \"avatar\" }))\n   184→\n   185→      const input = mockHook.el.querySelector(\"input[type='file']\") as HTMLInputElement\n   186→      expect(input.id).toBe(\"my-ref\")\n   187→      expect(input.name).toBe(\"avatar\")\n   188→    })\n   189→  })\n   190→\n   191→  describe(\"entries and derived state\", () => {\n   192→    it(\"should return empty entries when config has no entries\", () => {\n   193→      const handle = mountUpload(createUploadConfig())\n   194→      expect(handle.result.entries).toEqual([])\n   195→    })\n   196→\n   197→    it(\"should reflect entries from the upload config\", () => {\n   198→      const entries = [\n   199→        {\n   200→          ref: \"0\",\n   201→          client_name: \"photo.jpg\",\n   202→          client_size: 1024,\n   203→          client_type: \"image/jpeg\",\n   204→          progress: 50,\n   205→          done: false,\n   206→          valid: true,\n   207→          preflighted: true,\n   208→          errors: [],\n   209→        },\n   210→      ]\n   211→\n   212→      const handle = mountUpload(createUploadConfig({ entries }))\n   213→      expect(handle.result.entries).toEqual(entries)\n   214→    })\n   215→\n   216→    it(\"should calculate progress from entries\", () => {\n   217→      const entries = [\n   218→        { ref: \"0\", client_name: \"a.jpg\", client_size: 100, client_type: \"image/jpeg\", progress: 50, done: false, valid: true, preflighted: true, errors: [] },\n   219→        { ref: \"1\", client_name: \"b.jpg\", client_size: 200, client_type: \"image/jpeg\", progress: 100, done: true, valid: true, preflighted: true, errors: [] },\n   220→      ]\n   221→\n   222→      const handle = mountUpload(createUploadConfig({ entries }))\n   223→      expect(handle.result.progress).toBe(75) // (50 + 100) / 2\n   224→    })\n   225→\n   226→    it(\"should return 0 progress when there are no entries\", () => {\n   227→      const handle = mountUpload(createUploadConfig())\n   228→      expect(handle.result.progress).toBe(0)\n   229→    })\n   230→\n   231→    it(\"should report valid when there are no errors\", () => {\n   232→      const handle = mountUpload(createUploadConfig({ errors: [] }))\n   233→      expect(handle.result.valid).toBe(true)\n   234→    })\n   235→\n   236→    it(\"should report invalid when there are errors\", () => {\n   237→      const handle = mountUpload(\n   238→        createUploadConfig({ errors: [{ ref: \"0\", error: \"too large\" }] })\n   239→      )\n   240→      expect(handle.result.valid).toBe(false)\n   241→    })\n   242→\n   243→    it(\"should update entries when config changes\", () => {\n   244→      const initialConfig = createUploadConfig()\n   245→      const handle = mountUpload(initialConfig)\n   246→\n   247→      expect(handle.result.entries).toEqual([])\n   248→\n   249→      const newEntries = [\n   250→        { ref: \"0\", client_name: \"file.jpg\", client_size: 512, client_type: \"image/jpeg\", progress: 0, done: false, valid: true, preflighted: false, errors: [] },\n   251→      ]\n   252→      handle.rerender(createUploadConfig({ entries: newEntries }))\n   253→\n   254→      expect(handle.result.entries).toEqual(newEntries)\n   255→    })\n   256→\n   257→    it(\"should update progress when entries change\", () => {\n   258→      const entries = [\n   259→        { ref: \"0\", client_name: \"a.jpg\", client_size: 100, client_type: \"image/jpeg\", progress: 0, done: false, valid: true, preflighted: false, errors: [] },\n   260→      ]\n   261→      const handle = mountUpload(createUploadConfig({ entries }))\n   262→      expect(handle.result.progress).toBe(0)\n   263→\n   264→      handle.rerender(\n   265→        createUploadConfig({\n   266→          entries: [{ ...entries[0], progress: 80 }],\n   267→        })\n   268→      )\n   269→      expect(handle.result.progress).toBe(80)\n   270→    })\n   271→  })\n   272→\n   273→  describe(\"entry ref attributes\", () => {\n   274→    it(\"should update data-phx-active-refs when entries change\", () => {\n   275→      const entries = [\n   276→        { ref: \"0\", client_name: \"a.jpg\", client_size: 100, client_type: \"image/jpeg\", progress: 0, done: false, valid: true, preflighted: false, errors: [] },\n   277→        { ref: \"1\", client_name: \"b.jpg\", client_size: 200, client_type: \"image/jpeg\", progress: 0, done: false, valid: true, preflighted: false, errors: [] },\n   278→      ]\n   279→      mountUpload(createUploadConfig({ entries }))\n   280→\n   281→      const input = mockHook.el.querySelector(\"input[type='file']\") as HTMLInputElement\n   282→      expect(input.getAttribute(\"data-phx-active-refs\")).toBe(\"0,1\")\n   283→    })\n   284→\n   285→    it(\"should update data-phx-done-refs for completed entries\", () => {\n   286→      const entries = [\n   287→        { ref: \"0\", client_name: \"a.jpg\", client_size: 100, client_type: \"image/jpeg\", progress: 100, done: true, valid: true, preflighted: true, errors: [] },\n   288→        { ref: \"1\", client_name: \"b.jpg\", client_size: 200, client_type: \"image/jpeg\", progress: 0, done: false, valid: true, preflighted: false, errors: [] },\n   289→      ]\n   290→      mountUpload(createUploadConfig({ entries }))\n   291→\n   292→      const input = mockHook.el.querySelector(\"input[type='file']\") as HTMLInputElement\n   293→      expect(input.getAttribute(\"data-phx-done-refs\")).toBe(\"0\")\n   294→    })\n   295→\n   296→    it(\"should update data-phx-preflighted-refs for preflighted entries\", () => {\n   297→      const entries = [\n   298→        { ref: \"0\", client_name: \"a.jpg\", client_size: 100, client_type: \"image/jpeg\", progress: 50, done: false, valid: true, preflighted: true, errors: [] },\n   299→        { ref: \"1\", client_name: \"b.jpg\", client_size: 200, client_type: \"image/jpeg\", progress: 0, done: false, valid: true, preflighted: false, errors: [] },\n   300→      ]\n   301→      mountUpload(createUploadConfig({ entries }))\n   302→\n   303→      const input = mockHook.el.querySelector(\"input[type='file']\") as HTMLInputElement\n   304→      expect(input.getAttribute(\"data-phx-preflighted-refs\")).toBe(\"0\")\n   305→    })\n   306→  })\n   307→\n   308→  describe(\"showFilePicker\", () => {\n   309→    it(\"should click the hidden input element\", () => {\n   310→      const handle = mountUpload(createUploadConfig())\n   311→\n   312→      const input = mockHook.el.querySelector(\"input[type='file']\") as HTMLInputElement\n   313→      const clickSpy = vi.spyOn(input, \"click\")\n   314→\n   315→      handle.result.showFilePicker()\n   316→      expect(clickSpy).toHaveBeenCalled()\n   317→    })\n   318→  })\n   319→\n   320→  describe(\"addFiles\", () => {\n   321→    it(\"should set files from an array of File objects and dispatch change\", async () => {\n   322→      const handle = mountUpload(createUploadConfig())\n   323→\n   324→      const input = mockHook.el.querySelector(\"input[type='file']\") as HTMLInputElement\n   325→      const dispatchSpy = vi.spyOn(input, \"dispatchEvent\")\n   326→\n   327→      const file = new File([\"content\"], \"test.jpg\", { type: \"image/jpeg\" })\n   328→\n   329→      // addFiles with array creates a DataTransfer internally\n   330→      // jsdom doesn't support DataTransfer, so we test the array branch directly\n   331→      // by calling the function and verifying the change event is dispatched\n   332→      handle.result.addFiles([file])\n   333→\n   334→      // Change event is dispatched asynchronously\n   335→      await act(async () => {\n   336→        await new Promise(resolve => setTimeout(resolve, 10))\n   337→      })\n   338→\n   339→      expect(dispatchSpy).toHaveBeenCalledWith(\n   340→        expect.objectContaining({ type: \"change\", bubbles: true })\n   341→      )\n   342→    })\n   343→  })\n   344→\n   345→  describe(\"submit\", () => {\n   346→    it(\"should dispatch a submit event on the form\", () => {\n   347→      const handle = mountUpload(createUploadConfig())\n   348→\n   349→      const form = mockHook.el.querySelector(\"form\") as HTMLFormElement\n   350→      const dispatchSpy = vi.spyOn(form, \"dispatchEvent\")\n   351→\n   352→      handle.result.submit()\n   353→\n   354→      expect(dispatchSpy).toHaveBeenCalledWith(\n   355→        expect.objectContaining({ type: \"submit\", bubbles: true })\n   356→      )\n   357→    })\n   358→  })\n   359→\n   360→  describe(\"cancel\", () => {\n   361→    it(\"should push cancel-upload event for a specific entry ref\", () => {\n   362→      const handle = mountUpload(createUploadConfig())\n   363→\n   364→      handle.result.cancel(\"entry-ref-0\")\n   365→\n   366→      expect(mockHook.pushEvent).toHaveBeenCalledWith(\"cancel-upload\", { ref: \"entry-ref-0\" })\n   367→    })\n   368→\n   369→    it(\"should push cancel-upload event for all entries when no ref is provided\", () => {\n   370→      const entries = [\n   371→        { ref: \"0\", client_name: \"a.jpg\", client_size: 100, client_type: \"image/jpeg\", progress: 0, done: false, valid: true, preflighted: false, errors: [] },\n   372→        { ref: \"1\", client_name: \"b.jpg\", client_size: 200, client_type: \"image/jpeg\", progress: 0, done: false, valid: true, preflighted: false, errors: [] },\n   373→      ]\n   374→      const handle = mountUpload(createUploadConfig({ entries }))\n   375→\n   376→      handle.result.cancel()\n   377→\n   378→      expect(mockHook.pushEvent).toHaveBeenCalledTimes(2)\n   379→      expect(mockHook.pushEvent).toHaveBeenCalledWith(\"cancel-upload\", { ref: \"0\" })\n   380→      expect(mockHook.pushEvent).toHaveBeenCalledWith(\"cancel-upload\", { ref: \"1\" })\n   381→    })\n   382→  })\n   383→\n   384→  describe(\"clear\", () => {\n   385→    it(\"should clear the file input value\", () => {\n   386→      const handle = mountUpload(createUploadConfig())\n   387→\n   388→      // Just verify clear doesn't throw and works on the input\n   389→      handle.result.clear()\n   390→\n   391→      const input = mockHook.el.querySelector(\"input[type='file']\") as HTMLInputElement\n   392→      expect(input.value).toBe(\"\")\n   393→    })\n   394→  })\n   395→\n   396→  describe(\"cleanup\", () => {\n   397→    it(\"should remove the form element on unmount\", () => {\n   398→      mountUpload(createUploadConfig())\n   399→\n   400→      expect(mockHook.el.querySelector(\"form\")).not.toBeNull()\n   401→\n   402→      act(() => {\n   403→        root.unmount()\n   404→      })\n   405→\n   406→      expect(mockHook.el.querySelector(\"form\")).toBeNull()\n   407→    })\n   408→  })\n   409→\n   410→  describe(\"accept: false\", () => {\n   411→    it(\"should not set accept attribute when accept is false\", () => {\n   412→      mountUpload(createUploadConfig({ accept: false }))\n   413→\n   414→      const input = mockHook.el.querySelector(\"input[type='file']\") as HTMLInputElement\n   415→      expect(input.accept).toBe(\"\")\n   416→    })\n   417→  })\n   418→})\n   419→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01SRAYcugjF8V87a6iUDUTu3","session_id":"d5cbf92b-6106-41f2-ab9b-5f76d18aa231","uuid":"cf9d9be1-e20f-4afb-8ce6-4b92af4c7dfc"}
