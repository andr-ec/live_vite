{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GcFnQgSFECFNNqVMe5FcJL","type":"tool_result","content":"     1→import { inject, onMounted, onUnmounted, ref, computed, watchEffect, toValue, type ComputedRef, type Ref } from \"vue\"\n     2→import type { MaybeRefOrGetter } from \"vue\"\n     3→import type { LiveHook, UploadConfig, UploadEntry, UploadOptions } from \"./types.js\"\n     4→\n     5→export const liveInjectKey = \"_live_vite\"\n     6→\n     7→/**\n     8→ * Returns the LiveVite instance.\n     9→ * Can be used to access the LiveVite instance from within a LiveVite component.\n    10→ * It allows to e.g. push events to the LiveView.\n    11→ */\n    12→export const useLiveVite = (): LiveHook => {\n    13→  const live = inject<LiveHook>(liveInjectKey)\n    14→  if (!live) throw new Error(\"LiveVite not provided. Are you using this inside a LiveVite component?\")\n    15→  return live\n    16→}\n    17→\n    18→/**\n    19→ * Registers a callback to be called when an event is received from the server.\n    20→ * It automatically removes the callback when the component is unmounted.\n    21→ * @param event - The event name.\n    22→ * @param callback - The callback to call when the event is received.\n    23→ */\n    24→export function useLiveEvent<T>(event: string, callback: (data: T) => void) {\n    25→  let callbackRef: ReturnType<LiveHook[\"handleEvent\"]> | null = null\n    26→  onMounted(() => {\n    27→    const live = useLiveVite()\n    28→    callbackRef = live.handleEvent(event, callback)\n    29→  })\n    30→  onUnmounted(() => {\n    31→    const live = useLiveVite()\n    32→    if (callbackRef) live.removeHandleEvent(callbackRef)\n    33→    callbackRef = null\n    34→  })\n    35→}\n    36→\n    37→/**\n    38→ * A composable for navigation.\n    39→ * It uses the LiveSocket instance to navigate to a new location.\n    40→ * Works in the same way as the `live_patch` and `live_redirect` functions in LiveView.\n    41→ * @returns An object with `patch` and `navigate` functions.\n    42→ */\n    43→export const useLiveNavigation = () => {\n    44→  const live = useLiveVite()\n    45→  const liveSocket = live.liveSocket\n    46→  if (!liveSocket) throw new Error(\"LiveSocket not initialized\")\n    47→\n    48→  /**\n    49→   * Patches the current LiveView.\n    50→   * @param hrefOrQueryParams - The URL or query params to navigate to.\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d5cbf92b-6106-41f2-ab9b-5f76d18aa231","uuid":"7d749253-8d81-4e01-ac8f-1c399c744e8e","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/use.ts","content":"import { inject, onMounted, onUnmounted, ref, computed, watchEffect, toValue, type ComputedRef, type Ref } from \"vue\"\nimport type { MaybeRefOrGetter } from \"vue\"\nimport type { LiveHook, UploadConfig, UploadEntry, UploadOptions } from \"./types.js\"\n\nexport const liveInjectKey = \"_live_vite\"\n\n/**\n * Returns the LiveVite instance.\n * Can be used to access the LiveVite instance from within a LiveVite component.\n * It allows to e.g. push events to the LiveView.\n */\nexport const useLiveVite = (): LiveHook => {\n  const live = inject<LiveHook>(liveInjectKey)\n  if (!live) throw new Error(\"LiveVite not provided. Are you using this inside a LiveVite component?\")\n  return live\n}\n\n/**\n * Registers a callback to be called when an event is received from the server.\n * It automatically removes the callback when the component is unmounted.\n * @param event - The event name.\n * @param callback - The callback to call when the event is received.\n */\nexport function useLiveEvent<T>(event: string, callback: (data: T) => void) {\n  let callbackRef: ReturnType<LiveHook[\"handleEvent\"]> | null = null\n  onMounted(() => {\n    const live = useLiveVite()\n    callbackRef = live.handleEvent(event, callback)\n  })\n  onUnmounted(() => {\n    const live = useLiveVite()\n    if (callbackRef) live.removeHandleEvent(callbackRef)\n    callbackRef = null\n  })\n}\n\n/**\n * A composable for navigation.\n * It uses the LiveSocket instance to navigate to a new location.\n * Works in the same way as the `live_patch` and `live_redirect` functions in LiveView.\n * @returns An object with `patch` and `navigate` functions.\n */\nexport const useLiveNavigation = () => {\n  const live = useLiveVite()\n  const liveSocket = live.liveSocket\n  if (!liveSocket) throw new Error(\"LiveSocket not initialized\")\n\n  /**\n   * Patches the current LiveView.\n   * @param hrefOrQueryParams - The URL or query params to navigate to.","numLines":50,"startLine":1,"totalLines":421}}}
