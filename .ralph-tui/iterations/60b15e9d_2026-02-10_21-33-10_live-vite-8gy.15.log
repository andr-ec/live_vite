const specialSlot = page\n      .locator('[data-pw-label]:has-text(\"Special\")')\n      .locator(\"..\")\n      .locator(\"[data-pw-slot]\")\n    await expect(specialSlot).toContainText(\"Ñoño café résumé naïve\")\n  })\n})\n","structuredPatch":[],"originalFile":null}}
