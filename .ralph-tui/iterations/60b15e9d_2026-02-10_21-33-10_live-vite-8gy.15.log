{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GYrU3YZkpkkXy8p9JkXD8d","type":"tool_result","content":"     1→defmodule LiveVite do\n     2→  @moduledoc \"\"\"\n     3→  LiveVite provides seamless integration between Phoenix LiveView and Vue.js components.\n     4→\n     5→  ## Installation and Configuration\n     6→\n     7→  See README.md for installation instructions and usage.\n     8→\n     9→  ## Component Options\n    10→\n    11→  When using the `vue/1`/`react/1` components or `~VUE`/`~REACT` sigils, the following options are supported:\n    12→\n    13→  ### Required Attributes\n    14→    * `v-component` (string) - Name of the Vue component (e.g., \"YourComponent\", \"directory/Example\")\n    15→\n    16→  > #### Tip {: .tip}\n    17→  >\n    18→  > Value of `v-component` will be directly passed to `resolve` function of the `createLiveVite` instance.\n    19→  > It should return Vue component or a promise that resolves to a Vue component.\n    20→  > In a standard setup, you can find it in `assets/vue/index.js`.\n    21→\n    22→  ### Optional Attributes\n    23→    * `id` (string) - Explicit ID of the wrapper component. If not provided, a random one will be\n    24→      generated. Useful to keep ID consistent in development (e.g., \"vue-1\")\n    25→    * `class` (string) - CSS class(es) to apply to the Vue component wrapper\n    26→      (e.g., \"my-class\" or \"my-class another-class\")\n    27→    * `v-ssr` (boolean) - Whether to render the component on the server. Defaults to the value set\n    28→      in config (default: true)\n    29→    * `v-socket` (LiveView.Socket) - LiveView socket, should be provided when rendering inside LiveView\n    30→\n    31→  ### Event Handlers\n    32→    * `v-on:*` - Vue event handlers can be attached using the `v-on:` prefix\n    33→      (e.g., `v-on:click`, `v-on:input`)\n    34→\n    35→  ### Props and Slots\n    36→    * All other attributes are passed as props to the Vue component\n    37→    * Slots can be passed as regular Phoenix slots\n    38→  \"\"\"\n    39→\n    40→  use Phoenix.Component\n    41→\n    42→  import Phoenix.HTML\n    43→\n    44→  alias LiveVite.Encoder\n    45→  alias LiveVite.Slots\n    46→  alias LiveVite.SSR\n    47→  alias Phoenix.LiveView\n    48→  alias Phoenix.LiveView.LiveStream\n    49→\n    50→  require Logger\n    51→\n    52→  @ssr_default Application.compile_env(:live_vite, :ssr, true)\n    53→  @diff_default Application.compile_env(:live_vite, :enable_props_diff, true)\n    54→\n    55→  defmacro __using__(_opts) do\n    56→    quote do\n    57→      import LiveVite\n    58→    end\n    59→  end\n    60→\n    61→  @doc \"\"\"\n    62→  Renders a React component within Phoenix LiveView.\n    63→\n    64→  Sets `v-framework` to `\"react\"` and delegates to the shared rendering pipeline.\n    65→\n    66→  ## Examples\n    67→\n    68→      <.react\n    69→        v-component=\"MyComponent\"\n    70→        message=\"Hello\"\n    71→        v-on:click=\"handleClick\"\n    72→        class=\"my-component\"\n    73→      />\n    74→\n    75→      <.react\n    76→        v-component=\"nested/Component\"\n    77→        v-ssr={false}\n    78→        items={@items}\n    79→      >\n    80→        <:default>Default slot content</:default>\n    81→        <:named>Named slot content</:named>\n    82→      </.react>\n    83→  \"\"\"\n    84→  def react(assigns) do\n    85→    assigns\n    86→    |> Map.put(:\"v-framework\", \"react\")\n    87→    |> vue()\n    88→  end\n    89→\n    90→  @doc \"\"\"\n    91→  Renders a Vue component within Phoenix LiveView.\n    92→\n    93→  ## Examples\n    94→\n    95→      <.vue\n    96→        v-component=\"MyComponent\"\n    97→        message=\"Hello\"\n    98→        v-on:click=\"handleClick\"\n    99→        class=\"my-component\"\n   100→      />\n   101→\n   102→      <.vue\n   103→        v-component=\"nested/Component\"\n   104→        v-ssr={false}\n   105→        items={@items}\n   106→      >\n   107→        <:default>Default slot content</:default>\n   108→        <:named>Named slot content</:named>\n   109→      </.vue>\n   110→  \"\"\"\n   111→  def vue(assigns) do\n   112→    init = assigns.__changed__ == nil\n   113→    dead = assigns[:\"v-socket\"] == nil or not LiveView.connected?(assigns[:\"v-socket\"])\n   114→    use_diff = Map.get(assigns, :\"v-diff\", @diff_default)\n   115→    use_streams_diff = Enum.any?(assigns, fn {_k, v} -> match?(%LiveStream{}, v) end)\n   116→    render_ssr? = init and dead and Map.get(assigns, :\"v-ssr\", @ssr_default)\n   117→    framework = Map.get(assigns, :\"v-framework\", \"vue\")\n   118→\n   119→    # if we enable diffs, we use only changed props for all the remaining calculations\n   120→    base_assigns =\n   121→      if use_diff do\n   122→        Enum.filter(assigns, fn {k, _v} -> key_changed(assigns, k) end)\n   123→      else\n   124→        assigns\n   125→      end\n   126→\n   127→    props = extract(base_assigns, :props)\n   128→    streams = extract(base_assigns, :streams)\n   129→    slots = extract(base_assigns, :slots)\n   130→    handlers = extract(base_assigns, :handlers)\n   131→    props_diff = if use_diff, do: calculate_props_diff(props, assigns), else: []\n   132→    streams_diff = if use_streams_diff, do: calculate_streams_diff(streams, init or dead), else: []\n   133→\n   134→    assigns =\n   135→      assigns\n   136→      |> Map.put_new(:class, nil)\n   137→      |> Map.put(:__component_name, Map.get(assigns, :\"v-component\"))\n   138→      |> Map.put(:__framework, framework)\n   139→      |> Map.put(:props, props)\n   140→      # let's compress it a little bit, and decompress it on the client side\n   141→      |> Map.put(:props_diff, Enum.map(props_diff, &prepare_diff/1))\n   142→      |> Map.put(:streams_diff, Enum.map(streams_diff, &prepare_diff/1))\n   143→      |> Map.put(:handlers, handlers)\n   144→      |> Map.put(:slots, Slots.rendered_slot_map(slots))\n   145→      |> Map.put(:use_diff, use_diff)\n   146→\n   147→    assigns =\n   148→      Map.put(assigns, :ssr_render, if(render_ssr?, do: ssr_render(assigns)))\n   149→\n   150→    computed_changed =\n   151→      %{\n   152→        # we send initial props only on initial render, later we send only changed props\n   153→        props: init or dead or not use_diff,\n   154→        ssr_render: render_ssr?,\n   155→        slots: slots != %{},\n   156→        handlers: handlers != %{},\n   157→        # we want to send props_diff always but not on initial render\n   158→        props_diff: not init and not dead and use_diff,\n   159→        # we want to send stream_diffs always when there's at least one stream in assigns\n   160→        streams_diff: use_streams_diff\n   161→      }\n   162→\n   163→    assigns =\n   164→      update_in(assigns.__changed__, fn\n   165→        nil -> nil\n   166→        changed -> for {k, true} <- computed_changed, into: changed, do: {k, true}\n   167→      end)\n   168→\n   169→    # optimizing diffs by using string interpolation\n   170→    # https://elixirforum.com/t/heex-attribute-value-in-quotes-send-less-data-than-values-in-braces/63274\n   171→    ~H\"\"\"\n   172→    {raw(@ssr_render[:preloadLinks])}\n   173→    <div\n   174→      id={assigns[:id] || id(@__component_name)}\n   175→      data-name={@__component_name}\n   176→      data-framework={@__framework}\n   177→      data-props={\"#{json(Encoder.encode(@props))}\"}\n   178→      data-props-diff={\"#{json(@props_diff)}\"}\n   179→      data-streams-diff={\"#{json(@streams_diff)}\"}\n   180→      data-ssr={(@ssr_render != nil) |> to_string()}\n   181→      data-use-diff={@use_diff |> to_string()}\n   182→      data-handlers={\"#{for({k, v} <- @handlers, into: %{}, do: {k, json(v.ops)}) |> json()}\"}\n   183→      data-slots={\"#{@slots |> Slots.base_encode_64() |> json}\"}\n   184→      phx-update=\"ignore\"\n   185→      phx-hook=\"VueHook\"\n   186→      phx-no-format\n   187→      class={@class}\n   188→    ><%= raw(@ssr_render[:html]) %></div>\n   189→    \"\"\"\n   190→  end\n   191→\n   192→  # Calculates minimal JSON Patch operations for changed props only.\n   193→  # Uses Phoenix LiveView's __changed__ tracking to identify what props have changed.\n   194→  # For simple values, generates direct replace operations.\n   195→  # For complex values (maps, lists), uses Jsonpatch.diff to find minimal changes.\n   196→  # Uses LiveVite.Encoder to safely encode structs before diffing.\n   197→  defp calculate_props_diff(props, %{__changed__: changed}) do\n   198→    # For simple types: changed[k] == true\n   199→    # For complex types: changed[k] is the old value\n   200→    props\n   201→    |> Enum.flat_map(fn {k, new_value} ->\n   202→      case changed[k] do\n   203→        nil ->\n   204→          []\n   205→\n   206→        # For simple types, generate replace operation\n   207→        true ->\n   208→          [%{op: \"replace\", path: \"/#{k}\", value: Encoder.encode(new_value)}]\n   209→\n   210→        # For complex types which didn't change type, use Jsonpatch to find minimal diff\n   211→        old_value ->\n   212→          Jsonpatch.diff(old_value, new_value,\n   213→            ancestor_path: \"/#{k}\",\n   214→            prepare_map: fn\n   215→              struct when is_struct(struct) -> Encoder.encode(struct)\n   216→              rest -> rest\n   217→            end,\n   218→            object_hash: &object_hash/1\n   219→          )\n   220→      end\n   221→    end)\n   222→    # let's add a harmless test operation to ensure we never have the same diff as before\n   223→    |> then(fn diff -> [%{op: \"test\", path: \"\", value: :rand.uniform(10_000_000)} | diff] end)\n   224→  end\n   225→\n   226→  # Generates JSON patch operations for LiveStream changes\n   227→  # Handles insertions and deletions for Phoenix LiveView streams\n   228→  defp calculate_streams_diff(streams, initial)\n   229→\n   230→  defp calculate_streams_diff(streams, true) do\n   231→    # for initial render, we want to reset all streams, and then apply the diffs\n   232→    init = Enum.map(streams, fn {k, _} -> %{op: \"replace\", path: \"/#{k}\", value: []} end)\n   233→    diffs = Enum.flat_map(streams, fn {k, stream} -> generate_stream_patches(k, stream) end)\n   234→    init ++ diffs\n   235→  end\n   236→\n   237→  defp calculate_streams_diff(streams, false) do\n   238→    streams\n   239→    |> Enum.flat_map(fn {k, stream} -> generate_stream_patches(k, stream) end)\n   240→    |> then(fn diff -> [%{op: \"test\", path: \"\", value: :rand.uniform(10_000_000)} | diff] end)\n   241→  end\n   242→\n   243→  # this function tells which field of the struct should be used as a key for the diff\n   244→  # right now it's hardcoded as id, maybe in the future I'll add a way to configure it,\n   245→  # depending on the user's needs\n   246→  defp object_hash(%{id: id}), do: id\n   247→  defp object_hash(_), do: nil\n   248→\n   249→  # Generates JSON patch operations for LiveStream changes\n   250→  # Handles insertions and deletions for Phoenix LiveView streams\n   251→  defp generate_stream_patches(stream_name, %LiveStream{} = stream) do\n   252→    patches = []\n   253→\n   254→    # Handle reset operation first\n   255→    patches =\n   256→      if stream.reset?,\n   257→        do: [%{op: \"replace\", path: \"/#{stream_name}\", value: []} | patches],\n   258→        else: patches\n   259→\n   260→    # Handle deletions second\n   261→    patches =\n   262→      Enum.reduce(stream.deletes, patches, fn dom_id, patches ->\n   263→        [%{op: \"remove\", path: \"/#{stream_name}/$$#{dom_id}\"} | patches]\n   264→      end)\n   265→\n   266→    # Handle insertions third, but reversed - inserts at -1 should be correctly ordered, inserts at 0 should be reversed\n   267→    # see https://hexdocs.pm/phoenix_live_view/Phoenix.LiveView.html#stream/4 :at option\n   268→    stream.inserts\n   269→    |> Enum.reverse()\n   270→    |> Enum.reduce(patches, fn {dom_id, at, item, limit, update_only}, patches ->\n   271→      item = Map.put(Encoder.encode(item), :__dom_id, dom_id)\n   272→\n   273→      patches =\n   274→        if update_only,\n   275→          do: [%{op: \"replace\", path: \"/#{stream_name}/$$#{dom_id}\", value: item} | patches],\n   276→          else: [%{op: \"upsert\", path: \"/#{stream_name}/#{if at == -1, do: \"-\", else: at}\", value: item} | patches]\n   277→\n   278→      if limit,\n   279→        do: [%{op: \"limit\", path: \"/#{stream_name}\", value: limit} | patches],\n   280→        else: patches\n   281→    end)\n   282→    |> Enum.reverse()\n   283→  end\n   284→\n   285→  # we compress the diff to make it smaller, so it's faster to send to the client\n   286→  # then, it's decompressed on the client side\n   287→  defp prepare_diff(%{op: op, path: p, value: value}), do: [op, p, value]\n   288→  defp prepare_diff(%{op: op, path: p}), do: [op, p]\n   289→\n   290→  defp extract(assigns, type) do\n   291→    Enum.reduce(assigns, %{}, fn {key, value}, acc ->\n   292→      case normalize_key(key, value) do\n   293→        ^type -> Map.put(acc, key, value)\n   294→        {^type, k} -> Map.put(acc, k, value)\n   295→        _ -> acc\n   296→      end\n   297→    end)\n   298→  end\n   299→\n   300→  defp normalize_key(key, _val) when key in ~w\"id class v-ssr v-diff v-component v-framework v-socket __changed__ __given__\"a,\n   301→    do: :special\n   302→\n   303→  defp normalize_key(_key, [%{__slot__: _}]), do: :slots\n   304→  defp normalize_key(key, val) when is_atom(key), do: key |> to_string() |> normalize_key(val)\n   305→  defp normalize_key(\"v-on:\" <> key, _val), do: {:handlers, key}\n   306→  defp normalize_key(_key, %LiveStream{}), do: :streams\n   307→  defp normalize_key(_key, _val), do: :props\n   308→\n   309→  defp key_changed(%{__changed__: nil}, _key), do: true\n   310→  defp key_changed(%{__changed__: changed}, key), do: changed[key] != nil\n   311→\n   312→  defp ssr_render(assigns) do\n   313→    name = assigns[:\"v-component\"]\n   314→    encoded_props = Encoder.encode(assigns.props)\n   315→    framework = assigns[:__framework] || \"vue\"\n   316→\n   317→    case SSR.render(name, encoded_props, assigns.slots, framework) do\n   318→      {:error, message} ->\n   319→        Logger.error(\"Vue SSR error: #{message}\")\n   320→        nil\n   321→\n   322→      %{preloadLinks: links, html: html} ->\n   323→        %{preloadLinks: links, html: html}\n   324→    end\n   325→  rescue\n   326→    SSR.NotConfigured ->\n   327→      nil\n   328→  end\n   329→\n   330→  defp json(data), do: Jason.encode!(data, escape: :html_safe)\n   331→\n   332→  defp id(name) do\n   333→    # a small trick to avoid collisions of IDs but keep them consistent across dead and live render\n   334→    # id(name) is called only once during the whole LiveView lifecycle because it's not using any assigns\n   335→    number = Process.get(:live_vite_counter, 1)\n   336→    Process.put(:live_vite_counter, number + 1)\n   337→    \"#{name}-#{number}\"\n   338→  end\n   339→\n   340→  @doc false\n   341→  def get_socket(assigns) do\n   342→    case get_in(assigns, [:vue_opts, :socket]) || assigns[:socket] do\n   343→      %LiveView.Socket{} = socket -> socket\n   344→      _ -> nil\n   345→    end\n   346→  end\n   347→\n   348→  @doc false\n   349→  @deprecated \"~V sigil is deprecated, please use ~VUE instead.\"\n   350→  defmacro sigil_V(term, modifiers) do\n   351→    do_sigil(term, modifiers, :vue, __CALLER__)\n   352→  end\n   353→\n   354→  @doc \"\"\"\n   355→  Inlines a Vue single-file component inside a LiveView.\n   356→\n   357→  Writes the template to `./assets/vue/_build/{module}.vue` at compile time\n   358→  and renders it using `LiveVite.vue/1`.\n   359→\n   360→  ## Example\n   361→\n   362→      def render(assigns) do\n   363→        ~VUE\\\"\\\"\\\"\n   364→        <template>\n   365→          <div>{{ message }}</div>\n   366→        </template>\n   367→\n   368→        <script setup>\n   369→          defineProps({ message: String })\n   370→        </script>\n   371→        \\\"\\\"\\\"\n   372→      end\n   373→  \"\"\"\n   374→  defmacro sigil_VUE(term, modifiers) do\n   375→    do_sigil(term, modifiers, :vue, __CALLER__)\n   376→  end\n   377→\n   378→  @doc \"\"\"\n   379→  Inlines a React component (TSX) inside a LiveView.\n   380→\n   381→  Writes the template to `./assets/vue/_build/{module}.tsx` at compile time\n   382→  and renders it using `LiveVite.react/1`.\n   383→\n   384→  ## Example\n   385→\n   386→      def render(assigns) do\n   387→        ~REACT\\\"\\\"\\\"\n   388→        export default function({ message }: { message: string }) {\n   389→          return <div>{message}</div>\n   390→        }\n   391→        \\\"\\\"\\\"\n   392→      end\n   393→  \"\"\"\n   394→  defmacro sigil_REACT(term, modifiers) do\n   395→    do_sigil(term, modifiers, :react, __CALLER__)\n   396→  end\n   397→\n   398→  @framework_sigil_config %{\n   399→    vue: %{extension: \".vue\"},\n   400→    react: %{extension: \".tsx\"}\n   401→  }\n   402→\n   403→  defp do_sigil({:<<>>, _meta, [string]}, [], framework, caller) do\n   404→    config = @framework_sigil_config[framework]\n   405→    path = \"./assets/vue/_build/#{caller.module}#{config.extension}\"\n   406→\n   407→    with :ok <- File.mkdir_p(Path.dirname(path)) do\n   408→      File.write!(path, string)\n   409→    end\n   410→\n   411→    do_sigil_template(framework)\n   412→  end\n   413→\n   414→  defp do_sigil_template(:vue) do\n   415→    quote do\n   416→      ~H\"\"\"\n   417→      <LiveVite.vue\n   418→        class={get_in(assigns, [:vue_opts, :class])}\n   419→        v-component={\"_build/#{__MODULE__}\"}\n   420→        v-socket={get_socket(assigns)}\n   421→        v-ssr={get_in(assigns, [:vue_opts, :ssr]) != false}\n   422→        {Map.drop(assigns, [:vue_opts, :socket, :flash, :live_action])}\n   423→      />\n   424→      \"\"\"\n   425→    end\n   426→  end\n   427→\n   428→  defp do_sigil_template(:react) do\n   429→    quote do\n   430→      ~H\"\"\"\n   431→      <LiveVite.react\n   432→        class={get_in(assigns, [:vue_opts, :class])}\n   433→        v-component={\"_build/#{__MODULE__}\"}\n   434→        v-socket={get_socket(assigns)}\n   435→        v-ssr={get_in(assigns, [:vue_opts, :ssr]) != false}\n   436→        {Map.drop(assigns, [:vue_opts, :socket, :flash, :live_action])}\n   437→      />\n   438→      \"\"\"\n   439→    end\n   440→  end\n   441→end\n   442→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d5cbf92b-6106-41f2-ab9b-5f76d18aa231","uuid":"e2781140-f873-4351-b428-e80b9d3f0e51","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/lib/live_vite.ex","content":"defmodule LiveVite do\n  @moduledoc \"\"\"\n  LiveVite provides seamless integration between Phoenix LiveView and Vue.js components.\n\n  ## Installation and Configuration\n\n  See README.md for installation instructions and usage.\n\n  ## Component Options\n\n  When using the `vue/1`/`react/1` components or `~VUE`/`~REACT` sigils, the following options are supported:\n\n  ### Required Attributes\n    * `v-component` (string) - Name of the Vue component (e.g., \"YourComponent\", \"directory/Example\")\n\n  > #### Tip {: .tip}\n  >\n  > Value of `v-component` will be directly passed to `resolve` function of the `createLiveVite` instance.\n  > It should return Vue component or a promise that resolves to a Vue component.\n  > In a standard setup, you can find it in `assets/vue/index.js`.\n\n  ### Optional Attributes\n    * `id` (string) - Explicit ID of the wrapper component. If not provided, a random one will be\n      generated. Useful to keep ID consistent in development (e.g., \"vue-1\")\n    * `class` (string) - CSS class(es) to apply to the Vue component wrapper\n      (e.g., \"my-class\" or \"my-class another-class\")\n    * `v-ssr` (boolean) - Whether to render the component on the server. Defaults to the value set\n      in config (default: true)\n    * `v-socket` (LiveView.Socket) - LiveView socket, should be provided when rendering inside LiveView\n\n  ### Event Handlers\n    * `v-on:*` - Vue event handlers can be attached using the `v-on:` prefix\n      (e.g., `v-on:click`, `v-on:input`)\n\n  ### Props and Slots\n    * All other attributes are passed as props to the Vue component\n    * Slots can be passed as regular Phoenix slots\n  \"\"\"\n\n  use Phoenix.Component\n\n  import Phoenix.HTML\n\n  alias LiveVite.Encoder\n  alias LiveVite.Slots\n  alias LiveVite.SSR\n  alias Phoenix.LiveView\n  alias Phoenix.LiveView.LiveStream\n\n  require Logger\n\n  @ssr_default Application.compile_env(:live_vite, :ssr, true)\n  @diff_default Application.compile_env(:live_vite, :enable_props_diff, true)\n\n  defmacro __using__(_opts) do\n    quote do\n      import LiveVite\n    end\n  end\n\n  @doc \"\"\"\n  Renders a React component within Phoenix LiveView.\n\n  Sets `v-framework` to `\"react\"` and delegates to the shared rendering pipeline.\n\n  ## Examples\n\n      <.react\n        v-component=\"MyComponent\"\n        message=\"Hello\"\n        v-on:click=\"handleClick\"\n        class=\"my-component\"\n      />\n\n      <.react\n        v-component=\"nested/Component\"\n        v-ssr={false}\n        items={@items}\n      >\n        <:default>Default slot content</:default>\n        <:named>Named slot content</:named>\n      </.react>\n  \"\"\"\n  def react(assigns) do\n    assigns\n    |> Map.put(:\"v-framework\", \"react\")\n    |> vue()\n  end\n\n  @doc \"\"\"\n  Renders a Vue component within Phoenix LiveView.\n\n  ## Examples\n\n      <.vue\n        v-component=\"MyComponent\"\n        message=\"Hello\"\n        v-on:click=\"handleClick\"\n        class=\"my-component\"\n      />\n\n      <.vue\n        v-component=\"nested/Component\"\n        v-ssr={false}\n        items={@items}\n      >\n        <:default>Default slot content</:default>\n        <:named>Named slot content</:named>\n      </.vue>\n  \"\"\"\n  def vue(assigns) do\n    init = assigns.__changed__ == nil\n    dead = assigns[:\"v-socket\"] == nil or not LiveView.connected?(assigns[:\"v-socket\"])\n    use_diff = Map.get(assigns, :\"v-diff\", @diff_default)\n    use_streams_diff = Enum.any?(assigns, fn {_k, v} -> match?(%LiveStream{}, v) end)\n    render_ssr? = init and dead and Map.get(assigns, :\"v-ssr\", @ssr_default)\n    framework = Map.get(assigns, :\"v-framework\", \"vue\")\n\n    # if we enable diffs, we use only changed props for all the remaining calculations\n    base_assigns =\n      if use_diff do\n        Enum.filter(assigns, fn {k, _v} -> key_changed(assigns, k) end)\n      else\n        assigns\n      end\n\n    props = extract(base_assigns, :props)\n    streams = extract(base_assigns, :streams)\n    slots = extract(base_assigns, :slots)\n    handlers = extract(base_assigns, :handlers)\n    props_diff = if use_diff, do: calculate_props_diff(props, assigns), else: []\n    streams_diff = if use_streams_diff, do: calculate_streams_diff(streams, init or dead), else: []\n\n    assigns =\n      assigns\n      |> Map.put_new(:class, nil)\n      |> Map.put(:__component_name, Map.get(assigns, :\"v-component\"))\n      |> Map.put(:__framework, framework)\n      |> Map.put(:props, props)\n      # let's compress it a little bit, and decompress it on the client side\n      |> Map.put(:props_diff, Enum.map(props_diff, &prepare_diff/1))\n      |> Map.put(:streams_diff, Enum.map(streams_diff, &prepare_diff/1))\n      |> Map.put(:handlers, handlers)\n      |> Map.put(:slots, Slots.rendered_slot_map(slots))\n      |> Map.put(:use_diff, use_diff)\n\n    assigns =\n      Map.put(assigns, :ssr_render, if(render_ssr?, do: ssr_render(assigns)))\n\n    computed_changed =\n      %{\n        # we send initial props only on initial render, later we send only changed props\n        props: init or dead or not use_diff,\n        ssr_render: render_ssr?,\n        slots: slots != %{},\n        handlers: handlers != %{},\n        # we want to send props_diff always but not on initial render\n        props_diff: not init and not dead and use_diff,\n        # we want to send stream_diffs always when there's at least one stream in assigns\n        streams_diff: use_streams_diff\n      }\n\n    assigns =\n      update_in(assigns.__changed__, fn\n        nil -> nil\n        changed -> for {k, true} <- computed_changed, into: changed, do: {k, true}\n      end)\n\n    # optimizing diffs by using string interpolation\n    # https://elixirforum.com/t/heex-attribute-value-in-quotes-send-less-data-than-values-in-braces/63274\n    ~H\"\"\"\n    {raw(@ssr_render[:preloadLinks])}\n    <div\n      id={assigns[:id] || id(@__component_name)}\n      data-name={@__component_name}\n      data-framework={@__framework}\n      data-props={\"#{json(Encoder.encode(@props))}\"}\n      data-props-diff={\"#{json(@props_diff)}\"}\n      data-streams-diff={\"#{json(@streams_diff)}\"}\n      data-ssr={(@ssr_render != nil) |> to_string()}\n      data-use-diff={@use_diff |> to_string()}\n      data-handlers={\"#{for({k, v} <- @handlers, into: %{}, do: {k, json(v.ops)}) |> json()}\"}\n      data-slots={\"#{@slots |> Slots.base_encode_64() |> json}\"}\n      phx-update=\"ignore\"\n      phx-hook=\"VueHook\"\n      phx-no-format\n      class={@class}\n    ><%= raw(@ssr_render[:html]) %></div>\n    \"\"\"\n  end\n\n  # Calculates minimal JSON Patch operations for changed props only.\n  # Uses Phoenix LiveView's __changed__ tracking to identify what props have changed.\n  # For simple values, generates direct replace operations.\n  # For complex values (maps, lists), uses Jsonpatch.diff to find minimal changes.\n  # Uses LiveVite.Encoder to safely encode structs before diffing.\n  defp calculate_props_diff(props, %{__changed__: changed}) do\n    # For simple types: changed[k] == true\n    # For complex types: changed[k] is the old value\n    props\n    |> Enum.flat_map(fn {k, new_value} ->\n      case changed[k] do\n        nil ->\n          []\n\n        # For simple types, generate replace operation\n        true ->\n          [%{op: \"replace\", path: \"/#{k}\", value: Encoder.encode(new_value)}]\n\n        # For complex types which didn't change type, use Jsonpatch to find minimal diff\n        old_value ->\n          Jsonpatch.diff(old_value, new_value,\n            ancestor_path: \"/#{k}\",\n            prepare_map: fn\n              struct when is_struct(struct) -> Encoder.encode(struct)\n              rest -> rest\n            end,\n            object_hash: &object_hash/1\n          )\n      end\n    end)\n    # let's add a harmless test operation to ensure we never have the same diff as before\n    |> then(fn diff -> [%{op: \"test\", path: \"\", value: :rand.uniform(10_000_000)} | diff] end)\n  end\n\n  # Generates JSON patch operations for LiveStream changes\n  # Handles insertions and deletions for Phoenix LiveView streams\n  defp calculate_streams_diff(streams, initial)\n\n  defp calculate_streams_diff(streams, true) do\n    # for initial render, we want to reset all streams, and then apply the diffs\n    init = Enum.map(streams, fn {k, _} -> %{op: \"replace\", path: \"/#{k}\", value: []} end)\n    diffs = Enum.flat_map(streams, fn {k, stream} -> generate_stream_patches(k, stream) end)\n    init ++ diffs\n  end\n\n  defp calculate_streams_diff(streams, false) do\n    streams\n    |> Enum.flat_map(fn {k, stream} -> generate_stream_patches(k, stream) end)\n    |> then(fn diff -> [%{op: \"test\", path: \"\", value: :rand.uniform(10_000_000)} | diff] end)\n  end\n\n  # this function tells which field of the struct should be used as a key for the diff\n  # right now it's hardcoded as id, maybe in the future I'll add a way to configure it,\n  # depending on the user's needs\n  defp object_hash(%{id: id}), do: id\n  defp object_hash(_), do: nil\n\n  # Generates JSON patch operations for LiveStream changes\n  # Handles insertions and deletions for Phoenix LiveView streams\n  defp generate_stream_patches(stream_name, %LiveStream{} = stream) do\n    patches = []\n\n    # Handle reset operation first\n    patches =\n      if stream.reset?,\n        do: [%{op: \"replace\", path: \"/#{stream_name}\", value: []} | patches],\n        else: patches\n\n    # Handle deletions second\n    patches =\n      Enum.reduce(stream.deletes, patches, fn dom_id, patches ->\n        [%{op: \"remove\", path: \"/#{stream_name}/$$#{dom_id}\"} | patches]\n      end)\n\n    # Handle insertions third, but reversed - inserts at -1 should be correctly ordered, inserts at 0 should be reversed\n    # see https://hexdocs.pm/phoenix_live_view/Phoenix.LiveView.html#stream/4 :at option\n    stream.inserts\n    |> Enum.reverse()\n    |> Enum.reduce(patches, fn {dom_id, at, item, limit, update_only}, patches ->\n      item = Map.put(Encoder.encode(item), :__dom_id, dom_id)\n\n      patches =\n        if update_only,\n          do: [%{op: \"replace\", path: \"/#{stream_name}/$$#{dom_id}\", value: item} | patches],\n          else: [%{op: \"upsert\", path: \"/#{stream_name}/#{if at == -1, do: \"-\", else: at}\", value: item} | patches]\n\n      if limit,\n        do: [%{op: \"limit\", path: \"/#{stream_name}\", value: limit} | patches],\n        else: patches\n    end)\n    |> Enum.reverse()\n  end\n\n  # we compress the diff to make it smaller, so it's faster to send to the client\n  # then, it's decompressed on the client side\n  defp prepare_diff(%{op: op, path: p, value: value}), do: [op, p, value]\n  defp prepare_diff(%{op: op, path: p}), do: [op, p]\n\n  defp extract(assigns, type) do\n    Enum.reduce(assigns, %{}, fn {key, value}, acc ->\n      case normalize_key(key, value) do\n        ^type -> Map.put(acc, key, value)\n        {^type, k} -> Map.put(acc, k, value)\n        _ -> acc\n      end\n    end)\n  end\n\n  defp normalize_key(key, _val) when key in ~w\"id class v-ssr v-diff v-component v-framework v-socket __changed__ __given__\"a,\n    do: :special\n\n  defp normalize_key(_key, [%{__slot__: _}]), do: :slots\n  defp normalize_key(key, val) when is_atom(key), do: key |> to_string() |> normalize_key(val)\n  defp normalize_key(\"v-on:\" <> key, _val), do: {:handlers, key}\n  defp normalize_key(_key, %LiveStream{}), do: :streams\n  defp normalize_key(_key, _val), do: :props\n\n  defp key_changed(%{__changed__: nil}, _key), do: true\n  defp key_changed(%{__changed__: changed}, key), do: changed[key] != nil\n\n  defp ssr_render(assigns) do\n    name = assigns[:\"v-component\"]\n    encoded_props = Encoder.encode(assigns.props)\n    framework = assigns[:__framework] || \"vue\"\n\n    case SSR.render(name, encoded_props, assigns.slots, framework) do\n      {:error, message} ->\n        Logger.error(\"Vue SSR error: #{message}\")\n        nil\n\n      %{preloadLinks: links, html: html} ->\n        %{preloadLinks: links, html: html}\n    end\n  rescue\n    SSR.NotConfigured ->\n      nil\n  end\n\n  defp json(data), do: Jason.encode!(data, escape: :html_safe)\n\n  defp id(name) do\n    # a small trick to avoid collisions of IDs but keep them consistent across dead and live render\n    # id(name) is called only once during the whole LiveView lifecycle because it's not using any assigns\n    number = Process.get(:live_vite_counter, 1)\n    Process.put(:live_vite_counter, number + 1)\n    \"#{name}-#{number}\"\n  end\n\n  @doc false\n  def get_socket(assigns) do\n    case get_in(assigns, [:vue_opts, :socket]) || assigns[:socket] do\n      %LiveView.Socket{} = socket -> socket\n      _ -> nil\n    end\n  end\n\n  @doc false\n  @deprecated \"~V sigil is deprecated, please use ~VUE instead.\"\n  defmacro sigil_V(term, modifiers) do\n    do_sigil(term, modifiers, :vue, __CALLER__)\n  end\n\n  @doc \"\"\"\n  Inlines a Vue single-file component inside a LiveView.\n\n  Writes the template to `./assets/vue/_build/{module}.vue` at compile time\n  and renders it using `LiveVite.vue/1`.\n\n  ## Example\n\n      def render(assigns) do\n        ~VUE\\\"\\\"\\\"\n        <template>\n          <div>{{ message }}</div>\n        </template>\n\n        <script setup>\n          defineProps({ message: String })\n        </script>\n        \\\"\\\"\\\"\n      end\n  \"\"\"\n  defmacro sigil_VUE(term, modifiers) do\n    do_sigil(term, modifiers, :vue, __CALLER__)\n  end\n\n  @doc \"\"\"\n  Inlines a React component (TSX) inside a LiveView.\n\n  Writes the template to `./assets/vue/_build/{module}.tsx` at compile time\n  and renders it using `LiveVite.react/1`.\n\n  ## Example\n\n      def render(assigns) do\n        ~REACT\\\"\\\"\\\"\n        export default function({ message }: { message: string }) {\n          return <div>{message}</div>\n        }\n        \\\"\\\"\\\"\n      end\n  \"\"\"\n  defmacro sigil_REACT(term, modifiers) do\n    do_sigil(term, modifiers, :react, __CALLER__)\n  end\n\n  @framework_sigil_config %{\n    vue: %{extension: \".vue\"},\n    react: %{extension: \".tsx\"}\n  }\n\n  defp do_sigil({:<<>>, _meta, [string]}, [], framework, caller) do\n    config = @framework_sigil_config[framework]\n    path = \"./assets/vue/_build/#{caller.module}#{config.extension}\"\n\n    with :ok <- File.mkdir_p(Path.dirname(path)) do\n      File.write!(path, string)\n    end\n\n    do_sigil_template(framework)\n  end\n\n  defp do_sigil_template(:vue) do\n    quote do\n      ~H\"\"\"\n      <LiveVite.vue\n        class={get_in(assigns, [:vue_opts, :class])}\n        v-component={\"_build/#{__MODULE__}\"}\n        v-socket={get_socket(assigns)}\n        v-ssr={get_in(assigns, [:vue_opts, :ssr]) != false}\n        {Map.drop(assigns, [:vue_opts, :socket, :flash, :live_action])}\n      />\n      \"\"\"\n    end\n  end\n\n  defp do_sigil_template(:react) do\n    quote do\n      ~H\"\"\"\n      <LiveVite.react\n        class={get_in(assigns, [:vue_opts, :class])}\n        v-component={\"_build/#{__MODULE__}\"}\n        v-socket={get_socket(assigns)}\n        v-ssr={get_in(assigns, [:vue_opts, :ssr]) != false}\n        {Map.drop(assigns, [:vue_opts, :socket, :flash, :live_action])}\n      />\n      \"\"\"\n    end\n  end\nend\n","numLines":442,"startLine":1,"totalLines":442}}}
