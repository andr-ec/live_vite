ect(pushPrefCheckbox).toBeChecked()\n   587→    await expect(page.locator(\"[data-pw-is-dirty]\")).toHaveText(\"Dirty: true\")\n   588→\n   589→    // Reset the form\n   590→    await page.locator(\"[data-pw-reset]\").click()\n   591→\n   592→    // All checkboxes should be unchecked\n   593→    await expect(acceptTermsCheckbox).not.toBeChecked()\n   594→    await expect(newsletterCheckbox).not.toBeChecked()\n   595→    await expect(emailPrefCheckbox).not.toBeChecked()\n   596→    await expect(pushPrefCheckbox).not.toBeChecked()\n   597→    await expect(page.locator(\"[data-pw-is-dirty]\")).toHaveText(\"Dirty: false\")\n   598→  })\n   599→\n   600→  test(\"checkbox form submission with all checkbox states\", async ({ page }) => {\n   601→    const nameInput = page.locator(\"[data-pw-name-input]\")\n   602→    const emailInput = page.locator(\"[data-pw-email-input]\")\n   603→    const ageInput = page.locator(\"[data-pw-age-input]\")\n   604→    const acceptTermsCheckbox = page.locator(\"[data-pw-accept-terms]\")\n   605→    const newsletterCheckbox = page.locator(\"[data-pw-newsletter]\")\n   606→    const emailPrefCheckbox = page.locator(\"[data-pw-preferences-email]\")\n   607→    const smsPrefCheckbox = page.locator(\"[data-pw-preferences-sms]\")\n   608→\n   609→    // Fill form with valid data\n   610→    await nameInput.fill(\"John Doe\")\n   611→    await emailInput.fill(\"john@example.com\")\n   612→    await ageInput.fill(\"30\")\n   613→    await acceptTermsCheckbox.check()\n   614→    await newsletterCheckbox.check()\n   615→    await emailPrefCheckbox.check()\n   616→    await smsPrefCheckbox.check()\n   617→\n   618→    // Add bio to make form valid\n   619→    const bioInput = page.locator(\"[data-pw-bio-input]\")\n   620→    await bioInput.fill(\"This is a comprehensive bio with sufficient content for validation\")\n   621→\n   622→    await syncLV(page)\n   623→\n   624→    // Form should be valid\n   625→    await expect(page.locator(\"[data-pw-is-