t\", async ({ page }) => {\n   275→      // Verify initial state: 3 items\n   276→      await expect(page.locator('h3:has-text(\"Items\")')).toHaveText(\"Items (3)\")\n   277→\n   278→      // Add 3 items at start with limit 5 (should keep first 5 items)\n   279→      await page.click('[data-testid=\"add-multiple-start-button\"]')\n   280→      await syncLV(page)\n   281→\n   282→      // Should have 5 items total (3 new + 3 original, but limited to 5)\n   283→      await expect(page.locator('h3:has-text(\"Items\")')).toHaveText(\"Items (5)\")\n   284→\n   285→      // Check that new items are at the start and in correct order\n   286→      // Expected order: Start Item C, Start Item B, Start Item A, Item 1, Item 2\n   287→      // (Note: items are added at position 0 in reverse order)\n   288→      await expect(page.locator('[data-testid=\"item-6\"] [data-testid=\"item-name\"]')).toHaveText(\"Start Item C\")\n   289→      await expect(page.locator('[data-testid=\"item-5\"] [data-testid=\"item-name\"]')).toHaveText(\"Start Item B\")\n   290→      await expect(page.locator('[data-testid=\"item-4\"] [data-testid=\"item-name\"]')).toHaveText(\"Start Item A\")\n   291→      await expect(page.locator('[data-testid=\"item-1\"] [data-testid=\"item-name\"]')).toHaveText(\"Item 1\")\n   292→      await expect(page.locator('[data-testid=\"item-2\"] [data-testid=\"item-name\"]')).toHaveText(\"Item 2\")\n   293→\n   294→      // Item 3 should be removed due to limit 5\n   295→      await expect(page.locator('[data-testid=\"item-3\"]')).not.toBeVisible()\n   296→    })\n   297→\n   298→    test(\"adds multiple items at end with negative limit\", async ({ page }) => {\n   299→      // Verify initial state: 3 items\n   300→      await expect(page.locator('h3:has-text(\"Items\")')).toHaveText(\"Items (3)\")\n   301→\n   302→      // Add 3 items at end with negative limit -5 (should keep last 5 items)\n   303→      await page.click('[data-testid=\"add-multiple-end-button\"]')\n   30