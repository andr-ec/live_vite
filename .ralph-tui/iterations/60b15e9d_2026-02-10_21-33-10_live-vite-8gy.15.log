t csrfToken = document.querySelector(\"meta[name='csrf-token']\")?.getAttribute(\"content\")\nlet liveSocket = new LiveSocket(\"/live\", Socket, {\n  params: { _csrf_token: csrfToken },\n  hooks: { VueHook },\n})\n\n// connect if there are any LiveViews on the page\nliveSocket.connect()\nwindow.liveSocket = liveSocket\n","numLines":53,"startLine":1,"totalLines":53}}}
