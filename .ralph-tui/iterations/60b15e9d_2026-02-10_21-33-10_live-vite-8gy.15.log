imeout(timeout)\n   199→\n   200→      timeout = setTimeout(async () => {\n   201→        const currentResolvers = pendingResolvers\n   202→        pendingResolvers = []\n   203→        timeout = null\n   204→        timeoutRef.value = null\n   205→        executingCount++\n   206→        executingCountRef.value++\n   207→\n   208→        try {\n   209→          const result = await func(...args)\n   210→          currentResolvers.forEach(({ resolve }) => resolve(result))\n   211→        } catch (error) {\n   212→          currentResolvers.forEach(({ reject }) => reject(error))\n   213→        } finally {\n   214→          executingCount--\n   215→          executingCountRef.value--\n   216→        }\n   217→      }, wait)\n   218→\n   219→      timeoutRef.value = timeout\n   220→    })\n   221→  }\n   222→\n   223→  const isPending = computed(() => timeoutRef.value !== null || executingCountRef.value > 0)\n   224→\n   225→  return { debouncedFn, isPending }\n   226→}\n   227→\n   228→export const cacheOnAccessProxy = <T extends object>(createFunc: (key: keyof T) => any) =>\n   229→  new Proxy(\n   230→    {},\n   231→    {\n   232→      // @ts-expect-error proxy get always expect string key\n   233→      get: (fields, key: keyof T) => {\n   234→        if (typeof key === \"string\" && key.startsWith(\"__\")) {\n   235→          return Reflect.get(fields, key)\n   236→        }\n   237→        if (!Reflect.has(fields, key)) {\n   238→          Reflect.set(fields, key, createFunc(key))\n   239→        }\n   240→        return Reflect.get(fields, key)\n   241→      },\n   242→    }\n   243→  )\n   244→\n   245→/**\n   246→ * Parses a path string like \"user.items[0].name\" into an array of keys\n   247→ */\n   248→export function parsePath(path: string): (string | number)[] {\n   249→  if (!path) return []\n   250→\n   251→  const keys: (string | number)[] = []\n   252→  let current = \"\"\n   253→  let i = 0\n   254→\n   255→  while (i < path.length) {\n   256→    co