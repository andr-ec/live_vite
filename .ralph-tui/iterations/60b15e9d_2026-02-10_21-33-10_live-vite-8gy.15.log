{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nu1dgYg3jS7PSM7cbmv4RF","type":"tool_result","content":"     1→import { useCallback, useEffect, useMemo, useRef, useState } from \"react\"\n     2→import { useLive } from \"./useReact.js\"\n     3→import type { UploadConfig, UploadEntry, UploadOptions } from \"./types.js\"\n     4→\n     5→export interface UseLiveUploadReactReturn {\n     6→  /** Current entries from the upload config */\n     7→  entries: UploadEntry[]\n     8→  /** Opens the native file-picker dialog */\n     9→  showFilePicker: () => void\n    10→  /** Manually enqueue external files (e.g. drag-drop) */\n    11→  addFiles: (files: (File | Blob)[] | DataTransfer) => void\n    12→  /** Submit all currently queued files to LiveView */\n    13→  submit: () => void\n    14→  /** Cancel a single entry by ref or every entry when omitted */\n    15→  cancel: (ref?: string) => void\n    16→  /** Clear local queue and reset hidden input (post-upload cleanup) */\n    17→  clear: () => void\n    18→  /** Overall progress 0-100 derived from entries */\n    19→  progress: number\n    20→  /** The underlying hidden <input type=file> */\n    21→  inputEl: HTMLInputElement | null\n    22→  /** Whether the selected files are valid */\n    23→  valid: boolean\n    24→}\n    25→\n    26→/**\n    27→ * React hook for Phoenix LiveView file uploads.\n    28→ * Provides a React-friendly API for handling file uploads with LiveView.\n    29→ * Mirrors the Vue `useLiveUpload()` composable.\n    30→ *\n    31→ * @param uploadConfig - The upload configuration from LiveView props\n    32→ * @param options - The options for the upload (changeEvent, submitEvent)\n    33→ * @returns An object with upload methods and state\n    34→ */\n    35→export function useLiveUpload(\n    36→  uploadConfig: UploadConfig,\n    37→  options: UploadOptions\n    38→): UseLiveUploadReactReturn {\n    39→  const live = useLive()\n    40→  const inputElRef = useRef<HTMLInputElement | null>(null)\n    41→  const [, setVersion] = useState(0)\n    42→  const rerender = useCallback(() => setVersion(v => v + 1), [])\n    43→\n    44→  // Keep a ref to the latest uploadConfig so the DOM update effect can read it\n    45→  const configRef = useRef(uploadConfig)\n    46→  configRef.current = uploadConfig\n    47→\n    48→  // Create and manage the hidden file input element with Phoenix upload attributes\n    49→  useEffect(() => {\n    50→    const form = document.createElement(\"form\")\n    51→    if (options.changeEvent) form.setAttribute(\"phx-change\", options.changeEvent)\n    52→    form.setAttribute(\"phx-submit\", options.submitEvent)\n    53→    form.style.display = \"none\"\n    54→\n    55→    const input = document.createElement(\"input\")\n    56→    input.type = \"file\"\n    57→    input.id = uploadConfig.ref\n    58→    input.name = uploadConfig.name\n    59→\n    60→    // Phoenix LiveView upload attributes\n    61→    input.setAttribute(\"data-phx-hook\", \"Phoenix.LiveFileUpload\")\n    62→    input.setAttribute(\"data-phx-update\", \"ignore\")\n    63→    input.setAttribute(\"data-phx-upload-ref\", uploadConfig.ref)\n    64→    form.appendChild(input)\n    65→\n    66→    if (uploadConfig.accept && typeof uploadConfig.accept === \"string\") {\n    67→      input.accept = uploadConfig.accept\n    68→    }\n    69→\n    70→    if (uploadConfig.auto_upload) {\n    71→      input.setAttribute(\"data-phx-auto-upload\", \"true\")\n    72→    }\n    73→\n    74→    if (uploadConfig.max_entries > 1) {\n    75→      input.multiple = true\n    76→    }\n    77→\n    78→    live.el.appendChild(form)\n    79→    inputElRef.current = input\n    80→    rerender()\n    81→\n    82→    return () => {\n    83→      form.remove()\n    84→      inputElRef.current = null\n    85→    }\n    86→  }, []) // eslint-disable-line react-hooks/exhaustive-deps -- mount once\n    87→\n    88→  // Update entry ref attributes when config changes\n    89→  useEffect(() => {\n    90→    const input = inputElRef.current\n    91→    if (!input) return\n    92→\n    93→    const joinEntries = (entries: UploadEntry[]) => entries.map(e => e.ref).join(\",\")\n    94→\n    95→    input.setAttribute(\"data-phx-active-refs\", joinEntries(uploadConfig.entries))\n    96→    input.setAttribute(\"data-phx-done-refs\", joinEntries(uploadConfig.entries.filter(e => e.done)))\n    97→    input.setAttribute(\"data-phx-preflighted-refs\", joinEntries(uploadConfig.entries.filter(e => e.preflighted)))\n    98→  }, [uploadConfig.entries])\n    99→\n   100→  // Derived state\n   101→  const entries = uploadConfig.entries || []\n   102→\n   103→  const progress = useMemo(() => {\n   104→    if (entries.length === 0) return 0\n   105→    const totalProgress = entries.reduce((sum, entry) => sum + (entry.progress || 0), 0)\n   106→    return Math.round(totalProgress / entries.length)\n   107→  }, [entries])\n   108→\n   109→  const valid = useMemo(() => {\n   110→    return Object.keys(uploadConfig.errors).length === 0\n   111→  }, [uploadConfig.errors])\n   112→\n   113→  const showFilePicker = useCallback(() => {\n   114→    inputElRef.current?.click()\n   115→  }, [])\n   116→\n   117→  const addFiles = useCallback((input: (File | Blob)[] | DataTransfer) => {\n   118→    const el = inputElRef.current\n   119→    if (!el) return\n   120→\n   121→    if (typeof DataTransfer !== \"undefined\" && input instanceof DataTransfer) {\n   122→      el.files = input.files\n   123→    } else if (Array.isArray(input) && typeof DataTransfer !== \"undefined\") {\n   124→      const dataTransfer = new DataTransfer()\n   125→      input.forEach(f => dataTransfer.items.add(f as File))\n   126→      el.files = dataTransfer.files\n   127→    }\n   128→\n   129→    // Dispatch change event to trigger Phoenix LiveView upload handling\n   130→    setTimeout(() => {\n   131→      if (inputElRef.current) {\n   132→        inputElRef.current.dispatchEvent(new Event(\"change\", { bubbles: true, cancelable: true }))\n   133→      }\n   134→    }, 0)\n   135→  }, [])\n   136→\n   137→  const submit = useCallback(() => {\n   138→    inputElRef.current?.form?.dispatchEvent(new Event(\"submit\", { bubbles: true, cancelable: true }))\n   139→  }, [])\n   140→\n   141→  const cancel = useCallback(\n   142→    (ref?: string) => {\n   143→      if (ref) {\n   144→        live.pushEvent(\"cancel-upload\", { ref })\n   145→      } else {\n   146→        const currentEntries = configRef.current.entries || []\n   147→        currentEntries.forEach(entry => {\n   148→          live.pushEvent(\"cancel-upload\", { ref: entry.ref })\n   149→        })\n   150→      }\n   151→    },\n   152→    [live],\n   153→  )\n   154→\n   155→  const clear = useCallback(() => {\n   156→    if (inputElRef.current) {\n   157→      inputElRef.current.value = \"\"\n   158→    }\n   159→  }, [])\n   160→\n   161→  return {\n   162→    entries,\n   163→    showFilePicker,\n   164→    addFiles,\n   165→    submit,\n   166→    cancel,\n   167→    clear,\n   168→    progress,\n   169→    inputEl: inputElRef.current,\n   170→    valid,\n   171→  }\n   172→}\n   173→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01SRAYcugjF8V87a6iUDUTu3","session_id":"d5cbf92b-6106-41f2-ab9b-5f76d18aa231","uuid":"389b7b03-57a3-4b0d-8700-af3a918accbc"}
