{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CmSaxHcGigLUroCvpRhs9e","type":"tool_result","content":"     1→import { createApp, createSSRApp, h, reactive, type App, type Plugin } from \"vue\"\n     2→import type { FrameworkRenderer, MountContext, RendererState, SSRContext as RendererSSRContext } from \"../renderer.js\"\n     3→import { applyPatch, type Operation } from \"../jsonPatch.js\"\n     4→import { liveInjectKey } from \"../use.js\"\n     5→import { mapValues } from \"../utils.js\"\n     6→\n     7→type VueApp = App<Element>\n     8→\n     9→/**\n    10→ * Convert slot name -> HTML string into Vue slot functions.\n    11→ * Each slot renders as a div with innerHTML set to the decoded HTML.\n    12→ */\n    13→function htmlSlotsToVue(slots: Record<string, string>): Record<string, () => any> {\n    14→  return mapValues(slots, html => () => h(\"div\", { innerHTML: html.trim() }))\n    15→}\n    16→\n    17→/**\n    18→ * The default Vue setup function. Creates a Vue app, installs the LiveVite\n    19→ * plugin, and mounts it. Users can override this via `createLiveVite({ setup })`.\n    20→ */\n    21→export const defaultVueSetup = (\n    22→  makeApp: typeof createApp | typeof createSSRApp,\n    23→  component: any,\n    24→  props: Record<string, any>,\n    25→  slots: Record<string, () => any>,\n    26→  plugin: Plugin<[]>,\n    27→  el: Element,\n    28→): VueApp => {\n    29→  const app = makeApp({ render: () => h(component, props, slots) })\n    30→  app.use(plugin)\n    31→  app.mount(el)\n    32→  return app\n    33→}\n    34→\n    35→export type VueSetupFn = (\n    36→  makeApp: typeof createApp | typeof createSSRApp,\n    37→  component: any,\n    38→  props: Record<string, any>,\n    39→  slots: Record<string, () => any>,\n    40→  plugin: Plugin<[]>,\n    41→  el: Element,\n    42→  ssr: boolean,\n    43→) => VueApp\n    44→\n    45→export interface VueRendererOptions {\n    46→  /** Custom setup function for creating t