{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Aj5SxCrs2gAadCo2NkyPzm","type":"tool_result","content":"     1→import fsMod from 'node:fs';\n     2→import type { AddressInfo } from 'node:net';\n     3→import { fileURLToPath } from 'node:url';\n     4→import colors from 'piccolore';\n     5→import type { InlineConfig, ViteDevServer } from 'vite';\n     6→import { mergeConfig as mergeViteConfig } from 'vite';\n     7→import astroIntegrationActionsRouteHandler from '../actions/integration.js';\n     8→import { isActionsFilePresent } from '../actions/utils.js';\n     9→import { CONTENT_LAYER_TYPE } from '../content/consts.js';\n    10→import { globalContentLayer } from '../content/content-layer.js';\n    11→import { globalContentConfigObserver } from '../content/utils.js';\n    12→import type { SerializedSSRManifest } from '../core/app/types.js';\n    13→import type { PageBuildData } from '../core/build/types.js';\n    14→import { buildClientDirectiveEntrypoint } from '../core/client-directive/index.js';\n    15→import { mergeConfig } from '../core/config/merge.js';\n    16→import { validateConfigRefined } from '../core/config/validate.js';\n    17→import { validateSetAdapter } from '../core/dev/adapter-validation.js';\n    18→import type { AstroIntegrationLogger, Logger } from '../core/logger/core.js';\n    19→import { getRouteGenerator } from '../core/routing/manifest/generator.js';\n    20→import { getClientOutputDirectory } from '../prerender/utils.js';\n    21→import type { AstroSettings } from '../types/astro.js';\n    22→import type { AstroConfig } from '../types/public/config.js';\n    23→import type {\n    24→\tContentEntryType,\n    25→\tDataEntryType,\n    26→\tRefreshContentOptions,\n    27→} from '../types/public/content.js';\n    28→import type {\n    29→\tAstroIntegration,\n    30→\tAstroRenderer,\n    31→\tBaseIntegrationHooks,\n    32→\tHookParameters,\n    33→\tIntegrationResolvedRoute,\n    34→\tRouteOptions,\n    35→\tRouteToHeaders,\n    36→} from '../types/public/integrations.js';\n    37→import type { RouteData } from '../types/public/internal.js';\n    38→import { validateSupportedFeatures } from './features-validation.js';\n    39→\n    40→async function withTakingALongTimeMsg<T>({\n    41→\tname,\n    42→\thookName,\n    43→\thookFn,\n    44→\tlogger,\n    45→\tintegrationLogger,\n    46→}: {\n    47→\tname: string;\n    48→\thookName: keyof BaseIntegrationHooks;\n    49→\thookFn: () => T | Promise<T>;\n    50→\tlogger: Logger;\n    51→\tintegrationLogger: AstroIntegrationLogger;\n    52→}): Promise<T> {\n    53→\tconst timeout = setTimeout(() => {\n    54→\t\tlogger.info(\n    55→\t\t\t'build',\n    56→\t\t\t`Waiting for integration ${colors.bold(JSON.stringify(name))}, hook ${colors.bold(\n    57→\t\t\t\tJSON.stringify(hookName),\n    58→\t\t\t)}...`,\n    59→\t\t);\n    60→\t}, 3000);\n    61→\ttry {\n    62→\t\treturn await hookFn();\n    63→\t} catch (err) {\n    64→\t\tintegrationLogger.error(\n    65→\t\t\t`An unhandled error occurred while running the ${colors.bold(JSON.stringify(hookName))} hook`,\n    66→\t\t);\n    67→\t\tthrow err;\n    68→\t} finally {\n    69→\t\tclearTimeout(timeout);\n    70→\t}\n    71→}\n    72→\n    73→/** Executes the specified hook of the integration if present, and handles loggers */\n    74→async function runHookInternal<THook extends keyof BaseIntegrationHooks>({\n    75→\tintegration,\n    76→\thookName,\n    77→\tlogger,\n    78→\tparams,\n    79→}: {\n    80→\tintegration: AstroIntegration;\n    81→\thookName: THook;\n    82→\tlogger: Logger;\n    83→\tparams: () => Omit<HookParameters<NoInfer<THook>>, 'logger'>;\n    84→}) {\n    85→\tconst hook = integration?.hooks?.[hookName];\n    86→\tconst integrationLogger = getLogger(integration, logger);\n    87→\tif (hook) {\n    88→\t\tawait withTakingALongTimeMsg({\n    89→\t\t\tname: integration.name,\n    90→\t\t\thookName,\n    91→\t\t\thookFn: () => hook(Object.assign(params(), { logger: integrationLogger }) as any),\n    92→\t\t\tlogger,\n    93→\t\t\tintegrationLogger,\n    94→\t\t});\n    95→\t}\n    96→\treturn { integrationLogger };\n    97→}\n    98→\n    99→// Used internally to store instances of loggers.\n   100→const Loggers = new WeakMap<AstroIntegration, AstroIntegrationLogger>();\n   101→\n   102→function getLogger(integration: AstroIntegration, logger: Logger) {\n   103→\tif (Loggers.has(integration)) {\n   104→\t\t// SAFETY: we check the existence in the if block\n   105→\t\treturn Loggers.get(integration)!;\n   106→\t}\n   107→\tconst integrationLogger = logger.forkIntegrationLogger(integration.name);\n   108→\tLoggers.set(integration, integrationLogger);\n   109→\treturn integrationLogger;\n   110→}\n   111→\n   112→const serverEventPrefix = 'astro-dev-toolbar';\n   113→\n   114→export function getToolbarServerCommunicationHelpers(server: ViteDevServer) {\n   115→\treturn {\n   116→\t\t/**\n   117→\t\t * Send a message to the dev toolbar that an app can listen for. The payload can be any serializable data.\n   118→\t\t * @param event - The event name\n   119→\t\t * @param payload - The payload to send\n   120→\t\t */\n   121→\t\tsend: <T>(event: string, payload: T) => {\n   122→\t\t\tserver.environments.client.hot.send(event, payload);\n   123→\t\t},\n   124→\t\t/**\n   125→\t\t * Receive a message from a dev toolbar app.\n   126→\t\t * @param event\n   127→\t\t * @param callback\n   128→\t\t */\n   129→\t\ton: <T>(event: string, callback: (data: T) => void) => {\n   130→\t\t\tserver.hot.on(event, callback);\n   131→\t\t},\n   132→\t\t/**\n   133→\t\t * Fired when an app is initialized.\n   134→\t\t * @param appId - The id of the app that was initialized\n   135→\t\t * @param callback - The callback to run when the app is initialized\n   136→\t\t */\n   137→\t\tonAppInitialized: (appId: string, callback: (data: Record<string, never>) => void) => {\n   138→\t\t\tserver.hot.on(`${serverEventPrefix}:${appId}:initialized`, callback);\n   139→\t\t},\n   140→\t\t/**\n   141→\t\t * Fired when an app is toggled on or off.\n   142→\t\t * @param appId - The id of the app that was toggled\n   143→\t\t * @param callback - The callback to run when the app is toggled\n   144→\t\t */\n   145→\t\tonAppToggled: (appId: string, callback: (data: { state: boolean }) => void) => {\n   146→\t\t\tserver.hot.on(`${serverEventPrefix}:${appId}:toggled`, callback);\n   147→\t\t},\n   148→\t};\n   149→}\n   150→\n   151→// Will match any invalid characters (will be converted to _). We only allow a-zA-Z0-9.-_\n   152→const SAFE_CHARS_RE = /[^\\w.-]/g;\n   153→\n   154→export function normalizeCodegenDir(integrationName: string): string {\n   155→\treturn `./integrations/${integrationName.replace(SAFE_CHARS_RE, '_')}/`;\n   156→}\n   157→\n   158→export function normalizeInjectedTypeFilename(filename: string, integrationName: string): string {\n   159→\tif (!filename.endsWith('.d.ts')) {\n   160→\t\tthrow new Error(\n   161→\t\t\t`Integration ${colors.bold(integrationName)} is injecting a type that does not end with \"${colors.bold('.d.ts')}\"`,\n   162→\t\t);\n   163→\t}\n   164→\treturn `${normalizeCodegenDir(integrationName)}${filename.replace(SAFE_CHARS_RE, '_')}`;\n   165→}\n   166→\n   167→interface RunHookConfigSetup {\n   168→\tsettings: AstroSettings;\n   169→\tcommand: 'dev' | 'build' | 'preview' | 'sync';\n   170→\tlogger: Logger;\n   171→\tisRestart?: boolean;\n   172→\tfs?: typeof fsMod;\n   173→}\n   174→\n   175→export async function runHookConfigSetup({\n   176→\tsettings,\n   177→\tcommand,\n   178→\tlogger,\n   179→\tisRestart = false,\n   180→\tfs = fsMod,\n   181→}: RunHookConfigSetup): Promise<AstroSettings> {\n   182→\t// An adapter is an integration, so if one is provided add it to the list of integrations.\n   183→\tif (settings.config.adapter) {\n   184→\t\tsettings.config.integrations.unshift(settings.config.adapter);\n   185→\t}\n   186→\tconst actionsFilename = await isActionsFilePresent(fs, settings.config.srcDir);\n   187→\tif (actionsFilename) {\n   188→\t\tsettings.config.integrations.push(\n   189→\t\t\tastroIntegrationActionsRouteHandler({ settings, filename: actionsFilename }),\n   190→\t\t);\n   191→\t}\n   192→\n   193→\tlet updatedConfig: AstroConfig = { ...settings.config };\n   194→\tlet updatedSettings: AstroSettings = { ...settings, config: updatedConfig };\n   195→\tlet addedClientDirectives = new Map<string, Promise<string>>();\n   196→\tlet astroJSXRenderer: AstroRenderer | null = null;\n   197→\n   198→\t// eslint-disable-next-line @typescript-eslint/prefer-for-of -- We need a for loop to be able to read integrations pushed while the loop is running.\n   199→\tfor (let i = 0; i < updatedConfig.integrations.length; i++) {\n   200→\t\tconst integration = updatedConfig.integrations[i];\n   201→\n   202→\t\t/**\n   203→\t\t * By making integration hooks optional, Astro can now ignore null or undefined Integrations\n   204→\t\t * instead of giving an internal error most people can't read\n   205→\t\t *\n   206→\t\t * This also enables optional integrations, e.g.\n   207→\t\t * ```ts\n   208→\t\t * integration: [\n   209→\t\t *   // Only run `compress` integration in production environments, etc...\n   210→\t\t *   import.meta.env.production ? compress() : null\n   211→\t\t * ]\n   212→\t\t * ```\n   213→\t\t */\n   214→\n   215→\t\tconst { integrationLogger } = await runHookInternal({\n   216→\t\t\tintegration,\n   217→\t\t\thookName: 'astro:config:setup',\n   218→\t\t\tlogger,\n   219→\t\t\tparams: () => {\n   220→\t\t\t\tconst hooks: Omit<HookParameters<'astro:config:setup'>, 'logger'> = {\n   221→\t\t\t\t\tconfig: updatedConfig,\n   222→\t\t\t\t\tcommand,\n   223→\t\t\t\t\tisRestart,\n   224→\t\t\t\t\taddRenderer(renderer: AstroRenderer) {\n   225→\t\t\t\t\t\tif (!renderer.name) {\n   226→\t\t\t\t\t\t\tthrow new Error(\n   227→\t\t\t\t\t\t\t\t`Integration ${colors.bold(integration.name)} has an unnamed renderer.`,\n   228→\t\t\t\t\t\t\t);\n   229→\t\t\t\t\t\t}\n   230→\n   231→\t\t\t\t\t\tif (!renderer.serverEntrypoint) {\n   232→\t\t\t\t\t\t\tthrow new Error(\n   233→\t\t\t\t\t\t\t\t`Renderer ${colors.bold(renderer.name)} does not provide a serverEntrypoint.`,\n   234→\t\t\t\t\t\t\t);\n   235→\t\t\t\t\t\t}\n   236→\n   237→\t\t\t\t\t\tif (renderer.name === 'astro:jsx') {\n   238→\t\t\t\t\t\t\tastroJSXRenderer = renderer;\n   239→\t\t\t\t\t\t} else {\n   240→\t\t\t\t\t\t\tupdatedSettings.renderers.push(renderer);\n   241→\t\t\t\t\t\t}\n   242→\t\t\t\t\t},\n   243→\t\t\t\t\tinjectScript: (stage, content) => {\n   244→\t\t\t\t\t\tupdatedSettings.scripts.push({ stage, content });\n   245→\t\t\t\t\t},\n   246→\t\t\t\t\tupdateConfig: (newConfig) => {\n   247→\t\t\t\t\t\tupdatedConfig = mergeConfig(updatedConfig, newConfig);\n   248→\t\t\t\t\t\treturn { ...updatedConfig };\n   249→\t\t\t\t\t},\n   250→\t\t\t\t\tinjectRoute: (injectRoute) => {\n   251→\t\t\t\t\t\tif (injectRoute.entrypoint == null && 'entryPoint' in injectRoute) {\n   252→\t\t\t\t\t\t\tlogger.warn(\n   253→\t\t\t\t\t\t\t\tnull,\n   254→\t\t\t\t\t\t\t\t`The injected route \"${injectRoute.pattern}\" by ${integration.name} specifies the entry point with the \"entryPoint\" property. This property is deprecated, please use \"entrypoint\" instead.`,\n   255→\t\t\t\t\t\t\t);\n   256→\t\t\t\t\t\t\tinjectRoute.entrypoint = injectRoute.entryPoint as string;\n   257→\t\t\t\t\t\t}\n   258→\t\t\t\t\t\tupdatedSettings.injectedRoutes.push({ ...injectRoute, origin: 'external' });\n   259→\t\t\t\t\t},\n   260→\t\t\t\t\taddWatchFile: (path) => {\n   261→\t\t\t\t\t\tupdatedSettings.watchFiles.push(path instanceof URL ? fileURLToPath(path) : path);\n   262→\t\t\t\t\t},\n   263→\t\t\t\t\taddDevToolbarApp: (entrypoint) => {\n   264→\t\t\t\t\t\tupdatedSettings.devToolbarApps.push(entrypoint);\n   265→\t\t\t\t\t},\n   266→\t\t\t\t\taddClientDirective: ({ name, entrypoint }) => {\n   267→\t\t\t\t\t\tif (updatedSettings.clientDirectives.has(name) || addedClientDire