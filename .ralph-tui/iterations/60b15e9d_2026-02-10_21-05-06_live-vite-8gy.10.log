ow new Error(\"Vue setup function did not return an app!\")\n    94→\n    95→      return { props, slots, app }\n    96→    },\n    97→\n    98→    updateProps(state: RendererState<VueApp>, newProps: Record<string, any>): void {\n    99→      Object.assign(state.props, newProps)\n   100→    },\n   101→\n   102→    patchProps(state: RendererState<VueApp>, operations: Operation[]): void {\n   103→      applyPatch(state.props, operations)\n   104→    },\n   105→\n   106→    updateSlots(state: RendererState<VueApp>, newSlots: Record<string, string>): void {\n   107→      Object.assign(state.slots, htmlSlotsToVue(newSlots))\n   108→    },\n   109→\n   110→    unmount(state: RendererState<VueApp>): void {\n   111→      if (state.app) {\n   112→        window.addEventListener(\"phx:page-loading-stop\", () => state.app!.unmount(), { once: true })\n   113→      }\n   114→    },\n   115→\n   116→    async renderToString(ctx: RendererSSRContext): Promise<string> {\n   117→      // Dynamic import to avoid bundling server-only deps in client builds\n   118→      const { renderToString: vueRenderToString } = await import(\"vue/server-renderer\")\n   119→\n   120→      const component = ctx.component\n   121→      const slotComponents = htmlSlotsToVue(ctx.slots)\n   122→\n   123→      const ssrSetup = options.setup ?? ((makeApp, component, props, slots, plugin, el) => {\n   124→        const app = makeApp({ render: () => h(component, props, slots) })\n   125→        app.use(plugin)\n   126→        // Don't mount in SSR - no real DOM\n   127→        return app\n   128→      })\n   129→\n   130→      const plugin: Plugin<[]> = {\n   131→        install: (app: App) => {\n   132→          app.mount = (...args: unknown[]): any => undefined\n   133→          app.provide(\"_live_vite\", Object.assign({}, mockHook))\n   134→        },\n   135→      }\n   136→\n   137→      const app = ssrSetup(createSSRApp, component, ctx.props, slotComponents, plugin, {} as Element, true)\n   138→\n   13