f)\\n   544→      const nameField = form.field(\\\"name\\\")\\n   545→\\n   546→      nameField.value.value = \\\"Jane Doe\\\"\\n   547→      await nextTick()\\n   548→      expect(form.isDirty.value).toBe(true)\\n   549→\\n   550→      form.reset()\\n   551→      await nextTick()\\n   552→      expect(form.isDirty.value).toBe(false)\\n   553→    })\\n   554→  })\\n   555→\\n   556→  describe(\\\"array field creation\\\", () => {\\n   557→    it(\\\"should create array field with proper methods\\\", () => {\\n   558→      const formRef = createFormRef()\\n   559→      const form = createFormInScope(formRef)\\n   560→      const skillsArray = form.fieldArray(\\\"profile.skills\\\")\\n   561→\\n   562→      expect(skillsArray.value.value).toEqual([\\\"JavaScript\\\", \\\"TypeScript\\\"])\\n   563→      expect(skillsArray.fields.value).toHaveLength(2)\\n   564→      expect(skillsArray.fields.value[0].value.value).toBe(\\\"JavaScript\\\")\\n   565→      expect(skillsArray.fields.value[1].value.value).toBe(\\\"TypeScript\\\")\\n   566→    })\\n   567→\\n   568→    it(\\\"should add items to array\\\", async () => {\\n   569→      const formRef = createFormRef()\\n   570→      const form = createFormInScope(formRef)\\n   571→      const skillsArray = form.fieldArray(\\\"profile.skills\\\")\\n   572→\\n   573→      skillsArray.add(\\\"Vue.js\\\")\\n   574→      await nextTick()\\n   575→\\n   576→      expect(skillsArray.value.value).toEqual([\\\"JavaScript\\\", \\\"TypeScript\\\", \\\"Vue.js\\\"])\\n   577→      expect(skillsArray.fields.value).toHaveLength(3)\\n   578→    })\\n   579→\\n   580→    it(\\\"should remove items from array\\\", async () => {\\n   581→      const formRef = createFormRef()\\n   582→      const form = createFormInScope(formRef)\\n   583→      const skillsArray = form.fieldArray(\\\"profile.skills\\\")\\n   584→\\n   585→      skillsArray.remove(0)\\n   586→      await nextTick()\\n   587→\\n   588→      expect(skillsArray.value.value).toEqual([\\\"TypeScript\\\"])\\n   589→      expect(skillsArray.fields.value).toHaveLength(1)\\n   590→    })\\n   591→\\n   592→    it(\\\"should move items in array\\\", async () => {\\n   593→      const formRef = createFormRef()\\n   594→      const form = createFormInScope(formRef)\\n   595→      const skillsArray = form.fieldArray(\\\"profile.skills\\\")\\n   596→\\n   597→      skillsArray.move(0, 1)\\n   598→      await nextTick()\\n   599→\\n   600→      expect(skillsArray.value.value).toEqual([\\\"TypeScript\\\", \\\"JavaScript\\\"])\\n   601→    })\\n   602→\\n   603→    it(\\\"should handle complex nested array operations\\\", async () => {\\n   604→      const formRef = createFormRef()\\n   605→      const form = createFormInScope(formRef)\\n   606→      const itemsArray = form.fieldArray(\\\"items\\\")\\n   607→\\n   608→      expect(itemsArray.fields.value).toHaveLength(2)\\n   609→      expect(itemsArray.fields.value[0].field(\\\"name\\\").value.value).toBe(\\\"Item 1\\\")\\n   610→      expect(itemsArray.fields.value[1].field(\\\"name\\\").value.value).toBe(\\\"Item 2\\\")\\n   611→\\n   612→      // Add new item\\n   613→      itemsArray.add({ name: \\\"Item 3\\\", tags: [\\\"tag4\\\"] })\\n   614→      await nextTick()\\n   615→\\n   616→      expect(itemsArray.fields.value).toHaveLength(3)\\n   617→      expect(itemsArray.fields.value[2].field(\\\"name\\\").value.value).toBe(\\\"Item 3\\\")\\n   618→\\n   619→      // Test field and fieldArray methods on array items\\n   620→      const secondItem = itemsArray.field(\\\"[1].name\\\")\\n   621→      expect(secondItem.value.value).toBe(\\\"Item 2\\\")\\n   622→\\n   623→      const firstItemTags = itemsArray.fieldArray(\\\"[0].tags\\\")\\n   624→      expect(firstItemTags.value.value).toEqual([\\\"tag1\\\", \\\"tag2\\\"])\\n   625→    })\\n   626→\\n   627→    it(\\\"should maintain reactivity when array items are modified\\\", async () => {\\n   628→      const formRef = createFormRef()\\n   629→      const form = createFormInScope(formRef)\\n   630→      const itemsArray = form.fieldArray(\\\"items\\\")\\n   631→\\n   632→      // Modify first item's name\\n   633→      const firstItemNameField = itemsArray.fields.value[0].field(\\\"name\\\")\\n   634→      firstItemNameField.value.value = \\\"Modified Item 1\\\"\\n   635→      await nextTick()\\n   636→\\n   637→      // Check that the change is reflected in multiple ways of accessing the same field\\n   638→      expect(itemsArray.field(\\\"[0].name\\\").value.value).toBe(\\\"Modified Item 1\\\")\\n   639→      expect(itemsArray.field(0).field(\\\"name\\\").value.value).toBe(\\\"Modified Item 1\\\")\\n   640→      expect(form.field(\\\"items[0].name\\\").value.value).toBe(\\\"Modified Item 1\\\")\\n   641→    })\\n   642→\\n   643→    it(\\\"should handle array move operations correctly\\\", async () => {\\n   644→      const formRef = createFormRef()\\n   645→      const form = createFormInScope(formRef)\\n   646→      const skillsArray = form.fieldArray(\\\"profile.skills\\\")\\n   647→\\n   648→      expect(skillsArray.value.value).toEqual([\\\"JavaScript\\\", \\\"TypeScript\\\"])\\n   649→\\n   650→      skillsArray.move(0, 1)\\n   651→      await nextTick()\\n   652→\\n   653→      expect(skillsArray.value.value).toEqual([\\\"TypeScript\\\", \\\"JavaScript\\\"])\\n   654→      expect(skillsArray.fields.value[0].value.value).toBe(\\\"TypeScript\\\")\\n   655→      expect(skillsArray.fields.value[1].value.value).toBe(\\\"JavaScript\\\")\\n   656→    })\\n   657→\\n   658→    it(\\\"should track dirty state for array operations\\\", async () => {\\n   659→      const formRef = createFormRef()\\n   660→      const form = createFormInScope(formRef)\\n   661→      const skillsArray = form.fieldArray(\\\"profile.skills\\\")\\n   662→\\n   663→      expect(skillsArray.isDirty.value).toBe(false)\\n   664→      expect(form.isDirty.value).toBe(false)\\n   665→\\n   666→      skillsArray.add(\\\"Vue.js\\\")\\n   667→      await nextTick()\\n   668→\\n   669→      expect(skillsArray.isDirty.value).toBe(true)\\n   670→      expect(form.isDirty.value).toBe(true)\\n   671→\\n   672→      // Remove the added item to restore original state\\n   673→      skillsArray.remove(2)\\n   674→      await nextTick()\\n   675→\\n   676→      expect(skillsArray.isDirty.value).toBe(false)\\n   677→      expect(form.isDirty.value).toBe(false)\\n   678→    })\\n   679→\\n   680→    it(\\\"should handle array validation errors\\\", () => {\\n   681→      const formRef = createFormRef({\\n   682→        errors: {\\n   683→          items: [\\n   684→            { name: [\\\"First item name is required\\\"], tags: [] },\\n   685→            { name: [], tags: [[\\\"Invalid tag format\\\"]] },\\n   686→          ],\\n   687→        },\\n   688→      })\\n   689→\\n   690→      const form = createFormInScope(formRef)\\n   691→      const itemsArray = form.fieldArray(\\\"items\\\")\\n   692→\\n   693→      expect(form.isValid.value).toBe(false)\\n   694→      expect(itemsArray.isValid.value).toBe(false)\\n   695→\\n   696→      const firstItemName = itemsArray.field(\\\"[0].name\\\")\\n   697→      expect(firstItemName.errors.value).toEqual([\\\"First item name is required\\\"])\\n   698→      expect(firstItemName.isValid.value).toBe(false)\\n   699→\\n   700→      const secondItemTags = itemsArray.fieldArray(\\\"[1].tags\\\")\\n   701→      expect(secondItemTags.errors.value).toEqual([[\\\"Invalid tag format\\\"]])\\n   702→      expect(secondItemTags.isValid.value).toBe(false)\\n   703→\\n   704→      const secondItemTagsFirstTag = secondItemTags.field(0)\\n   705→      expect(secondItemTagsFirstTag.errors.value).toEqual([\\\"Invalid tag format\\\"])\\n   706→      expect(secondItemTagsFirstTag.isValid.value).toBe(false)\\n   707→    })\\n   708→\\n   709→    it(\\\"should support both string paths and number shortcuts in array field API\\\", () => {\\n   710→      const formRef = createFormRef()\\n   711→      const form = createFormInScope(formRef)\\n   712→      const itemsArray = form.fieldArray(\\\"items\\\")\\n   713→\\n   714→      // Test string path syntax\\n   715→      const firstItemNameByStringPath = itemsArray.field(\\\"[0].name\\\")\\n   716→      expect(firstItemNameByStringPath.value.value).toBe(\\\"Item 1\\\")\\n   717→\\n   718→      const firstItemTagsByStringPath = itemsArray.fieldArray(\\\"[0].tags\\\")\\n   719→      expect(firstItemTagsByStringPath.value.value).toEqual([\\\"tag1\\\", \\\"tag2\\\"])\\n   720→\\n   721→      // Test number shortcut syntax (equivalent to \\\"[0]\\\")\\n   722→      const firstItemByNumber = itemsArray.field(0)\\n   723→      expect(firstItemByNumber.field(\\\"name\\\").value.value).toBe(\\\"Item 1\\\")\\n   724→\\n   725→      const firstItemTagsArrayByNumber = itemsArray.field(0).fieldArray(\\\"tags\\\")\\n   726→      expect(firstItemTagsArrayByNumber.value.value).toEqual([\\\"tag1\\\", \\\"tag2\\\"])\\n   727→\\n   728→      // Both approaches should access the same underlying field\\n   729→      expect(firstItemNameByStringPath.value.value).toBe(firstItemByNumber.field(\\\"name\\\").value.value)\\n   730→    })\\n   731→  })\\n   732→\\n   733→  describe(\\\"integration tests - LiveView form lifecycle\\\", () => {\\n   734→    it(\\\"should follow complete form lifecycle: initial -> update -> validate -> server response\\\", async () => {\\n   735→      // 1. Initial state - form is valid with no errors\\n   736→      const formRef = createFormRef()\\n   737→      const form = createFormInScope(formRef, {\\n   738→        changeEvent: \\\"validate\\\",\\n   739→        debounceInMiliseconds: 100,\\n   740→      })\\n   741→\\n   742→      const nameField = form.field(\\\"name\\\")\\n   743→\\n   744→      // Assert initial state\\n   745→      expect(nameField.value.value).toBe(\\\"John Doe\\\")\\n   746→      expect(nameField.errors.value).toEqual([])\\n   747→      expect(form.isValid.value).toBe(true)\\n   748→      expect(form.isDirty.value).toBe(false)\\n   749→\\n   750→      // 2. User updates field (simulating active editing)\\n   751→      nameField.value.value = \\\"Jane Smith\\\"\\n   752→      await nextTick()\\n   753→\\n   754→      expect(form.isDirty.value).toBe(true)\\n   755→\\n   756→      // 3. Wait for debounced validation event to be sent\\n   757→      await new Promise(resolve => setTimeout(resolve, 150))\\n   758→\\n   759→      expect(mockLiveVue.pushEvent).toHaveBeenCalledWith(\\\"validate\\\", {\\n   760→        test_form: expect.objectContaining({\\n   761→          name: \\\"Jane Smith\\\",\\n   762→          email: \\\"john@example.com\\\",\\n   763→        }),\\n   764→      }, expect.any(Function))\\n   765→\\n   766→      // 4. Server responds with updated values and validation errors\\n   767→      formRef.value = {\\n   768→        ...formRef.value,\\n   769→        values: {\\n   770→          ...formRef.value.values,\\n   771→          name: \\\"Jane Smith\\\",\\n   772→          email: \\\"john@example.com\\\",\\n   773→        },\\n   774→        errors: {\\n   775→          name: [\\\"Name must be at least 3 characters\\\"],\\n   776→        } as unknown as FormErrors<TestForm>,\\n   777→      }\\n   778→\\n   779→      await nextTick()\\n   780→      // Wait a bit more for debounced execution to fully complete\\n   781→      await new Promise(resolve => setTimeout(resolve, 50))\\n   782→\\n   783→      // Field should now show server error\\n   784→      expect(nameField.errors.value).toEqual([\\\"Name must be at least 3 characters\\\"])\\n   785→      expect(nameField.isValid.value).toBe(false)\\n   786→      expect(form.isValid.value).toBe(false)\\n   787→\\n   788→      // With \\\"last update wins\\\", server response overwrites user edit (server sent original values + errors)\\n   789→      expect(nameField.value.value).toBe(\\\"Jane Smith\\\")\\n   790→    })\\n   791→\\n   792→    it(\\\"should handle form submission with server validation\\\", async () => {\\n   793→      const formRef = createFormRef()\\n   794→      const form = createFormInScope(formRef, {\\n   795→        submitEvent: \\\"submit_form\\\",\\n   796→      })\\n   797→\\n   798→      // Submit the form\\n   799→      await form.submit()\\n   800→\\n   801→      expect(mockLiveVue.pushEvent).toHaveBeenCalledWith(\\\"submit_form\\\", {\\n   802→        test_form: expect.objectContaining({\\n   803→          name: \\\"John Doe\\\",\\n   804→          email: \\\"john@example.com\\\",\\n   805→        }),\\n   806→      }, expect.any(Function))\\n   807→    })\\n   808→\\n   809→    it(\\\"should use prepareData function before sending to server\\\", async () => {\\n   810→      const formRef = createFormRef()\\n   811→      const prepareData = vi.fn(data => ({ transformed: data }))\\n   812→      const form = createFormInScope(formRef, { prepareData })\\n   813→\\n   814→      const nameField = form.field(\\\"name\\\")\\n   815→      nameField.value.value = \\\"Modified Name\\\"\\n   816→\\n   817→      await form.submit()\\n   818→\\n   819→      expect(prepareData).toHaveBeenCalledWith(\\n   820→        expect.objectContaining({\\n   821→          name: \\\"Modified Name\\\",\\n   822→        })\\n   823→      )\\n   824→      expect(mockLiveVue.pushEvent).toHaveBeenCalledWith(\\\"submit\\\", {\\n   825→        test_form: { transformed: expect.objectContaining({ name: \\\"Modified Name\\\" }) },\\n   826→      }, expect.any(Function))\\n   827→    })\\n   828→\\n   829→    it(\\\"should handle cases when LiveView is not available\\\", async () => {\\n   830→      mockUseLiveVue.mockReturnValue(null)\\n   831→\\n   832→      const formRef = createFormRef()\\n   833→      const form = createFormInScope(formRef)\\n   834→\\n   835→      // Should not throw and should resolve\\n   836→      await expect(form.submit()).resolves.toBeUndefined()\\n   837→    })\\n   838→\\n   839→    it(\\\"should update all fields reactively when server form changes\\\", async () => {\\n   840→      const formRef = createFormRef()\\n   841→      const form = createFormInScope(formRef)\\n   842→\\n   843→      const nameField = form.field(\\\"name\\\")\\n   844→      const emailField = form.field(\\\"email\\\")\\n   845→      const bioField = form.field(\\\"profile.bio\\\")\\n   846→      const itemNameField = form.field(\\\"items[0].name\\\")\\n   847→\\n   848→      // Initial values\\n   849→      expect(nameField.value.value).toBe(\\\"John Doe\\\")\\n   850→      expect(emailField.value.value).toBe(\\\"john@example.com\\\")\\n   851→      expect(bioField.value.value).toBe(\\\"Software developer\\\")\\n   852→      expect(itemNameField.value.value).toBe(\\\"Item 1\\\")\\n   853→      expect(nameField.errors.value).toEqual([])\\n   854→\\n   855→      // Update the reactive form (simulating server update with new values and errors)\\n   856→      formRef.value = {\\n   857→        name: \\\"updated_form\\\",\\n   858→        values: {\\n   859→          name: \\\"Jane Smith\\\",\\n   860→          email: \\\"jane@example.com\\\",\\n   861→          age: 25,\\n   862→          profile: {\\n   863→            bio: \\\"Product designer\\\",\\n   864→            skills: [\\\"Figma\\\", \\\"Sketch\\\"],\\n   865→          },\\n   866→          items: [\\n   867→            { name: \\\"Design mockups\\\", tags: [\\\"ui\\\", \\\"ux\\\"] },\\n   868→            { name: \\\"User research\\\", tags: [\\\"research\\\"] },\\n   869→          ],\\n   870→        },\\n   871→        errors: {\\n   872→          name: [\\\"Name already taken\\\"],\\n   873→          email: [],\\n   874→        } as unknown as FormErrors<TestForm>,\\n   875→        valid: false,\\n   876→      }\\n   877→\\n   878→      await nextTick()\\n   879→      // Wait a bit for any pending validation to complete\\n   880→      await new Promise(resolve => setTimeout(resolve, 50))\\n   881→\\n   882→      // All fields should be updated\\n   883→      expect(nameField.value.value).toBe(\\\"Jane Smith\\\")\\n   884→      expect(emailField.value.value).toBe(\\\"jane@example.com\\\")\\n   885→      expect(bioField.value.value).toBe(\\\"Product designer\\\")\\n   886→      expect(itemNameField.value.value).toBe(\\\"Design mockups\\\")\\n   887→\\n   888→      // Errors should be updated\\n   889→      expect(nameField.errors.value).toEqual([\\\"Name already taken\\\"])\\n   890→      expect(emailField.errors.value).toEqual([])\\n   891→    })\\n   892→\\n   893→    it(\\\"should properly debounce validation events during typing\\\", async () => {\\n   894→      const formRef = createFormRef()\\n   895→      const form = createFormInScope(formRef, {\\n   896→        changeEvent: \\\"validate_field\\\",\\n   897→        debounceInMiliseconds: 10,\\n   898→      })\\n   899→\\n   900→      const nameField = form.field(\\\"name\\\")\\n   901→\\n   902→      // Simulate rapid typing\\n   903→      nameField.value.value = \\\"J\\\"\\n   904→      await nextTick()\\n   905→      nameField.value.value = \\\"Ja\\\"\\n   906→      await nextTick()\\n   907→      nameField.value.value = \\\"Jan\\\"\\n   908→      await nextTick()\\n   909→      nameField.value.value = \\\"Jane\\\"\\n   910→      await nextTick()\\n   911→\\n   912→      // Should not have sent any events yet\\n   913→      expect(mockLiveVue.pushEvent).not.toHaveBeenCalled()\\n   914→\\n   915→      // Wait for debounce delay\\n   916→      await new Promise(resolve => setTimeout(resolve, 15))\\n   917→\\n   918→      // Should have sent only one validation event with final value\\n   919→      expect(mockLiveVue.pushEvent).toHaveBeenCalledTimes(1)\\n   920→      expect(mockLiveVue.pushEvent).toHaveBeenCalledWith(\\\"validate_field\\\", {\\n   921→        test_form: expect.objectContaining({\\n   922→          name: \\\"Jane\\\",\\n   923→        }),\\n   924→      }, expect.any(Function))\\n   925→    })\\n   926→\\n   927→    it(\\\"should not send validation events when changeEvent is null\\\", async () => {\\n   928→      const formRef = createFormRef()\\n   929→      const form = createFormInScope(formRef, {\\n   930→        changeEvent: null, // Disable validation events\\n   931→        debounceInMiliseconds: 10,\\n   932→      })\\n   933→\\n   934→      const nameField = form.field(\\\"name\\\")\\n   935→      nameField.value.value = \\\"Modified Name\\\"\\n   936→      await nextTick()\\n   937→\\n   938→      // Wait for debounce delay\\n   939→      await new Promise(resolve => setTimeout(resolve, 15))\\n   940→\\n   941→      // Should not have sent any validation events\\n   942→      expect(mockLiveVue.pushEvent).not.toHaveBeenCalled()\\n   943→    })\\n   944→\\n   945→    it(\\\"should not send duplicate change events when server updates the form\\\", async () => {\\n   946→      const formRef = createFormRef()\\n   947→      const form = createFormInScope(formRef, {\\n   948→        changeEvent: \\\"validate\\\",\\n   949→        debounceInMiliseconds: 10,\\n   950→      })\\n   951→\\n   952→      const nameField = form.field(\\\"name\\\")\\n   953→\\n   954→      // Clear any initial calls\\n   955→      vi.clearAllMocks()\\n   956→\\n   957→      // User changes a field\\n   958→      nameField.value.value = \\\"John Updated\\\"\\n   959→      await nextTick()\\n   960→\\n   961→      // Wait for debounced change event\\n   962→      await new Promise(resolve => setTimeout(resolve, 15))\\n   963→\\n   964→      // Should have sent one change event\\n   965→      expect(mockLiveVue.pushEvent).toHaveBeenCalledTimes(1)\\n   966→      expect(mockLiveVue.pushEvent).toHaveBeenCalledWith(\\\"validate\\\", {\\n   967→        test_form: expect.objectContaining({\\n   968→          name: \\\"John Updated\\\",\\n   969→        }),\\n   970→      }, expect.any(Function))\\n   971→\\n   972→      // Clear the mock to track subsequent calls\\n   973→      vi.clearAllMocks()\\n   974→\\n   975→      // Server updates the form (simulating server response with updated values)\\n   976→      formRef.value = {\\n   977→        ...formRef.value,\\n   978→        values: {\\n   979→          ...formRef.value.values,\\n   980→          name: \\\"John Server Updated\\\",\\n   981→          email: \\\"updated@server.com\\\",\\n   982→        },\\n   983→      }\\n   984→\\n   985→      await nextTick()\\n   986→\\n   987→      // Wait for any potential debounced events\\n   988→      await new Promise(resolve => setTimeout(resolve, 15))\\n   989→\\n   990→      // Should NOT have sent any additional change events (this was the bug)\\n   991→      expect(mockLiveVue.pushEvent).not.toHaveBeenCalled()\\n   992→\\n   993→      // Verify the field was updated from server\\n   994→      expect(nameField.value.value).toBe(\\\"John Server Updated\\\")\\n   995→    })\\n   996→\\n   997→    it(\\\"should use form name as key in event payload instead of 'data'\\\", async () => {\\n   998→      const formRef = createFormRef({\\n   999→        name: \\\"user_form\\\", // Custom form name\\n  1000→      })\\n  1001→      const form = createFormInScope(formRef, {\\n  1002→        changeEvent: \\\"validate\\\",\\n  1003→        submitEvent: \\\"save\\\",\\n  1004→        debounceInMiliseconds: 10,\\n  1005→      })\\n  1006→\\n  1007→      const nameField = form.field(\\\"name\\\")\\n  1008→      nameField.value.value = \\\"New Name\\\"\\n  1009→      await nextTick()\\n  1010→\\n  1011→      // Wait for debounce delay for change event\\n  1012→      await new Promise(resolve => setTimeout(resolve, 15))\\n  1013→\\n  1014→      expect(mockLiveVue.pushEvent).toHaveBeenCalledWith(\\\"validate\\\", {\\n  1015→        user_form: expect.objectContaining({\\n  1016→          name: \\\"New Name\\\",\\n  1017→        }),\\n  1018→      }, expect.any(Function))\\n  1019→\\n  1020→      // Test submit event as well\\n  1021→      await form.submit()\\n  1022→\\n  1023→      expect(mockLiveVue.pushEvent).toHaveBeenCalledWith(\\\"save\\\", {\\n  1024→        user_form: expect.objectContaining({\\n  1025→          name: \\\"New Name\\\",\\n  1026→        }),\\n  1027→      }, expect.any(Function))\\n  1028→    })\\n  1029→\\n  1030→    it(\\\"should clear field errors when server removes them\\\", async () => {\\n  1031→      // Start with a form that has errors\\n  1032→      const formRef = createFormRef({\\n  1033→        errors: {\\n  1034→          name: [\\\"Name is required\\\"],\\n  1035→          email: [\\\"Invalid email format\\\"],\\n  1036→          profile: {\\n  1037→            bio: [\\\"Bio is too short\\\"],\\n  1038→          },\\n  1039→        },\\n  1040→      })\\n  1041→\\n  1042→      const form = createFormInScope(formRef)\\n  1043→      const nameField = form.field(\\\"name\\\")\\n  1044→      const emailField = form.field(\\\"email\\\")\\n  1045→      const bioField = form.field(\\\"profile.bio\\\")\\n  1046→\\n  1047→      // Verify initial error state\\n  1048→      expect(nameField.errors.value).toEqual([\\\"Name is required\\\"])\\n  1049→      expect(emailField.errors.value).toEqual([\\\"Invalid email format\\\"])\\n  1050→      expect(bioField.errors.value).toEqual([\\\"Bio is too short\\\"])\\n  1051→      expect(form.isValid.value).toBe(false)\\n  1052→\\n  1053→      // Server clears some errors (simulating successful validation)\\n  1054→      formRef.value = {\\n  1055→        ...formRef.value,\\n  1056→        errors: {\\n  1057→          email: [\\\"Invalid email format\\\"], // Keep email error\\n  1058→          // name and profile.bio errors are cleared (not present)\\n  1059→        } as unknown as FormErrors<TestForm>,\\n  1060→      }\\n  1061→\\n  1062→      await nextTick()\\n  1063→      // Wait a bit for any pending operations to complete\\n  1064→      await new Promise(resolve => setTimeout(resolve, 50))\\n  1065→\\n  1066→      // Cleared errors should now be empty arrays\\n  1067→      expect(nameField.errors.value).toEqual([])\\n  1068→      expect(bioField.errors.value).toEqual([])\\n  1069→      expect(nameField.isValid.value).toBe(true)\\n  1070→      expect(bioField.isValid.value).toBe(true)\\n  1071→\\n  1072→      // Remaining error should still be present\\n  1073→      expect(emailField.errors.value).toEqual([\\\"Invalid email format\\\"])\\n  1074→      expect(emailField.isValid.value).toBe(false)\\n  1075→\\n  1076→      // Form should be invalid due to remaining email error\\n  1077→      expect(form.isValid.value).toBe(false)\\n  1078→\\n  1079→      // Clear all errors\\n  1080→      formRef.value = {\\n  1081→        ...formRef.value,\\n  1082→        errors: {} as FormErrors<TestForm>,\\n  1083→      }\\n  1084→\\n  1085→      await nextTick()\\n  1086→      // Wait a bit for any pending operations to complete\\n  1087→      await new Promise(resolve => setTimeout(resolve, 50))\\n  1088→\\n  1089→      // All errors should now be cleared\\n  1090→      expect(nameField.errors.value).toEqual([])\\n  1091→      expect(emailField.errors.value).toEqual([])\\n  1092→      expect(bioField.errors.value).toEqual([])\\n  1093→      expect(form.isValid.value).toBe(true)\\n  1094→    })\\n  1095→\\n  1096→    it(\\\"should mark all fields as touched when submit is called, then reset on success\\\", async () => {\\n  1097→      const formRef = createFormRef()\\n  1098→      const form = createFormInScope(formRef)\\n  1099→\\n  1100→      // Create various field types to test comprehensive touched state\\n  1101→      const nameField = form.field(\\\"name\\\")\\n  1102→      const emailField = form.field(\\\"email\\\")\\n  1103→      const bioField = form.field(\\\"profile.bio\\\")\\n  1104→      const skillsArray = form.fieldArray(\\\"profile.skills\\\")\\n  1105→      const firstSkillField = skillsArray.field(0)\\n  1106→      const itemNameField = form.field(\\\"items[0].name\\\")\\n  1107→      const itemTagField = form.field(\\\"items[0].tags[0]\\\")\\n  1108→\