c1.pdf\\\",\\n   385→        client_size: 1024,\\n   386→        client_type: \\\"application/pdf\\\",\\n   387→        progress: 100,\\n   388→        done?: true,\\n   389→        valid?: true,\\n   390→        preflighted?: true\\n   391→      }\\n   392→\\n   393→      entry2 = %UploadEntry{\\n   394→        ref: \\\"entry-2\\\",\\n   395→        client_name: \\\"doc2.jpg\\\",\\n   396→        client_size: 2048,\\n   397→        client_type: \\\"image/jpeg\\\",\\n   398→        progress: 75,\\n   399→        done?: false,\\n   400→        valid?: true,\\n   401→        preflighted?: false\\n   402→      }\\n   403→\\n   404→      config = %UploadConfig{\\n   405→        ref: \\\"upload-1\\\",\\n   406→        name: \\\"documents\\\",\\n   407→        accept: [\\\".pdf\\\", \\\".jpg\\\"],\\n   408→        max_entries: 5,\\n   409→        auto_upload?: false,\\n   410→        entries: [entry1, entry2],\\n   411→        errors: []\\n   412→      }\\n   413→\\n   414→      expected = %{\\n   415→        ref: \\\"upload-1\\\",\\n   416→        name: \\\"documents\\\",\\n   417→        accept: [\\\".pdf\\\", \\\".jpg\\\"],\\n   418→        max_entries: 5,\\n   419→        auto_upload: false,\\n   420→        entries: [\\n   421→          %{\\n   422→            ref: \\\"entry-1\\\",\\n   423→            client_name: \\\"doc1.pdf\\\",\\n   424→            client_size: 1024,\\n   425→            client_type: \\\"application/pdf\\\",\\n   426→            progress: 100,\\n   427→            done: true,\\n   428→            valid: true,\\n   429→            preflighted: true,\\n   430→            errors: []\\n   431→          },\\n   432→          %{\\n   433→            ref: \\\"entry-2\\\",\\n   434→            client_name: \\\"doc2.jpg\\\",\\n   435→            client_size: 2048,\\n   436→            client_type: \\\"image/jpeg\\\",\\n   437→            progress: 75,\\n   438→            done: false,\\n   439→            valid: true,\\n   440→            preflighted: fa