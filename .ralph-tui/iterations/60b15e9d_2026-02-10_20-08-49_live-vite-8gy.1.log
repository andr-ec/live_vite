t(\\\"Items\\\")')\\n    44→    await expect(itemsHeading).toHaveText(\\\"Items (4)\\\")\\n    45→\\n    46→    // Check that form was cleared\\n    47→    await expect(page.locator('[data-testid=\\\"name-input\\\"]')).toHaveValue(\\\"\\\")\\n    48→    await expect(page.locator('[data-testid=\\\"description-input\\\"]')).toHaveValue(\\\"\\\")\\n    49→  })\\n    50→\\n    51→  test(\\\"adds multiple items in sequence\\\", async ({ page }) => {\\n    52→    // Add first item\\n    53→    await page.fill('[data-testid=\\\"name-input\\\"]', \\\"Item A\\\")\\n    54→    await page.fill('[data-testid=\\\"description-input\\\"]', \\\"Description A\\\")\\n    55→    await page.click('[data-testid=\\\"add-button\\\"]')\\n    56→    await syncLV(page)\\n    57→\\n    58→    // Add second item\\n    59→    await page.fill('[data-testid=\\\"name-input\\\"]', \\\"Item B\\\")\\n    60→    await page.fill('[data-testid=\\\"description-input\\\"]', \\\"Description B\\\")\\n    61→    await page.click('[data-testid=\\\"add-button\\\"]')\\n    62→    await syncLV(page)\\n    63→\\n    64→    // Check both items exist\\n    65→    await expect(page.locator('[data-testid=\\\"item-4\\\"]')).toBeVisible()\\n    66→    await expect(page.locator('[data-testid=\\\"item-5\\\"]')).toBeVisible()\\n    67→\\n    68→    // Check count\\n    69→    const itemsHeading = page.locator('h3:has-text(\\\"Items\\\")')\\n    70→    await expect(itemsHeading).toHaveText(\\\"Items (5)\\\")\\n    71→  })\\n    72→\\n    73→  test(\\\"removes individual items from stream\\\", async ({ page }) => {\\n    74→    // Remove item 2\\n    75→    await page.click('[data-testid=\\\"remove-2\\\"]')\\n    76→    await syncLV(page)\\n    77→\\n    78→    // Check that item 2 is gone but others remain\\n    79→    await expect(page.locator('[data-testid=\\\"item-1\\\"]')).toBeVisible()\\n    80→    await expect(page.locator('[data-testid=\\\"item-2\\\"]')).not.toBeVisible()\\n    81→    await expect(page.locator('[dat