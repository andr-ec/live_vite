→import { test, expect } from \\\"@playwright/test\\\"\\n     2→import { syncLV } from \\\"../../utils.js\\\"\\n     3→\\n     4→test.describe(\\\"LiveVue Stream Integration\\\", () => {\\n     5→  test.beforeEach(async ({ page }) => {\\n     6→    await page.goto(\\\"/streams\\\")\\n     7→    await syncLV(page)\\n     8→  })\\n     9→\\n    10→  test(\\\"renders initial stream items\\\", async ({ page }) => {\\n    11→    // Check that initial items are rendered\\n    12→    await expect(page.locator('[data-testid=\\\"item-1\\\"]')).toBeVisible()\\n    13→    await expect(page.locator('[data-testid=\\\"item-2\\\"]')).toBeVisible()\\n    14→    await expect(page.locator('[data-testid=\\\"item-3\\\"]')).toBeVisible()\\n    15→\\n    16→    // Check item content\\n    17→    await expect(page.locator('[data-testid=\\\"item-1\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Item 1\\\")\\n    18→    await expect(page.locator('[data-testid=\\\"item-1\\\"] [data-testid=\\\"item-description\\\"]')).toHaveText(\\\"First item\\\")\\n    19→    await expect(page.locator('[data-testid=\\\"item-1\\\"] [data-testid=\\\"item-id\\\"]')).toHaveText(\\\"ID: 1\\\")\\n    20→\\n    21→    // Check item count\\n    22→    const itemsHeading = page.locator('h3:has-text(\\\"Items\\\")')\\n    23→    await expect(itemsHeading).toHaveText(\\\"Items (3)\\\")\\n    24→  })\\n    25→\\n    26→  test(\\\"adds new items to stream\\\", async ({ page }) => {\\n    27→    // Fill form and add new item\\n    28→    await page.fill('[data-testid=\\\"name-input\\\"]', \\\"New Item\\\")\\n    29→    await page.fill('[data-testid=\\\"description-input\\\"]', \\\"This is a new item\\\")\\n    30→    await page.click('[data-testid=\\\"add-button\\\"]')\\n    31→\\n    32→    await syncLV(page)\\n    33→\\n    34→    // Check that new item appears\\n    35→    await expect(page.locator('[data-testid=\\\"item-4\\\"]')).toBeVisible()\\n    36→    await expect(page.locator('[data-testid=\\\"item-4\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"New Item\\\")\\n    37→    await expect(page.locator('[data-testid=\\\"item-4\\\"] [data-testid=\\\"item-description\\\"]')).toHaveText(\\n    38→      \\\"This is a new item\\\"\\n    39→    )\\n    40→    await expect(page.locator('[data-testid=\\\"item-4\\\"] [data-testid=\\\"item-id\\\"]')).toHaveText(\\\"ID: 4\\\")\\n    41→\\n    42→    // Check updated count\\n    43→    const itemsHeading = page.locator('h3:has-text(\\\"Items\\\")')\\n    44→    await expect(itemsHeading).toHaveText(\\\"Items (4)\\\")\\n    45→\\n    46→    // Check that form was cleared\\n    47→    await expect(page.locator('[data-testid=\\\"name-input\\\"]')).toHaveValue(\\\"\\\")\\n    48→    await expect(page.locator('[data-testid=\\\"description-input\\\"]')).toHaveValue(\\\"\\\")\\n    49→  })\\n    50→\\n    51→  test(\\\"adds multiple items in sequence\\\", async ({ page }) => {\\n    52→    // Add first item\\n    53→    await page.fill('[data-testid=\\\"name-input\\\"]', \\\"Item A\\\")\\n    54→    await page.fill('[data-testid=\\\"description-input\\\"]', \\\"Description A\\\")\\n    55→    await page.click('[data-testid=\\\"add-button\\\"]')\\n    56→    await syncLV(page)\\n    57→\\n    58→    // Add second item\\n    59→    await page.fill('[data-testid=\\\"name-input\\\"]', \\\"Item B\\\")\\n    60→    await page.fill('[data-testid=\\\"description-input\\\"]', \\\"Description B\\\")\\n    61→    await page.click('[data-testid=\\\"add-button\\\"]')\\n    62→    await syncLV(page)\\n    63→\\n    64→    // Check both items exist\\n    65→    await expect(page.locator('[data-testid=\\\"item-4\\\"]')).toBeVisible()\\n    66→    await expect(page.locator('[data-testid=\\\"item-5\\\"]')).toBeVisible()\\n    67→\\n    68→    // Check count\\n    69→    const itemsHeading = page.locator('h3:has-text(\\\"Items\\\")')\\n    70→    await expect(itemsHeading).toHaveText(\\\"Items (5)\\\")\\n    71→  })\\n    72→\\n    73→  test(\\\"removes individual items from stream\\\", async ({ page }) => {\\n    74→    // Remove item 2\\n    75→    await page.click('[data-testid=\\\"remove-2\\\"]')\\n    76→    await syncLV(page)\\n    77→\\n    78→    // Check that item 2 is gone but others remain\\n    79→    await expect(page.locator('[data-testid=\\\"item-1\\\"]')).toBeVisible()\\n    80→    await expect(page.locator('[data-testid=\\\"item-2\\\"]')).not.toBeVisible()\\n    81→    await expect(page.locator('[data-testid=\\\"item-3\\\"]')).toBeVisible()\\n    82→\\n    83→    // Check updated count\\n    84→    const itemsHeading = page.locator('h3:has-text(\\\"Items\\\")')\\n    85→    await expect(itemsHeading).toHaveText(\\\"Items (2)\\\")\\n    86→  })\\n    87→\\n    88→  test(\\\"removes multiple items\\\", async ({ page }) => {\\n    89→    // Remove items 1 and 3\\n    90→    await page.click('[data-testid=\\\"remove-1\\\"]')\\n    91→    await syncLV(page)\\n    92→    await page.click('[data-testid=\\\"remove-3\\\"]')\\n    93→    await syncLV(page)\\n    94→\\n    95→    // Check only item 2 remains\\n    96→    await expect(page.locator('[data-testid=\\\"item-1\\\"]')).not.toBeVisible()\\n    97→    await expect(page.locator('[data-testid=\\\"item-2\\\"]')).toBeVisible()\\n    98→    await expect(page.locator('[data-testid=\\\"item-3\\\"]')).not.toBeVisible()\\n    99→\\n   100→    // Check count\\n   101→    const itemsHeading = page.locator('h3:has-text(\\\"Items\\\")')\\n   102→    await expect(itemsHeading).toHaveText(\\\"Items (1)\\\")\\n   103→  })\\n   104→\\n   105→  test(\\\"clears entire stream\\\", async ({ page }) => {\\n   106→    // Clear all items\\n   107→    await page.click('[data-testid=\\\"clear-button\\\"]')\\n   108→    await syncLV(page)\\n   109→\\n   110→    // Check that all items are gone\\n   111→    await expect(page.locator('[data-testid=\\\"item-1\\\"]')).not.toBeVisible()\\n   112→    await expect(page.locator('[data-testid=\\\"item-2\\\"]')).not.toBeVisible()\\n   113→    await expect(page.locator('[data-testid=\\\"item-3\\\"]')).not.toBeVisible()\\n   114→\\n   115→    // Check empty state\\n   116→    await expect(page.locator('[data-testid=\\\"empty-message\\\"]')).toBeVisible()\\n   117→    await expect(page.locator('[data-testid=\\\"empty-message\\\"]')).toHaveText(\\\"No items in the stream\\\")\\n   118→\\n   119→    // Check count\\n   120→    const itemsHeading = page.locator('h3:has-text(\\\"Items\\\")')\\n   121→    await expect(itemsHeading).toHaveText(\\\"Items (0)\\\")\\n   122→  })\\n   123→\\n   124→  test(\\\"resets stream to default state\\\", async ({ page }) => {\\n   125→    // First clear the stream\\n   126→    await page.click('[data-testid=\\\"clear-button\\\"]')\\n   127→    await syncLV(page)\\n   128→    await expect(page.locator('[data-testid=\\\"empty-message\\\"]')).toBeVisible()\\n   129→\\n   130→    // Then reset it\\n   131→    await page.click('[data-testid=\\\"reset-button\\\"]')\\n   132→    await syncLV(page)\\n   133→\\n   134→    // Check that original items are back\\n   135→    await expect(page.locator('[data-testid=\\\"item-1\\\"]')).toBeVisible()\\n   136→    await expect(page.locator('[data-testid=\\\"item-2\\\"]')).toBeVisible()\\n   137→    await expect(page.locator('[data-testid=\\\"item-3\\\"]')).toBeVisible()\\n   138→    await expect(page.locator('[data-testid=\\\"empty-message\\\"]')).not.toBeVisible()\\n   139→\\n   140→    // Check count\\n   141→    const itemsHeading = page.locator('h3:has-text(\\\"Items\\\")')\\n   142→    await expect(itemsHeading).toHaveText(\\\"Items (3)\\\")\\n   143→  })\\n   144→\\n   145→  test(\\\"handles complex workflow: add, remove, clear, reset\\\", async ({ page }) => {\\n   146→    // Add a new item\\n   147→    await page.fill('[data-testid=\\\"name-input\\\"]', \\\"Workflow Item\\\")\\n   148→    await page.fill('[data-testid=\\\"description-input\\\"]', \\\"Testing workflow\\\")\\n   149→    await page.click('[data-testid=\\\"add-