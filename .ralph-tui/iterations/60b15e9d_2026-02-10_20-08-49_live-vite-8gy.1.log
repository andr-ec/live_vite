\\\"profile.bio\\\")\\n  1186→\\n  1187→      // Make changes and mark fields as touched\\n  1188→      nameField.value.value = \\\"Jane Smith\\\"\\n  1189→      bioField.value.value = \\\"Updated bio\\\"\\n  1190→      nameField.blur() // Mark as touched\\n  1191→      bioField.blur() // Mark as touched\\n  1192→\\n  1193→      await nextTick()\\n  1194→\\n  1195→      // Verify dirty and touched state before submit\\n  1196→      expect(form.isDirty.value).toBe(true)\\n  1197→      expect(form.isTouched.value).toBe(true)\\n  1198→      expect(nameField.isTouched.value).toBe(true)\\n  1199→      expect(bioField.isTouched.value).toBe(true)\\n  1200→      expect(form.submitCount.value).toBe(0)\\n  1201→\\n  1202→      // Verify initial values haven't changed\\n  1203→      expect(form.initialValues.name).toBe(\\\"John Doe\\\")\\n  1204→      expect(form.initialValues.profile.bio).toBe(\\\"Software developer\\\")\\n  1205→\\n  1206→      // Simulate server updating form with new values after submit\\n  1207→      // This would typically happen in LiveView after processing the form\\n  1208→      formRef.value = {\\n  1209→        ...formRef.value,\\n  1210→        values: {\\n  1211→          ...formRef.value.values,\\n  1212→          name: \\\"Jane Smith\\\", // Server accepted the change\\n  1213→          profile: {\\n  1214→            ...formRef.value.values.profile,\\n  1215→            bio: \\\"Updated bio\\\", // Server accepted the change\\n  1216→          },\\n  1217→        },\\n  1218→        errors: {} as FormErrors<TestForm>, // Clear any previous errors\\n  1219→      }\\n  1220→\\n  1221→      // Submit the form (should succeed and trigger reset)\\n  1222→      await form.submit()\\n  1223→      // Wait for the reset timeout to complete\\n  1224→      await new Promise(resolve => setTimeout(resolve, 10))\\n  1225→\\n  1226→      await nextTick()\\n  1227→\\n  1228→      // After successful submit, form should be reset\\n  1229→      expect(form.isDir