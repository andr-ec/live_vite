estid=\\\"description-input\\\"]', \\\"Description B\\\")\\n    61→    await page.click('[data-testid=\\\"add-button\\\"]')\\n    62→    await syncLV(page)\\n    63→\\n    64→    // Check both items exist\\n    65→    await expect(page.locator('[data-testid=\\\"item-4\\\"]')).toBeVisible()\\n    66→    await expect(page.locator('[data-testid=\\\"item-5\\\"]')).toBeVisible()\\n    67→\\n    68→    // Check count\\n    69→    const itemsHeading = page.locator('h3:has-text(\\\"Items\\\")')\\n    70→    await expect(itemsHeading).toHaveText(\\\"Items (5)\\\")\\n    71→  })\\n    72→\\n    73→  test(\\\"removes individual items from stream\\\", async ({ page }) => {\\n    74→    // Remove item 2\\n    75→    await page.click('[data-testid=\\\"remove-2\\\"]')\\n    76→    await syncLV(page)\\n    77→\\n    78→    // Check that item 2 is gone but others remain\\n    79→    await expect(page.locator('[data-testid=\\\"item-1\\\"]')).toBeVisible()\\n    80→    await expect(page.locator('[data-testid=\\\"item-2\\\"]')).not.toBeVisible()\\n    81→    await expect(page.locator('[data-testid=\\\"item-3\\\"]')).toBeVisible()\\n    82→\\n    83→    // Check updated count\\n    84→    const itemsHeading = page.locator('h3:has-text(\\\"Items\\\")')\\n    85→    await expect(itemsHeading).toHaveText(\\\"Items (2)\\\")\\n    86→  })\\n    87→\\n    88→  test(\\\"removes multiple items\\\", async ({ page }) => {\\n    89→    // Remove items 1 and 3\\n    90→    await page.click('[data-testid=\\\"remove-1\\\"]')\\n    91→    await syncLV(page)\\n    92→    await page.click('[data-testid=\\\"remove-3\\\"]')\\n    93→    await syncLV(page)\\n    94→\\n    95→    // Check only item 2 remains\\n    96→    await expect(page.locator('[data-testid=\\\"item-1\\\"]')).not.toBeVisible()\\n    97→    await expect(page.locator('[data-testid=\\\"item-2\\\"]')).toBeVisible()\\n    98→    await expect(page.locator('[data-testid=\\\"item-3\\\"]')).not.toBeVisible()\\n    99→\\n   100→    // Check count\