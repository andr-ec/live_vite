sage\\\"]')).not.toBeVisible()\\n   139→\\n   140→    // Check count\\n   141→    const itemsHeading = page.locator('h3:has-text(\\\"Items\\\")')\\n   142→    await expect(itemsHeading).toHaveText(\\\"Items (3)\\\")\\n   143→  })\\n   144→\\n   145→  test(\\\"handles complex workflow: add, remove, clear, reset\\\", async ({ page }) => {\\n   146→    // Add a new item\\n   147→    await page.fill('[data-testid=\\\"name-input\\\"]', \\\"Workflow Item\\\")\\n   148→    await page.fill('[data-testid=\\\"description-input\\\"]', \\\"Testing workflow\\\")\\n   149→    await page.click('[data-testid=\\\"add-button\\\"]')\\n   150→    await syncLV(page)\\n   151→\\n   152→    // Verify we have 4 items\\n   153→    const itemsHeading = page.locator('h3:has-text(\\\"Items\\\")')\\n   154→    await expect(itemsHeading).toHaveText(\\\"Items (4)\\\")\\n   155→\\n   156→    // Remove one original item\\n   157→    await page.click('[data-testid=\\\"remove-2\\\"]')\\n   158→    await syncLV(page)\\n   159→    await expect(itemsHeading).toHaveText(\\\"Items (3)\\\")\\n   160→\\n   161→    // Clear all\\n   162→    await page.click('[data-testid=\\\"clear-button\\\"]')\\n   163→    await syncLV(page)\\n   164→    await expect(itemsHeading).toHaveText(\\\"Items (0)\\\")\\n   165→    await expect(page.locator('[data-testid=\\\"empty-message\\\"]')).toBeVisible()\\n   166→\\n   167→    // Reset to defaults\\n   168→    await page.click('[data-testid=\\\"reset-button\\\"]')\\n   169→    await syncLV(page)\\n   170→    await expect(itemsHeading).toHaveText(\\\"Items (3)\\\")\\n   171→    await expect(page.locator('[data-testid=\\\"empty-message\\\"]')).not.toBeVisible()\\n   172→\\n   173→    // Verify the original 3 items are back (not the added one)\\n   174→    await expect(page.locator('[data-testid=\\\"item-1\\\"]')).toBeVisible()\\n   175→    await expect(page.locator('[data-testid=\\\"item-2\\\"]')).toBeVisible()\\n   176→    await expect(page.locator('[data-testid=\\\"item-3\\\"]')).toBeVisible()\\n   177→    await expect(page.locator('[data-testid=\\\"item-4\\\"]')).not.toBeVisible()\\n   178→  })\\n   179→\\n   180→  test(\\\"validates form input for adding items\\\", async ({ page }) => {\\n   181→    // Try to add item with empty name\\n   182→    await page.fill('[data-testid=\\\"name-input\\\"]', \\\"\\\")\\n   183→    await page.fill('[data-testid=\\\"description-input\\\"]', \\\"Description only\\\")\\n   184→\\n   185→    // This should trigger an alert (form validation)\\n   186→    page.on(\\\"dialog\\\", async dialog => {\\n   187→      expect(dialog.message()).toBe(\\\"Please enter a name for the item\\\")\\n   188→      await dialog.accept()\\n   189→    })\\n   190→\\n   191→    await page.click('[data-testid=\\\"add-button\\\"]')\\n   192→\\n   193→    // Item should not be added\\n   194→    await syncLV(page)\\n   195→    const itemsHeading = page.locator('h3:has-text(\\\"Items\\\")')\\n   196→    await expect(itemsHeading).toHaveText(\\\"Items (3)\\\") // Still 3 items\\n   197→  })\\n   198→\\n   199→  test(\\\"displays debug information correctly\\\", async ({ page }) => {\\n   200→    // Check debug info shows correct type and length\\n   201→    await expect(page.locator('.debug-info p:has-text(\\\"Items type:\\\")')).toBeVisible()\\n   202→    await expect(page.locator('.debug-info p:has-text(\\\"Items length:\\\")')).toBeVisible()\\n   203→\\n   204→    // Check raw items data is displayed\\n   205→    await expect(page.locator('[data-testid=\\\"raw-items\\\"]')).toBeVisible()\\n   206→\\n   207→    const rawItemsText = await page.locator('[data-testid=\\\"raw-items\\\"]').textContent()\\n   208→    expect(rawItemsText).toContain('\\\"id\\\"')\\n   209→    expect(rawItemsText).toContain('\\\"name\\\"')\\n   210→    expect(rawItemsText).toContain('\\\"description\\\"')\\n   211→  })\\n   212→\\n   213→  test(\\\"maintains item order during operations\\\", async ({ page }) => {\\n   214→    // Get initial order\\n   215→    const item1Name = await page.locator('[data-testid=\\\"item-1\\\"] [data-testid=\\\"item-name\\\"]').textContent()\\n   216→    const item2Name = await page.locator('[data-testid=\\\"item-2\\\"] [data-testid=\\\"item-name\\\"]').textContent()\\n   217→    const item3Name = await page.locator('[data-testid=\\\"item-3\\\"] [data-testid=\\\"item-name\\\"]').textContent()\\n   218→\\n   219→    expect(item1Name).toBe(\\\"Item 1\\\")\\n   220→    expect(item2Name).toBe(\\\"Item 2\\\")\\n   221→    expect(item3Name).toBe(\\\"Item 3\\\")\\n   222→\\n   223→    // Add new item (should appear after existing ones)\\n   224→    await page.fill('[data-testid=\\\"name-input\\\"]', \\\"Item 4\\\")\\n   225→    await page.fill('[data-testid=\\\"description-input\\\"]', \\\"Fourth item\\\")\\n   226→    await page.click('[data-testid=\\\"add-button\\\"]')\\n   227→    await syncLV(page)\\n   228→\\n   229→    // Check that new item appears at the end\\n   230→    const item4Name = await page.locator('[data-testid=\\\"item-4\\\"] [data-testid=\\\"item-name\\\"]').textContent()\\n   231→    expect(item4Name).toBe(\\\"Item 4\\\")\\n   232→\\n   233→    // Remove middle item and check order is maintained\\n   234→    await page.click('[data-testid=\\\"remove-2\\\"]')\\n   235→    await syncLV(page)\\n   236→\\n   237→    // Items 1, 3, 4 should still be in correct order\\n   238→    await expect(page.locator('[data-testid=\\\"item-1\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Item 1\\\")\\n   239→    await expect(page.locator('[data-testid=\\\"item-3\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Item 3\\\")\\n   240→    await expect(page.locator('[data-testid=\\\"item-4\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Item 4\\\")\\n   241→  })\\n   242→\\n   243→  test(\\\"maintains correct item order after stream reset\\\", async ({ page }) => {\\n   244→    // Add some items and clear to modify the stream\\n   245→    await page.fill('[data-testid=\\\