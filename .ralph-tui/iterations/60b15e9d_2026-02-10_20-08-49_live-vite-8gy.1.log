{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ak24kRPpYRvDhaDSQ6Lim5","type":"tool_result","content":"     1→defmodule Mix.Tasks.LiveVue.Install do\n     2→  @moduledoc \"\"\"\n     3→  Installer for LiveVue with Vite.\n     4→\n     5→  This task first installs Vite using the PhoenixVite installer,\n     6→  then configures the project for LiveVue.\n     7→\n     8→  ## Options\n     9→\n    10→    * `--bun` - Use Bun instead of Node.js/npm\n    11→\n    12→  ## Examples\n    13→\n    14→      mix live_vue.install\n    15→      mix live_vue.install --bun\n    16→\n    17→  \"\"\"\n    18→\n    19→  import Mix.Tasks.PhoenixVite.Install.Helper\n    20→\n    21→  @usage_rules_content File.read!(Path.join([__DIR__, \"../../../usage-rules.md\"]))\n    22→  with_igniter do\n    23→    use Igniter.Mix.Task\n    24→\n    25→    alias Igniter.Libs.Phoenix\n    26→    alias Igniter.Project.Config\n    27→\n    28→    @impl Igniter.Mix.Task\n    29→    def info(_argv, _parent) do\n    30→      %Igniter.Mix.Task.Info{\n    31→        composes: [\"phoenix_vite.install\"],\n    32→        schema: [bun: :boolean],\n    33→        aliases: [b: :bun]\n    34→      }\n    35→    end\n    36→\n    37→    @impl Igniter.Mix.Task\n    38→    def igniter(igniter) do\n    39→      app_name = Igniter.Project.Application.app_name(igniter)\n    40→\n    41→      igniter\n    42→      |> Igniter.compose_task(\"phoenix_vite.install\", igniter.args.argv)\n    43→      |> configure_environments(app_name)\n    44→      |> add_live_vue_to_html_helpers(app_name)\n    45→      |> update_javascript_configuration()\n    46→      |> update_vite_configuration()\n    47→      |> update_phoenix_vite_config()\n    48→      |> configure_tailwind_for_vue()\n    49→      |> update_package_json_for_vue()\n    50→      |> create_vue_files()\n    51→      |> setup_ssr_for_production(app_name)\n    52→      |> update_mix_aliases()\n    53→      |> add_vue_demo_route()\n    54→      |> update_home_template()\n    55→      |> update_gitignore()\n    56→      |> append_usage_rules_to_agents_md()\n    57→    end\n    58→\n    59→    # Configure environments (config/dev.exs and config/prod.exs)\n    60→    defp configure_environments(igniter, _app_name) do\n    61→      igniter\n    62→      |> Config.configure(\"config.exs\", :live_vue, [:ssr], true)\n    63→      |> Config.configure(\"dev.exs\", :live_vue, [:vite_host], \"http://localhost:5173\")\n    64→      |> Config.configure(\"dev.exs\", :live_vue, [:ssr_module], {:code, Sourceror.parse_string!(\"LiveVue.SSR.ViteJS\")})\n    65→      |> Config.configure(\"prod.exs\", :live_vue, [:ssr_module], {:code, Sourceror.parse_string!(\"LiveVue.SSR.NodeJS\")})\n    66→      |> Config.configure(\"prod.exs\", :live_vue, [:ssr], true)\n    67→    end\n    68→\n    69→    # Add LiveVue to html_helpers in lib/app_web.ex\n    70→    defp add_live_vue_to_html_helpers(igniter, _app_name) do\n    71→      web_module = Phoenix.web_module(igniter)\n    72→      web_folder = Macro.underscore(web_module)\n    73→      web_file = Path.join([\"lib\", web_folder <> \".ex\"])\n    74→\n    75→      Igniter.update_file(igniter, web_file, fn source ->\n    76→        Rewrite.Source.update(source, :content, fn content ->\n    77→          # Check if LiveVue is already added to avoid duplicate additions.\n    78→          # Use regex to match \"use LiveVue\" as a standalone module, not as part of\n    79→          # another module name (e.g., \"use LiveVueWebsiteWeb\" should not match).\n    80→          if Regex.match?(~r/use LiveVue\\b/, content) do\n    81→            content\n    82→          else\n    83→            # Get the short module name (without Elixir. prefix)\n    84→            web_module_name = web_module |> Module.split() |> Enum.join(\".\")\n    85→\n    86→            # Add LiveVue support only in the html_helpers function\n    87→            String.replace(\n    88→              content,\n    89→              ~r/(defp html_helpers do\\s+quote do\\s+# Translation\\s+use Gettext, backend: #{Regex.escape(web_module_name)}\\.Gettext)/,\n    90→              \"\\\\1\\n\\n      # Add support for Vue components\\n      use LiveVue\\n\\n      # Generate component for each vue file, so you can use <.ComponentName> syntax\\n      # instead of <.vue v-component=\\\"ComponentName\\\">\\n      use LiveVue.Components, vue_root: [\\\"./assets/vue\\\", \\\"./lib/#{web_folder}\\\"]\"\n    91→            )\n    92→          end\n    93→        end)\n    94→      end)\n    95→    end\n    96→\n    97→    # Update JavaScript configuration (app.js)\n    98→    defp update_javascript_configuration(igniter) do\n    99→      Igniter.update_file(igniter, \"assets/js/app.js\", fn source ->\n   100→        Rewrite.Source.update(source, :content, fn content ->\n   101→          content\n   102→          |> add_live_vue_imports()\n   103→          |> update_live_socket_hooks()\n   104→        end)\n   105→      end)\n   106→    end\n   107→\n   108→    defp add_live_vue_imports(content) do\n   109→      if String.contains?(content, \"import {getHooks} from \\\"live_vue\\\"\") do\n   110→        content\n   111→      else\n   112→        String.replace(\n   113→          content,\n   114→          \"import topbar from \\\"topbar\\\"\",\n   115→          ~s(import topbar from \"topbar\"\\nimport {getHooks} from \"live_vue\"\\nimport liveVueApp from \"../vue\")\n   116→        )\n   117→      end\n   118→    end\n   119→\n   120→    defp update_live_socket_hooks(content) do\n   121→      String.replace(\n   122→        content,\n   123→        \"hooks: {...colocatedHooks},\",\n   124→        \"hooks: {...colocatedHooks, ...getHooks(liveVueApp)},\"\n   125→      )\n   126→    end\n   127→\n   128→    defp update_phoenix_vite_config(igniter) do\n   129→      Config.configure(\n   130→        igniter,\n   131→        \"config.exs\",\n   132→        :phoenix_vite,\n   133→        [PhoenixVite.Npm, :assets],\n   134→        {:code, Sourceror.parse_string!(~s|[args: [], cd: __DIR__]|)}\n   135→      )\n   136→    end\n   137→\n   138→    # Update Vite configuration\n   139→    defp update_vite_configuration(igniter) do\n   140→      Igniter.update_file(igniter, \"assets/vite.config.mjs\", fn source ->\n   141→        Rewrite.Source.update(source, :content, fn content ->\n   142→          content\n   143→          |> add_vite_imports()\n   144→          |> update_vite_server_config()\n   145→          |> update_vite_optimized_deps()\n   146→          |> update_vite_plugins()\n   147→          |> update_vite_manifest()\n   148→          |> add_ssr_vite_entry()\n   149→        end)\n   150→      end)\n   151→    end\n   152→\n   153→    defp add_vite_imports(content) do\n   154→      if String.contains?(content, \"import vue from\") do\n   155→        content\n   156→      else\n   157→        String.replace(\n   158→          content,\n   159→          \"import { phoenixVitePlugin } from 'phoenix_vite'\",\n   160→          ~s(import vue from \"@vitejs/plugin-vue\";\\nimport liveVuePlugin from \"live_vue/vitePlugin\";)\n   161→        )\n   162→      end\n   163→    end\n   164→\n   165→    defp update_vite_server_config(content) do\n   166→      if String.contains?(content, \"host: \\\"127.0.0.1\\\"\") do\n   167→        content\n   168→      else\n   169→        String.replace(\n   170→          content,\n   171→          \"port: 5173,\",\n   172→          \"host: \\\"127.0.0.1\\\",\\n    port: 5173,\"\n   173→        )\n   174→      end\n   175→    end\n   176→\n   177→    defp update_vite_optimized_deps(content) do\n   178→      String.replace(\n   179→        content,\n   180→        ~s(include: [\"phoenix\", \"phoenix_html\", \"phoenix_live_view\"],),\n   181→        ~s(include: [\"live_vue\", \"phoenix\", \"phoenix_html\", \"phoenix_live_view\"],)\n   182→      )\n   183→    end\n   184→\n   185→    defp update_vite_plugins(content) do\n   186→      # Replace the phoenixVitePlugin call with the Vue plugins while keeping tailwindcss\n   187→      String.replace(\n   188→        content,\n   189→        ~r/phoenixVitePlugin\\(\\{\\s*pattern: \\/\\\\.\\(ex\\|heex\\)\\$\\/\\s*\\}\\)/s,\n   190→        \"vue(),\\n    liveVuePlugin()\"\n   191→      )\n   192→    end\n   193→\n   194→    defp update_vite_manifest(content) do\n   195→      if String.contains?(content, \"manifest: false\") do\n   196→        content\n   197→      else\n   198→        String.replace(\n   199→          content,\n   200→          ~r/manifest: true,/s,\n   201→          \"manifest: false,\\n    ssrManifest: false,\"\n   202→        )\n   203→      end\n   204→    end\n   205→\n   206→    defp add_ssr_vite_entry(content) do\n   207→      if String.contains?(content, \"noExternal\") do\n   208→        content\n   209→      else\n   210→        String.replace(\n   211→          content,\n   212→          ~r/build: {/s,\n   213→          \"ssr: { noExternal: process.env.NODE_ENV === \\\"production\\\" ? true : undefined },\\n    build: {\"\n   214→        )\n   215→      end\n   216→    end\n   217→\n   218→    # Configure Tailwind to include Vue files\n   219→    defp configure_tailwind_for_vue(igniter) do\n   220→      Igniter.update_file(igniter, \"assets/css/app.css\", fn source ->\n   221→        Rewrite.Source.update(source, :content, fn content ->\n   222→          if String.contains?(content, \"@source \\\"../vue\\\";\") do\n   223→            content\n   224→          else\n   225→            String.replace(\n   226→              content,\n   227→              \"@source \\\"../js\\\";\",\n   228→              ~s(@source \"../js\";\\n@source \"../vue\";)\n   229→            )\n   230→          end\n   231→        end)\n   232→      end)\n   233→    end\n   234→\n   235→    # Update package.json for Vue dependencies\n   236→    defp update_package_json_for_vue(igniter) do\n   237→      igniter\n   238→      |> Igniter.move_file(\"assets/package.json\", \"package.json\")\n   239→      |> Igniter.update_file(\"package.json\", fn source ->\n   240→        Rewrite.Source.update(source, :content, fn _ ->\n   241→          \"\"\"\n   242→          {\n   243→            \"dependencies\": {\n   244→              \"@vueuse/core\": \"^13.7.0\",\n   245→              \"live_vue\": \"file:./deps/live_vue\",\n   246→              \"phoenix\": \"file:./deps/phoenix\",\n   247→              \"phoenix_html\": \"file:./deps/phoenix_html\",\n   248→              \"phoenix_live_view\": \"file:./deps/phoenix_live_view\",\n   249→              \"topbar\": \"^3.0.0\",\n   250→              \"vue\": \"^3.4.21\"\n   251→            },\n   252→            \"devDependencies\": {\n   253→              \"@tailwindcss/vite\": \"^4.1.0\",\n   254→              \"@vitejs/plugin-vue\": \"^5.0.4\",\n   255→              \"daisyui\": \"^5.0.0\",\n   256→              \"phoenix_vite\": \"file:./deps/phoenix_vite\",\n   257→              \"tailwindcss\": \"^4.1.0\",\n   258→              \"typescript\": \"^5.4.5\",\n   259→              \"vite\": \"^6.3.0\",\n   260→              \"vue-tsc\": \"^2.0.13\"\n   261→            }\n   262→          }\n   263→          \"\"\"\n   264→        end)\n   265→      end)\n   266→    end\n   267→\n   268→    # Create Vue files from templates\n   269→    defp create_vue_files(igniter) do\n   270→      web_module = Phoenix.web_module(igniter)\n   271→      web_folder = Macro.underscore(web_module)\n   272→\n   273→      igniter\n   274→      |> Igniter.compose_task(\"igniter.add_extension\", [\"phoenix\"])\n   275→      |> Igniter.mkdir(\"assets/vue\")\n   276→      |> Igniter.mkdir(\"lib/#{web_folder}/live\")\n   277→      |> Igniter.create_new_file(\"assets/vue/index.ts\", vue_index_content())\n   278→      |> Igniter.create_new_file(\"assets/vue/VueDemo.vue\", demo_vue_content())\n   279→      |> Igniter.create_new_file(\"assets/js/server.js\", server_js_content())\n   280→      |> Igniter.create_new_file(\n   281→        \"assets/vue/.gitignore\",\n   282→        \"# Ignore automatically generated Vue files by the ~V sigil\\n_build/\"\n   283→      )\n   284→      |> Igniter.create_new_file(\"lib/#{web_folder}/live/vue_demo_live.ex\", demo_live_view_content(igniter))\n   285→      |> update_tsconfig_for_vue()\n   286→    end\n   287→\n   288→    defp update_tsconfig_for_vue(igniter) do\n   289→      web_module = Phoenix.web_module(igniter)\n   290→      web_folder = Macro.underscore(web_module)\n   291→\n   292→      igniter\n   293→      |> Igniter.rm(\"assets/tsconfig.json\")\n   294→      |> Igniter.create_new_file(\"tsconfig.json\", \"\"\"\n   295→      {\n   296→        \"compilerOptions\": {\n   297→          \"allowJs\": true,\n   298→          \"baseUrl\": \".\",\n   299→          \"lib\": [\"ES2015\", \"DOM\"],\n   300→          \"module\": \"ESNext\",\n   301→          \"moduleResolution\": \"bundler\",\n   302→          \"noEmit\": true,\n   303→          \"skipLibCheck\": true,\n   304→          \"paths\": {\n   305→            \"*\": [ \"./deps/*\", \"node_modules/*\" ]\n   306→          },\n   307→          \"strict\": true,\n   308→          \"types\": [ \"vite/client\" ]\n   309→        },\n   310→        \"include\": [\n   311→          \"./assets/js/**/*\",\n   312→          \"./assets/vue/**/*\",\n   313→          \"./lib/#{web_folder}/**/*\"\n   314→        ],\n   315→        \"exclude\": [\n   316→          \"node_modules\"\n   317→        ]\n   318→      }\n   319→      \"\"\")\n   320→    end\n   321→\n   322→    # Setup SSR for production in application.ex\n   323→    defp setup_ssr_for_production(igniter, _app_name) do\n   324→      app_module = igniter |> Igniter.Project.Application.app_name() |> to_string()\n   325→      app_file = \"lib/#{Macro.underscore(app_module)}/application.ex\"\n   326→\n   327→      # Use simple file update instead of complex AST manipulation\n   328→      Igniter.update_file(igniter, app_file, fn source ->\n   329→        Rewrite.Source.update(source, :content, fn content ->\n   330→          # Look for the children list and add NodeJS.Supervisor right after the opening bracket\n   331→          if String.contains?(content, \"children = [\") and not String.contains?(content, \"NodeJS.Supervisor\") do\n   332→            String.replace(\n   333→              content,\n   334→              ~r/(children = \\[\\s*\\n)/,\n   335→              \"\\\\1      {NodeJS.Supervisor, [path: LiveVue.SSR.NodeJS.server_path(), pool_size: 4]},\\n\"\n   336→            )\n   337→          else\n   338→            content\n   339→          end\n   340→        end)\n   341→      end)\n   342→    end\n   343→\n   344→    defp vue_index_content do\n   345→      \"\"\"\n   346→      import { h, type Component } from \"vue\"\n   347→      import { createLiveVue, findComponent, type LiveHook, type ComponentMap } from \"live_vue\"\n   348→\n   349→      // needed to make $live available in the Vue component\n   350→      declare module \"vue\" {\n   351→        interface ComponentCustomProperties {\n   352→          $live: LiveHook\n   353→        }\n   354→      }\n   355→\n   356→      export default createLiveVue({\n   357→        // name will be passed as-is in v-component of the .vue HEEX component\n   358→        resolve: name => {\n   359→          // we're importing from ../../lib to allow collocating Vue files with LiveView files\n   360→          // eager: true disables lazy loading - all these components will be part of the app.js bundle\n   361→          // more: https://vite.dev/guide/features.html#glob-import\n   362→          const components = {\n   363→            ...import.meta.glob(\"./**/*.vue\", { eager: true }),\n   364→            ...import.meta.glob(\"../../lib/**/*.vue\", { eager: true }),\n   365→          } as ComponentMap\n   366→\n   367→          // finds component by name or path suffix and gives a nice error message.\n   368→          // `path/to/component/index.vue` can be found as `path/to/component` or simply `component`\n   369→          // `path/to/Component.vue` can be found as `path/to/Component` or simply `Component`\n   370→          return findComponent(components as ComponentMap, name)\n   371→        },\n   372→        // it's a default implementation of creating and mounting vue app, you can easily extend it to add your own plugins, directives etc.\n   373→        setup: ({ createApp, component, props, slots, plugin, el }) => {\n   374→          const app = createApp({ render: () => h(component as Component, props, slots) })\n   375→          app.use(plugin)\n   376→          // add your own plugins here\n   377→          // app.use(pinia)\n   378→          app.mount(el)\n   379→          return app\n   380→        },\n   381→      })\n   382→      \"\"\"\n   383→    end\n   384→\n   385→    defp demo_live_view_content(igniter) do\n   386→      web_module_name = Phoenix.web_module(igniter)\n   387→\n   388→      \"\"\"\n   389→      defmodule #{inspect(web_module_name)}.VueDemoLive do\n   390→        use #{inspect(web_module_name)}, :live_view\n   391→\n   392→        @impl true\n   393→        def render(assigns) do\n   394→          ~H\\\"\\\"\\\"\n   395→          <Layouts.app flash={@flash}>\n   396→            <.vue\n   397→              todos={@todos}\n   398→              form={@form}\n   399→              v-component=\"VueDemo\"\n   400→              v-socket={@socket}\n   401→            />\n   402→          </Layouts.app>\n   403→          \\\"\\\"\\\"\n   404→        end\n   405→\n   406→        @impl true\n   407→        def mount(_params, _session, socket) do\n   408→          socket =\n   409→            socket\n   410→            |> assign(:todos, [\n   411→              %{id: 1, text: \"Learn LiveVue basics\", completed: true},\n   412→              %{id: 2, text: \"Build an interactive component\", completed: false},\n   413→              %{id: 3, text: \"Deploy to production\", completed: false}\n   414→            ])\n   415→            |> assign(:next_id, 4)\n   416→            |> assign(:form, add_todo_form(%{text: \"\"}))\n   417→\n   418→          {:ok, socket}\n   419→        end\n   420→\n   421→        @impl true\n   422→        def handle_event(\"validate_todo\", %{\"todo\" => params}, socket) do\n   423→          {:noreply, assign(socket, :form, add_todo_form(params))}\n   424→        end\n   425→\n   426→        @impl true\n   427→        def handle_event(\"add_todo\", %{\"todo\" => params}, socket) do\n   428→          changeset = add_todo_changeset(params, socket.assigns.next_id)\n   429→\n   430→          case Ecto.Changeset.apply_action(changeset, :insert) do\n   431→            {:ok, new_todo} ->\n   432→              socket =\n   433→                socket\n   434→                |> assign(:todos, socket.assigns.todos ++ [new_todo])\n   435→                |> assign(:next_id, socket.assigns.next_id + 1)\n   436→                |> assign(:form, add_todo_form(%{text: \"\"}))\n   437→\n   438→              {:noreply, socket}\n   439→\n   440→            {:error, changeset} ->\n   441→              {:noreply, assign(socket, :form, to_form(changeset, as: :todo))}\n   442→          end\n   443→        end\n   444→\n   445→        @impl true\n   446→        def handle_event(\"toggle_todo\", %{\"id\" => id}, socket) do\n   447→          todos =\n   448→            Enum.map(socket.assigns.todos, fn todo ->\n   449→              if todo.id == id, do: %{todo | completed: !todo.completed}, else: todo\n   450→            end)\n   451→\n   452→          {:noreply, assign(socket, :todos, todos)}\n   453→        end\n   454→\n   455→        @impl true\n   456→        def handle_event(\"delete_todo\", %{\"id\" => id}, socket) do\n   457→          todos = Enum.reject(socket.assigns.todos, fn todo -> todo.id == id end)\n   458→          {:noreply, assign(socket, :todos, todos)}\n   459→        end\n   460→\n   461→        @impl true\n   462→        def handle_event(\"clear_completed\", _params, socket) do\n   463→          todos = Enum.reject(socket.assigns.todos, fn todo -> todo.completed end)\n   464→          {:noreply, assign(socket, :todos, todos)}\n   465→        end\n   466→\n   467→        defp add_todo_changeset(params, id \\\\\\\\ nil) do\n   468→          data = %{text: \"\", id: id, completed: false}\n   469→          types = %{text: :string}\n   470→\n   471→          {data, types}\n   472→          |> Ecto.Changeset.cast(params, Map.keys(types))\n   473→          |> Ecto.Changeset.validate_required([:text])\n   474→          |> Ecto.Changeset.validate_length(:text, min: 8, max: 50)\n   475→        end\n   476→\n   477→        defp add_todo_form(params) do\n   478→          params\n   479→          |> add_todo_changeset()\n   480→          |> Map.put(:action, :validate)\n   481→          |> to_form(as: :todo)\n   482→        end\n   483→      end\n   484→      \"\"\"\n   485→    end\n   486→\n   487→    defp demo_vue_content do\n   488→      \"\"\"\n   489→      <script setup lang=\"ts\">\n   490→      import { ref, computed } from \"vue\"\n   491→      import { useLiveVue, Form, useLiveForm } from \"live_vue\"\n   492→\n   493→      type FilterType = \"all\" | \"active\" | \"completed\"\n   494→\n   495→      // Props from LiveView - server state\n   496→      const props = defineProps<{\n   497→        todos: Array<{ id: number; text: string; completed: boolean }>\n   498→        form: Form<{ text: string }>\n   499→      }>()\n   500→\n   501→      // Phoenix hook instance responsible for syncing this Vue component\n   502→      const live = useLiveVue()\n   503→\n   504→      // Server-side validation using changesets\n   505→      const { field, submit, isValid } = useLiveForm<{ text: string }>(() => props.form, {\n   506→        submitEvent: \"add_todo\",\n   507→        changeEvent: \"validate_todo\",\n   508→        debounceInMiliseconds: 50,\n   509→      })\n   510→\n   511→      const textField = field(\"text\")\n   512→\n   513→      // Local client-side state\n   514→      const filter = ref<FilterType>(\"all\")\n   515→\n   516→      const filterByType = (type: FilterType) => {\n   517→        switch (type) {\n   518→          case \"active\":\n   519→            return props.todos.filter((todo) => !todo.completed)\n   520→          case \"completed\":\n   521→            return props.todos.filter((todo) => todo.completed)\n   522→          default:\n   523→            return props.todos\n   524→        }\n   525→      }\n   526→      // Computed properties for reactive UI\n   527→      const filteredTodos = computed(() => filterByType(filter.value))\n   528→      const completedCount = computed(() => filterByType(\"completed\").length)\n   529→      </script>\n   530→\n   531→      <template>\n   532→        <div class=\"text-center\">\n   533→          <div class=\"max-w-2xl space-y-8\">\n   534→            <!-- Header -->\n   535→            <div>\n   536→              <h1 class=\"text-5xl font-bold\">🎉 Welcome to LiveVue!</h1>\n   537→              <p class=\"text-lg text-base-content/70\">Vue.js components seamlessly integrated with Phoenix LiveView</p>\n   538→            </div>\n   539→\n   540→            <!-- Todo Demo Card -->\n   541→            <div>\n   542→              <!-- Add Todo Form -->\n   543→              <form @submit.prevent=\"submit\" class=\"form-control mb-6\">\n   544→                <div class=\"join mb-2\">\n   545→                  <input\n   546→                    v-bind=\"textField.inputAttrs.value\"\n   547→                    type=\"text\"\n   548→                    placeholder=\"What needs to be done?\"\n   549→                    class=\"input input-bordered join-item flex-1\"\n   550→                  />\n   551→                  <button type=\"submit\" :disabled=\"!isValid\" class=\"btn btn-primary join-item\">Add Todo</button>\n   552→                </div>\n   553→                <div\n   554→                  v-if=\"(textField.isTouched.value || textField.isDirty.value) && textField.errorMessage.value\"\n   555→                  class=\"text-error text-xs\"\n   556→                >\n   557→                  {{ textField.errorMessage }}\n   558→                </div>\n   559→              </form>\n   560→\n   561→              <!-- Filter Buttons -->\n   562→              <div class=\"join mb-6 mx-auto\">\n   563→                <button\n   564→                  v-for=\"filterType in ['all', 'active', 'completed'] as FilterType[]\"\n   565→                  :key=\"filterType\"\n   566→                  @click=\"filter = filterType\"\n   567→                  :class=\"['btn btn-sm join-item', filter === filterType ? 'btn-active' : '']\"\n   568→                >\n   569→                  {{ filterType.charAt(0).toUpperCase() + filterType.slice(1) }}\n   570→                  ({{ filterByType(filterType).length }})\n   571→                </button>\n   572→              </div>\n   573→\n   574→              <!-- Todo List -->\n   575→              <div v-if=\"filteredTodos.length > 0\" class=\"space-y-2 mb-4\">\n   576→                <div v-for=\"todo in filteredTodos\" :key=\"todo.id\" class=\"card card-compact bg-base-200\">\n   577→                  <div class=\"card-body\">\n   578→                    <div class=\"flex items-center gap-3\">\n   579→                      <input\n   580→                        type=\"checkbox\"\n   581→                        :checked=\"todo.completed\"\n   582→                        @change=\"$live.pushEvent('toggle_todo', { id: todo.id })\"\n   583→                        class=\"checkbox checkbox-primary\"\n   584→                      />\n   585→                      <span :class=\"['flex-1 text-left', todo.completed ? 'line-through opacity-60' : '']\">\n   586→                        {{ todo.text }}\n   587→                      </span>\n   588→                      <button @click=\"$live.pushEvent('delete_todo', { id: todo.id })\" class=\"btn btn-error btn-sm\">\n   589→                        Delete\n   590→                      </button>\n   591→                    </div>\n   592→                  </div>\n   593→                </div>\n   594→              </div>\n   595→\n   596→              <div v-else class=\"alert\">\n   597→                <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" class=\"stroke-info shrink-0 w-6 h-6\">\n   598→                  <path\n   599→                    stroke-linecap=\"round\"\n   600→                    stroke-linejoin=\"round\"\n   601→                    stroke-width=\"2\"\n   602→                    d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"\n   603→                  ></path>\n   604→                </svg>\n   605→                <span>{{ filter === \"all\" ? \"No todos yet!\" : `No ${filter} todos!` }}</span>\n   606→              </div>\n   607→\n   608→              <!-- Actions -->\n   609→              <div v-if=\"props.todos.some((todo) => todo.completed)\" class=\"card-actions justify-between\">\n   610→                <span class=\"text-sm opacity-70\">{{ completedCount }} completed</span>\n   611→                <button @click=\"$live.pushEvent('clear_completed', {})\" class=\"btn btn-error btn-sm\">Clear completed</button>\n   612→              </div>\n   613→            </div>\n   614→\n   615→            <!-- Features Info -->\n   616→            <div class=\"alert alert-info\">\n   617→              <div>\n   618→                <h4 class=\"font-bold\">LiveVue Features Demonstrated:</h4>\n   619→                <ul class=\"text-sm mt-2 space-y-1\">\n   620→                  <li>✅ <strong>Reactive Props:</strong> Todos flow from server state</li>\n   621→                  <li>✅ <strong>Server Events:</strong> Add, toggle, delete todos send events to LiveView</li>\n   622→                  <li>✅ <strong>Local State:</strong> Filter buttons work entirely client-side</li>\n   623→                  <li>✅ <strong>Server-side Validation:</strong> Uses Ecto.Changeset</li>\n   624→                </ul>\n   625→              </div>\n   626→            </div>\n   627→          </div>\n   628→        </div>\n   629→      </template>\n   630→      \"\"\"\n   631→    end\n   632→\n   633→    defp server_js_content do\n   634→      \"\"\"\n   635→      import components from \"../vue\"\n   636→      import { getRender, loadManifest } from \"live_vue/server\"\n   637→\n   638→      // present only in prod build. Returns empty obj if doesn't exist\n   639→      // used to render preload links\n   640→      const manifest = loadManifest(\"../priv/static/.vite/ssr-manifest.json\")\n   641→      export const render = getRender(components, manifest)\n   642→      \"\"\"\n   643→    end\n   644→\n   645→    # Add vue_demo route to dev section of router.ex\n   646→    defp add_vue_demo_route(igniter) do\n   647→      web_module = Phoenix.web_module(igniter)\n   648→      web_folder = Macro.underscore(web_module)\n   649→      web_module_name = web_module |> Module.split() |> Enum.join(\".\")\n   650→      router_file = Path.join([\"lib\", web_folder, \"router.ex\"])\n   651→\n   652→      Igniter.update_file(igniter, router_file, fn source ->\n   653→        Rewrite.Source.update(source, :content, fn content ->\n   654→          # Add the vue_demo route to the dev section after live_dashboard\n   655→          if String.contains?(content, \"live \\\"/vue_demo\\\"\") do\n   656→            content\n   657→          else\n   658→            if String.contains?(content, \"live_dashboard\") do\n   659→              String.replace(\n   660→                content,\n   661→                ~r/(live_dashboard.*)/,\n   662→                \"\\\\1\\n      live \\\"/vue_demo\\\", #{web_module_name}.VueDemoLive\"\n   663→              )\n   664→            else\n   665→              # there is no live_dashboard, so we need to add the route to the browser pipeline\n   666→              String.replace(\n   667→                content,\n   668→                ~r/(pipe_through :browser.*)/,\n   669→                \"\\\\1\\n      live \\\"/dev/vue_demo\\\", #{web_module_name}.VueDemoLive\"\n   670→              )\n   671→            end\n   672→          end\n   673→        end)\n   674→      end)\n   675→    end\n   676→\n   677→    # Update home.html.heex template with LiveVue content\n   678→    defp update_home_template(igniter) do\n   679→      web_module = Phoenix.web_module(igniter)\n   680→      web_folder = Macro.underscore(web_module)\n   681→      home_template = Path.join([\"lib\", web_folder, \"controllers\", \"page_html\", \"home.html.heex\"])\n   682→\n   683→      Igniter.update_file(igniter, home_template, fn source ->\n   684→        Rewrite.Source.update(source, :content, fn content ->\n   685→          content\n   686→          |> String.replace(\n   687→            \"Peace of mind from prototype to production.\",\n   688→            \"End-to-end reactivity for your Live Vue apps.\"\n   689→          )\n   690→          |> String.replace(\n   691→            ~r/Build rich, interactive web applications quickly.*at scale\\./s,\n   692→            \"\"\"\n   693→            Congratulations, you've successfully created a LiveVue app with Phoenix!\n   694→                  We've automatically created two files for you: <br />\n   695→                  <code class=\"text-sm text-primary\">assets/vue/VueDemo.vue</code>\n   696→                  <br />\n   697→                  <code class=\"text-sm text-primary\">lib/#{web_folder}/live/vue_demo.ex</code>\n   698→                  <br /> Click the button below to see it in action.\\\n   699→            \"\"\"\n   700→          )\n   701→          |> String.replace(\n   702→            ~s(<div class=\"flex\">),\n   703→            ~s(<a href={~p\"/dev/vue_demo\"} class=\"btn btn-primary mt-4\">Vue Demo</a>\\n    <div class=\"flex\">)\n   704→          )\n   705→        end)\n   706→      end)\n   707→    end\n   708→\n   709→    # Update mix.exs aliases to include set_build_path function\n   710→    defp update_mix_aliases(igniter) do\n   711→      Igniter.update_file(igniter, \"mix.exs\", fn source ->\n   712→        Rewrite.Source.update(source, :content, fn content ->\n   713→          # Check if set_build_path function already exists\n   714→          if String.contains?(content, \"js/server.js\") do\n   715→            content\n   716→          else\n   717→            # Add the set_build_path function at the end of the module (before final end)\n   718→            String.replace(\n   719→              content,\n   720→              ~s(\"phoenix_vite.npm vite build\"),\n   721→              ~s(\"phoenix_vite.npm vite build --manifest --emptyOutDir true\", \"phoenix_vite.npm vite build --ssrManifest --emptyOutDir false --ssr js/server.js --outDir ../priv/static\")\n   722→            )\n   723→          end\n   724→        end)\n   725→      end)\n   726→    end\n   727→\n   728→    defp append_usage_rules_to_agents_md(igniter) do\n   729→      if Igniter.exists?(igniter, \"AGENTS.md\") do\n   730→        Igniter.update_file(igniter, \"AGENTS.md\", fn source ->\n   731→          Rewrite.Source.update(source, :content, fn content ->\n   732→            # Check if LiveVue usage rules are already added\n   733→            if String.contains?(content, \"<!-- live_vue-start -->\") do\n   734→              content\n   735→            else\n   736→              rules = \"\\n\\n<!-- live_vue-start -->\\n\" <> @usage_rules_content <> \"\\n<!-- live_vue-end -->\\n\"\n   737→              # Append just before the end of the file\n   738→              if String.contains?(content, \"<!-- usage-rules-end -->\") do\n   739→                String.replace(content, ~r/(<!-- usage-rules-end -->)/, rules <> \"\\\\1\")\n   740→              else\n   741→                content <> rules\n   742→              end\n   743→            end\n   744→          end)\n   745→        end)\n   746→      else\n   747→        igniter\n   748→      end\n   749→    end\n   750→\n   751→    defp update_gitignore(igniter) do\n   752→      Igniter.update_file(igniter, \".gitignore\", fn source ->\n   753→        Rewrite.Source.update(source, :content, fn content ->\n   754→          String.replace(content, \"/assets/node_modules\", \"node_modules\")\n   755→        end)\n   756→      end)\n   757→    end\n   758→  else\n   759→    use Mix.Task\n   760→\n   761→    @impl Mix.Task\n   762→    def run(_argv) do\n   763→      Mix.shell().error(\"\"\"\n   764→      The task 'live_vue.install' requires igniter. Please install igniter and try again.\n   765→\n   766→      For more information, see: https://hexdocs.pm/igniter/readme.html#installation\n   767→      \"\"\")\n   768→\n   769→      exit({:shutdown, 1})\n   770→    end\n   771→  end\n   772→end\n   773→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"64a1054d-d5d1-470b-988c-6d3926af5d5d","uuid":"44d76b07-1b11-481f-b6f1-e1b7a41ef1af","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/lib/mix/tasks/live_vue.install.ex","content":"defmodule Mix.Tasks.LiveVue.Install do\n  @moduledoc \"\"\"\n  Installer for LiveVue with Vite.\n\n  This task first installs Vite using the PhoenixVite installer,\n  then configures the project for LiveVue.\n\n  ## Options\n\n    * `--bun` - Use Bun instead of Node.js/npm\n\n  ## Examples\n\n      mix live_vue.install\n      mix live_vue.install --bun\n\n  \"\"\"\n\n  import Mix.Tasks.PhoenixVite.Install.Helper\n\n  @usage_rules_content File.read!(Path.join([__DIR__, \"../../../usage-rules.md\"]))\n  with_igniter do\n    use Igniter.Mix.Task\n\n    alias Igniter.Libs.Phoenix\n    alias Igniter.Project.Config\n\n    @impl Igniter.Mix.Task\n    def info(_argv, _parent) do\n      %Igniter.Mix.Task.Info{\n        composes: [\"phoenix_vite.install\"],\n        schema: [bun: :boolean],\n        aliases: [b: :bun]\n      }\n    end\n\n    @impl Igniter.Mix.Task\n    def igniter(igniter) do\n      app_name = Igniter.Project.Application.app_name(igniter)\n\n      igniter\n      |> Igniter.compose_task(\"phoenix_vite.install\", igniter.args.argv)\n      |> configure_environments(app_name)\n      |> add_live_vue_to_html_helpers(app_name)\n      |> update_javascript_configuration()\n      |> update_vite_configuration()\n      |> update_phoenix_vite_config()\n      |> configure_tailwind_for_vue()\n      |> update_package_json_for_vue()\n      |> create_vue_files()\n      |> setup_ssr_for_production(app_name)\n      |> update_mix_aliases()\n      |> add_vue_demo_route()\n      |> update_home_template()\n      |> update_gitignore()\n      |> append_usage_rules_to_agents_md()\n    end\n\n    # Configure environments (config/dev.exs and config/prod.exs)\n    defp configure_environments(igniter, _app_name) do\n      igniter\n      |> Config.configure(\"config.exs\", :live_vue, [:ssr], true)\n      |> Config.configure(\"dev.exs\", :live_vue, [:vite_host], \"http://localhost:5173\")\n      |> Config.configure(\"dev.exs\", :live_vue, [:ssr_module], {:code, Sourceror.parse_string!(\"LiveVue.SSR.ViteJS\")})\n      |> Config.configure(\"prod.exs\", :live_vue, [:ssr_module], {:code, Sourceror.parse_string!(\"LiveVue.SSR.NodeJS\")})\n      |> Config.configure(\"prod.exs\", :live_vue, [:ssr], true)\n    end\n\n    # Add LiveVue to html_helpers in lib/app_web.ex\n    defp add_live_vue_to_html_helpers(igniter, _app_name) do\n      web_module = Phoenix.web_module(igniter)\n      web_folder = Macro.underscore(web_module)\n      web_file = Path.join([\"lib\", web_folder <> \".ex\"])\n\n      Igniter.update_file(igniter, web_file, fn source ->\n        Rewrite.Source.update(source, :content, fn content ->\n          # Check if LiveVue is already added to avoid duplicate additions.\n          # Use regex to match \"use LiveVue\" as a standalone module, not as part of\n          # another module name (e.g., \"use LiveVueWebsiteWeb\" should not match).\n          if Regex.match?(~r/use LiveVue\\b/, content) do\n            content\n          else\n            # Get the short module name (without Elixir. prefix)\n            web_module_name = web_module |> Module.split() |> Enum.join(\".\")\n\n            # Add LiveVue support only in the html_helpers function\n            String.replace(\n              content,\n              ~r/(defp html_helpers do\\s+quote do\\s+# Translation\\s+use Gettext, backend: #{Regex.escape(web_module_name)}\\.Gettext)/,\n              \"\\\\1\\n\\n      # Add support for Vue components\\n      use LiveVue\\n\\n      # Generate component for each vue file, so you can use <.ComponentName> syntax\\n      # instead of <.vue v-component=\\\"ComponentName\\\">\\n      use LiveVue.Components, vue_root: [\\\"./assets/vue\\\", \\\"./lib/#{web_folder}\\\"]\"\n            )\n          end\n        end)\n      end)\n    end\n\n    # Update JavaScript configuration (app.js)\n    defp update_javascript_configuration(igniter) do\n      Igniter.update_file(igniter, \"assets/js/app.js\", fn source ->\n        Rewrite.Source.update(source, :content, fn content ->\n          content\n          |> add_live_vue_imports()\n          |> update_live_socket_hooks()\n        end)\n      end)\n    end\n\n    defp add_live_vue_imports(content) do\n      if String.contains?(content, \"import {getHooks} from \\\"live_vue\\\"\") do\n        content\n      else\n        String.replace(\n          content,\n          \"import topbar from \\\"topbar\\\"\",\n          ~s(import topbar from \"topbar\"\\nimport {getHooks} from \"live_vue\"\\nimport liveVueApp from \"../vue\")\n        )\n      end\n    end\n\n    defp update_live_socket_hooks(content) do\n      String.replace(\n        content,\n        \"hooks: {...colocatedHooks},\",\n        \"hooks: {...colocatedHooks, ...getHooks(liveVueApp)},\"\n      )\n    end\n\n    defp update_phoenix_vite_config(igniter) do\n      Config.configure(\n        igniter,\n        \"config.exs\",\n        :phoenix_vite,\n        [PhoenixVite.Npm, :assets],\n        {:code, Sourceror.parse_string!(~s|[args: [], cd: __DIR__]|)}\n      )\n    end\n\n    # Update Vite configuration\n    defp update_vite_configuration(igniter) do\n      Igniter.update_file(igniter, \"assets/vite.config.mjs\", fn source ->\n        Rewrite.Source.update(source, :content, fn content ->\n          content\n          |> add_vite_imports()\n          |> update_vite_server_config()\n          |> update_vite_optimized_deps()\n          |> update_vite_plugins()\n          |> update_vite_manifest()\n          |> add_ssr_vite_entry()\n        end)\n      end)\n    end\n\n    defp add_vite_imports(content) do\n      if String.contains?(content, \"import vue from\") do\n        content\n      else\n        String.replace(\n          content,\n          \"import { phoenixVitePlugin } from 'phoenix_vite'\",\n          ~s(import vue from \"@vitejs/plugin-vue\";\\nimport liveVuePlugin from \"live_vue/vitePlugin\";)\n        )\n      end\n    end\n\n    defp update_vite_server_config(content) do\n      if String.contains?(content, \"host: \\\"127.0.0.1\\\"\") do\n        content\n      else\n        String.replace(\n          content,\n          \"port: 5173,\",\n          \"host: \\\"127.0.0.1\\\",\\n    port: 5173,\"\n        )\n      end\n    end\n\n    defp update_vite_optimized_deps(content) do\n      String.replace(\n        content,\n        ~s(include: [\"phoenix\", \"phoenix_html\", \"phoenix_live_view\"],),\n        ~s(include: [\"live_vue\", \"phoenix\", \"phoenix_html\", \"phoenix_live_view\"],)\n      )\n    end\n\n    defp update_vite_plugins(content) do\n      # Replace the phoenixVitePlugin call with the Vue plugins while keeping tailwindcss\n      String.replace(\n        content,\n        ~r/phoenixVitePlugin\\(\\{\\s*pattern: \\/\\\\.\\(ex\\|heex\\)\\$\\/\\s*\\}\\)/s,\n        \"vue(),\\n    liveVuePlugin()\"\n      )\n    end\n\n    defp update_vite_manifest(content) do\n      if String.contains?(content, \"manifest: false\") do\n        content\n      else\n        String.replace(\n          content,\n          ~r/manifest: true,/s,\n          \"manifest: false,\\n    ssrManifest: false,\"\n        )\n      end\n    end\n\n    defp add_ssr_vite_entry(content) do\n      if String.contains?(content, \"noExternal\") do\n        content\n      else\n        String.replace(\n          content,\n          ~r/build: {/s,\n          \"ssr: { noExternal: process.env.NODE_ENV === \\\"production\\\" ? true : undefined },\\n    build: {\"\n        )\n      end\n    end\n\n    # Configure Tailwind to include Vue files\n    defp configure_tailwind_for_vue(igniter) do\n      Igniter.update_file(igniter, \"assets/css/app.css\", fn source ->\n        Rewrite.Source.update(source, :content, fn content ->\n          if String.contains?(content, \"@source \\\"../vue\\\";\") do\n            content\n          else\n            String.replace(\n              content,\n              \"@source \\\"../js\\\";\",\n              ~s(@source \"../js\";\\n@source \"../vue\";)\n            )\n          end\n        end)\n      end)\n    end\n\n    # Update package.json for Vue dependencies\n    defp update_package_json_for_vue(igniter) do\n      igniter\n      |> Igniter.move_file(\"assets/package.json\", \"package.json\")\n      |> Igniter.update_file(\"package.json\", fn source ->\n        Rewrite.Source.update(source, :content, fn _ ->\n          \"\"\"\n          {\n            \"dependencies\": {\n              \"@vueuse/core\": \"^13.7.0\",\n              \"live_vue\": \"file:./deps/live_vue\",\n              \"phoenix\": \"file:./deps/phoenix\",\n              \"phoenix_html\": \"file:./deps/phoenix_html\",\n              \"phoenix_live_view\": \"file:./deps/phoenix_live_view\",\n              \"topbar\": \"^3.0.0\",\n              \"vue\": \"^3.4.21\"\n            },\n            \"devDependencies\": {\n              \"@tailwindcss/vite\": \"^4.1.0\",\n              \"@vitejs/plugin-vue\": \"^5.0.4\",\n              \"daisyui\": \"^5.0.0\",\n              \"phoenix_vite\": \"file:./deps/phoenix_vite\",\n              \"tailwindcss\": \"^4.1.0\",\n              \"typescript\": \"^5.4.5\",\n              \"vite\": \"^6.3.0\",\n              \"vue-tsc\": \"^2.0.13\"\n            }\n          }\n          \"\"\"\n        end)\n      end)\n    end\n\n    # Create Vue files from templates\n    defp create_vue_files(igniter) do\n      web_module = Phoenix.web_module(igniter)\n      web_folder = Macro.underscore(web_module)\n\n      igniter\n      |> Igniter.compose_task(\"igniter.add_extension\", [\"phoenix\"])\n      |> Igniter.mkdir(\"assets/vue\")\n      |> Igniter.mkdir(\"lib/#{web_folder}/live\")\n      |> Igniter.create_new_file(\"assets/vue/index.ts\", vue_index_content())\n      |> Igniter.create_new_file(\"assets/vue/VueDemo.vue\", demo_vue_content())\n      |> Igniter.create_new_file(\"assets/js/server.js\", server_js_content())\n      |> Igniter.create_new_file(\n        \"assets/vue/.gitignore\",\n        \"# Ignore automatically generated Vue files by the ~V sigil\\n_build/\"\n      )\n      |> Igniter.create_new_file(\"lib/#{web_folder}/live/vue_demo_live.ex\", demo_live_view_content(igniter))\n      |> update_tsconfig_for_vue()\n    end\n\n    defp update_tsconfig_for_vue(igniter) do\n      web_module = Phoenix.web_module(igniter)\n      web_folder = Macro.underscore(web_module)\n\n      igniter\n      |> Igniter.rm(\"assets/tsconfig.json\")\n      |> Igniter.create_new_file(\"tsconfig.json\", \"\"\"\n      {\n        \"compilerOptions\": {\n          \"allowJs\": true,\n          \"baseUrl\": \".\",\n          \"lib\": [\"ES2015\", \"DOM\"],\n          \"module\": \"ESNext\",\n          \"moduleResolution\": \"bundler\",\n          \"noEmit\": true,\n          \"skipLibCheck\": true,\n          \"paths\": {\n            \"*\": [ \"./deps/*\", \"node_modules/*\" ]\n          },\n          \"strict\": true,\n          \"types\": [ \"vite/client\" ]\n        },\n        \"include\": [\n          \"./assets/js/**/*\",\n          \"./assets/vue/**/*\",\n          \"./lib/#{web_folder}/**/*\"\n        ],\n        \"exclude\": [\n          \"node_modules\"\n        ]\n      }\n      \"\"\")\n    end\n\n    # Setup SSR for production in application.ex\n    defp setup_ssr_for_production(igniter, _app_name) do\n      app_module = igniter |> Igniter.Project.Application.app_name() |> to_string()\n      app_file = \"lib/#{Macro.underscore(app_module)}/application.ex\"\n\n      # Use simple file update instead of complex AST manipulation\n      Igniter.update_file(igniter, app_file, fn source ->\n        Rewrite.Source.update(source, :content, fn content ->\n          # Look for the children list and add NodeJS.Supervisor right after the opening bracket\n          if String.contains?(content, \"children = [\") and not String.contains?(content, \"NodeJS.Supervisor\") do\n            String.replace(\n              content,\n              ~r/(children = \\[\\s*\\n)/,\n              \"\\\\1      {NodeJS.Supervisor, [path: LiveVue.SSR.NodeJS.server_path(), pool_size: 4]},\\n\"\n            )\n          else\n            content\n          end\n        end)\n      end)\n    end\n\n    defp vue_index_content do\n      \"\"\"\n      import { h, type Component } from \"vue\"\n      import { createLiveVue, findComponent, type LiveHook, type ComponentMap } from \"live_vue\"\n\n      // needed to make $live available in the Vue component\n      declare module \"vue\" {\n        interface ComponentCustomProperties {\n          $live: LiveHook\n        }\n      }\n\n      export default createLiveVue({\n        // name will be passed as-is in v-component of the .vue HEEX component\n        resolve: name => {\n          // we're importing from ../../lib to allow collocating Vue files with LiveView files\n          // eager: true disables lazy loading - all these components will be part of the app.js bundle\n          // more: https://vite.dev/guide/features.html#glob-import\n          const components = {\n            ...import.meta.glob(\"./**/*.vue\", { eager: true }),\n            ...import.meta.glob(\"../../lib/**/*.vue\", { eager: true }),\n          } as ComponentMap\n\n          // finds component by name or path suffix and gives a nice error message.\n          // `path/to/component/index.vue` can be found as `path/to/component` or simply `component`\n          // `path/to/Component.vue` can be found as `path/to/Component` or simply `Component`\n          return findComponent(components as ComponentMap, name)\n        },\n        // it's a default implementation of creating and mounting vue app, you can easily extend it to add your own plugins, directives etc.\n        setup: ({ createApp, component, props, slots, plugin, el }) => {\n          const app = createApp({ render: () => h(component as Component, props, slots) })\n          app.use(plugin)\n          // add your own plugins here\n          // app.use(pinia)\n          app.mount(el)\n          return app\n        },\n      })\n      \"\"\"\n    end\n\n    defp demo_live_view_content(igniter) do\n      web_module_name = Phoenix.web_module(igniter)\n\n      \"\"\"\n      defmodule #{inspect(web_module_name)}.VueDemoLive do\n        use #{inspect(web_module_name)}, :live_view\n\n        @impl true\n        def render(assigns) do\n          ~H\\\"\\\"\\\"\n          <Layouts.app flash={@flash}>\n            <.vue\n              todos={@todos}\n              form={@form}\n              v-component=\"VueDemo\"\n              v-socket={@socket}\n            />\n          </Layouts.app>\n          \\\"\\\"\\\"\n        end\n\n        @impl true\n        def mount(_params, _session, socket) do\n          socket =\n            socket\n            |> assign(:todos, [\n              %{id: 1, text: \"Learn LiveVue basics\", completed: true},\n              %{id: 2, text: \"Build an interactive component\", completed: false},\n              %{id: 3, text: \"Deploy to production\", completed: false}\n            ])\n            |> assign(:next_id, 4)\n            |> assign(:form, add_todo_form(%{text: \"\"}))\n\n          {:ok, socket}\n        end\n\n        @impl true\n        def handle_event(\"validate_todo\", %{\"todo\" => params}, socket) do\n          {:noreply, assign(socket, :form, add_todo_form(params))}\n        end\n\n        @impl true\n        def handle_event(\"add_todo\", %{\"todo\" => params}, socket) do\n          changeset = add_todo_changeset(params, socket.assigns.next_id)\n\n          case Ecto.Changeset.apply_action(changeset, :insert) do\n            {:ok, new_todo} ->\n              socket =\n                socket\n                |> assign(:todos, socket.assigns.todos ++ [new_todo])\n                |> assign(:next_id, socket.assigns.next_id + 1)\n                |> assign(:form, add_todo_form(%{text: \"\"}))\n\n              {:noreply, socket}\n\n            {:error, changeset} ->\n              {:noreply, assign(socket, :form, to_form(changeset, as: :todo))}\n          end\n        end\n\n        @impl true\n        def handle_event(\"toggle_todo\", %{\"id\" => id}, socket) do\n          todos =\n            Enum.map(socket.assigns.todos, fn todo ->\n              if todo.id == id, do: %{todo | completed: !todo.completed}, else: todo\n            end)\n\n          {:noreply, assign(socket, :todos, todos)}\n        end\n\n        @impl true\n        def handle_event(\"delete_todo\", %{\"id\" => id}, socket) do\n          todos = Enum.reject(socket.assigns.todos, fn todo -> todo.id == id end)\n          {:noreply, assign(socket, :todos, todos)}\n        end\n\n        @impl true\n        def handle_event(\"clear_completed\", _params, socket) do\n          todos = Enum.reject(socket.assigns.todos, fn todo -> todo.completed end)\n          {:noreply, assign(socket, :todos, todos)}\n        end\n\n        defp add_todo_changeset(params, id \\\\\\\\ nil) do\n          data = %{text: \"\", id: id, completed: false}\n          types = %{text: :string}\n\n          {data, types}\n          |> Ecto.Changeset.cast(params, Map.keys(types))\n          |> Ecto.Changeset.validate_required([:text])\n          |> Ecto.Changeset.validate_length(:text, min: 8, max: 50)\n        end\n\n        defp add_todo_form(params) do\n          params\n          |> add_todo_changeset()\n          |> Map.put(:action, :validate)\n          |> to_form(as: :todo)\n        end\n      end\n      \"\"\"\n    end\n\n    defp demo_vue_content do\n      \"\"\"\n      <script setup lang=\"ts\">\n      import { ref, computed } from \"vue\"\n      import { useLiveVue, Form, useLiveForm } from \"live_vue\"\n\n      type FilterType = \"all\" | \"active\" | \"completed\"\n\n      // Props from LiveView - server state\n      const props = defineProps<{\n        todos: Array<{ id: number; text: string; completed: boolean }>\n        form: Form<{ text: string }>\n      }>()\n\n      // Phoenix hook instance responsible for syncing this Vue component\n      const live = useLiveVue()\n\n      // Server-side validation using changesets\n      const { field, submit, isValid } = useLiveForm<{ text: string }>(() => props.form, {\n        submitEvent: \"add_todo\",\n        changeEvent: \"validate_todo\",\n        debounceInMiliseconds: 50,\n      })\n\n      const textField = field(\"text\")\n\n      // Local client-side state\n      const filter = ref<FilterType>(\"all\")\n\n      const filterByType = (type: FilterType) => {\n        switch (type) {\n          case \"active\":\n            return props.todos.filter((todo) => !todo.completed)\n          case \"completed\":\n            return props.todos.filter((todo) => todo.completed)\n          default:\n            return props.todos\n        }\n      }\n      // Computed properties for reactive UI\n      const filteredTodos = computed(() => filterByType(filter.value))\n      const completedCount = computed(() => filterByType(\"completed\").length)\n      </script>\n\n      <template>\n        <div class=\"text-center\">\n          <div class=\"max-w-2xl space-y-8\">\n            <!-- Header -->\n            <div>\n              <h1 class=\"text-5xl font-bold\">🎉 Welcome to LiveVue!</h1>\n              <p class=\"text-lg text-base-content/70\">Vue.js components seamlessly integrated with Phoenix LiveView</p>\n            </div>\n\n            <!-- Todo Demo Card -->\n            <div>\n              <!-- Add Todo Form -->\n              <form @submit.prevent=\"submit\" class=\"form-control mb-6\">\n                <div class=\"join mb-2\">\n                  <input\n                    v-bind=\"textField.inputAttrs.value\"\n                    type=\"text\"\n                    placeholder=\"What needs to be done?\"\n                    class=\"input input-bordered join-item flex-1\"\n                  />\n                  <button type=\"submit\" :disabled=\"!isValid\" class=\"btn btn-primary join-item\">Add Todo</button>\n                </div>\n                <div\n                  v-if=\"(textField.isTouched.value || textField.isDirty.value) && textField.errorMessage.value\"\n                  class=\"text-error text-xs\"\n                >\n                  {{ textField.errorMessage }}\n                </div>\n              </form>\n\n              <!-- Filter Buttons -->\n              <div class=\"join mb-6 mx-auto\">\n                <button\n                  v-for=\"filterType in ['all', 'active', 'completed'] as FilterType[]\"\n                  :key=\"filterType\"\n                  @click=\"filter = filterType\"\n                  :class=\"['btn btn-sm join-item', filter === filterType ? 'btn-active' : '']\"\n                >\n                  {{ filterType.charAt(0).toUpperCase() + filterType.slice(1) }}\n                  ({{ filterByType(filterType).length }})\n                </button>\n              </div>\n\n              <!-- Todo List -->\n              <div v-if=\"filteredTodos.length > 0\" class=\"space-y-2 mb-4\">\n                <div v-for=\"todo in filteredTodos\" :key=\"todo.id\" class=\"card card-compact bg-base-200\">\n                  <div class=\"card-body\">\n                    <div class=\"flex items-center gap-3\">\n                      <input\n                        type=\"checkbox\"\n                        :checked=\"todo.completed\"\n                        @change=\"$live.pushEvent('toggle_todo', { id: todo.id })\"\n                        class=\"checkbox checkbox-primary\"\n                      />\n                      <span :class=\"['flex-1 text-left', todo.completed ? 'line-through opacity-60' : '']\">\n                        {{ todo.text }}\n                      </span>\n                      <button @click=\"$live.pushEvent('delete_todo', { id: todo.id })\" class=\"btn btn-error btn-sm\">\n                        Delete\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <div v-else class=\"alert\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" class=\"stroke-info shrink-0 w-6 h-6\">\n                  <path\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    stroke-width=\"2\"\n                    d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"\n                  ></path>\n                </svg>\n                <span>{{ filter === \"all\" ? \"No todos yet!\" : `No ${filter} todos!` }}</span>\n              </div>\n\n              <!-- Actions -->\n              <div v-if=\"props.todos.some((todo) => todo.completed)\" class=\"card-actions justify-between\">\n                <span class=\"text-sm opacity-70\">{{ completedCount }} completed</span>\n                <button @click=\"$live.pushEvent('clear_completed', {})\" class=\"btn btn-error btn-sm\">Clear completed</button>\n              </div>\n            </div>\n\n            <!-- Features Info -->\n            <div class=\"alert alert-info\">\n              <div>\n                <h4 class=\"font-bold\">LiveVue Features Demonstrated:</h4>\n                <ul class=\"text-sm mt-2 space-y-1\">\n                  <li>✅ <strong>Reactive Props:</strong> Todos flow from server state</li>\n                  <li>✅ <strong>Server Events:</strong> Add, toggle, delete todos send events to LiveView</li>\n                  <li>✅ <strong>Local State:</strong> Filter buttons work entirely client-side</li>\n                  <li>✅ <strong>Server-side Validation:</strong> Uses Ecto.Changeset</li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </template>\n      \"\"\"\n    end\n\n    defp server_js_content do\n      \"\"\"\n      import components from \"../vue\"\n      import { getRender, loadManifest } from \"live_vue/server\"\n\n      // present only in prod build. Returns empty obj if doesn't exist\n      // used to render preload links\n      const manifest = loadManifest(\"../priv/static/.vite/ssr-manifest.json\")\n      export const render = getRender(components, manifest)\n      \"\"\"\n    end\n\n    # Add vue_demo route to dev section of router.ex\n    defp add_vue_demo_route(igniter) do\n      web_module = Phoenix.web_module(igniter)\n      web_folder = Macro.underscore(web_module)\n      web_module_name = web_module |> Module.split() |> Enum.join(\".\")\n      router_file = Path.join([\"lib\", web_folder, \"router.ex\"])\n\n      Igniter.update_file(igniter, router_file, fn source ->\n        Rewrite.Source.update(source, :content, fn content ->\n          # Add the vue_demo route to the dev section after live_dashboard\n          if String.contains?(content, \"live \\\"/vue_demo\\\"\") do\n            content\n          else\n            if String.contains?(content, \"live_dashboard\") do\n              String.replace(\n                content,\n                ~r/(live_dashboard.*)/,\n                \"\\\\1\\n      live \\\"/vue_demo\\\", #{web_module_name}.VueDemoLive\"\n              )\n            else\n              # there is no live_dashboard, so we need to add the route to the browser pipeline\n              String.replace(\n                content,\n                ~r/(pipe_through :browser.*)/,\n                \"\\\\1\\n      live \\\"/dev/vue_demo\\\", #{web_module_name}.VueDemoLive\"\n              )\n            end\n          end\n        end)\n      end)\n    end\n\n    # Update home.html.heex template with LiveVue content\n    defp update_home_template(igniter) do\n      web_module = Phoenix.web_module(igniter)\n      web_folder = Macro.underscore(web_module)\n      home_template = Path.join([\"lib\", web_folder, \"controllers\", \"page_html\", \"home.html.heex\"])\n\n      Igniter.update_file(igniter, home_template, fn source ->\n        Rewrite.Source.update(source, :content, fn content ->\n          content\n          |> String.replace(\n            \"Peace of mind from prototype to production.\",\n            \"End-to-end reactivity for your Live Vue apps.\"\n          )\n          |> String.replace(\n            ~r/Build rich, interactive web applications quickly.*at scale\\./s,\n            \"\"\"\n            Congratulations, you've successfully created a LiveVue app with Phoenix!\n                  We've automatically created two files for you: <br />\n                  <code class=\"text-sm text-primary\">assets/vue/VueDemo.vue</code>\n                  <br />\n                  <code class=\"text-sm text-primary\">lib/#{web_folder}/live/vue_demo.ex</code>\n                  <br /> Click the button below to see it in action.\\\n            \"\"\"\n          )\n          |> String.replace(\n            ~s(<div class=\"flex\">),\n            ~s(<a href={~p\"/dev/vue_demo\"} class=\"btn btn-primary mt-4\">Vue Demo</a>\\n    <div class=\"flex\">)\n          )\n        end)\n      end)\n    end\n\n    # Update mix.exs aliases to include set_build_path function\n    defp update_mix_aliases(igniter) do\n      Igniter.update_file(igniter, \"mix.exs\", fn source ->\n        Rewrite.Source.update(source, :content, fn content ->\n          # Check if set_build_path function already exists\n          if String.contains?(content, \"js/server.js\") do\n            content\n          else\n            # Add the set_build_path function at the end of the module (before final end)\n            String.replace(\n              content,\n              ~s(\"phoenix_vite.npm vite build\"),\n              ~s(\"phoenix_vite.npm vite build --manifest --emptyOutDir true\", \"phoenix_vite.npm vite build --ssrManifest --emptyOutDir false --ssr js/server.js --outDir ../priv/static\")\n            )\n          end\n        end)\n      end)\n    end\n\n    defp append_usage_rules_to_agents_md(igniter) do\n      if Igniter.exists?(igniter, \"AGENTS.md\") do\n        Igniter.update_file(igniter, \"AGENTS.md\", fn source ->\n          Rewrite.Source.update(source, :content, fn content ->\n            # Check if LiveVue usage rules are already added\n            if String.contains?(content, \"<!-- live_vue-start -->\") do\n              content\n            else\n              rules = \"\\n\\n<!-- live_vue-start -->\\n\" <> @usage_rules_content <> \"\\n<!-- live_vue-end -->\\n\"\n              # Append just before the end of the file\n              if String.contains?(content, \"<!-- usage-rules-end -->\") do\n                String.replace(content, ~r/(<!-- usage-rules-end -->)/, rules <> \"\\\\1\")\n              else\n                content <> rules\n              end\n            end\n          end)\n        end)\n      else\n        igniter\n      end\n    end\n\n    defp update_gitignore(igniter) do\n      Igniter.update_file(igniter, \".gitignore\", fn source ->\n        Rewrite.Source.update(source, :content, fn content ->\n          String.replace(content, \"/assets/node_modules\", \"node_modules\")\n        end)\n      end)\n    end\n  else\n    use Mix.Task\n\n    @impl Mix.Task\n    def run(_argv) do\n      Mix.shell().error(\"\"\"\n      The task 'live_vue.install' requires igniter. Please install igniter and try again.\n\n      For more information, see: https://hexdocs.pm/igniter/readme.html#installation\n      \"\"\")\n\n      exit({:shutdown, 1})\n    end\n  end\nend\n","numLines":773,"startLine":1,"totalLines":773}}}
