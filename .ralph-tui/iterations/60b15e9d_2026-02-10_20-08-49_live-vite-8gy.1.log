ting ones)\\n   224→    await page.fill('[data-testid=\\\"name-input\\\"]', \\\"Item 4\\\")\\n   225→    await page.fill('[data-testid=\\\"description-input\\\"]', \\\"Fourth item\\\")\\n   226→    await page.click('[data-testid=\\\"add-button\\\"]')\\n   227→    await syncLV(page)\\n   228→\\n   229→    // Check that new item appears at the end\\n   230→    const item4Name = await page.locator('[data-testid=\\\"item-4\\\"] [data-testid=\\\"item-name\\\"]').textContent()\\n   231→    expect(item4Name).toBe(\\\"Item 4\\\")\\n   232→\\n   233→    // Remove middle item and check order is maintained\\n   234→    await page.click('[data-testid=\\\"remove-2\\\"]')\\n   235→    await syncLV(page)\\n   236→\\n   237→    // Items 1, 3, 4 should still be in correct order\\n   238→    await expect(page.locator('[data-testid=\\\"item-1\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Item 1\\\")\\n   239→    await expect(page.locator('[data-testid=\\\"item-3\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Item 3\\\")\\n   240→    await expect(page.locator('[data-testid=\\\"item-4\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Item 4\\\")\\n   241→  })\\n   242→\\n   243→  test(\\\"maintains correct item order after stream reset\\\", async ({ page }) => {\\n   244→    // Add some items and clear to modify the stream\\n   245→    await page.fill('[data-testid=\\\"name-input\\\"]', \\\"Extra Item\\\")\\n   246→    await page.fill('[data-testid=\\\"description-input\\\"]', \\\"Extra description\\\")\\n   247→    await page.click('[data-testid=\\\"add-button\\\"]')\\n   248→    await syncLV(page)\\n   249→\\n   250→    // Reset the stream\\n   251→    await page.click('[data-testid=\\\"reset-button\\\"]')\\n   252→    await syncLV(page)\\n   253→\\n   254→    // Verify items appear in correct order: Item 1, Item 2, Item 3\\n   255→    const allItems = await page.locator('[data-testid=\\\"item-name\\\"]').allTextContents()\\n   256→    expect(allItems).toEqual([\\\"Item 1\\\", \\\"Item 2\\\", \\\"Item 3\\\"])\\n   257→\\n   258→    // Reset the stream\\n   259→    await page.click('[data-testid=\\\"reset-button-at-0\\\"]')\\n   260→    await syncLV(page)\\n   261→\\n   262→    // Verify items appear in correct order: Item 1, Item 2, Item 3\\n   263→    const allReversedItems = await page.locator('[data-testid=\\\"item-name\\\"]').allTextContents()\\n   264→    expect(allReversedItems).toEqual([\\\"Item 3\\\", \\\"Item 2\\\", \\\"Item 1\\\"])\\n   265→  })\\n   266→\\n   267→  // Limit operation tests\\n   268→  test.describe(\\\"Limit Operations\\\", () => {\\n   269→    test.beforeEach(async ({ page }) => {\\n   270→      await page.goto(\\\"/streams\\\")\\n   271→      await syncLV(page)\\n   272→    })\\n   273→\\n   274→    test(\\\"adds multiple items at start with positive limit\\\", async ({ page }) => {\\n   275→      // Verify initial state: 3 items\\n   276→      await expect(page.locator('h3:has-text(\\\"Items\\\")')).toHaveText(\\\"Items (3)\\\")\\n   277→\\n   278→      // Add 3 items at start with limit 5 (should keep first 5 items)\\n   279→      await page.click('[data-testid=\\\"add-multiple-start-button\\\"]')\\n   280→      await syncLV(page)\\n   281→\\n   282→      // Should have 5 items total (3 new + 3 original, but limited to 5)\\n   283→      await expect(page.locator('h3:has-text(\\\"Items\\\")')).toHaveText(\\\"Items (5)\\\")\\n   284→\\n   285→      // Check that new items are at the start and in correct order\\n   286→      // Expected order: Start Item C, Start Item B, Start Item A, Item 1, Item 2\\n   287→      // (Note: items are added at position 0 in reverse order)\\n   288→      await expect(page.locator('[data-testid=\\\"item-6\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Start Item C\\\")\\n   289→      await expect(page.locator('[data-testid=\\\"item-5\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Start Item B\\\")\\n   290→      await expect(page.locator('[data-testid=\\\"item-4\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Start Item A\\\")\\n   291→      await expect(page.locator('[data-testid=\\\"item-1\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Item 1\\\")\\n   292→      await expect(page.locator('[data-testid=\\\"item-2\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Item 2\\\")\\n   293→\\n   294→      // Item 3 should be removed due to limit 5\\n   295→      await expect(page.locator('[data-testid=\\\"item-3\\\"]')).not.toBeVisible()\\n   296→    })\\n   297→\\n   298→    test(\\\"adds multiple items at end with negative limit\\\", async ({ page }) => {\\n   299→      // Verify initial state: 3 items\\n   300→      await expect(page.locator('h3:has-text(\\\"Items\\\")')).toHaveText(\\\"Items (3)\\\")\\n   301→\\n   302→      // Add 3 items at end with negative limit -5 (should keep last 5 items)\\n   303→      await page.click('[data-testid=\\\"add-multiple-end-button\\\"]')\\n   304→      await syncLV(page)\\n   305→\\n   306→      // Should have 5 items total (3 original + 3 new, but limited to last 5)\\n   307→      await expect(page.locator('h3:has-text(\\\"Items\\\")')).toHaveText(\\\"Items (5)\\\")\\n   308→\\n   309→      // Check that new items are at the end and original items remain\\n   310→      // Expected order: Item 2, Item 3, End Item X, End Item Y, End Item Z\\n   311→      // (Item 1 should be removed due to negative limit -5)\\n   312→      await expect(page.locator('[data-testid=\\\"item-1\\\"]')).not.toBeVisible()\\n   313→      await expect(page.locator('[data-testid=\\\"item-2\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Item 2\\\")\\n   314→      await expect(page.locator('[data-testid=\\\"item-3\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Item 3\\\")\\n   315→      await expect(page.locator('[data-testid=\\\"item-4\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"End Item X\\\")\\n   316→      await expect(page.locator('[data-testid=\\\"item-5\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"End Item Y\\\")\\n   317→      await expect(page.locator('[data-testid=\\\"item-6\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"End Item Z\\\")\\n   318→    })\\n   319→\\n   320→    test(\\\"adds single item with custom positive limit\\\", async ({ page }) => {\\n   321→      // Set positive limit to 2\\n   322→      await page.fill('[data-testid=\\\"positive-limit-input\\\"]', \\\"2\\\")\\n   323→\\n   324→      // Add item with positive limit 2\\n   325→      await page.click('[data-testid=\\\"add-positive-limit-button\\\"]')\\n   326→      await syncLV(page)\\n   327→\\n   328→      // Should have only 2 items (limited to first 2)\\n   329→      await expect(page.locator('h3:has-text(\\\"Items\\\")')).toHaveText(\\\"Items (2)\\\")\\n   330→\\n   331→      // Check which items remain (should be original Item 1 and new limited item)\\n   332→      await expect(page.locator('[data-testid=\\\"item-1\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Item 1\\\")\\n   333→      await expect(page.locator('[data-testid=\\\"item-4\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Limited Item +2\\\")\\n   334→\\n   335→      // Items 2 and 3 should be removed\\n   336→      await expect(page.locator('[data-testid=\\\"item-2\\\"]')).not.toBeVisible()\\n   337→      await expect(page.locator('[data-testid=\\\"item-3\\\"]')).not.toBeVisible()\\n   338→    })\\n   339→\\n   340→    test(\\\"adds single item with custom negative limit\\\", async ({ page }) => {\\n   341→      // Set negative limit to 2\\n   342→      await page.fill('[data-testid=\\\"negative-limit-input\\\"]', \\\"2\\\")\\n   343→\\n   344→      // Add item with negative limit -2\\n   345→      await page.click('[data-testid=\\\"add-negative-limit-button\\\"]')\\n   346→      await syncLV(page)\\n   347→\\n   348→      // Should have only 2 items (limited to last 2)\\n   349→      await expect(page.locator('h3:has-text(\\\"Items\\\")'