eckbox\\\" })\\n    39→const newsletterField = form.field(\\\"newsletter\\\", { type: \\\"checkbox\\\" })\\n    40→\\n    41→// Multi-checkbox fields for preferences\\n    42→const emailPrefField = form.field(\\\"preferences\\\", { type: \\\"checkbox\\\", value: \\\"email\\\" })\\n    43→const smsPrefField = form.field(\\\"preferences\\\", { type: \\\"checkbox\\\", value: \\\"sms\\\" })\\n    44→const pushPrefField = form.field(\\\"preferences\\\", { type: \\\"checkbox\\\", value: \\\"push\\\" })\\n    45→\\n    46→// Nested object fields\\n    47→const profileField = form.field(\\\"profile\\\")\\n    48→const bioField = profileField.field(\\\"bio\\\")\\n    49→\\n    50→// Array fields\\n    51→const skillsArray = form.fieldArray(\\\"profile.skills\\\")\\n    52→const itemsArray = form.fieldArray(\\\"items\\\")\\n    53→\\n    54→const submitForm = async () => {\\n    55→  try {\\n    56→    await form.submit()\\n    57→  } catch (error) {\\n    58→    console.error(\\\"Form submission failed:\\\", error)\\n    59→  }\\n    60→}\\n    61→</script>\\n    62→\\n    63→<template>\\n    64→  <div class=\\\"form-test-container\\\" data-pw-form>\\n    65→    <h1>Form Test</h1>\\n    66→\\n    67→    <!-- Form State Display -->\\n    68→    <div class=\\\"form-state\\\" data-pw-form-state>\\n    69→      <div data-pw-is-valid>Valid: {{ form.isValid.value ? \\\"true\\\" : \\\"false\\\" }}</div>\\n    70→      <div data-pw-is-dirty>Dirty: {{ form.isDirty.value ? \\\"true\\\" : \\\"false\\\" }}</div>\\n    71→      <div data-pw-is-touched>Touched: {{ form.isTouched.value ? \\\"true\\\" : \\\"false\\\" }}</div>\\n    72→      <div data-pw-values>\\n    73→        Values:\\n    74→        <pre>{{ JSON.stringify(props.form, null, 2) }}</pre>\\n    75→      </div>\\n    76→    </div>\\n    77→\\n    78→    <!-- Basic Fields -->\\n    79→    <div class=\\\"basic-fields\\\">\\n    80→      <div class=\\\"field\\\">\\n    81→        <label :for=\\\"nameField.inputAttrs.value.id\\\">Name</label>\\n    82→        <input\\n    83→          :value=\\\"nameField.inputAttrs.value.value\\\"\\n    84→          @input=\\\"nameField.inputAttrs.value.onInput\\\"\\n    85→          @blur=\\\"nameField.inputAttrs.value.onBlur\\\"\\n    86→          :name=\\\"nameField.inputAttrs.value.name\\\"\\n    87→          :id=\\\"nameField.inputAttrs.value.id\\\"\\n    88→          :aria-invalid=\\\"nameField.inputAttrs.value['aria-invalid']\\\"\\n    89→          :aria-describedby=\\\"nameField.inputAttrs.value['aria-describedby']\\\"\\n    90→          data-pw-name-input\\n    91→          placeholder=\\\"Enter name\\\"\\n    92→        />\\n    93→        <div v-if=\\\"nameField.errorMessage.value\\\" class=\\\"error\\\" data-pw-name-error>\\n    94→          {{ nameField.errorMessage.value }}\\n    95→        </div>\\n    96→      </div>\\n    97→\\n    98→      <div class=\\\"field\\\">\\n    99→        <label :for=\\\"emailField.inputAttrs.value.id\\\">Email</label>\\n   100→        <input\\n   101→          :value=\\\"emailField.inputAttrs.value.value\\\"\\n   102→          @input=\\\"emailField.inputAttrs.value.onInput\\\"\\n   103→          @blur=\\\"emailField.inputAttrs.value.onBlur\\\"\\n   104→          :name=\\\"emailField.inputAttrs.value.name\\\"\\n   105→          :id=\\\"emailField.inputAttrs.value.id\\\"\\n   106→          :aria-invalid=\\\"emailField.inputAttrs.value['aria-invalid']\\\"\\n   107→          :aria-describedby=\\\"emailField.inputAttrs.value['aria-describedby']\\\"\\n   108→          data-pw-email-input\\n   109→          type=\\\"email\\\"\\n   110→          placeholder=\\\"Enter email\\\"\\n   111→        />\\n   112→        <div v-if=\\\"emailField.errorMessage.value\\\" class=\\\"error\\\" data-pw-email-error>\\n   113→          {{ emailField.errorMessage.value }}\\n   114→        </div>\\n   115→      </div>\\n   116→\\n   117→      <div class=\\\"field\\\">\\n   118→        <label :for=\\\"ageField.inputAttrs.value.id\\\">Age</label>\\n   119→        <input v-bind=\\\"ageField.inputAttrs.value\\\" data-pw-age-input type=\\\"number\\\" placeholder=\\\"Enter age\\\" />\\n   120→        <div v-if=\\\"ageField.errorMessage.value\\\" class=\\\"error\\\" data-pw-age-error>\\n   121→          {{ ageField.errorMessage.value }}\\n   122→        </div>\\n   123→      </div>\\n   124→    </div>\\n   125→\\n   126→    <!-- Checkbox Fields -->\\n   127→    <div class=\\\"checkbox-fields\\\">\\n   128→      <h3>Checkboxes</h3>\\n   129→\\n   130→      <!-- Single Checkbox -->\\n   131→      <div class=\\\"field checkbox-field\\\">\\n   132→        <label>\\n   133→          <input v-bind=\\\"acceptTermsField.inputAttrs.value\\\" data-pw-accept-terms />\\n   134→          Accept Terms and Conditions\\n   135→        </label>\\n   136→        <div v-if=\\\"acceptTermsField.errorMessage.value\\\" class=\\\"error\\\" data-pw-accept-terms-error>\\n   137→          {{ acceptTermsField.errorMessage.value }}\\n   138→        </div>\\n   139→      </div>\\n   140→\\n   141→      <!-- Another Single Checkbox -->\\n   142→      <div class=\\\"field checkbox-field\\\">\\n   143→        <label>\\n   144→          <input v-bind=\\\"newsletterField.inputAttrs.value\\\" data-pw-newsletter />\\n   145→          Subscribe to Newsletter\\n   146→        </label>\\n   147→        <div v-if=\\\"newsletterField.errorMessage.value\\\" class=\\\"error\\\" data-pw-newsletter-error>\\n   148→          {{ newsletterField.errorMessage.value }}\\n   149→        </div>\\n   150→      </div>\\n   151→\\n   152→      <!-- Multi-Checkbox (Array of Values) -->\\n   153→      <div class=\\\"field\\\">\\n   154→        <label>Preferences (select multiple)</label>\\n   155→        <div class=\\\"checkbox-group\\\">\\n   156→          <label class=\\\"checkbox-option\\\">\\n   157→            <input v-bind=\\\"emailPrefField.inputAttrs.value\\\" data-pw-preferences-email />\\n   158→            Email Notifications\\n   159→          </label>\\n   160→          <label class=\\\"checkbox-option\\\">\\n   161→            <input v-bind=\\\"smsPrefField.inputAttrs.value\\\" data-pw-preferences-sms />\\n   162→            SMS Notifications\\n   163→          </label>\\n   164→          <label class=\\\"checkbox-option\\\">\\n   165→            <input v-bind=\\\"pushPrefField.inputAttrs.value\\\" data-pw-preferences-push />\\n   166→            Push Notifications\\n   167→          </label>\\n   168→        </div>\\n   169→        <div v-if=\\\"emailPrefField.errorMessage.value\\\" class=\\\"error\\\" data-pw-preferences-error>\\n   170→          {{ emailPrefField.errorMessage.value }}\\n   171→        </div>\\n   172→      </div>\\n   173→    </div>\\n   174→\\n   175→    <!-- Nested Fields -->\\n   176→    <div class=\\\"nested-fields\\\">\\n   177→      <h3>Profile</h3>\\n   178→      <div class=\\\"field\\\">\\n   179→        <label :for=\\\"bioField.inputAttrs.value.id\\\">Bio</label>\\n   180→        <textarea v-bind=\\\"bioField.inputAttrs.value\\\" data-pw-bio-input placeholder=\\\"Enter bio\\\" rows=\\\"3\\\"></textarea>\\n   181→        <div v-if=\\\"bioField.errorMessage.value\\\" class=\\\"error\\\" data-pw-bio-error>\\n   182→          {{ bioField.errorMessage.value }}\\n   183→        </div>\\n   184→      </div>\\n   185→    </div>\\n   186→\\n   187→    <!-- Skills Array -->\\n   188→    <div class=\\\"skills-section\\\">\\n   189→      <div class=\\\"skills-header\\\">\\n   190→        <h3>Skills</h3>\\n   191→        <button @click=\\\"skillsArray.add('')\\\" data-pw-add-skill>Add Skill</button>\\n   192→      </div>\\n   193→\\n   194→      <div class=\\\"skills-list\\\">\\n   195→        <div\\n   196→          v-for=\\\"(skillField, index) in skillsArray.fields.value\\\"\\n   197→          :key=\\\"index\\\"\\n   198→          class=\\\"skill-item\\\"\\n   199→          :data-pw-skill-item=\\\"index\\\"\\n   200→        >\\n   201→          <input v-bind=\\\"skillField.inputAttrs.value\\\" :data-pw-skill-input=\\\"index\\\" placeholder=\\\"Enter skill\\\" />\\n   202→          <button @click=\\\"() => skillsArray.remove(index)\\\" :data-pw-remove-skill=\\\"index\\\">Remove</button>\\n   203→        </div>\\n   204→      </div>\\n   205→    </div>\\n   206→\\n   207→    <!-- Items Array with nested tags -->\\n   208→    <div class=\\\"items-section\\\">\\n   209→      <div class=\\\"items-header\\\">\\n   210→        <h3>Items</h3>\\n   211→        <button @click=\\\"() => itemsArray.add({ title: '', tags: [] })\\\" data-pw-add-item>Add Item</button>\\n   212→      </div>\\n   213→\\n   214→      <div class=\\\"items-list\\\">\\n   215→        <div\\n   216→          v-for=\\\"(itemField, itemIndex) in itemsArray.fields.value\\\"\\n   217→          :key=\\\"itemIndex\\\"\\n   218→          class=\\\"item\\\"\\n   219→          :data-pw-item=\\\"itemIndex\\\"\\n   220→        >\\n   221→          <div class=\\\"item-header\\\">\\n   222→            <h4>Item {{ itemIndex + 1 }}</h4>\\n   223→            <button @click=\\\"() => itemsArray.remove(itemIndex)\\\" :data-pw-remove-item=\\\"itemIndex\\\">Remove Item</button>\\n   224→          </div>\\n   225→\\n   226→          <div class=\\\"field\\\">\\n   227→            <label>Title</label>\\n   228→            <input\\n   229→              v-bind=\\\"itemField.field('title').inputAttrs.value\\\"\\n   230→              :data-pw-item-title=\\\"itemIndex\\\"\\n   231→              placeholder=\\\"Enter item title\\\"\\n   232→            />\\n   233→            <div v-if=\\\"itemField.field('title').errorMessage.value\\\" class=\\\"error\\\">\\n   234→              {{ itemField.field(\\\"title\\\").errorMessage.value }}\\n   235→            </div>\\n   236→          </div>\\n   237→\\n   238→          <!-- Tags for this item -->\\n   239→          <div class=\\\"tags-section\\\">\\n   240→            <div class=\\\"tags-header\\\">\\n   241→              <label>Tags</label>\\n   242→              <button @click=\\\"() => itemsArray.fieldArray(`[${itemIndex}].tags`).add('')\\\" :data-pw-add-tag=\\\"itemIndex\\\">\\n   243→                Add Tag\\n   244→              </button>\\n   245→            </div>\\n   246→\\n   247→            <div class=\\\"tags-list\\\">\\n   248→              <div\\n   249→                v-for=\\\"(tagField, tagIndex) in itemField.fieldArray('tags').fields.value\\\"\\n   250→                :key=\\\"tagIndex\\\"\\n   251→                class=\\\"tag-item\\\"\\n   252→                :data-pw-tag-item=\\\"`${itemIndex}-${tagIndex}`\\\"\\n   253→              >\\n   254→                <input\\n   255→                  v-bind=\\\"tagField.inputAttrs.value\\\"\\n   256→                  :data-pw-tag-input=\\\"`${itemIndex}-${tagIndex}`\\\"\\n   257→                  placeholder=\\\"Enter tag\\\"\\n   258→                />\\n   259→                <button\\n   260→                  @click=\\\"() => itemsArray.fieldArray(`[${itemIndex}].tags`).remove(tagIndex)\\\"\\n   261→                  :data-pw-remove-tag=\\\"`${itemIndex}-${tagIndex}`\\\"\\n   262→                >\\n   263→                  Remove\\n   264→                </button>\\n   265→              </div>\\n   266→            </div>\\n   267→          </div>\\n   268→        </div>\\n   269→      </div>\\n   270→    </div>\\n   271→\\n   272→    <!-- Form Actions -->\\n   273→    <div class=\\\"form-actions\\\">\\n   274→      <button @click=\\\"form.reset()\\\" data-pw-reset>Reset</button>\\n   275→      <button @click=\\\"submitForm\\\" :disabled=\\\"!form.isValid.value\\\" data-pw-submit>Submit</button>\\n   276→    </div>\\n   277→  </div>\\n   278→</template>\\n   279→\\n   280→<style scoped>\\n   281→.form-test-container {\\n   282→  max-width: 600px;\\n   283→  margin: 0 auto;\\n   284→  padding: 20px;\\n   285→}\\n   286→\\n   287→.form-state {\\n   288→  background: #f5f5f5;\\n   289→  padding: 10px;\\n   290→  margin-bottom: 20px;\\n   291→  border-radius: 4px;\\n 