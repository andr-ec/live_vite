      {{ emailPrefField.errorMessage.value }}\\n   171→        </div>\\n   172→      </div>\\n   173→    </div>\\n   174→\\n   175→    <!-- Nested Fields -->\\n   176→    <div class=\\\"nested-fields\\\">\\n   177→      <h3>Profile</h3>\\n   178→      <div class=\\\"field\\\">\\n   179→        <label :for=\\\"bioField.inputAttrs.value.id\\\">Bio</label>\\n   180→        <textarea v-bind=\\\"bioField.inputAttrs.value\\\" data-pw-bio-input placeholder=\\\"Enter bio\\\" rows=\\\"3\\\"></textarea>\\n   181→        <div v-if=\\\"bioField.errorMessage.value\\\" class=\\\"error\\\" data-pw-bio-error>\\n   182→          {{ bioField.errorMessage.value }}\\n   183→        </div>\\n   184→      </div>\\n   185→    </div>\\n   186→\\n   187→    <!-- Skills Array -->\\n   188→    <div class=\\\"skills-section\\\">\\n   189→      <div class=\\\"skills-header\\\">\\n   190→        <h3>Skills</h3>\\n   191→        <button @click=\\\"skillsArray.add('')\\\" data-pw-add-skill>Add Skill</button>\\n   192→      </div>\\n   193→\\n   194→      <div class=\\\"skills-list\\\">\\n   195→        <div\\n   196→          v-for=\\\"(skillField, index) in skillsArray.fields.value\\\"\\n   197→          :key=\\\"index\\\"\\n   198→          class=\\\"skill-item\\\"\\n   199→          :data-pw-skill-item=\\\"index\\\"\\n   200→        >\\n   201→          <input v-bind=\\\"skillField.inputAttrs.value\\\" :data-pw-skill-input=\\\"index\\\" placeholder=\\\"Enter skill\\\" />\\n   202→          <button @click=\\\"() => skillsArray.remove(index)\\\" :data-pw-remove-skill=\\\"index\\\">Remove</button>\\n   203→        </div>\\n   204→      </div>\\n   205→    </div>\\n   206→\\n   207→    <!-- Items Array with nested tags -->\\n   208→    <div class=\\\"items-section\\\">\\n   209→      <div class=\\\"items-header\\\">\\n   210→        <h3>Items</h3>\\n   211→        <button @click=\\\"() => itemsArray.add({ title: '', tags: [] })\\\" data-pw-add-item>Add Item</button>\\n   212→      </div>\\n   213→\\n   214→      <div class=\\\"items-list\\\">\\n   215→        <div\\n   216→          v-for=\\\"(itemField, itemIndex) in itemsArray.fields.value\\\"\\n   217→          :key=\\\"itemIndex\\\"\\n   218→          class=\\\"item\\\"\\n   219→          :data-pw-item=\\\"itemIndex\\\"\\n   220→        >\\n   221→          <div class=\\\"item-header\\\">\\n   222→            <h4>Item {{ itemIndex + 1 }}</h4>\\n   223→            <button @click=\\\"() => itemsArray.remove(itemIndex)\\\" :data-pw-remove-item=\\\"itemIndex\\\">Remove Item</button>\\n   224→          </div>\\n   225→\\n   226→          <div class=\\\"field\\\">\\n   227→            <label>Title</label>\\n   228→            <input\\n   229→              v-bind=\\\"itemField.field('title').inputAttrs.value\\\"\\n   230→              :data-pw-item-title=\\\"itemIndex\\\"\\n   231→              placeholder=\\\"Enter item title\\\"\\n   232→            />\\n   233→            <div v-if=\\\"itemField.field('title').errorMessage.value\\\" class=\\\"error\\\">\\n   234→              {{ itemField.field(\\\"title\\\").errorMessage.value }}\\n   235→            </div>\\n   236→          </div>\\n   237→\\n   238→          <!-- Tags for this item -->\\n   239→          <div class=\\\"tags-section\\\">\\n   240→            <div class=\\\"tags-header\\\">\\n   241→              <label>Tags</label>\\n   242→              <button @click=\\\"() => itemsArray.fieldArray(`[${itemIndex}].tags`).add('')\\\" :data-pw-add-tag=\\\"itemIndex\\\">\\n   243→                Add Tag\\n   244→              </button>\\n   245→            </div>\\n   246→\\n   247→            <div class=\\\"tags-list\\\">\\n   248→              <div\\n   249→                v-for=\\\"(tagField, tagIndex) in itemField.fieldArray('tags').fields.value\\\"\\n   250→                :key=\\\"tagIndex\\\"\\n   251→                class=\\\"tag-item\\\"\\n   252→                :data-pw-tag-item=\\\"`${itemIndex}-${tagIndex}`\\\"\\n   253→              >\\n   254→