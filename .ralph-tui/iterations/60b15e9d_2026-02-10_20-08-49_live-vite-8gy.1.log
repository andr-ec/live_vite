 4→const props = defineProps<{\\n     5→  counter: number\\n     6→}>()\\n     7→\\n     8→// Different event reply composables for testing\\n     9→const incrementReply = useEventReply<{counter: number, timestamp: string}>(\\\"increment\\\")\\n    10→const userReply = useEventReply<{id: number, name: string, email: string}>(\\\"get-user\\\")\\n    11→const errorReply = useEventReply(\\\"error-event\\\")\\n    12→const slowReply = useEventReply<{message: string, completed_at: string}>(\\\"slow-event\\\")\\n    13→const pingReply = useEventReply<{response: string, timestamp: string}>(\\\"ping\\\")\\n    14→const dataTypeReply = useEventReply(\\\"get-data-type\\\")\\n    15→const validateReply = useEventReply<{valid: boolean, error?: string, message?: string}>(\\\"validate-input\\\")\\n    16→\\n    17→// Test increment functionality\\n    18→const handleIncrement = async (by: number) => {\\n    19→  try {\\n    20→    const result = await incrementReply.execute({ by })\\n    21→    console.log(\\\"Increment result:\\\", result)\\n    22→  } catch (error) {\\n    23→    console.error(\\\"Increment error:\\\", error)\\n    24→  }\\n    25→}\\n    26→\\n    27→// Test user data fetching\\n    28→const fetchUser = async (id: number) => {\\n    29→  try {\\n    30→    const result = await userReply.execute({ id })\\n    31→    console.log(\\\"User data:\\\", result)\\n    32→  } catch (error) {\\n    33→    console.error(\\\"User fetch error:\\\", error)\\n    34→  }\\n    35→}\\n    36→\\n    37→// Test error handling\\n    38→const triggerError = async () => {\\n    39→  try {\\n    40→    const result = await errorReply.execute()\\n    41→    console.log(\\\"Error result:\\\", result)\\n    42→  } catch (error) {\\n    43→    console.error(\\\"Expected error:\\\", error)\\n    44→  }\\n    45→}\\n    46→\\n    47→// Test slow event with cancellation\\n    48→const startSlowEvent = async (delay: number) => {\\n    49→  try {\\n    50→    const result = await slowReply.execute({ delay })\\n    51→    console.log(\\\"Slow event result:\\\", result)\\n    52→  } catch (error) {\\n    53→    console.error(\\\"Slow event error:\\\", error)\\n    54→  }\\n    55→}\\n    56→\\n    57→const cancelSlowEvent = () => {\\n    58→  slowReply.cancel()\\n    59→}\\n    60→\\n    61→// Test ping without parameters\\n    62→const ping = async () => {\\n    63→  try {\\n    64→    const result = await pingReply.execute()\\n    65→    console.log(\\\"Ping result:\\\", result)\\n    66→  } catch (error) {\\n    67→    console.error(\\\"Ping error:\\\", error)\\n    68→  }\\n    69→}\\n    70→\\n    71→// Test different data types\\n    72→const testDataType = async (type: string) => {\\n    73→  try {\\n    74→    const result = await dataTypeReply.execute({ type })\\n    75→    console.log(`Data type ${type} result:`, result)\\n    76→  } catch (error) {\\n    77→    console.error(`Data type ${type} error:`, error)\\n    78→  }\\n    79→}\\n    80→\\n    81→// Test input validation\\n    82→const validateShortInput = async () => {\\n    83→  try {\\n    84→    const result = await validateReply.execute({ input: \\\"Hi\\\" })\\n    85→    console.log(\\\"Validation result:\\\", result)\\n    86→  } catch (error) {\\n    87→    console.error(\\\"Validation error:\\\", error)\\n    88→  }\\n    89→}\\n    90→\\n    91→const validateValidInput = async () => {\\n    92→  try {\\n    93→    const result = await validateReply.execute({ input: \\\"Valid Input\\\" })\\n    94→    console.log(\\\"Validation result:\\\", result)\\n    95→  } catch (error) {\\n    96→    console.error(\\\"Validation error:\\\", error)\\n    97→  }\\n    98→}\\n    99→\\n   100→const validateLongInput = async () => {\\n   101→  try {\\n   102→    const result = await validateReply.execute({ input: \\\"This is a very long input that exceeds the maximum allowed length\\\" })\\n   103→    console.log(\\\"Validation result:\\\", result)\\n   104→  } catch (error) {\\n   105→    console.error(\\\"Validation error:\\\", error)\\n   106→  }\\n   107→}\\n   108→</script>\\n   109→\\n   110→<template>\\n   111→  <div class=\\\"event-reply-test\\\" data-pw-event-reply-test>\\n   112→    <h2>useEventReply Tests</h2>\\n   113→\\n   114→    <!-- Server State Display -->\\n   115→    <div class=\\\"server-state\\\" data-pw-server-state>\\n   116→      <p data-pw-server-counter>Server Counter: {{ counter }}</p>\\n   117→    </div>\\n   118→\\n   119→    <!-- Basic Increment Test -->\\n   120→    <div class=\\\"section\\\">\\n   121→      <h3>Increment Test</h3>\\n   122→      <div class=\\\"controls\\\">\\n   123→        <button @click=\\\"handleIncrement(1)\\\" data-pw-increment-1>+1</button>\\n   124→        <button @click=\\\"handleIncrement(5)\\\" data-pw-increment-5>+5</button>\\n   125→      </div>\\n   126→      <div class=\\\"state\\\">\\n   127→        <div data-pw-increment-loading>Loading: {{ incrementReply.isLoading.value }}</div>\\n   128→        <div data-pw-increment-data>Data: {{ JSON.stringify(incrementReply.data.value) }}</div>\\n   129→      </div>\\n   130→    </div>\\n   131→\\n   132→    <!-- User Data Test -->\\n   133→    <div class=\\\"section\\\">\\n   134→      <h3>User Data Test</h3>\\n   135→      <div class=\\\"controls\\\">\\n   136→        <button @click=\\\"fetchUser(1)\\\" data-pw-fetch-user-1>Fetch User 1</button>\\n   137→        <button @click=\\\"fetchUser(2)\\\" data-pw-fetch-user-2>Fetch User 2</button>\\n   138→        <button @click=\\\"fetchUser(999)\\\" data-pw-fetch-user-999>Fetch User 999</button>\\n   139→      </div>\\n   140→      <div class=\\\"state\\\">\\n   141→        <div data-pw-user-loading>Loading: {{ userReply.isLoading.value }}</div>\\n   142→        <div data-pw-user-data>Data: {{ JSON.stringify(userReply.data.value) }}</div>\\n   143→      </div>\\n   144→    </div>\\n   145→\\n   146→    <!-- Error Handling Test -->\\n   147→    <div class=\\\"section\\\">\\n   148→      <h3>Server Error Resp