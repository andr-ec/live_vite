t we have the first item, new regular item, and new limited item\\n   379→      await expect(page.locator('[data-testid=\\\"item-5\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Limited Item +3\\\")\\n   380→      await expect(page.locator('[data-testid=\\\"item-1\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Item 1\\\")\\n   381→      await expect(page.locator('[data-testid=\\\"item-2\\\"] [data-testid=\\\"item-name\\\"]')).toHaveText(\\\"Item 2\\\")\\n   382→    })\\n   383→\\n   384→    test(\\\"validates limit input constraints\\\", async ({ page }) => {\\n   385→      // Test that buttons are disabled for invalid inputs\\n   386→      await expect(page.locator('[data-testid=\\\"add-positive-limit-button\\\"]')).not.toBeDisabled()\\n   387→      await expect(page.locator('[data-testid=\\\"add-negative-limit-button\\\"]')).not.toBeDisabled()\\n   388→\\n   389→      // Clear inputs should disable buttons\\n   390→      await page.fill('[data-testid=\\\"positive-limit-input\\\"]', \\\"\\\")\\n   391→      await page.fill('[data-testid=\\\"negative-limit-input\\\"]', \\\"\\\")\\n   392→\\n   393→      await expect(page.locator('[data-testid=\\\"add-positive-limit-button\\\"]')).toBeDisabled()\\n   394→      await expect(page.locator('[data-testid=\\\"add-negative-limit-button\\\"]')).toBeDisabled()\\n   395→\\n   396→      // Zero should disable buttons\\n   397→      await page.fill('[data-testid=\\\"positive-limit-input\\\"]', \\\"0\\\")\\n   398→      await page.fill('[data-testid=\\\"negative-limit-input\\\"]', \\\"0\\\")\\n   399→\\n   400→      await expect(page.locator('[data-testid=\\\"add-positive-limit-button\\\"]')).toBeDisabled()\\n   401→      await expect(page.locator('[data-testid=\\\"add-negative-limit-button\\\"]')).toBeDisabled()\\n   402→\\n   403→      // Valid values should enable buttons\\n   404→      await page.fill('[data-testid=\\\"positive-limit-input\\\"]', \\\"3\\\")\\n   405→      await page.fill('[data-testid=\\\"nega