00,\\n  1320→      })\\n  1321→\\n  1322→      const nameField = form.field(\\\"name\\\")\\n  1323→\\n  1324→      // 1. User makes an edit (triggers validation)\\n  1325→      nameField.value.value = \\\"User Edit\\\"\\n  1326→      await nextTick()\\n  1327→\\n  1328→      // 2. Quick server update while validation is pending\\n  1329→      formRef.value = {\\n  1330→        ...formRef.value,\\n  1331→        values: {\\n  1332→          ...formRef.value.values,\\n  1333→          name: \\\"First Server Update\\\",\\n  1334→        },\\n  1335→      }\\n  1336→      await nextTick()\\n  1337→\\n  1338→      // 3. Wait for validation to complete and a bit more\\n  1339→      await new Promise(resolve => setTimeout(resolve, 200))\\n  1340→\\n  1341→      // Check what happened to first update (should be blocked)\\n  1342→      expect(nameField.value.value).toBe(\\\"User Edit\\\") // First update was blocked\\n  1343→\\n  1344→      // 4. Second server update after validation completes\\n  1345→      formRef.value = {\\n  1346→        ...formRef.value,\\n  1347→        values: {\\n  1348→          ...formRef.value.values,\\n  1349→          name: \\\"Second Server Update\\\",\\n  1350→        },\\n  1351→      }\\n  1352→      await nextTick()\\n  1353→\\n  1354→      // Give a moment for the update to apply\\n  1355→      await new Promise(resolve => setTimeout(resolve, 50))\\n  1356→\\n  1357→      // 5. The second server update should now be visible (last update wins)\\n  1358→      expect(nameField.value.value).toBe(\\\"Second Server Update\\\")\\n  1359→    })\\n  1360→  })\\n  1361→\\n  1362→  describe(\\\"checkbox functionality\\\", () => {\\n  1363→    it(\\\"should create boolean checkbox field with correct inputAttrs\\\", () => {\\n  1364→      const formRef = createFormRef()\\n  1365→      const form = createFormInScope(formRef)\\n  1366→      const checkboxField = form.field(\\\"acceptTerms\\\", { type: \\\"checkbox\\\" })\\n  1367→\\n  1368→      expect(