ject } from \\\"vue\\\"\\n    15→\\n    16→const mockInject = inject as any\\n    17→\\n    18→// Mock LiveHook for testing\\n    19→const createMockLiveHook = (): LiveHook => ({\\n    20→  handleEvent: vi.fn().mockReturnValue(\\\"callback-id\\\"),\\n    21→  removeHandleEvent: vi.fn(),\\n    22→  liveSocket: {\\n    23→    pushHistoryPatch: vi.fn(),\\n    24→    historyRedirect: vi.fn(),\\n    25→    execJS: vi.fn(),\\n    26→  } as any,\\n    27→  pushEvent: vi.fn(),\\n    28→  pushEventTo: vi.fn(),\\n    29→  el: document.createElement(\\\"div\\\"),\\n    30→} as unknown as LiveHook)\\n    31→\\n    32→describe(\\\"useLiveVue\\\", () => {\\n    33→  let mockLive: LiveHook\\n    34→\\n    35→  beforeEach(() => {\\n    36→    vi.clearAllMocks()\\n    37→    mockLive = createMockLiveHook()\\n    38→  })\\n    39→\\n    40→  it(\\\"should return LiveHook when properly provided\\\", () => {\\n    41→    mockInject.mockReturnValue(mockLive)\\n    42→\\n    43→    const result = useLiveVue()\\n    44→\\n    45→    expect(mockInject).toHaveBeenCalledWith(liveInjectKey)\\n    46→    expect(result).toBe(mockLive)\\n    47→  })\\n    48→\\n    49→  it(\\\"should throw error when LiveVue is not provided\\\", () => {\\n    50→    mockInject.mockReturnValue(undefined)\\n    51→\\n    52→    expect(() => useLiveVue()).toThrow(\\\"LiveVue not provided. Are you using this inside a LiveVue component?\\\")\\n    53→  })\\n    54→\\n    55→  it(\\\"should throw error when LiveVue is null\\\", () => {\\n    56→    mockInject.mockReturnValue(null)\\n    57→\\n    58→    expect(() => useLiveVue()).toThrow(\\\"LiveVue not provided. Are you using this inside a LiveVue component?\\\")\\n    59→  })\\n    60→})\\n    61→\\n    62→describe(\\\"useLiveEvent\\\", () => {\\n    63→  let mockLive: LiveHook\\n    64→  beforeEach(() => {\\n    65→    vi.clearAllMocks()\\n    66→    mockLive = createMockLiveHook()\\n    67→    mockInject.mockReturnValue(mockLive)\\n    68→  })\\n    69→\\n    70→  it(\\\"should register event handler on mount\\\", () => {\\n    71→    const eventName = \\\"test-event\\\"\\n    72→    const callback = vi.fn()\\n    73→\\n    74→    useLiveEvent(eventName, callback)\\n    75→\\n    76→    expect(mockLive.handleEvent).toHaveBeenCalledWith(eventName, callback)\\n    77→  })\\n    78→\\n    79→  it(\\\"should remove event handler on unmount\\\", () => {\\n    80→    const eventName = \\\"test-event\\\"\\n    81→    const callback = vi.fn()\\n    82→    const callbackId = \\\"test-callback-id\\\"\\n    83→    \\n    84→    mockLive.handleEvent = vi.fn().mockReturnValue(callbackId)\\n    85→    mockInject.mockReturnValue(mockLive)\\n    86→\\n    87→    useLiveEvent(eventName, callback)\\n    88→\\n    89→    expect(mockLive.removeHandleEvent).toHaveBeenCalledWith(callbackId)\\n    90→  })\\n    91→\\n    92→  it(\\\"should handle multiple event registrations\\\", () => {\\n    93→    const callback1 = vi.fn()\\n    94→    const callback2 = vi.fn()\\n    95→\\n    96→    useLiveEvent(\\\"event1\\\", callback1)\\n    97→    useLiveEvent(\\\"event2\\\", callback2)\\n    98→\\n    99→    expect(mockLive.handleEvent).toHaveBeenCalledTimes(2)\\n   100→    expect(mockLive.handleEvent).toHaveBeenCalledWith(\\\"event1\\\", callback1)\\n   101→    expect(mockLive.handleEvent).toHaveBeenCalledWith(\\\"event2\\\", callback2)\\n   102→    expect(mockLive.removeHandleEvent).toHaveBeenCalledTimes(2)\\n   103→  })\\n   104→\\n   105→  it(\\\"should handle callback with typed data\\\", () => {\\n   106→    interface TestEventData {\\n   107→      message: string\\n   108→      count: number\\n   109→    }\\n   110→\\n   111→    const callback = vi.fn<(data: TestEventData) => void>()\\n   112→    \\n   113→    useLiveEvent<TestEventData>(\\\"typed-event\\\", callback)\\n   114→\\n   115→    expect(mockLive.handleEvent).toHaveBeenCalledWith(\\\"typed-event\\\", expect.any(Function))\\n   116→  })\\n   117→\\n   118→  it(\\\"should not remove handler if callback was null\\\", () => {\\n   119→    mockLive.handleEvent = vi.fn().mockReturnValue(null)\\n   120→    mockInject.mockReturnValue(mockLive)\\n   121→\\n   122→    useLiveEvent(\\\"test-event\\\", vi.fn())\\n   123→\\n   124→    expect(mockLive.removeHandleEvent).not.toHaveBeenCalled()\\n   125→  })\\n   126→})\\n   127→\\n   128→describe(\\\"useLiveNavigation\\\", () => {\\n   129→  let mockLive: LiveHook\\n   130→  let mockLiveSocket: any\\n   131→  let originalLocation: Location\\n   132→\\n   133→  beforeEach(() => {\\n   134→    vi.clearAllMocks()\\n   135→    \\n   136→    // Mock window.location\\n   137→    originalLocation = window.location\\n   138→    delete (window as any).location\\n   139→    ;(window as any).location = {\\n   140→      pathname: \\\"/current-path\\\",\\n   141→      search: \\\"\\\",\\n   142→      href: \\\"http://localhost/current-path\\\"\\n   143→    }\\n   144→\\n   145→    mockLiveSocket = {\\n   146→      pushHistoryPatch: vi.fn(),\\n   147→      historyRedirect: vi.fn(),\\n   148→    }\\n   149→    \\n   150→    mockLive = createMockLiveHook()\\n   151→    mockLive.liveSocket = mockLiveSocket\\n   152→    mockInject.mockReturnValue(mockLive)\\n   153→  })\\n   154→\\n   155→  afterEach(() => {\\n   156→    ;(window as any).location = originalLocation\\n   157→  })\\n   158→\\n   159→  it(\\\"should throw error when LiveSocket is not initialized\\\", () => {\\n   160→    const mockLiveWithoutSocket = { ...mockLive, liveSocket: null }\\n   161→    mockInject.mockReturnValue(mockLiveWithoutSocket)\\n   162→\\n   163→    expect(() => useLiveNavigation()).toThrow(\\\"LiveSocket not initialized\\\")\\n   164→  })\\n   165→\\n   166→  it(\\\"should throw error when LiveSocket is undefined\\\", () => {\\n   167→    const mockLiveWithoutSocket = { ...mockLive, liveSocket: undefined }\\n   168→    mockInject.mockReturnValue(mockLiveWithoutSocket)\\n   169→\\n   170→    expect(() => useLiveNavigation()).toThrow(\\\"LiveSocket not initialized\\\")\\n   171→  })\\n   172→\\n   173→  describe(\\\"patch function\\\", () => {\\n   174→    it(\\\"should patch with string href\\\", () => {\\n   175→      const { patch } = useLiveNavigation()\\n   176→      const href = \\\"/new-path\\\"\\n   177→\\n   178→      patch(href)\\n   179→\\n   180→      expect(mockLiveSocket.pushHistoryPatch).toHaveBeenCalledWith(\\n   181→        expect.any(Event),\\n   182→        href,\\n   183→        \\\"push\\\",\\n   184→        null\\n   185→      )\\n   186→    })\\n   187→\\n   188→    it(\\\"should patch with string href and replace option\\\", () => {\\n   189→      const { patch } = useLiveNavigation()\\n   190→      const href = \\\"/new-path\\\"\\n   191→\\n   192→      patch(href, { replace: true })\\n   193→\\n   194→      expect(mockLiveSocket.pushHistoryPatch).toHaveBeenCalledWith(\\n   195→        expect.any(Event),\\n   196→        href,\\n   197→        \\\"replace\\\",\\n   198→        null\\n   199→      )\\n   200→    })\\n   201→\\n   202→    it(\\\"should patch with query params object\\\", () => {\\n   203→      const { patch } = useLiveNavigation()\\n   204→      const queryParams = { page: \\\"2\\\", filter: \\\"active\\\" }\\n   205→\\n   206→      patch(queryParams)\\n   207→\\n   208→      expect(mockLiveSocket.pushHistoryPatch).toHaveBeenCalledWith(\\n   209→        expect.any(Event),\\n   210→        \\\"/current-path?page=2&filter=active\\\",\\n   211→        \\\"push\\\",\\n   212→        null\\n   213→      )\\n   214→    })\\n   215→\\n   216→    it(\\\"should patch with query params object and replace option\\\", () => {\\n   217→      const { patch } = useLiveNavigation()\\n   218→      const queryParams = { search: \\\"test\\\", category: \\\"books\\\" }\\n   219→\\n   220→      patch(queryParams, { replace: true })\\n   221→\\n   222→      expect(mockLiveSocket.pushHistoryPatch).toHaveBeenCalledWith(\\n   223→        expect.any(Event),\\n   224→        \\\"/current-path?search=test&category=books\\\",\\n   225→        \\\"replace\\\",\\n   226→        null\\n   227→      )\\n   228→    })\\n   229→\\n   230→    it(\\\"should handle empty query params object\\\", () => {\\n   231→      const { patch } = useLiveNavigation()\\n   232→      const queryParams = {}\\n   233→\\n   234→      patch(queryParams)\\n   235→\\n   236→      expect(mockLiveSocket.pushHistoryPatch).toHaveBeenCalledWith(\\n   237→        expect.any(Event),\\n   238→        \\\"/current-path?\\\",\\n   239→        \\\"push\\\",\\n   240→        null\\n   241→      )\\n   242→    })\\n   243→\\n   244→    it(\\\"should handle query params with special characters\\\", () => {\\n   245→      const { patch } = useLiveNavigation()\\n   246→      const queryParams = { search: \\\"hello world\\\", filter: \\\"a&b\\\" }\\n   247→\\n   248→      patch(queryParams)\\n   249→\\n   250→      expect(mockLiveSocket.pushHistoryPatch).toHaveBeenCalledWith(\\n   251→        expect.any(Event),\\n   252→        \\\"/current-path?search=hello+world&filter=a%26b\\\",\\n   253→        \\\"push\\\",\\n   254→        null\\n   255→      )\\n   256→    })\\n   257→  })\\n   258→\\n   259→  describe(\\\"navigate function\\\", () => {\\n   260→    it(\\\"should navigate with href\\\", () => {\\n   261→      const { navigate } = useLiveNavigation()\\n   262→      const href = \\\"/new-page\\\"\\n   263→\\n   264→      navigate(href)\\n   265→\\n   266→      expect(mockLiveSocket.historyRedirect).toHaveBeenCalledWith(\\n   267→        expect.any(Event),\\n   268→        href,\\n   269→        \\\"push\\\",\\n   270→        null,\\n   271→        null\\n   272→      )\\n   273→    })\\n   274→\\n   275→    it(\\\"should navigate with href and replace option\\\", () => {\\n   276→      const { navigate } = useLiveNavigation()\\n   277→      const href = \\\"/new-page\\\"\\n   278→\\n   279→      navigate(href, { replace: true })\\n   280→\\n   281→      expect(mockLiveSocket.historyRedirect).toHaveBeenCalledWith(\\n   282→        expect.any(Event),\\n   283→        href,\\n   284→        \\\"replace\\\",\\n   285→        null,\\n   286→        null\\n   287→      )\\n   288→    })\\n   289→\\n   290→    it(\\\"should handle external URLs\\\", () => {\\n   291→      const { navigate } = useLiveNavigation()\\n   292→      const href = \\\"https://example.com/external\\\"\\n   293→\\n   294→      navigate(href)\\n   295→\\n   296→      expect(mockLiveSocket.historyRedirect).toHaveBeenCalledWith(\\n   297→        expect.any(Event),\\n   298→        href,\\n   299→        \\\"push\\\",\\n   300→        null,\\n   301→        null\\n   302→      )\\n   303→    })\\n   304→\\n   305→    it(\\\"should handle relative paths\\\", () => {\\n   306→      const { navigate } = useLiveNavigation()\\n   307→      const href = \\\"../parent-page\\\"\\n   308→\\n   309→      navigate(href)\\n   310→\\n   311→      expect(mockLiveSocket.historyRedirect).toHaveBeenCalledWith(\\n   312→        expect.any(Event),\\n   313→        href,\\n   314→        \\\"push\\\",\\n   315→        null,\\n   316→        null\\n   317→      )\\n   318→    })\\n   319→  })\\n   320→\\n   321→  it(\\\"should return object with patch and navigate functions\\\", () => {\\n   322→    const navigation = useLiveNavigation()\\n   323→\\n   324→    expect(navigation).toHaveProperty(\\\"patch\\\")\\n   325→    expect(navigation).toHaveProperty(\\\"navigate\\\")\\n   326→    expect(typeof navigation.patch).toBe(\\\"function\\\")\\n   327→    expect(typeof navigation.navigate).toBe(\\\"function\\\")\\n   328→  })\\n   329→})\\n   330→\\n   331→describe(\\\"integration tests\\\", () => {\\n   332→  let mockLive: LiveHook\\n   333→\\n   334→  beforeEach(() => {\\n   335→    vi.clearAllMocks()\\n   336→    mockLive = createMockLiveHook()\\n   337→    mockInject.mockReturnValue(mockLive)\\n   338→  })\\n   339→\\n   340→  it(\\\"should work together - useLiveVue and useLiveEvent\\\", () => {\\n   341→    const callback = vi.fn()\\n   342→    \\n   343→    // First get the live instance\\n   344→    const live = useLiveVue()\\n   345→    expect(live).toBe(mockLive)\\n   346→    \\n   347→    // Then use it for event handling\\n   348→    useLiveEvent(\\\"test-event\\\", callback)\\n   349→    \\n   350→    expect(mockLive.handleEvent).toHaveBeenCalledWith(\\\"test-event\\\", callback)\\n   351→  })\\n   352→\\n   353→  it(\\\"should work together - useLiveVue and useLiveNavigation\\\", () => {\\n   354→    // First get the live instance\\n   355→    const live = useLiveVue()\\n   356→    expect(live).toBe(mockLive)\\n   357→    \\n   358→    // Then use it for navigation\\n   359→    const { patch, navigate } = useLiveNavigation()\\n   360→    \\n   361→    patch(\\\"/test-path\\\")\\n   362→    navigate(\\\"/another-path\\\")\\n   363→    \\n   364→    expect(mockLive.liveSocket.pushHistoryPatch).toHaveBeenCalledWith(\\n   365→      expect.any(Event),\\n   366→      \\\"/test-path\\\",\\n   367→      \\\"push\\\",\\n   368→      null\\n   369→    )\\n   370→    expect(mockLive.liveSocket.historyRedirect).toHaveBeenCalledWith(\\n   371→      expect.any(Event),\\n   372→      \\\"/another-path\\\",\\n   373→      \\\"push\\\",\\n   374→      null,\\n   375→      null\\n   376→    )\\n   377→  })\\n   378→})\\n   379→\\n   380→describe(\\\"useEventReply\\\", () => {\\n   381→  let mockLive: LiveHook\\n   382→  let mockPushEvent: any\\n   383→\\n   384→  beforeEach(() => {\\n   385→    vi.clearAllMocks()\\n   386→    mockPushEvent = vi.fn()\\n   387→    mockLive = {\\n   388→      ...createMockLiveHook(),\\n   389→      pushEvent: mockPushEvent,\\n   390→    }\\n   391→    mockInject.mockReturnValue(mockLive)\\n   392→  })\\n   393→\\n   394→  it(\\\"should initialize with default values\\\", () => {\\n   395→    const { data, isLoading } = useEventReply(\\\"test-event\\\")\\n   396→\\n   397→    expect(data.value).toBe(null)\\n   398→    expect(isLoading.value).toBe(false)\\n   399→  })\\n   400→\\n   401→  it(\\\"should initialize with custom default value\\\", () => {\\n   402→    const defaultValue = { message: \\\"hello\\\" }\\n   403→    const { data } = useEventReply(\\\"test-event\\\", { defaultValue })\\n   404→\\n   405→    expect(data.value).toEqual(defaultValue)\\n   406→  })\\n   407→\\n   408→  it(\\\"should execute event successfully\\\", async () => {\\n   409→    const { data, isLoading, execute } = useEventReply<string>(\\\"test-event\\\")\\n   410→    const testParams = { id: 123 }\\n   411→    const expectedReply = \\\"success\\\"\\n   412→\\n   413→    // Mock pushEvent to call the callback immediately\\n   414→    mockPushEvent.mockImplementation((eventName: string, params: any, callback: (reply: any) => void) => {\\n   415→      callback(expectedReply)\\n   416→    })\\n   417→\\n   418→    const result = await execute(testParams)\\n   419→\\n   420→    expect(mockPushEvent).toHaveBeenCalledWith(\\\"test-event\\\", testParams, expect.any(Function))\\n   421→    expect(result).toBe(expectedReply)\\n   422→    expect(data.value).toBe(expectedReply)\\n   423→    expect(isLoading.value).toBe(false)\\n   424→  })\\n   425→\\n   426→  it(\\\"should execute event without parameters\\\", async () => {\\n   427→    const { execute } = useEventReply(\\\"test-event\\\")\\n   428→    const expectedReply = { status: \\\"ok\\\" }\\n   429→\\n   430→    mockPushEvent.mockImplementation((eventName: string, params: any, callback: (reply: any) => void) => {\\n   431→      callback(expectedReply)\\n   432→    })\\n   433→\\n   434→    const result = await execute()\\n   435→\\n   436→    expect(mockPushEvent).toHaveBeenCalledWith(\\\"test-event\\\", undefined, expect.any(Function))\\n   437→    expect(result).toEqual(expectedReply)\\n   438→  })\\n   439→\\n   440→\\n   441→  it(\\\"should reject concurrent executions\\\", async () => {\\n   442→    const { execute } = useEventReply(\\\"test-event\\\")\\n   443→    const consoleSpy = vi.spyOn(console, 'warn').mockImplementation(() => {})\\n   444→\\n   445→    // Mock pushEvent to never call callback (simulating slow response)\\n   446→    mockPushEvent.mockImplementation(() => {})\\n   447→\\n   448→    const firstExecution = execute({ id: 1 })\\n   449→    \\n   450→    // Second execution should be rejected immediately\\n   451→    await expect(execute({ id: 2 })).rejects.toThrow('Event \\\"test-event\\\" is already executing')\\n   452→    \\n   453→    expect(consoleSpy).toHaveBeenCalledWith(\\n   454→      'Event \\\"test-event\\\" is already executing. Call cancel() first if you want to start a new execution.'\\n   455→    )\\n   456→    \\n   457→    consoleSpy.mockRestore()\\n   458→  })\\n   459→\\n   460→\\n   461→  it(\\\"should cancel execution and ignore pending responses\\\", async () => {\\n   462→    const { data, isLoading, execute, cancel } = useEventReply<string>(\\\"test-event\\\")\\n   463→    let pendingCallback: ((reply: string) => void) | null = null\\n   464→\\n   465→    // Mock pushEvent to store callback without calling it\\n   466→    mockPushEvent.mockImplementation((_eventName: string, _params: any, callback: (reply: string) => void) => {\\n   467→      pendingCallback = callback\\n   468→    })\\n   469→\\n   470→    const promise = execute({ id: 123 })\\n   471→    // Cancel the execution\\n   472→    cancel()\\n   473→    expect(isLoading.value).toBe(false)\\n   474→\\n   475→    // The promise should be rejected\\n   476→    await expect(promise).rejects.toThrow('Event \\\"test-event\\\" was cancelled')\\n   477→\\n   478→    // Now call the pending callback - it should be ignored\\n   479→    if (pendingCallback) {\\n   480→      (pendingCallback as (reply: string) => void)(\\\"delayed response\\\")\\n   481→    }\\n   482→\\n   483→    expect(data.value).toBe(null) // Should remain unchanged\\n   484→  })\\n   485→\\n   486→  it(\\\"should reject pending promise when cancelled\\\", async () => {\\n   487→    const { execute, cancel } = useEventReply<string>(\\\"test-event\\\")\\n   488→    let pendingCallback: ((reply: string) => void) | null = null\\n   489→\\n   490→    // Mock pushEvent to store callback without calling it\\n   491→    mockPushEvent.mockImplementation((_eventName: string, _params: any, callback: (reply: string) => void) => {\\n   492→      pendingCallback = callback\\n   493→    })\\n   494→\\n   495→    // Start execution and get the promise\\n   496→    const promise = execute({ id: 123 })\\n   497→\\n   498→    // Cancel the execution - this should reject the promise\\n   499→    cancel()\\n   500→\\n   501→    // The promise should be rejected with a cancellation error\\n   502→    await expect(promise).rejects.toThrow('Event \\\"test-event\\\" was cancelled')\\n   503→\\n   504→    // Calling the pending callback should not affect anything\\n   505→    if (pendingCallback) {\\n   506→      (pendingCallback as (reply: string) => void)(\\\"delayed response\\\")\\n   507→    }\\n   508→  })\\n   509→\\n   510→  it(\\\"should handle multiple cancel calls safely\\\", () => {\\n   511→    const { cancel, isLoading } = useEventReply(\\\"test-event\\\")\\n   512→\\n   513→    // Multiple cancels when there's no pending execution should be safe\\n   514→    cancel()\\n   515→    cancel()\\n   516→    cancel()\\n   517→\\n   518→    expect(isLoading.value).toBe(false)\\n   519→  })\\n   520→\\n   521→  it(\\\"should handle cancel after execution completes\\\", async () => {\\n   522→    const { execute, cancel } = useEventReply<string>(\\\"test-event\\\")\\n   523→\\n   524→    mockPushEvent.mockImplementation((_eventName: string, _params: any, callback: (reply: string) => void) => {\\n   525→      callback(\\\"response\\\")\\n   526→    })\\n   527→\\n   528→    // Execute and complete\\n   529→    await execute()\\n   530→\\n   531→    // Cancel after completion should be safe (no pending promise to reject)\\n   532→    cancel()\\n   533→    cancel() // Multiple calls should also be safe\\n   534→  })\\n   535→\\n   536→  it(\\\"should allow new execution after cancel\\\", async () => {\\n   537→    const { execute, cancel, data } = useEventReply<string>(\\\"test-event\\\")\\n   538→    let pendingCallback: ((reply: string) => void) | null = null\\n   539→\\n   540→    // First execution\\n   541→    mockPushEvent.mockImplementationOnce((_eventName: string, _params: any, callback: (reply: string) => void) => {\\n   542→      pendingCallback = callback\\n   543→    })\\n   544→\\n   545→    const firstPromise = execute({ id: 1 })\\n   546→    cancel()\\n   547→\\n   548→    // First promise should be rejected\\n   549→    await expect(firstPromise).rejects.toThrow('Event \\\"test-event\\\" was cancelled')\\n   550→\\n   551→    // Second execution should work\\n   552→    mockPushEvent.mockImplementationOnce((_eventName: string, _params: any, callback: (reply: string) => void) => {\\n   553→      callback(\\\"second response\\\")\\n   554→    })\\n   555→\\n   556→    await execute({ id: 2 })\\n   557→    expect(data.value).toBe(\\\"second response\\\")\\n   558→\\n   559→    // Original callback should still be ignored\\n   560→    if (pendingCallback) {\\n   561→      (pendingCallback as (reply: string) => void)(\\\"first response\\\")\\n   562→    }\\n   563→    expect(data.value).toBe(\\\"second response\\\")\\n   564→  })\\n   565→\\n   566→  it(\\\"should work with typed parameters\\\", async () => {\\n   567→    interface UserParams {\\n   568→      id: number\\n   569→      name: string\\n   570→    }\\n   571→    \\n   572→    interface UserResponse {\\n   573→      user: {\\n   574→        id: number\\n   575→        name: string\\n   576→        email: string\\n   577→      }\\n   578→    }\\n   579→\\n   580→    const { execute } = useEventReply<UserResponse, UserParams>(\\\"get-user\\\")\\n   581→    const params: UserParams = { id: 123, name: \\\"John\\\" }\\n   582→    const expectedResponse: UserResponse = {\\n   583→      user: { id: 123, name: \\\"John\\\", email: \\\"john@example.com\\\" }\\n   584→    }\\n   585→\\n   586→    mockPushEvent.mockImplementation((eventName: string, params: any, callback: (reply: any) => void) => {\\n   587→      callback(expectedResponse)\\n   588→    })\\n   589→\\n   590→    const result = await execute(params)\\n   591→    \\n   592→    expect(mockPushEvent).toHaveBeenCalledWith(\\\"get-user\\\", params, expect.any(Function))\\n   593→    expect(result).toEqual(expectedResponse)\\n   594→  })\\n   595→\\n   596→  it(\\\"should return correct interface\\\", () => {\\n   597→    const result = useEventReply(\\\"test-event\\\")\\n   598→\\n   599→    expect(result).toHaveProperty(\\\"data\\\")\\n   600→    expect(result).toHaveProperty(\\\"isLoading\\\")\\n   601→    expect(result).toHaveProperty(\\\"execute\\\")\\n   602→    expect(result).toHaveProperty(\\\"cancel\\\")\\n   603→    expect(typeof result.execute).toBe(\\\"function\\\")\\n   604→    expect(typeof result.cancel).toBe(\\\"function\\\")\\n   605→  })\\n   606→\\n   607→  it(\\\"should use updateData function when provided\\\", async () => {\\n   608→    const updateData = vi.fn((reply: string, currentData: string | null) => {\\n   609→      return currentData ? `${currentData},${reply}` : reply\\n   610→    })\\n   611→\\n   612→    const { data, execute } = useEventReply<string>(\\\"test-event\\\", { updateData })\\n   613→\\n   614→    // First execution\\n   615→    mockPushEvent.mockImplementationOnce((_eventName: string, _params: any, callback: (reply: any) => void) => {\\n   616→      callback(\\\"first\\\")\\n   617→    })\\n   618→\\n   619→    await execute({ id: 1 })\\n   620→    expect(updateData).toHaveBeenCalledWith(\\\"first\\\", null)\\n   621→    expect(data.value).toBe(\\\"first\\\")\\n   622→\\n   623→    // Second execution should accumulate\\n   624→    mockPushEvent.mockImplementationOnce((_eventName: string, _params: any, callback: (reply: any) => void) => {\\n   625→      callback(\\\"second\\\")\\n   626→    })\\n   627→\\n   628→    await execute({ id: 2 })\\n   629→    expect(updateData).toHaveBeenCalledWith(\\\"second\\\", \\\"first\\\")\\n   630→    expect(data.value).toBe(\\\"first,second\\\")\\n   631→  })\\n   632→\\n   633→  it(\\\"should use updateData with default value\\\", async () => {\\n   634→    const updateData = vi.fn((reply: number, currentData: number | null) => {\\n   635→      return (currentData || 0) + reply\\n   636→    })\\n   637→\\n   638→    const { data, execute } = useEventReply<number>(\\\"test-event\\\", { \\n   639→      defaultValue: 10, \\n   640→      updateData \\n   641→    })\\n   642→\\n   643→    expect(data.value).toBe(10)\\n   644→\\n   645→    mockPushEvent.mockImplementationOnce((_eventName: string, _params: any, callback: (reply: any) => void) => {\\n   646→      callback(5)\\n   647→    })\\n   648→\\n   649→    await execute()\\n   650→    expect(updateData).toHaveBeenCalledWith(5, 10)\\n   651→    expect(data.value).toBe(15)\\n   652→  })\\n   653→\\n   654→  it(\\\"should use updateData for array accumulation\\\", async () => {\\n   655→    interface Item {\\n   656→      id: number\\n   657→      name: string\\n   658→    }\\n   659→\\n   660→    const updateData = vi.fn((reply: Item[], currentData: Item[] | null) => {\\n   661→      return currentData ? [...currentData, ...reply] : reply\\n   662→    })\\n   663→\\n   664→    const { data, execute } = useEventReply<Item[]>(\\\"test-event\\\", { updateData })\\n   665→\\n   666→    // First item\\n   667→    mockPushEvent.mockImplementationOnce((_eventName: string, _params: any, callback: (reply: any) => void) => {\\n   668→      callback([{ id: 1, name: \\\"first\\\" }])\\n   669→    })\\n   670→\\n   671→    await execute()\\n   672→    expect(data.value).toEqual([{ id: 1, name: \\\"first\\\" }])\\n   673→\\n   674→    // Second item\\n   675→    mockPushEvent.mockImplementationOnce((_eventName: string, _params: any, callback: (reply: any) => void) => {\\n   676→      callback([{ id: 2, name: \\\"second\\\" }])\\n   677→    })\\n   678→\\n   679→    await execute()\\n   680→    expect(data.value).toEqual([\\n   681→      { id: 1, name: \\\"first\\\" },\\n   682→      { id: 2, name: \\\"second\\\" }\\n   683→    ])\\n   684→  })\\n   685→\\n   686→  it(\\\"should not call updateData when execution is cancelled\\\", async () => {\\n   687→    const updateData = vi.fn((reply: string, _currentData: string | null) => reply)\\n   688→\\n   689→    const { execute, cancel } = useEventReply<string>(\\\"test-event\\\", { updateData })\\n   690→    let pendingCallback: ((reply: string) => void) | null = null\\n   691→\\n   692→    mockPushEvent.mockImplementation((_eventName: string, _params: any, callback: (reply: string) => void) => {\\n   693→      pendingCallback = callback\\n   694→    })\\n   695→\\n   696→    const promise = execute()\\n   697→    cancel()\\n   698→\\n   699→    // The promise should be rejected due to cancellation\\n   700→    await expect(promise).rejects.toThrow('Event \\\"test-event\\\" was cancelled')\\n   701→\\n   702→    // Call the pending callback - updateData should not be called\\n   703→    if (pendingCallback) {\\n   704→      (pendingCallback as (reply: string) => void)(\\\"delayed response\\\")\\n   705→    }\\n   706→\\n   707→    expect(updateData).not.toHaveBeenCalled()\\n   708→  })\\n   709→\\n   710→  it(\\\"should work without updateData function (default behavior)\\\", async () => {\\n   711→    const { data, execute } = useEventReply<string>(\\\"test-event\\\")\\n   712→\\n   713→    mockPushEvent.mockImplementation((_eventName: string, _params: any, callback: (reply: any) => void) => {\\n   714→      callback(\\\"response\\\")\\n   715→    })\\n   716→\\n   717→    await execute()\\n   718→    expect(data.value).toBe(\\\"response\\\")\\n   719→  })\\n   720→})\\n\\n<system-reminder>\\nWhenever you read a file, you should