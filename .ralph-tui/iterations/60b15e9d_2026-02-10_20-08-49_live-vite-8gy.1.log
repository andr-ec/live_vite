{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CVibh9ymj5r9s85qcywEZ4","type":"tool_result","content":"     1→defprotocol LiveVue.Encoder do\n     2→  @moduledoc \"\"\"\n     3→  Protocol for encoding values to JSON for LiveVue.\n     4→\n     5→  This protocol is used to safely transform structs into plain maps before\n     6→  calculating JSON patches. It ensures that struct fields are explicitly\n     7→  exposed and prevents accidental exposure of sensitive data.\n     8→\n     9→  It's very similar to Jason.Encoder, but it's converting structs to maps instead of strings.\n    10→\n    11→  ## Deriving\n    12→\n    13→  The protocol allows leveraging Elixir's `@derive` feature to simplify protocol\n    14→  implementation in trivial cases. Accepted options are:\n    15→\n    16→  * `:only` - encodes only values of specified keys.\n    17→  * `:except` - encodes all struct fields except specified keys.\n    18→\n    19→  By default all keys except the `:__struct__` key are encoded.\n    20→\n    21→  ## Example\n    22→\n    23→  Let's assume a presence of the following struct:\n    24→\n    25→      defmodule User do\n    26→        defstruct [:name, :email, :password]\n    27→      end\n    28→\n    29→  If we were to call `@derive LiveVue.Encoder` just before `defstruct`, an\n    30→  implementation would be generated that encodes all fields except `:__struct__`:\n    31→\n    32→      defmodule User do\n    33→        @derive LiveVue.Encoder\n    34→        defstruct [:name, :email, :password]\n    35→      end\n    36→\n    37→  If we called `@derive {LiveVue.Encoder, only: [:name, :email]}`, only the\n    38→  specified fields would be encoded:\n    39→\n    40→      defmodule User do\n    41→        @derive {LiveVue.Encoder, only: [:name, :email]}\n    42→        defstruct [:name, :email, :password]\n    43→      end\n    44→\n    45→  If we called `@derive {LiveVue.Encoder, except: [:password]}`, all fields\n    46→  except the specified ones would be encoded:\n    47→\n    48→      defmodule User do\n    49→        @derive {LiveVue.Encoder, except: [:password]}\n    50→        defstruct [:name, :email, :password]\n    51→      end\n    52→\n    53→  ## Deriving outside of the module\n    54→\n    55→  If you don't own the struct you want to encode, you may use Protocol.derive/3 placed outside of any module:\n    56→\n    57→  Protocol.derive(LiveVue.Encoder, User, only: [...])\n    58→\n    59→  ## Custom implementations\n    60→\n    61→  You may define your own implementation for the struct:\n    62→\n    63→  defimpl LiveVue.Encoder, for: User do\n    64→    def encode(struct, opts) do\n    65→      struct\n    66→      |> Map.take([:first, :second])\n    67→      |> LiveVue.Encoder.encode(opts)\n    68→    end\n    69→  end\n    70→  \"\"\"\n    71→\n    72→  @type t :: term\n    73→  @type opts :: Keyword.t()\n    74→  @fallback_to_any true\n    75→\n    76→  @doc \"\"\"\n    77→  Encodes a value to one of the primitive types.\n    78→  \"\"\"\n    79→  @spec encode(t, opts) :: any()\n    80→  def encode(value, opts \\\\ [])\n    81→end\n    82→\n    83→# Primitive types that are already JSON serializable\n    84→defimpl LiveVue.Encoder, for: Integer do\n    85→  def encode(value, _opts), do: value\n    86→end\n    87→\n    88→defimpl LiveVue.Encoder, for: Float do\n    89→  def encode(value, _opts), do: value\n    90→end\n    91→\n    92→defimpl LiveVue.Encoder, for: BitString do\n    93→  def encode(value, _opts), do: value\n    94→end\n    95→\n    96→defimpl LiveVue.Encoder, for: Atom do\n    97→  def encode(atom, _opts), do: atom\n    98→end\n    99→\n   100→# Complex types that need recursive encoding\n   101→defimpl LiveVue.Encoder, for: List do\n   102→  def encode(list, opts) do\n   103→    Enum.map(list, &LiveVue.Encoder.encode(&1, opts))\n   104→  end\n   105→end\n   106→\n   107→defimpl LiveVue.Encoder, for: Map do\n   108→  def encode(map, opts) do\n   109→    Map.new(map, fn {key, value} ->\n   110→      {key, LiveVue.Encoder.encode(value, opts)}\n   111→    end)\n   112→  end\n   113→end\n   114→\n   115→# Date and time types - Jason encoder handles them\n   116→defimpl LiveVue.Encoder, for: [Date, Time, NaiveDateTime, DateTime] do\n   117→  def encode(value, _opts) do\n   118→    # otherwise diff is comparing tuples, and that's not what we want\n   119→    @for.to_iso8601(value)\n   120→  end\n   121→end\n   122→\n   123→defimpl LiveVue.Encoder, for: Phoenix.HTML.Form do\n   124→  def encode(%Phoenix.HTML.Form{} = form, opts) do\n   125→    LiveVue.Encoder.encode(\n   126→      %{\n   127→        name: form.name,\n   128→        values: encode_form_values(form, opts),\n   129→        errors: encode_form_errors(form) || %{},\n   130→        valid: get_form_validity(form)\n   131→      },\n   132→      opts\n   133→    )\n   134→  rescue\n   135→    error in [Protocol.UndefinedError] ->\n   136→      reraise maybe_enhance_error(error), __STACKTRACE__\n   137→  end\n   138→\n   139→  defp get_form_validity(%{source: %{valid?: valid}}), do: valid\n   140→  defp get_form_validity(_), do: true\n   141→\n   142→  # Conditionally compiled helper to enhance error messages when Ecto is available\n   143→  if Code.ensure_loaded?(Ecto) do\n   144→    defp maybe_enhance_error(%{value: %Ecto.Association.NotLoaded{}} = error) do\n   145→      Map.update!(error, :description, fn description ->\n   146→        [first | rest] = String.split(description, \"\\n\\n\")\n   147→\n   148→        addition = \"\"\"\n   149→        To prevent this error from happening in forms, you can explicitly encode form using LiveVue.Encoder.encode(form, nilify_not_loaded: true) option.\n   150→        \"\"\"\n   151→\n   152→        Enum.join([first | [addition | rest]], \"\\n\\n\")\n   153→      end)\n   154→    end\n   155→\n   156→    defp maybe_enhance_error(error), do: error\n   157→  else\n   158→    defp maybe_enhance_error(error), do: error\n   159→  end\n   160→\n   161→  if Code.ensure_loaded?(Ecto) do\n   162→    @relations [:embed, :assoc]\n   163→\n   164→    # for changeset, we need to collect actual values from the changeset\n   165→    # - if there are changes, we need to use changed values\n   166→    # - if there are no changes, we should use params (possibly invalid, to reflect intermediate state)\n   167→    # - if there are not changes and no params, we should use the data\n   168→    # it's a bit tricky, because we need to traverse embeds and assocs\n   169→    defp collect_changeset_values(%Ecto.Changeset{} = source, opts) do\n   170→      data = Map.new(source.types, fn {field, type} -> {field, get_field_value(source, field, type, opts)} end)\n   171→\n   172→      result = if is_struct(source.data), do: Map.merge(source.data, data), else: data\n   173→\n   174→      # Filter out __meta__ field from Ecto schemas\n   175→      Map.delete(result, :__meta__)\n   176→    end\n   177→\n   178→    defp get_field_value(source, field, {tag, %{cardinality: :one}}, opts) when tag in @relations do\n   179→      case Map.fetch(source.changes, field) do\n   180→        {:ok, nil} ->\n   181→          nil\n   182→\n   183→        {:ok, %Ecto.Changeset{} = changeset} ->\n   184→          collect_changeset_values(changeset, opts)\n   185→\n   186→        # there are no changes underneath, so we can just use the data\n   187→        :error ->\n   188→          case Map.fetch!(source.data, field) do\n   189→            %Ecto.Association.NotLoaded{} = not_loaded ->\n   190→              # I was thinking how to solve this correctly\n   191→              # but for now I think ignoring this is the best option\n   192→              if opts[:nilify_not_loaded], do: nil, else: not_loaded\n   193→\n   194→            %{__meta__: _} = value ->\n   195→              Map.delete(value, :__meta__)\n   196→\n   197→            value ->\n   198→              value\n   199→          end\n   200→      end\n   201→    end\n   202→\n   203→    defp get_field_value(source, field, {tag, %{cardinality: :many}}, opts) when tag in @relations do\n   204→      case Map.fetch(source.changes, field) do\n   205→        {:ok, changesets} ->\n   206→          changesets\n   207→          # we need to filter out changesets that have no params - they are removed from the form\n   208→          |> Enum.filter(&(&1.params != nil))\n   209→          |> Enum.map(&collect_changeset_values(&1, opts))\n   210→\n   211→        :error ->\n   212→          case Map.fetch!(source.data, field) do\n   213→            %Ecto.Association.NotLoaded{} = not_loaded ->\n   214→              # let's return nil for not loaded associations\n   215→              if opts[:nilify_not_loaded], do: nil, else: not_loaded\n   216→\n   217→            [%{__meta__: _} | _] = value ->\n   218→              Enum.map(value, &Map.delete(&1, :__meta__))\n   219→\n   220→            value ->\n   221→              value\n   222→          end\n   223→      end\n   224→    end\n   225→\n   226→    defp get_field_value(source, field, _type, _opts) do\n   227→      Phoenix.HTML.FormData.Ecto.Changeset.input_value(source, %{params: source.params}, field)\n   228→\n   229→      # # First try to get the value using the standard Phoenix input_value function\n   230→      # case Phoenix.HTML.FormData.Ecto.Changeset.input_value(source, %{params: source.params}, field) do\n   231→      #   nil ->\n   232→      #     # If that returns nil, check if there's a field with [] suffix in params\n   233→      #     # This handles the case where multiple checkbox fields have names like \"preferences[]\"\n   234→      #     field_with_brackets = \"#{field}[]\"\n   235→      #     case Map.get(source.params, field_with_brackets) do\n   236→      #       nil -> nil\n   237→      #       value -> value\n   238→      #     end\n   239→      #   value -> value\n   240→      # end\n   241→    end\n   242→\n   243→    def encode_form_values(%{impl: Phoenix.HTML.FormData.Ecto.Changeset, source: source}, opts) do\n   244→      source |> collect_changeset_values(opts) |> LiveVue.Encoder.encode(opts)\n   245→    end\n   246→  end\n   247→\n   248→  # Fallback for other form implementations (like to_form backed by maps)\n   249→  def encode_form_values(form, opts) do\n   250→    base_values =\n   251→      form.hidden\n   252→      |> Map.new()\n   253→      |> Map.merge(form.data)\n   254→      |> Map.merge(Map.new(form.params))\n   255→\n   256→    # For non-changeset forms, we don't have type information for embeds\n   257→    # so just encode the values as-is\n   258→    LiveVue.Encoder.encode(base_values, opts)\n   259→  end\n   260→\n   261→  if Code.ensure_loaded?(Ecto) do\n   262→    defp collect_changeset_errors(%Ecto.Changeset{} = changeset) do\n   263→      # Collect direct errors from this changeset\n   264→      errors = translate_errors(changeset.errors)\n   265→\n   266→      # Collect errors from nested embedded changesets\n   267→      Enum.reduce(changeset.changes, errors, fn {field, value}, acc ->\n   268→        case Map.get(changeset.types, field) do\n   269→          {tag, %{cardinality: :one}} when tag in @relations ->\n   270→            # Single embedded changeset\n   271→            embed_errors = collect_changeset_errors(value)\n   272→            if embed_errors == %{}, do: acc, else: Map.put(acc, field, embed_errors)\n   273→\n   274→          {tag, %{cardinality: :many}} when tag in @relations ->\n   275→            # List of embedded changesets\n   276→            # Must filter out changesets with nil params (deleted items) to ensure the errors\n   277→            # array has the same length and ordering as the values array (see line 210)\n   278→            list_errors =\n   279→              value\n   280→              |> Enum.filter(&(&1.params != nil))\n   281→              |> Enum.map(fn embed_changeset ->\n   282→                embed_errors = collect_changeset_errors(embed_changeset)\n   283→                if embed_errors == %{}, do: nil, else: embed_errors\n   284→              end)\n   285→\n   286→            # Only include the field if there are any errors in the list\n   287→            if Enum.all?(list_errors, &is_nil/1), do: acc, else: Map.put(acc, field, list_errors)\n   288→\n   289→          _ ->\n   290→            acc\n   291→        end\n   292→      end)\n   293→    end\n   294→\n   295→    def encode_form_errors(%{impl: Phoenix.HTML.FormData.Ecto.Changeset} = form) do\n   296→      collect_changeset_errors(form.source)\n   297→    end\n   298→  end\n   299→\n   300→  # Fallback for other form implementations (like test mocks)\n   301→  def encode_form_errors(form) do\n   302→    translate_errors(form.errors)\n   303→  end\n   304→\n   305→  defp translate_errors(errors) do\n   306→    Map.new(errors, fn {field, error} -> {field, error |> List.wrap() |> Enum.map(&translate_error/1)} end)\n   307→  end\n   308→\n   309→  defp translate_error({msg, opts}) do\n   310→    backend = Application.get_env(:live_vue, :gettext_backend, nil)\n   311→    count = opts[:count]\n   312→\n   313→    cond do\n   314→      backend != nil and count != nil and Code.ensure_loaded?(Gettext) ->\n   315→        apply(Gettext, :dngettext, [backend, \"errors\", msg, msg, count, opts])\n   316→\n   317→      backend != nil and Code.ensure_loaded?(Gettext) ->\n   318→        apply(Gettext, :dgettext, [backend, \"errors\", msg, opts])\n   319→\n   320→      true ->\n   321→        Enum.reduce(opts, msg, fn {key, value}, acc ->\n   322→          String.replace(acc, \"%{#{key}}\", value |> List.wrap() |> Enum.map_join(\", \", &to_string/1))\n   323→        end)\n   324→    end\n   325→  end\n   326→end\n   327→\n   328→# Default implementation for structs - convert to map and encode recursively\n   329→defimpl LiveVue.Encoder, for: Any do\n   330→  defmacro __deriving__(module, struct, opts) do\n   331→    fields = fields_to_encode(struct, opts)\n   332→\n   333→    quote do\n   334→      defimpl LiveVue.Encoder, for: unquote(module) do\n   335→        def encode(struct, opts) do\n   336→          struct\n   337→          |> Map.take(unquote(fields))\n   338→          |> LiveVue.Encoder.encode(opts)\n   339→        end\n   340→      end\n   341→    end\n   342→  end\n   343→\n   344→  def encode(%{__struct__: module} = struct, _opts) do\n   345→    raise Protocol.UndefinedError,\n   346→      protocol: @protocol,\n   347→      value: struct,\n   348→      description: \"\"\"\n   349→      LiveVue.Encoder protocol must always be explicitly implemented.\n   350→\n   351→      It's used to encode structs to JSON for LiveVue. It's very similar to Jason.Encoder,\n   352→      but it's converting structs to maps so LiveVue can diff them correctly.\n   353→\n   354→      If you own the struct, you can derive the implementation specifying \\\n   355→      which fields should be encoded:\n   356→\n   357→          defmodule #{inspect(module)} do\n   358→            @derive {LiveVue.Encoder, only: [...]}\n   359→            defstruct ...\n   360→          end\n   361→\n   362→      If you don't own the struct you want to encode, \\\n   363→      you may use Protocol.derive/3 placed outside of any module:\n   364→\n   365→          Protocol.derive(LiveVue.Encoder, #{inspect(module)}, only: [...])\n   366→          Protocol.derive(LiveVue.Encoder, #{inspect(module)})\n   367→\n   368→      Nothing prevents you from defining your own implementation for the struct:\n   369→\n   370→      defimpl LiveVue.Encoder, for: #{inspect(module)} do\n   371→        def encode(struct, opts) do\n   372→          struct\n   373→          |> Map.take([:first, :second])\n   374→          |> LiveVue.Encoder.encode(opts)\n   375→        end\n   376→      end\n   377→      \"\"\"\n   378→  end\n   379→\n   380→  def encode(value, _opts) do\n   381→    # For any other type, try to pass through as-is\n   382→    # This covers things like PIDs, references, etc.\n   383→    value\n   384→  end\n   385→\n   386→  defp fields_to_encode(struct, opts) do\n   387→    fields = Map.keys(struct)\n   388→\n   389→    cond do\n   390→      only = Keyword.get(opts, :only) ->\n   391→        case only -- fields do\n   392→          [] ->\n   393→            only\n   394→\n   395→          error_keys ->\n   396→            raise ArgumentError,\n   397→                  \":only specified keys (#{inspect(error_keys)}) that are not defined in defstruct: \" <>\n   398→                    \"#{inspect(fields -- [:__struct__])}\"\n   399→        end\n   400→\n   401→      except = Keyword.get(opts, :except) ->\n   402→        case except -- fields do\n   403→          [] ->\n   404→            fields -- [:__struct__ | except]\n   405→\n   406→          error_keys ->\n   407→            raise ArgumentError,\n   408→                  \":except specified keys (#{inspect(error_keys)}) that are not defined in defstruct: \" <>\n   409→                    \"#{inspect(fields -- [:__struct__])}\"\n   410→        end\n   411→\n   412→      true ->\n   413→        fields -- [:__struct__]\n   414→    end\n   415→  end\n   416→end\n   417→\n   418→# Phoenix LiveView AsyncResult struct\n   419→defimpl LiveVue.Encoder, for: Phoenix.LiveView.AsyncResult do\n   420→  def encode(%Phoenix.LiveView.AsyncResult{} = struct, opts) do\n   421→    LiveVue.Encoder.encode(\n   422→      %{\n   423→        ok: struct.ok?,\n   424→        loading: struct.loading,\n   425→        failed: encode_failed(struct.failed),\n   426→        result: struct.result\n   427→      },\n   428→      opts\n   429→    )\n   430→  end\n   431→\n   432→  # Unwrap error tuples for JSON compatibility\n   433→  defp encode_failed({:error, reason}), do: reason\n   434→  defp encode_failed({:exit, reason}), do: reason\n   435→  defp encode_failed(other), do: other\n   436→end\n   437→\n   438→# Phoenix LiveView Upload structs\n   439→# Explicit implementation of LiveVue.Encoder for UploadConfig\n   440→defimpl LiveVue.Encoder, for: Phoenix.LiveView.UploadConfig do\n   441→  def encode(%Phoenix.LiveView.UploadConfig{} = struct, opts) do\n   442→    errors =\n   443→      Enum.map(struct.errors, fn {key, value} ->\n   444→        %{ref: key, error: LiveVue.Encoder.encode(value, opts)}\n   445→      end)\n   446→\n   447→    entries =\n   448→      Enum.map(struct.entries, fn entry ->\n   449→        encoded = LiveVue.Encoder.encode(entry, opts)\n   450→        entry_errors = errors |> Enum.filter(&(&1.ref == entry.ref)) |> Enum.map(& &1.error)\n   451→        Map.put(encoded, :errors, entry_errors)\n   452→      end)\n   453→\n   454→    LiveVue.Encoder.encode(\n   455→      %{\n   456→        ref: struct.ref,\n   457→        name: struct.name,\n   458→        accept: struct.accept,\n   459→        max_entries: struct.max_entries,\n   460→        auto_upload: struct.auto_upload?,\n   461→        entries: entries,\n   462→        errors: errors\n   463→      },\n   464→      opts\n   465→    )\n   466→  end\n   467→end\n   468→\n   469→# Explicit implementation of LiveVue.Encoder for UploadEntry\n   470→defimpl LiveVue.Encoder, for: Phoenix.LiveView.UploadEntry do\n   471→  def encode(%Phoenix.LiveView.UploadEntry{} = struct, opts) do\n   472→    LiveVue.Encoder.encode(\n   473→      %{\n   474→        ref: struct.ref,\n   475→        client_name: struct.client_name,\n   476→        client_size: struct.client_size,\n   477→        client_type: struct.client_type,\n   478→        progress: struct.progress,\n   479→        done: struct.done?,\n   480→        valid: struct.valid?,\n   481→        preflighted: struct.preflighted?\n   482→      },\n   483→      opts\n   484→    )\n   485→  end\n   486→end\n   487→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"64a1054d-d5d1-470b-988c-6d3926af5d5d","uuid":"0450f4fd-53e6-4ba3-83a8-c19de0aa8d56","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/lib/live_vue/encoder.ex","content":"defprotocol LiveVue.Encoder do\n  @moduledoc \"\"\"\n  Protocol for encoding values to JSON for LiveVue.\n\n  This protocol is used to safely transform structs into plain maps before\n  calculating JSON patches. It ensures that struct fields are explicitly\n  exposed and prevents accidental exposure of sensitive data.\n\n  It's very similar to Jason.Encoder, but it's converting structs to maps instead of strings.\n\n  ## Deriving\n\n  The protocol allows leveraging Elixir's `@derive` feature to simplify protocol\n  implementation in trivial cases. Accepted options are:\n\n  * `:only` - encodes only values of specified keys.\n  * `:except` - encodes all struct fields except specified keys.\n\n  By default all keys except the `:__struct__` key are encoded.\n\n  ## Example\n\n  Let's assume a presence of the following struct:\n\n      defmodule User do\n        defstruct [:name, :email, :password]\n      end\n\n  If we were to call `@derive LiveVue.Encoder` just before `defstruct`, an\n  implementation would be generated that encodes all fields except `:__struct__`:\n\n      defmodule User do\n        @derive LiveVue.Encoder\n        defstruct [:name, :email, :password]\n      end\n\n  If we called `@derive {LiveVue.Encoder, only: [:name, :email]}`, only the\n  specified fields would be encoded:\n\n      defmodule User do\n        @derive {LiveVue.Encoder, only: [:name, :email]}\n        defstruct [:name, :email, :password]\n      end\n\n  If we called `@derive {LiveVue.Encoder, except: [:password]}`, all fields\n  except the specified ones would be encoded:\n\n      defmodule User do\n        @derive {LiveVue.Encoder, except: [:password]}\n        defstruct [:name, :email, :password]\n      end\n\n  ## Deriving outside of the module\n\n  If you don't own the struct you want to encode, you may use Protocol.derive/3 placed outside of any module:\n\n  Protocol.derive(LiveVue.Encoder, User, only: [...])\n\n  ## Custom implementations\n\n  You may define your own implementation for the struct:\n\n  defimpl LiveVue.Encoder, for: User do\n    def encode(struct, opts) do\n      struct\n      |> Map.take([:first, :second])\n      |> LiveVue.Encoder.encode(opts)\n    end\n  end\n  \"\"\"\n\n  @type t :: term\n  @type opts :: Keyword.t()\n  @fallback_to_any true\n\n  @doc \"\"\"\n  Encodes a value to one of the primitive types.\n  \"\"\"\n  @spec encode(t, opts) :: any()\n  def encode(value, opts \\\\ [])\nend\n\n# Primitive types that are already JSON serializable\ndefimpl LiveVue.Encoder, for: Integer do\n  def encode(value, _opts), do: value\nend\n\ndefimpl LiveVue.Encoder, for: Float do\n  def encode(value, _opts), do: value\nend\n\ndefimpl LiveVue.Encoder, for: BitString do\n  def encode(value, _opts), do: value\nend\n\ndefimpl LiveVue.Encoder, for: Atom do\n  def encode(atom, _opts), do: atom\nend\n\n# Complex types that need recursive encoding\ndefimpl LiveVue.Encoder, for: List do\n  def encode(list, opts) do\n    Enum.map(list, &LiveVue.Encoder.encode(&1, opts))\n  end\nend\n\ndefimpl LiveVue.Encoder, for: Map do\n  def encode(map, opts) do\n    Map.new(map, fn {key, value} ->\n      {key, LiveVue.Encoder.encode(value, opts)}\n    end)\n  end\nend\n\n# Date and time types - Jason encoder handles them\ndefimpl LiveVue.Encoder, for: [Date, Time, NaiveDateTime, DateTime] do\n  def encode(value, _opts) do\n    # otherwise diff is comparing tuples, and that's not what we want\n    @for.to_iso8601(value)\n  end\nend\n\ndefimpl LiveVue.Encoder, for: Phoenix.HTML.Form do\n  def encode(%Phoenix.HTML.Form{} = form, opts) do\n    LiveVue.Encoder.encode(\n      %{\n        name: form.name,\n        values: encode_form_values(form, opts),\n        errors: encode_form_errors(form) || %{},\n        valid: get_form_validity(form)\n      },\n      opts\n    )\n  rescue\n    error in [Protocol.UndefinedError] ->\n      reraise maybe_enhance_error(error), __STACKTRACE__\n  end\n\n  defp get_form_validity(%{source: %{valid?: valid}}), do: valid\n  defp get_form_validity(_), do: true\n\n  # Conditionally compiled helper to enhance error messages when Ecto is available\n  if Code.ensure_loaded?(Ecto) do\n    defp maybe_enhance_error(%{value: %Ecto.Association.NotLoaded{}} = error) do\n      Map.update!(error, :description, fn description ->\n        [first | rest] = String.split(description, \"\\n\\n\")\n\n        addition = \"\"\"\n        To prevent this error from happening in forms, you can explicitly encode form using LiveVue.Encoder.encode(form, nilify_not_loaded: true) option.\n        \"\"\"\n\n        Enum.join([first | [addition | rest]], \"\\n\\n\")\n      end)\n    end\n\n    defp maybe_enhance_error(error), do: error\n  else\n    defp maybe_enhance_error(error), do: error\n  end\n\n  if Code.ensure_loaded?(Ecto) do\n    @relations [:embed, :assoc]\n\n    # for changeset, we need to collect actual values from the changeset\n    # - if there are changes, we need to use changed values\n    # - if there are no changes, we should use params (possibly invalid, to reflect intermediate state)\n    # - if there are not changes and no params, we should use the data\n    # it's a bit tricky, because we need to traverse embeds and assocs\n    defp collect_changeset_values(%Ecto.Changeset{} = source, opts) do\n      data = Map.new(source.types, fn {field, type} -> {field, get_field_value(source, field, type, opts)} end)\n\n      result = if is_struct(source.data), do: Map.merge(source.data, data), else: data\n\n      # Filter out __meta__ field from Ecto schemas\n      Map.delete(result, :__meta__)\n    end\n\n    defp get_field_value(source, field, {tag, %{cardinality: :one}}, opts) when tag in @relations do\n      case Map.fetch(source.changes, field) do\n        {:ok, nil} ->\n          nil\n\n        {:ok, %Ecto.Changeset{} = changeset} ->\n          collect_changeset_values(changeset, opts)\n\n        # there are no changes underneath, so we can just use the data\n        :error ->\n          case Map.fetch!(source.data, field) do\n            %Ecto.Association.NotLoaded{} = not_loaded ->\n              # I was thinking how to solve this correctly\n              # but for now I think ignoring this is the best option\n              if opts[:nilify_not_loaded], do: nil, else: not_loaded\n\n            %{__meta__: _} = value ->\n              Map.delete(value, :__meta__)\n\n            value ->\n              value\n          end\n      end\n    end\n\n    defp get_field_value(source, field, {tag, %{cardinality: :many}}, opts) when tag in @relations do\n      case Map.fetch(source.changes, field) do\n        {:ok, changesets} ->\n          changesets\n          # we need to filter out changesets that have no params - they are removed from the form\n          |> Enum.filter(&(&1.params != nil))\n          |> Enum.map(&collect_changeset_values(&1, opts))\n\n        :error ->\n          case Map.fetch!(source.data, field) do\n            %Ecto.Association.NotLoaded{} = not_loaded ->\n              # let's return nil for not loaded associations\n              if opts[:nilify_not_loaded], do: nil, else: not_loaded\n\n            [%{__meta__: _} | _] = value ->\n              Enum.map(value, &Map.delete(&1, :__meta__))\n\n            value ->\n              value\n          end\n      end\n    end\n\n    defp get_field_value(source, field, _type, _opts) do\n      Phoenix.HTML.FormData.Ecto.Changeset.input_value(source, %{params: source.params}, field)\n\n      # # First try to get the value using the standard Phoenix input_value function\n      # case Phoenix.HTML.FormData.Ecto.Changeset.input_value(source, %{params: source.params}, field) do\n      #   nil ->\n      #     # If that returns nil, check if there's a field with [] suffix in params\n      #     # This handles the case where multiple checkbox fields have names like \"preferences[]\"\n      #     field_with_brackets = \"#{field}[]\"\n      #     case Map.get(source.params, field_with_brackets) do\n      #       nil -> nil\n      #       value -> value\n      #     end\n      #   value -> value\n      # end\n    end\n\n    def encode_form_values(%{impl: Phoenix.HTML.FormData.Ecto.Changeset, source: source}, opts) do\n      source |> collect_changeset_values(opts) |> LiveVue.Encoder.encode(opts)\n    end\n  end\n\n  # Fallback for other form implementations (like to_form backed by maps)\n  def encode_form_values(form, opts) do\n    base_values =\n      form.hidden\n      |> Map.new()\n      |> Map.merge(form.data)\n      |> Map.merge(Map.new(form.params))\n\n    # For non-changeset forms, we don't have type information for embeds\n    # so just encode the values as-is\n    LiveVue.Encoder.encode(base_values, opts)\n  end\n\n  if Code.ensure_loaded?(Ecto) do\n    defp collect_changeset_errors(%Ecto.Changeset{} = changeset) do\n      # Collect direct errors from this changeset\n      errors = translate_errors(changeset.errors)\n\n      # Collect errors from nested embedded changesets\n      Enum.reduce(changeset.changes, errors, fn {field, value}, acc ->\n        case Map.get(changeset.types, field) do\n          {tag, %{cardinality: :one}} when tag in @relations ->\n            # Single embedded changeset\n            embed_errors = collect_changeset_errors(value)\n            if embed_errors == %{}, do: acc, else: Map.put(acc, field, embed_errors)\n\n          {tag, %{cardinality: :many}} when tag in @relations ->\n            # List of embedded changesets\n            # Must filter out changesets with nil params (deleted items) to ensure the errors\n            # array has the same length and ordering as the values array (see line 210)\n            list_errors =\n              value\n              |> Enum.filter(&(&1.params != nil))\n              |> Enum.map(fn embed_changeset ->\n                embed_errors = collect_changeset_errors(embed_changeset)\n                if embed_errors == %{}, do: nil, else: embed_errors\n              end)\n\n            # Only include the field if there are any errors in the list\n            if Enum.all?(list_errors, &is_nil/1), do: acc, else: Map.put(acc, field, list_errors)\n\n          _ ->\n            acc\n        end\n      end)\n    end\n\n    def encode_form_errors(%{impl: Phoenix.HTML.FormData.Ecto.Changeset} = form) do\n      collect_changeset_errors(form.source)\n    end\n  end\n\n  # Fallback for other form implementations (like test mocks)\n  def encode_form_errors(form) do\n    translate_errors(form.errors)\n  end\n\n  defp translate_errors(errors) do\n    Map.new(errors, fn {field, error} -> {field, error |> List.wrap() |> Enum.map(&translate_error/1)} end)\n  end\n\n  defp translate_error({msg, opts}) do\n    backend = Application.get_env(:live_vue, :gettext_backend, nil)\n    count = opts[:count]\n\n    cond do\n      backend != nil and count != nil and Code.ensure_loaded?(Gettext) ->\n        apply(Gettext, :dngettext, [backend, \"errors\", msg, msg, count, opts])\n\n      backend != nil and Code.ensure_loaded?(Gettext) ->\n        apply(Gettext, :dgettext, [backend, \"errors\", msg, opts])\n\n      true ->\n        Enum.reduce(opts, msg, fn {key, value}, acc ->\n          String.replace(acc, \"%{#{key}}\", value |> List.wrap() |> Enum.map_join(\", \", &to_string/1))\n        end)\n    end\n  end\nend\n\n# Default implementation for structs - convert to map and encode recursively\ndefimpl LiveVue.Encoder, for: Any do\n  defmacro __deriving__(module, struct, opts) do\n    fields = fields_to_encode(struct, opts)\n\n    quote do\n      defimpl LiveVue.Encoder, for: unquote(module) do\n        def encode(struct, opts) do\n          struct\n          |> Map.take(unquote(fields))\n          |> LiveVue.Encoder.encode(opts)\n        end\n      end\n    end\n  end\n\n  def encode(%{__struct__: module} = struct, _opts) do\n    raise Protocol.UndefinedError,\n      protocol: @protocol,\n      value: struct,\n      description: \"\"\"\n      LiveVue.Encoder protocol must always be explicitly implemented.\n\n      It's used to encode structs to JSON for LiveVue. It's very similar to Jason.Encoder,\n      but it's converting structs to maps so LiveVue can diff them correctly.\n\n      If you own the struct, you can derive the implementation specifying \\\n      which fields should be encoded:\n\n          defmodule #{inspect(module)} do\n            @derive {LiveVue.Encoder, only: [...]}\n            defstruct ...\n          end\n\n      If you don't own the struct you want to encode, \\\n      you may use Protocol.derive/3 placed outside of any module:\n\n          Protocol.derive(LiveVue.Encoder, #{inspect(module)}, only: [...])\n          Protocol.derive(LiveVue.Encoder, #{inspect(module)})\n\n      Nothing prevents you from defining your own implementation for the struct:\n\n      defimpl LiveVue.Encoder, for: #{inspect(module)} do\n        def encode(struct, opts) do\n          struct\n          |> Map.take([:first, :second])\n          |> LiveVue.Encoder.encode(opts)\n        end\n      end\n      \"\"\"\n  end\n\n  def encode(value, _opts) do\n    # For any other type, try to pass through as-is\n    # This covers things like PIDs, references, etc.\n    value\n  end\n\n  defp fields_to_encode(struct, opts) do\n    fields = Map.keys(struct)\n\n    cond do\n      only = Keyword.get(opts, :only) ->\n        case only -- fields do\n          [] ->\n            only\n\n          error_keys ->\n            raise ArgumentError,\n                  \":only specified keys (#{inspect(error_keys)}) that are not defined in defstruct: \" <>\n                    \"#{inspect(fields -- [:__struct__])}\"\n        end\n\n      except = Keyword.get(opts, :except) ->\n        case except -- fields do\n          [] ->\n            fields -- [:__struct__ | except]\n\n          error_keys ->\n            raise ArgumentError,\n                  \":except specified keys (#{inspect(error_keys)}) that are not defined in defstruct: \" <>\n                    \"#{inspect(fields -- [:__struct__])}\"\n        end\n\n      true ->\n        fields -- [:__struct__]\n    end\n  end\nend\n\n# Phoenix LiveView AsyncResult struct\ndefimpl LiveVue.Encoder, for: Phoenix.LiveView.AsyncResult do\n  def encode(%Phoenix.LiveView.AsyncResult{} = struct, opts) do\n    LiveVue.Encoder.encode(\n      %{\n        ok: struct.ok?,\n        loading: struct.loading,\n        failed: encode_failed(struct.failed),\n        result: struct.result\n      },\n      opts\n    )\n  end\n\n  # Unwrap error tuples for JSON compatibility\n  defp encode_failed({:error, reason}), do: reason\n  defp encode_failed({:exit, reason}), do: reason\n  defp encode_failed(other), do: other\nend\n\n# Phoenix LiveView Upload structs\n# Explicit implementation of LiveVue.Encoder for UploadConfig\ndefimpl LiveVue.Encoder, for: Phoenix.LiveView.UploadConfig do\n  def encode(%Phoenix.LiveView.UploadConfig{} = struct, opts) do\n    errors =\n      Enum.map(struct.errors, fn {key, value} ->\n        %{ref: key, error: LiveVue.Encoder.encode(value, opts)}\n      end)\n\n    entries =\n      Enum.map(struct.entries, fn entry ->\n        encoded = LiveVue.Encoder.encode(entry, opts)\n        entry_errors = errors |> Enum.filter(&(&1.ref == entry.ref)) |> Enum.map(& &1.error)\n        Map.put(encoded, :errors, entry_errors)\n      end)\n\n    LiveVue.Encoder.encode(\n      %{\n        ref: struct.ref,\n        name: struct.name,\n        accept: struct.accept,\n        max_entries: struct.max_entries,\n        auto_upload: struct.auto_upload?,\n        entries: entries,\n        errors: errors\n      },\n      opts\n    )\n  end\nend\n\n# Explicit implementation of LiveVue.Encoder for UploadEntry\ndefimpl LiveVue.Encoder, for: Phoenix.LiveView.UploadEntry do\n  def encode(%Phoenix.LiveView.UploadEntry{} = struct, opts) do\n    LiveVue.Encoder.encode(\n      %{\n        ref: struct.ref,\n        client_name: struct.client_name,\n        client_size: struct.client_size,\n        client_type: struct.client_type,\n        progress: struct.progress,\n        done: struct.done?,\n        valid: struct.valid?,\n        preflighted: struct.preflighted?\n      },\n      opts\n    )\n  end\nend\n","numLines":487,"startLine":1,"totalLines":487}}}
