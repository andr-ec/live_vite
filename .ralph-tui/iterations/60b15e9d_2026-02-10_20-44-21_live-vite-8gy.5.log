st available = rendererNames.join(\", \")\n+      throw new Error(\n+        framework\n+          ? `Unknown framework \"${framework}\" for SSR. Registered renderers: ${available}`\n+          : `Missing framework for SSR. Registered renderers: ${available}`\n+      )\n+    }\n+\n+    const component = await entry.resolve(name)\n+    return entry.renderer.renderToString!({ component, props, slots })\n+  }\n+}\n+\n export const getRender = (componentsOrApp: Components | LiveViteOptions, manifest: Manifest = {}) => {\n   const { resolve, setup } = migrateToLiveViteApp(componentsOrApp)\n \ndiff --git a/assets/vitePlugin.js b/assets/vitePlugin.js\nindex fedc8ee..b762be5 100644\n--- a/assets/vitePlugin.js\n+++ b/assets/vitePlugin.js\n@@ -106,7 +106,7 @@ function liveVitePlugin(opts = {}) {\n           jsonMiddleware(req, res, async () => {\n             try {\n               const render = (await server.ssrLoadModule(entrypoint)).render\n-              const html = await render(req.body?.name, req.body?.props, req.body?.slots)\n+              const html = await render(req.body?.name, req.body?.props, req.body?.slots, req.body?.framework)\n               res.end(html)\n             } catch (e) {\n               e instanceof Error && server.ssrFixStacktrace(e)\ndiff --git a/lib/live_vite.ex b/lib/live_vite.ex\nindex dab7376..ff77c2d 100644\n--- a/lib/live_vite.ex\n+++ b/lib/live_vite.ex\n@@ -85,6 +85,7 @@ defmodule LiveVite do\n     use_diff = Map.get(assigns, :\"v-diff\", @diff_default)\n     use_streams_diff = Enum.any?(assigns, fn {_k, v} -> match?(%LiveStream{}, v) end)\n     render_ssr? = init and dead and Map.get(assigns, :\"v-ssr\", @ssr_default)\n+    framework = Map.get(assigns, :\"v-framework\", \"vue\")\n \n     # if we enable diffs, we use only changed props for all the remaining calculations\n     base_assigns =\n@@ -105,6 +106,7 @@ defmodule LiveVite do\n       assigns\n       |> Map.put_new(:class, nil)\n       |> Map.put(:__component_name, Map.get(assigns,