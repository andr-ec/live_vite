{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vqm8fUfsQ6zN8BSvFTX992","type":"tool_result","content":"     1→import { createContext, useContext, useEffect, useRef } from \"react\"\n     2→import type { HookInterface } from \"./phoenixFallbackTypes.js\"\n     3→\n     4→/**\n     5→ * React context for the LiveView hook instance.\n     6→ * Used by the React renderer to provide the hook to descendant components.\n     7→ */\n     8→export const LiveContext = createContext<HookInterface | null>(null)\n     9→\n    10→/**\n    11→ * Returns the LiveView hook instance.\n    12→ * Can be used to access pushEvent, handleEvent, the DOM element, and liveSocket\n    13→ * from within a LiveVite React component.\n    14→ *\n    15→ * Mirrors the Vue `useLiveVite()` composable.\n    16→ */\n    17→export function useLive(): HookInterface {\n    18→  const live = useContext(LiveContext)\n    19→  if (!live) throw new Error(\"LiveContext not provided. Are you using this inside a LiveVite component?\")\n    20→  return live\n    21→}\n    22→\n    23→/**\n    24→ * Subscribes to a server-sent event and automatically cleans up on unmount.\n    25→ * Mirrors the Vue `useLiveEvent()` composable.\n    26→ *\n    27→ * @param event - The event name to listen for.\n    28→ * @param callback - The callback invoked with the event payload.\n    29→ */\n    30→export function useLiveEvent<T>(event: string, callback: (data: T) => void): void {\n    31→  const live = useLive()\n    32→  // Use a ref so the effect doesn't re-run when the callback identity changes\n    33→  const callbackRef = useRef(callback)\n    34→  callbackRef.current = callback\n    35→\n    36→  useEffect(() => {\n    37→    const ref = live.handleEvent(event, (payload: T) => {\n    38→      callbackRef.current(payload)\n    39→    })\n    40→    return () => {\n    41→      live.removeHandleEvent(ref)\n    42→    }\n    43→  }, [live, event])\n    44→}\n    45→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"c12d4867-85b4-4194-8832-855654f89bf7","uuid":"0937b468-4072-4c65-a287-3d9175c0be2c","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/useReact.ts","content":"import { createContext, useContext, useEffect, useRef } from \"react\"\nimport type { HookInterface } from \"./phoenixFallbackTypes.js\"\n\n/**\n * React context for the LiveView hook instance.\n * Used by the React renderer to provide the hook to descendant components.\n */\nexport const LiveContext = createContext<HookInterface | null>(null)\n\n/**\n * Returns the LiveView hook instance.\n * Can be used to access pushEvent, handleEvent, the DOM element, and liveSocket\n * from within a LiveVite React component.\n *\n * Mirrors the Vue `useLiveVite()` composable.\n */\nexport function useLive(): HookInterface {\n  const live = useContext(LiveContext)\n  if (!live) throw new Error(\"LiveContext not provided. Are you using this inside a LiveVite component?\")\n  return live\n}\n\n/**\n * Subscribes to a server-sent event and automatically cleans up on unmount.\n * Mirrors the Vue `useLiveEvent()` composable.\n *\n * @param event - The event name to listen for.\n * @param callback - The callback invoked with the event payload.\n */\nexport function useLiveEvent<T>(event: string, callback: (data: T) => void): void {\n  const live = useLive()\n  // Use a ref so the effect doesn't re-run when the callback identity changes\n  const callbackRef = useRef(callback)\n  callbackRef.current = callback\n\n  useEffect(() => {\n    const ref = live.handleEvent(event, (payload: T) => {\n      callbackRef.current(payload)\n    })\n    return () => {\n      live.removeHandleEvent(ref)\n    }\n  }, [live, event])\n}\n","numLines":45,"startLine":1,"totalLines":45}}}
