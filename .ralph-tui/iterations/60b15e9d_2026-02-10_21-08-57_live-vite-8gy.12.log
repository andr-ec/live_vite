{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vm561NcHLiB8Vmhm7UzbQ9","type":"tool_result","content":"     1→import { createElement } from \"react\"\n     2→import { createRoot, hydrateRoot, type Root } from \"react-dom/client\"\n     3→import type { FrameworkRenderer, MountContext, RendererState } from \"../renderer.js\"\n     4→import { applyPatch, type Operation } from \"../jsonPatch.js\"\n     5→import { mapValues } from \"../utils.js\"\n     6→import { LiveContext } from \"../useReact.js\"\n     7→\n     8→/**\n     9→ * State specific to the React renderer.\n    10→ * We store the component and hook alongside the root so we can\n    11→ * re-render the full tree on every prop/slot update.\n    12→ */\n    13→interface ReactRendererState {\n    14→  root: Root\n    15→  component: unknown\n    16→  hook: any\n    17→}\n    18→\n    19→/**\n    20→ * Convert slot name -> HTML string into React elements.\n    21→ * Each slot renders as a span with dangerouslySetInnerHTML.\n    22→ */\n    23→function htmlSlotsToReact(slots: Record<string, string>): Record<string, () => any> {\n    24→  return mapValues(slots, html => () =>\n    25→    createElement(\"span\", { dangerouslySetInnerHTML: { __html: html.trim() } })\n    26→  )\n    27→}\n    28→\n    29→/**\n    30→ * Re-render the React component tree with current props and slots.\n    31→ * Wraps the component in LiveContext.Provider so useLive()/useLiveEvent() work.\n    32→ */\n    33→function renderComponent(state: RendererState<ReactRendererState>): void {\n    34→  const { root, component, hook } = state.app!\n    35→  const inner = createElement(component as any, {\n    36→    ...state.props,\n    37→    ...mapValues(state.slots, slotFn => slotFn()),\n    38→    live: hook,\n    39→  })\n    40→  root.render(createElement(LiveContext.Provider, { value: hook }, inner))\n    41→}\n    42→\n    43→export interface ReactRendererOptions {\n    44→  /** Vite SSR manifest for preload link generation (production builds only). */\n    45→  manifest?: Record<string, string[]>\n    46→}\n    47→\n    48→/**\n    49→ * Creates a React framework renderer.\n    50→ *\n    51→ * Implements the `FrameworkRenderer` interface for React 18+.\n    52→ * Uses `createRoot`/`hydrateRoot` for mounting and re-renders the full\n    53→ * component tree on every prop/slot update via `root.render()`.\n    54→ *\n    55→ * Props are stored as a plain mutable object. Since React has no built-in\n    56→ * reactivity system, updates trigger an explicit re-render call.\n    57→ *\n    58→ * Slots are passed as React elements via `dangerouslySetInnerHTML`.\n    59→ */\n    60→export function createReactRenderer(options: ReactRendererOptions = {}): FrameworkRenderer<ReactRendererState> {\n    61→  return {\n    62→    name: \"react\",\n    63→\n    64→    mount(ctx: MountContext): RendererState<ReactRendererState> {\n    65→      const props = { ...ctx.props }\n    66→      const slots = htmlSlotsToReact(ctx.slots)\n    67→\n    68→      const inner = createElement(ctx.component as any, {\n    69→        ...props,\n    70→        ...mapValues(slots, slotFn => slotFn()),\n    71→        live: ctx.hook,\n    72→      })\n    73→      const element = createElement(LiveContext.Provider, { value: ctx.hook }, inner)\n    74→\n    75→      let root: Root\n    76→      if (ctx.ssr) {\n    77→        root = hydrateRoot(ctx.el, element)\n    78→      } else {\n    79→        root = createRoot(ctx.el)\n    80→        root.render(element)\n    81→      }\n    82→\n    83→      const state: RendererState<ReactRendererState> = {\n    84→        props,\n    85→        slots,\n    86→        app: { root, component: ctx.component, hook: ctx.hook },\n    87→      }\n    88→\n    89→      return state\n    90→    },\n    91→\n    92→    updateProps(state: RendererState<ReactRendererState>, newProps: Record<string, any>): void {\n    93→      Object.assign(state.props, newProps)\n    94→      renderComponent(state)\n    95→    },\n    96→\n    97→    patchProps(state: RendererState<ReactRendererState>, operations: Operation[]): void {\n    98→      applyPatch(state.props, operations)\n    99→      renderComponent(state)\n   100→    },\n   101→\n   102→    updateSlots(state: RendererState<ReactRendererState>, newSlots: Record<string, string>): void {\n   103→      Object.assign(state.slots, htmlSlotsToReact(newSlots))\n   104→      renderComponent(state)\n   105→    },\n   106→\n   107→    unmount(state: RendererState<ReactRendererState>): void {\n   108→      if (state.app) {\n   109→        window.addEventListener(\"phx:page-loading-stop\", () => state.app!.root.unmount(), { once: true })\n   110→      }\n   111→    },\n   112→\n   113→    async renderToString(ctx): Promise<string> {\n   114→      const { renderToString: reactRenderToString } = await import(\"react-dom/server\")\n   115→\n   116→      const slotElements = mapValues(htmlSlotsToReact(ctx.slots), slotFn => slotFn())\n   117→      const element = createElement(ctx.component as any, {\n   118→        ...ctx.props,\n   119→        ...slotElements,\n   120→      })\n   121→\n   122→      const html = reactRenderToString(element)\n   123→      return \"<!-- preload -->\" + html\n   124→    },\n   125→  }\n   126→}\n   127→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"c12d4867-85b4-4194-8832-855654f89bf7","uuid":"4315a7f4-f252-4727-b3f2-11ad90897e9e","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/renderers/react.ts","content":"import { createElement } from \"react\"\nimport { createRoot, hydrateRoot, type Root } from \"react-dom/client\"\nimport type { FrameworkRenderer, MountContext, RendererState } from \"../renderer.js\"\nimport { applyPatch, type Operation } from \"../jsonPatch.js\"\nimport { mapValues } from \"../utils.js\"\nimport { LiveContext } from \"../useReact.js\"\n\n/**\n * State specific to the React renderer.\n * We store the component and hook alongside the root so we can\n * re-render the full tree on every prop/slot update.\n */\ninterface ReactRendererState {\n  root: Root\n  component: unknown\n  hook: any\n}\n\n/**\n * Convert slot name -> HTML string into React elements.\n * Each slot renders as a span with dangerouslySetInnerHTML.\n */\nfunction htmlSlotsToReact(slots: Record<string, string>): Record<string, () => any> {\n  return mapValues(slots, html => () =>\n    createElement(\"span\", { dangerouslySetInnerHTML: { __html: html.trim() } })\n  )\n}\n\n/**\n * Re-render the React component tree with current props and slots.\n * Wraps the component in LiveContext.Provider so useLive()/useLiveEvent() work.\n */\nfunction renderComponent(state: RendererState<ReactRendererState>): void {\n  const { root, component, hook } = state.app!\n  const inner = createElement(component as any, {\n    ...state.props,\n    ...mapValues(state.slots, slotFn => slotFn()),\n    live: hook,\n  })\n  root.render(createElement(LiveContext.Provider, { value: hook }, inner))\n}\n\nexport interface ReactRendererOptions {\n  /** Vite SSR manifest for preload link generation (production builds only). */\n  manifest?: Record<string, string[]>\n}\n\n/**\n * Creates a React framework renderer.\n *\n * Implements the `FrameworkRenderer` interface for React 18+.\n * Uses `createRoot`/`hydrateRoot` for mounting and re-renders the full\n * component tree on every prop/slot update via `root.render()`.\n *\n * Props are stored as a plain mutable object. Since React has no built-in\n * reactivity system, updates trigger an explicit re-render call.\n *\n * Slots are passed as React elements via `dangerouslySetInnerHTML`.\n */\nexport function createReactRenderer(options: ReactRendererOptions = {}): FrameworkRenderer<ReactRendererState> {\n  return {\n    name: \"react\",\n\n    mount(ctx: MountContext): RendererState<ReactRendererState> {\n      const props = { ...ctx.props }\n      const slots = htmlSlotsToReact(ctx.slots)\n\n      const inner = createElement(ctx.component as any, {\n        ...props,\n        ...mapValues(slots, slotFn => slotFn()),\n        live: ctx.hook,\n      })\n      const element = createElement(LiveContext.Provider, { value: ctx.hook }, inner)\n\n      let root: Root\n      if (ctx.ssr) {\n        root = hydrateRoot(ctx.el, element)\n      } else {\n        root = createRoot(ctx.el)\n        root.render(element)\n      }\n\n      const state: RendererState<ReactRendererState> = {\n        props,\n        slots,\n        app: { root, component: ctx.component, hook: ctx.hook },\n      }\n\n      return state\n    },\n\n    updateProps(state: RendererState<ReactRendererState>, newProps: Record<string, any>): void {\n      Object.assign(state.props, newProps)\n      renderComponent(state)\n    },\n\n    patchProps(state: RendererState<ReactRendererState>, operations: Operation[]): void {\n      applyPatch(state.props, operations)\n      renderComponent(state)\n    },\n\n    updateSlots(state: RendererState<ReactRendererState>, newSlots: Record<string, string>): void {\n      Object.assign(state.slots, htmlSlotsToReact(newSlots))\n      renderComponent(state)\n    },\n\n    unmount(state: RendererState<ReactRendererState>): void {\n      if (state.app) {\n        window.addEventListener(\"phx:page-loading-stop\", () => state.app!.root.unmount(), { once: true })\n      }\n    },\n\n    async renderToString(ctx): Promise<string> {\n      const { renderToString: reactRenderToString } = await import(\"react-dom/server\")\n\n      const slotElements = mapValues(htmlSlotsToReact(ctx.slots), slotFn => slotFn())\n      const element = createElement(ctx.component as any, {\n        ...ctx.props,\n        ...slotElements,\n      })\n\n      const html = reactRenderToString(element)\n      return \"<!-- preload -->\" + html\n    },\n  }\n}\n","numLines":127,"startLine":1,"totalLines":127}}}
