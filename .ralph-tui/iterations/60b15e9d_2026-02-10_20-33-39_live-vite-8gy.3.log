9→      if (!app) throw new Error(\"Vue SSR setup function did not return an app!\")\n   140→\n   141→      const vueCtx: import(\"vue/server-renderer\").SSRContext = {}\n   142→      const html = await vueRenderToString(app, vueCtx)\n   143→\n   144→      // the SSR manifest generated by Vite contains module -> chunk/asset mapping\n   145→      // which we can then use to determine what files need to be preloaded for this request.\n   146→      const preloadLinks = renderPreloadLinks(vueCtx.modules ?? [], manifest)\n   147→      return preloadLinks + \"<!-- preload -->\" + html\n   148→    },\n   149→  }\n   150→}\n   151→\n   152→type SSRManifest = Record<string, string[]>\n   153→\n   154→function renderPreloadLinks(modules: string[], manifest: SSRManifest) {\n   155→  let links = \"\"\n   156→  const seen = new Set()\n   157→  modules.forEach((id: string) => {\n   158→    const files = manifest[id]\n   159→    if (files) {\n   160→      files.forEach(file => {\n   161→        if (!seen.has(file)) {\n   162→          seen.add(file)\n   163→          const filename = file.split(\"/\").pop() ?? file\n   164→          if (manifest[filename]) {\n   165→            for (const depFile of manifest[filename]) {\n   166→              links += renderPreloadLink(depFile)\n   167→              seen.add(depFile)\n   168→            }\n   169→          }\n   170→          links += renderPreloadLink(file)\n   171→        }\n   172→      })\n   173→    }\n   174→  })\n   175→  return links\n   176→}\n   177→\n   178→function renderPreloadLink(file: string) {\n   179→  if (file.endsWith(\".js\")) {\n   180→    return `<link rel=\"modulepreload\" crossorigin href=\"${file}\">`\n   181→  } else if (file.endsWith(\".css\")) {\n   182→    return `<link rel=\"stylesheet\" href=\"${file}\">`\n   183→  } else if (file.endsWith(\".woff\")) {\n   184→    return ` <link rel=\"preload\" href=\"${file}\" as=\"font\" type=\"font/woff\" crossorigin>`\n   185→  } else if (file.endsWith(\".woff2