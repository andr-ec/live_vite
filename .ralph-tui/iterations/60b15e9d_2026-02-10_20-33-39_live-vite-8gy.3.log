{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VitvMjZAtV1toWcdizFzYM","type":"tool_result","content":"     1→import { isProxy, isReactive, isRef, toRaw } from \"vue\"\n     2→import type { ComponentMap, ComponentOrComponentPromise } from \"./types.js\"\n     3→\n     4→/**\n     5→ * Maps the values of an object using a callback function and returns a new object with the mapped values.\n     6→ * @returns A new object with the mapped values.\n     7→ */\n     8→export const mapValues = <T, U>(\n     9→  object: Record<string, T>,\n    10→  cb: (value: T, key: string, object: Record<string, T>) => U\n    11→): Record<string, U> =>\n    12→  Object.entries(object).reduce((acc, [key, value]) => {\n    13→    acc[key] = cb(value, key, object)\n    14→    return acc\n    15→  }, {} as Record<string, U>)\n    16→\n    17→/**\n    18→ * Flattens the keys of an object using a callback function and returns a new object with the flattened keys.\n    19→ * @returns A new object with the flattened keys.\n    20→ */\n    21→export const flatMapKeys = <T>(\n    22→  object: Record<string, T>,\n    23→  cb: (key: string, value: any, object: Record<string, T>) => string[]\n    24→): Record<string, T> =>\n    25→  Object.entries(object).reduce((acc, [key, value]) => {\n    26→    const newKeys = cb(key, value, object)\n    27→    for (const newKey of newKeys) acc[newKey] = value\n    28→    return acc\n    29→  }, {} as Record<string, T>)\n    30→\n    31→/**\n    32→ * Finds a component by name or path suffix.\n    33→ * @returns The component if found, otherwise throws an error with a list of available components.\n    34→ */\n    35→export const findComponent = (components: ComponentMap, name: string): ComponentOrComponentPromise => {\n    36→  const nameParts = name.replace(/\\.vue$/, '').split('/').filter(part => part !== 'index')\n    37→  const matches: [string, ComponentOrComponentPromise][] = []\n    38→\n    39→  for (const [key, value] of Obje