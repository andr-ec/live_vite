he Vue app. Defaults to `defaultVueSetup`. */\n    47→  setup?: VueSetupFn\n    48→}\n    49→\n    50→/** Mock LiveView hook used during SSR (no real socket available) */\n    51→const mockHook = {\n    52→  el: {},\n    53→  liveSocket: { socket: { connectionState: () => \"closed\" } } as any,\n    54→  pushEvent: () => Promise.resolve(0),\n    55→  pushEventTo: () => Promise.resolve([]),\n    56→  handleEvent: () => ({ event: \"\", callback: () => {} }),\n    57→  removeHandleEvent: () => {},\n    58→  upload: () => {},\n    59→  uploadTo: () => {},\n    60→  vue: { props: {}, slots: {}, app: {} },\n    61→}\n    62→\n    63→/**\n    64→ * Creates a Vue framework renderer.\n    65→ *\n    66→ * This is the reference implementation of the `FrameworkRenderer` interface.\n    67→ * It handles Vue-specific concerns: `reactive()` for props, `h()` for slots,\n    68→ * `createApp`/`createSSRApp` for mounting, and `app.unmount()` for cleanup.\n    69→ */\n    70→export function createVueRenderer(options: VueRendererOptions = {}): FrameworkRenderer<VueApp> {\n    71→  const setup = options.setup ?? defaultVueSetup\n    72→\n    73→  return {\n    74→    name: \"vue\",\n    75→\n    76→    mount(ctx: MountContext): RendererState<VueApp> {\n    77→      const makeApp = ctx.ssr ? createSSRApp : createApp\n    78→      const props = reactive(ctx.props)\n    79→      const slots = reactive(htmlSlotsToVue(ctx.slots))\n    80→\n    81→      const plugin: Plugin<[]> = {\n    82→        install: (app: App) => {\n    83→          app.provide(liveInjectKey, ctx.hook)\n    84→          app.config.globalProperties.$live = ctx.hook\n    85→        },\n    86→      }\n    87→\n    88→      const app = setup(makeApp, ctx.component, props, slots, plugin, ctx.el, ctx.ssr)\n    89→\n    90→      if (!app) throw new Error(\"Vue setup function did not return an app!\")\n    91→\n    92→      return { props, slots, app }\n    93→    },\n    94→\n    95→    updateProps(state: RendererState<VueApp>, newProps: Record<string, any>): void {\n    96→      Object.assign(state.props, newProps)\n    97→    },\n    98→\n    99→    patchProps(state: RendererState<VueApp>, operations: Operation[]): void {\n   100→      applyPatch(state.props, operations)\n   101→    },\n   102→\n   103→    updateSlots(state: RendererState<VueApp>, newSlots: Record<string, string>): void {\n   104→      Object.assign(state.slots, htmlSlotsToVue(newSlots))\n   105→    },\n   106→\n   107→    unmount(state: RendererState<VueApp>): void {\n   108→      if (state.app) {\n   109→        window.addEventListener(\"phx:page-loading-stop\", () => state.app!.unmount(), { once: true })\n   110→      }\n   111→    },\n   112→\n   113→    async renderToString(ctx: RendererSSRContext): Promise<string> {\n   114→      // Dynamic import to avoid bundling server-only deps in client builds\n   115→      const { renderToString: vueRenderToString } = await import(\"vue/server-renderer\")\n   116→\n   117→      const component = ctx.component\n   118→      const slotComponents = htmlSlotsToVue(ctx.slots)\n   119→\n   120→      const ssrSetup = options.setup ?? ((makeApp, component, props, slots, plugin, el) => {\n   121→        const app = makeApp({ render: () => h(component, props, slots) })\n   122→        app.use(plugin)\n   123→        // Don't mount in SSR - no real DOM\n   124→        return app\n   125→      })\n   126→\n   127→      const plugin: Plugin<[]> = {\n   128→        install: (app: App) => {\n   129→          app.mount = (...args: unknown[]): any => undefined\n   130→          app.provide(\"_live_vite\", Object.assign({}, mockHook))\n   131→        },\n   132→      }\n   133→\n   134→      const app = ssrSetup(createSSRApp, component, ctx.props, slotComponents, plugin, {} as Element, true)\n   135→\n   136→      if (!app) throw new Error(\"Vue SSR setup function did not return an app!\")\n   137→\n   138→      const vueCtx: import(\"vue/server-renderer\").SSRContext = {}\n   139→      const html = await vueRenderToString(app, vueCtx)\n   140→\n   141→      return html\n   142→    },\n   143→  }\n   144→}\n   145→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"1899652c-e413-41dd-8fde-eabe52f30594","uuid":"91059cdb-2a13-4316-a4d6-54135fe7f331","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/renderers/vue.ts","content":"import { createApp, createSSRApp, h, reactive, type App, type Plugin } from \"vue\"\nimport type { FrameworkRenderer, MountContext, RendererState, SSRContext as RendererSSRContext } from \"../renderer.js\"\nimport { applyPatch, type Operation } from \"../jsonPatch.js\"\nimport { liveInjectKey } from \"../use.js\"\nimport { mapValues } from \"../utils.js\"\n\ntype VueApp = App<Element>\n\n/**\n * Convert slot name -> HTML string into Vue slot functions.\n * Each slot renders as a div with innerHTML set to the decoded HTML.\n */\nfunction htmlSlotsToVue(slots: Record<string, string>): Record<string, () => any> {\n  return mapValues(slots, html => () => h(\"div\", { innerHTML: html.trim() }))\n}\n\n/**\n * The default Vue setup function. Creates a Vue app, installs the LiveVite\n * plugin, and mounts it. Users can override this via `createLiveVite({ setup })`.\n */\nexport const defaultVueSetup = (\n  makeApp: typeof createApp | typeof createSSRApp,\n  component: any,\n  props: Record<string, any>,\n  slots: Record<string, () => any>,\n  plugin: Plugin<[]>,\n  el: Element,\n): VueApp => {\n  const app = makeApp({ render: () => h(component, props, slots) })\n  app.use(plugin)\n  app.mount(el)\n  return app\n}\n\nexport type VueSetupFn = (\n  makeApp: typeof createApp | typeof createSSRApp,\n  component: any,\n  props: Record<string, any>,\n  slots: Record<string, () => any>,\n  plugin: Plugin<[]>,\n  el: Element,\n  ssr: boolean,\n) => VueApp\n\nexport interface VueRendererOptions {\n  /** Custom setup function for creating the Vue app. Defaults to `defaultVueSetup`. */\n  setup?: VueSetupFn\n}\n\n/** Mock LiveView hook used during SSR (no real socket available) */\nconst mockHook = {\n  el: {},\n  liveSocket: { socket: { connectionState: () => \"closed\" } } as any,\n  pushEvent: () => Promise.resolve(0),\n  pushEventTo: () => Promise.resolve([]),\n  handleEvent: () => ({ event: \"\", callback: () => {} }),\n  removeHandleEvent: () => {},\n  upload: () => {},\n  uploadTo: () => {},\n  vue: { props: {}, slots: {}, app: {} },\n}\n\n/**\n * Creates a Vue framework renderer.\n *\n * This is the reference implementation of the `FrameworkRenderer` interface.\n * It handles Vue-specific concerns: `reactive()` for props, `h()` for slots,\n * `createApp`/`createSSRApp` for mounting, and `app.unmount()` for cleanup.\n */\nexport function createVueRenderer(options: VueRendererOptions = {}): FrameworkRenderer<VueApp> {\n  const setup = options.setup ?? defaultVueSetup\n\n  return {\n    name: \"vue\",\n\n    mount(ctx: MountContext): RendererState<VueApp> {\n      const makeApp = ctx.ssr ? createSSRApp : createApp\n      const props = reactive(ctx.props)\n      const slots = reactive(htmlSlotsToVue(ctx.slots))\n\n      const plugin: Plugin<[]> = {\n        install: (app: App) => {\n          app.provide(liveInjectKey, ctx.hook)\n          app.config.globalProperties.$live = ctx.hook\n        },\n      }\n\n      const app = setup(makeApp, ctx.component, props, slots, plugin, ctx.el, ctx.ssr)\n\n      if (!app) throw new Error(\"Vue setup function did not return an app!\")\n\n      return { props, slots, app }\n    },\n\n    updateProps(state: RendererState<VueApp>, newProps: Record<string, any>): void {\n      Object.assign(state.props, newProps)\n    },\n\n    patchProps(state: RendererState<VueApp>, operations: Operation[]): void {\n      applyPatch(state.props, operations)\n    },\n\n    updateSlots(state: RendererState<VueApp>, newSlots: Record<string, string>): void {\n      Object.assign(state.slots, htmlSlotsToVue(newSlots))\n    },\n\n    unmount(state: RendererState<VueApp>): void {\n      if (state.app) {\n        window.addEventListener(\"phx:page-loading-stop\", () => state.app!.unmount(), { once: true })\n      }\n    },\n\n    async renderToString(ctx: RendererSSRContext): Promise<string> {\n      // Dynamic import to avoid bundling server-only deps in client builds\n      const { renderToString: vueRenderToString } = await import(\"vue/server-renderer\")\n\n      const component = ctx.component\n      const slotComponents = htmlSlotsToVue(ctx.slots)\n\n      const ssrSetup = options.setup ?? ((makeApp, component, props, slots, plugin, el) => {\n        const app = makeApp({ render: () => h(component, props, slots) })\n        app.use(plugin)\n        // Don't mount in SSR - no real DOM\n        return app\n      })\n\n      const plugin: Plugin<[]> = {\n        install: (app: App) => {\n          app.mount = (...args: unknown[]): any => undefined\n          app.provide(\"_live_vite\", Object.assign({}, mockHook))\n        },\n      }\n\n      const app = ssrSetup(createSSRApp, component, ctx.props, slotComponents, plugin, {} as Element, true)\n\n      if (!app) throw new Error(\"Vue SSR setup function did not return an app!\")\n\n      const vueCtx: import(\"vue/server-renderer\").SSRContext = {}\n      const html = await vueRenderToString(app, vueCtx)\n\n      return html\n    },\n  }\n}\n","numLines":145,"startLine":1,"totalLines":145}}}
