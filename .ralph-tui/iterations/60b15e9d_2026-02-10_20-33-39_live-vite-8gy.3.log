rer = createVueRenderer({ setup: vueSetup, manifest })\n  return getRendererRender(renderer, resolve)\n}"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":877,"cache_read_input_tokens":87380,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":877},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"1899652c-e413-41dd-8fde-eabe52f30594","uuid":"c6349514-c849-4d8d-a9f2-9868c5f37a97"}
