{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S4T9mGVgNPFQVV4NELZPW7","type":"tool_result","content":"     1→import { describe, it, expect, vi, beforeEach } from \"vitest\"\n     2→import { ref, reactive, type App } from \"vue\"\n     3→import { getVueHook } from \"./hooks\"\n     4→import type { LiveViteApp, Hook } from \"./types\"\n     5→import { toUtf8Base64 } from \"./utils\"\n     6→\n     7→// Mock Vue component for testing\n     8→const MockComponent = {\n     9→  template: \"<div>{{ message }}</div>\",\n    10→  props: [\"message\", \"count\"],\n    11→  setup(props: any) {\n    12→    return { props }\n    13→  },\n    14→}\n    15→\n    16→// Mock LiveView hook context\n    17→const createMockLiveViewHook = (elementAttributes: Record<string, string> = {}) => {\n    18→  const mockElement = {\n    19→    getAttribute: vi.fn((name: string) => elementAttributes[name] || null),\n    20→    setAttribute: vi.fn(),\n    21→    removeAttribute: vi.fn(),\n    22→  } as any\n    23→\n    24→  const mockLiveSocket = {\n    25→    execJS: vi.fn(),\n    26→  }\n    27→\n    28→  return {\n    29→    el: mockElement,\n    30→    liveSocket: mockLiveSocket,\n    31→    vue: undefined as any,\n    32→  } as any // Type assertion to avoid strict type checking for test mocks\n    33→}\n    34→\n    35→// Mock LiveVite app configuration\n    36→const createMockLiveViteApp = (component = MockComponent): LiveViteApp => ({\n    37→  resolve: vi.fn().mockResolvedValue(component),\n    38→  setup: vi.fn(({ createApp, component, props, slots, plugin, el }) => {\n    39→    const app = createApp({\n    40→      render: () => null, // simplified for testing\n    41→    })\n    42→    app.use(plugin)\n    43→\n    44→    // Mock mount method to avoid DOM operations\n    45→    app.mount = vi.fn().mockReturnValue(app)\n    46→\n    47→    return app\n    48→  }),\n    49→})\n    50→\n    51→describe(\"getVueHook\", () => {\n    52→  let mockLiveViteApp: LiveViteApp\n    53→  let mockHookContext: ReturnType<typeof createMockLiveViewHook>\n    54→  let vueHook: Hook\n    55→\n    56→  beforeEach(() => {\n    57→    vi.clearAllMocks()\n    58→    mockLiveViteApp = createMockLiveViteApp()\n    59→    mockHookContext = createMockLiveViewHook()\n    60→    vueHook = getVueHook(mockLiveViteApp)\n    61→  })\n    62→\n    63→  describe(\"mounted lifecycle\", () => {\n    64→    it(\"should resolve component by name from data-name attribute\", async () => {\n    65→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n    66→        if (name === \"data-name\") return \"TestComponent\"\n    67→        return null\n    68→      })\n    69→\n    70→      await vueHook.mounted!.call(mockHookContext)\n    71→\n    72→      expect(mockLiveViteApp.resolve).toHaveBeenCalledWith(\"TestComponent\")\n    73→    })\n    74→\n    75→    it(\"should create SSR app when data-ssr is true\", async () => {\n    76→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n    77→        if (name === \"data-name\") return \"TestComponent\"\n    78→        if (name === \"data-ssr\") return \"true\"\n    79→        return null\n    80→      })\n    81→\n    82→      await vueHook.mounted!.call(mockHookContext)\n    83→\n    84→      // Verify setup was called with correct parameters\n    85→      expect(mockLiveViteApp.setup).toHaveBeenCalledWith(\n    86→        expect.objectContaining({\n    87→          component: MockComponent,\n    88→          ssr: false,\n    89→        })\n    90→      )\n    91→    })\n    92→\n    93→    it(\"should create client app when data-ssr is not true\", async () => {\n    94→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n    95→        if (name === \"data-name\") return \"TestComponent\"\n    96→        if (name === \"data-ssr\") return \"false\"\n    97→        return null\n    98→      })\n    99→\n   100→      await vueHook.mounted!.call(mockHookContext)\n   101→\n   102→      expect(mockLiveViteApp.setup).toHaveBeenCalledWith(\n   103→        expect.objectContaining({\n   104→          component: MockComponent,\n   105→          ssr: false,\n   106→        })\n   107→      )\n   108→    })\n   109→\n   110→    it(\"should parse props from data-props attribute\", async () => {\n   111→      const mockProps = { message: \"Hello\", count: 42 }\n   112→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   113→        if (name === \"data-name\") return \"TestComponent\"\n   114→        if (name === \"data-props\") return JSON.stringify(mockProps)\n   115→        return null\n   116→      })\n   117→\n   118→      await vueHook.mounted!.call(mockHookContext)\n   119→\n   120→      expect(mockLiveViteApp.setup).toHaveBeenCalledWith(\n   121→        expect.objectContaining({\n   122→          props: expect.objectContaining(mockProps),\n   123→        })\n   124→      )\n   125→    })\n   126→\n   127→    it(\"should parse handlers from data-handlers attribute\", async () => {\n   128→      const mockHandlers = { click: '[[\"push\", {\"event\": \"test-event\"}, \"phx-target\": null]]' }\n   129→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   130→        if (name === \"data-name\") return \"TestComponent\"\n   131→        if (name === \"data-handlers\") return JSON.stringify(mockHandlers)\n   132→        return null\n   133→      })\n   134→\n   135→      await vueHook.mounted!.call(mockHookContext)\n   136→\n   137→      const setupCall = (mockLiveViteApp.setup as any).mock.calls[0][0]\n   138→      expect(setupCall.props).toHaveProperty(\"onClick\")\n   139→      expect(typeof setupCall.props.onClick).toBe(\"function\")\n   140→    })\n   141→\n   142→    it(\"should parse slots from data-slots attribute\", async () => {\n   143→      const mockSlots = { default: toUtf8Base64(\"<p>😸Slot content😸</p>\") }\n   144→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   145→        if (name === \"data-name\") return \"TestComponent\"\n   146→        if (name === \"data-slots\") return JSON.stringify(mockSlots)\n   147→        return null\n   148→      })\n   149→\n   150→      await vueHook.mounted!.call(mockHookContext)\n   151→\n   152→      const setupCall = (mockLiveViteApp.setup as any).mock.calls[0][0]\n   153→      expect(setupCall.slots).toHaveProperty(\"default\")\n   154→      expect(typeof setupCall.slots.default).toBe(\"function\")\n   155→    })\n   156→\n   157→    it(\"should provide plugin with live hook context\", async () => {\n   158→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   159→        if (name === \"data-name\") return \"TestComponent\"\n   160→        return null\n   161→      })\n   162→\n   163→      await vueHook.mounted!.call(mockHookContext)\n   164→\n   165→      const setupCall = (mockLiveViteApp.setup as any).mock.calls[0][0]\n   166→      expect(setupCall.plugin).toBeDefined()\n   167→\n   168→      // Test plugin install function\n   169→      const mockApp = {\n   170→        provide: vi.fn(),\n   171→        config: { globalProperties: {} },\n   172→      } as any\n   173→\n   174→      setupCall.plugin.install(mockApp)\n   175→      expect(mockApp.provide).toHaveBeenCalled()\n   176→      expect(mockApp.config.globalProperties.$live).toBe(mockHookContext)\n   177→    })\n   178→\n   179→    it(\"should store vue instance on hook context\", async () => {\n   180→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   181→        if (name === \"data-name\") return \"TestComponent\"\n   182→        return null\n   183→      })\n   184→\n   185→      await vueHook.mounted!.call(mockHookContext)\n   186→\n   187→      expect(mockHookContext.vue).toBeDefined()\n   188→      expect(mockHookContext.vue.app).toBeDefined()\n   189→      expect(mockHookContext.vue.props).toBeDefined()\n   190→      expect(mockHookContext.vue.slots).toBeDefined()\n   191→    })\n   192→  })\n   193→\n   194→  describe(\"updated lifecycle\", () => {\n   195→    beforeEach(async () => {\n   196→      // Set up a mounted component first\n   197→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   198→        if (name === \"data-name\") return \"TestComponent\"\n   199→        if (name === \"data-props\") return JSON.stringify({ message: \"initial\", count: 1 })\n   200→        return null\n   201→      })\n   202→\n   203→      await vueHook.mounted!.call(mockHookContext)\n   204→    })\n   205→\n   206→    it(\"should apply props diff when data-use-diff is true\", async () => {\n   207→      // Set up a more complex initial props structure\n   208→      const complexInitialProps = {\n   209→        user: {\n   210→          name: \"John Doe\",\n   211→          age: 30,\n   212→          preferences: {\n   213→            theme: \"light\",\n   214→            notifications: true\n   215→          }\n   216→        },\n   217→        items: [\"apple\", \"banana\", \"cherry\"],\n   218→        count: 5,\n   219→        message: \"Hello World\"\n   220→      }\n   221→\n   222→      // Re-mount with complex initial props\n   223→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   224→        if (name === \"data-name\") return \"TestComponent\"\n   225→        if (name === \"data-props\") return JSON.stringify(complexInitialProps)\n   226→        return null\n   227→      })\n   228→      await vueHook.mounted!.call(mockHookContext)\n   229→\n   230→      // Define a complex diff that modifies various parts of the props\n   231→      const mockPropsDiff = [\n   232→        [\"replace\", \"/user/name\", \"Jane Smith\"],\n   233→        [\"replace\", \"/user/age\", 25],\n   234→        [\"add\", \"/user/email\", \"jane@example.com\"],\n   235→        [\"replace\", \"/user/preferences/theme\", \"dark\"],\n   236→        [\"add\", \"/items/-\", \"orange\"], // Add to end of array\n   237→        [\"remove\", \"/items/0\"], // Remove first item\n   238→        [\"replace\", \"/message\", \"Updated message\"],\n   239→        [\"add\", \"/newTopLevelProp\", \"brand new property\"]\n   240→      ]\n   241→\n   242→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   243→        if (name === \"data-use-diff\") return \"true\"\n   244→        if (name === \"data-props-diff\") return JSON.stringify(mockPropsDiff)\n   245→        return null\n   246→      })\n   247→\n   248→      vueHook.updated!.call(mockHookContext)\n   249→\n   250→      // Verify the complex diff was applied correctly\n   251→      expect(mockHookContext.vue.props.user.name).toBe(\"Jane Smith\")\n   252→      expect(mockHookContext.vue.props.user.age).toBe(25)\n   253→      expect(mockHookContext.vue.props.user.email).toBe(\"jane@example.com\")\n   254→      expect(mockHookContext.vue.props.user.preferences.theme).toBe(\"dark\")\n   255→      expect(mockHookContext.vue.props.user.preferences.notifications).toBe(true) // unchanged\n   256→      expect(mockHookContext.vue.props.items).toEqual([\"banana\", \"cherry\", \"orange\"]) // removed first, added last\n   257→      expect(mockHookContext.vue.props.message).toBe(\"Updated message\")\n   258→      expect(mockHookContext.vue.props.newTopLevelProp).toBe(\"brand new property\")\n   259→      expect(mockHookContext.vue.props.count).toBe(5) // unchanged\n   260→    })\n   261→\n   262→    it(\"should replace all props when data-use-diff is not true\", () => {\n   263→      const newProps = { message: \"completely new\", different: \"prop\" }\n   264→\n   265→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   266→        if (name === \"data-use-diff\") return \"false\"\n   267→        if (name === \"data-props\") return JSON.stringify(newProps)\n   268→        if (name === \"data-handlers\") return null\n   269→        return null\n   270→      })\n   271→\n   272→      // Object.assign merges, doesn't replace, so we need to check the merged result\n   273→      vueHook.updated!.call(mockHookContext)\n   274→\n   275→      expect(mockHookContext.vue.props.message).toBe(\"completely new\")\n   276→      expect(mockHookContext.vue.props.different).toBe(\"prop\")\n   277→      // count will still be there because Object.assign merges\n   278→      expect(mockHookContext.vue.props.count).toBe(1)\n   279→    })\n   280→\n   281→    it(\"should update slots\", () => {\n   282→      const newSlots = {\n   283→        default: toUtf8Base64(\"<p>Updated slot content</p>\"),\n   284→        header: toUtf8Base64(\"<h1>Header</h1>\"),\n   285→      }\n   286→\n   287→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   288→        if (name === \"data-slots\") return JSON.stringify(newSlots)\n   289→        return null\n   290→      })\n   291→\n   292→      vueHook.updated!.call(mockHookContext)\n   293→\n   294→      expect(mockHookContext.vue.slots.default).toBeDefined()\n   295→      expect(mockHookContext.vue.slots.header).toBeDefined()\n   296→      expect(typeof mockHookContext.vue.slots.default).toBe(\"function\")\n   297→      expect(typeof mockHookContext.vue.slots.header).toBe(\"function\")\n   298→    })\n   299→\n   300→    it(\"should handle handlers in updated props\", () => {\n   301→      const newHandlers = { submit: '[[\"push\", {\"event\": \"form-submit\"}, \"phx-target\": null]]' }\n   302→\n   303→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   304→        if (name === \"data-use-diff\") return \"false\"\n   305→        if (name === \"data-props\") return JSON.stringify({ message: \"test\" })\n   306→        if (name === \"data-handlers\") return JSON.stringify(newHandlers)\n   307→        return null\n   308→      })\n   309→\n   310→      vueHook.updated!.call(mockHookContext)\n   311→\n   312→      expect(mock