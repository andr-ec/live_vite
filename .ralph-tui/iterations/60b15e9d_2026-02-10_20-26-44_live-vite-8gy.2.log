{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VQDWCDuUr2nk99wEAs2deh","type":"tool_result","content":"     1→import { describe, it, expect, vi, beforeEach } from \"vitest\"\n     2→import { ref, reactive, type App } from \"vue\"\n     3→import { getVueHook } from \"./hooks\"\n     4→import type { LiveViteApp, Hook } from \"./types\"\n     5→import { toUtf8Base64 } from \"./utils\"\n     6→\n     7→// Mock Vue component for testing\n     8→const MockComponent = {\n     9→  template: \"<div>{{ message }}</div>\",\n    10→  props: [\"message\", \"count\"],\n    11→  setup(props: any) {\n    12→    return { props }\n    13→  },\n    14→}\n    15→\n    16→// Mock LiveView hook context\n    17→const createMockLiveViewHook = (elementAttributes: Record<string, string> = {}) => {\n    18→  const mockElement = {\n    19→    getAttribute: vi.fn((name: string) => elementAttributes[name] || null),\n    20→    setAttribute: vi.fn(),\n    21→    removeAttribute: vi.fn(),\n    22→  } as any\n    23→\n    24→  const mockLiveSocket = {\n    25→    execJS: vi.fn(),\n    26→  }\n    27→\n    28→  return {\n    29→    el: mockElement,\n    30→    liveSocket: mockLiveSocket,\n    31→    vue: undefined as any,\n    32→  } as any // Type assertion to avoid strict type checking for test mocks\n    33→}\n    34→\n    35→// Mock LiveVite app configuration\n    36→const createMockLiveViteApp = (component = MockComponent): LiveViteApp => ({\n    37→  resolve: vi.fn().mockResolvedValue(component),\n    38→  setup: vi.fn(({ createApp, component, props, slots, plugin, el }) => {\n    39→    const app = createApp({\n    40→      render: () => null, // simplified for testing\n    41→    })\n    42→    app.use(plugin)\n    43→\n    44→    // Mock mount method to avoid DOM operations\n    45→    app.mount = vi.fn().mockReturnValue(app)\n    46→\n    47→    return app\n    48→  }),\n    49→})\n    50→\n    51→describe(\"getVueHook\", () => {\n    52→  let mockLiveViteApp: L