etHooksComponentsFn | getHooksAppFn = (\n  componentsOrApp: ComponentMap | LiveViteApp,\n  options?: getHooksComponentsOptions\n) => {\n  const app = migrateToLiveViteApp(componentsOrApp, options ?? {})\n  return { VueHook: getVueHook(app) }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2431,"cache_read_input_tokens":62809,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2431},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"f7614b6c-f448-43a7-8572-6bc7e0743cbe","uuid":"29fb345b-a378-43bf-8259-b912f19ca0cb"}
