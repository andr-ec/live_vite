all(mockHookContext)\n   101→\n   102→      expect(mockLiveViteApp.setup).toHaveBeenCalledWith(\n   103→        expect.objectContaining({\n   104→          component: MockComponent,\n   105→          ssr: false,\n   106→        })\n   107→      )\n   108→    })\n   109→\n   110→    it(\"should parse props from data-props attribute\", async () => {\n   111→      const mockProps = { message: \"Hello\", count: 42 }\n   112→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   113→        if (name === \"data-name\") return \"TestComponent\"\n   114→        if (name === \"data-props\") return JSON.stringify(mockProps)\n   115→        return null\n   116→      })\n   117→\n   118→      await vueHook.mounted!.call(mockHookContext)\n   119→\n   120→      expect(mockLiveViteApp.setup).toHaveBeenCalledWith(\n   121→        expect.objectContaining({\n   122→          props: expect.objectContaining(mockProps),\n   123→        })\n   124→      )\n   125→    })\n   126→\n   127→    it(\"should parse handlers from data-handlers attribute\", async () => {\n   128→      const mockHandlers = { click: '[[\"push\", {\"event\": \"test-event\"}, \"phx-target\": null]]' }\n   129→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   130→        if (name === \"data-name\") return \"TestComponent\"\n   131→        if (name === \"data-handlers\") return JSON.stringify(mockHandlers)\n   132→        return null\n   133→      })\n   134→\n   135→      await vueHook.mounted!.call(mockHookContext)\n   136→\n   137→      const setupCall = (mockLiveViteApp.setup as any).mock.calls[0][0]\n   138→      expect(setupCall.props).toHaveProperty(\"onClick\")\n   139→      expect(typeof setupCall.props.onClick).toBe(\"function\")\n   140→    })\n   141→\n   142→    it(\"should parse slots from data-slots attribute\", async () => {\n   143→      const mockSlots = { default: toUtf8Base64(\"<p>😸Slot content😸</p>\") }\n   144→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   145→        if (name === \"data-name\") return \"TestComponent\"\n   146→        if (name === \"data-slots\") return JSON.stringify(mockSlots)\n   147→        return null\n   148→      })\n   149→\n   150→      await vueHook.mounted!.call(mockHookContext)\n   151→\n   152→      const setupCall = (mockLiveViteApp.setup as any).mock.calls[0][0]\n   153→      expect(setupCall.slots).toHaveProperty(\"default\")\n   154→      expect(typeof setupCall.slots.default).toBe(\"function\")\n   155→    })\n   156→\n   157→    it(\"should provide plugin with live hook context\", async () => {\n   158→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   159→        if (name === \"data-name\") return \"TestComponent\"\n   160→        return null\n   161→      })\n   162→\n   163→      await vueHook.mounted!.call(mockHookContext)\n   164→\n   165→      const setupCall = (mockLiveViteApp.setup as any).mock.calls[0][0]\n   166→      expect(setupCall.plugin).toBeDefined()\n   167→\n   168→      // Test plugin install function\n   169→      const mockApp = {\n   170→        provide: vi.fn(),\n   171→        config: { globalProperties: {} },\n   172→      } as any\n   173→\n   174→      setupCall.plugin.install(mockApp)\n   175→      expect(mockApp.provide).toHaveBeenCalled()\n   176→      expect(mockApp.config.globalProperties.$live).toBe(mockHookContext)\n   177→    })\n   178→\n   179→    it(\"should store vue instance on hook context\", async () => {\n   180→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   181→        if (name === \"data-name\") return \"TestComponent\"\n   182→        return null\n   183→      })\n   184→\n   185→      await vueHook.mounted!.call(mockHookContext)\n   186→\n   187→      expect(mockHookContext.vue).toBeDefined()\n   188→      expect(mockHookContext.vue.app).toBeDefined()\n   189→      expect(mockHookContext.vue.props).toBeDefined()\n   190→      expect(mockHookContext.vue.slots).toBeDefined()\n   191→    })\n   192→  })\n   193→\n   194→  describe(\"updated lifecycle\", () => {\n   195→    beforeEach(async () => {\n   196→      // Set up a mounted component first\n   197→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   198→        if (name === \"data-name\") return \"TestComponent\"\n   199→        if (name === \"data-props\") return JSON.stringify({ message: \"initial\", count: 1 })\n   200→        return null\n   201→      })\n   202→\n   203→      await vueHook.mounted!.call(mockHookContext)\n   204→    })\n   205→\n   206→    it(\"should apply props diff when data-use-diff is true\", async () => {\n   207→      // Set up a more complex initial props structure\n   208→      const complexInitialProps = {\n   209→        user: {\n   210→          name: \"John Doe\",\n   211→          age: 30,\n   212→          preferences: {\n   213→            theme: \"light\",\n   214→            notifications: true\n   215→          }\n   216→        },\n   217→        items: [\"apple\", \"banana\", \"cherry\"],\n   218→        count: 5,\n   219→        message: \"Hello World\"\n   220→      }\n   221→\n   222→      // Re-mount with complex initial props\n   223→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   224→        if (name === \"data-name\") return \"TestComponent\"\n   225→        if (name === \"data-props\") return JSON.stringify(complexInitialProps)\n   226→        return null\n   227→      })\n   228→      await vueHook.mounted!.call(mockHookContext)\n   229→\n   230→      // Define a complex diff that modifies various parts of the props\n   231→      const mockPropsDiff = [\n   232→        [\"replace\", \"/user/name\", \"Jane Smith\"],\n   233→        [\"replace\", \"/user/age\", 25],\n   234→        [\"add\", \"/user/email\", \"jane@example.com\"],\n   235→        [\"replace\", \"/user/preferences/theme\", \"dark\"],\n   236→        [\"add\", \"/items/-\", \"orange\"], // Add to end of array\n   237→        [\"remove\", \"/items/0\"], // Remove first item\n   238→        [\"replace\", \"/message\", \"Updated message\"],\n   239→        [\"add\", \"/newTopLevelProp\", \"brand new property\"]\n   240→      ]\n   241→\n   242→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   243→        if (name === \"data-use-diff\") return \"true\"\n   244→        if (name === \"data-props-diff\") return JSON.stringify(mockPropsDiff)\n   245→        return null\n   246→      })\n   247→\n   248→      vueHook.updated!.call(mockHookContext)\n   249→\n   250→      // Verify the complex diff was applied correctly\n   251→      expect(mockHookContext.vue.props.user.name).toBe(\"Jane Smith\")\n   252→      expect(mockHookContext.vue.props.user.age).toBe(25)\n   253→      expect(mockHookContext.vue.props.user.email).toBe(\"jane@example.com\")\n   254→      expect(mockHookContext.vue.props.user.preferences.theme).toBe(\"dark\")\n   255→      expect(mockHookContext.vue.props.user.preferences.notifications).toBe(true) // unchanged\n   256→      expect(mockHookContext.vue.props.items).toEqual([\"banana\", \"cherry\", \"orange\"]) // removed first, added last\n   257→      expect(mockHookContext.vue.props.message).toBe(\"Updated message\")\n   258→      expect(mockHookContext.vue.props.newTopLevelProp).toBe(\"brand new property\")\n   259→      expect(mockHookContext.vue.props.count).toBe(5) // unchanged\n   260→    })\n   261→\n   262→    it(\"should replace all props when data-use-diff is not true\", () => {\n   263→      const newProps = { message: \"completely new\", different: \"prop\" }\n   264→\n   265→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   266→        if (name === \"data-use-diff\") return \"false\"\n   267→        if (name === \"data-props\") return JSON.stringify(newProps)\n   268→        if (name === \"data-handlers\") return null\n   269→        return null\n   270→      })\n   271→\n   272→      // Object.assign merges, doesn't replace, so we need to check the merged result\n   273→      vueHook.updated!.call(mockHookContext)\n   274→\n   275→      expect(mockHookContext.vue.props.message).toBe(\"completely new\")\n   276→      expect(mockHookContext.vue.props.different).toBe(\"prop\")\n   277→      // count will still be there because Object.assign merges\n   278→      expect(mockHookContext.vue.props.count).toBe(1)\n   279→    })\n   280→\n   281→    it(\"should update slots\", () => {\n   282→      const newSlots = {\n   283→        default: toUtf8Base64(\"<p>Updated slot content</p>\"),\n   284→        header: toUtf8Base64(\"<h1>Header</h1>\"),\n   285→      }\n   286→\n   287→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   288→        if (name === \"data-slots\") return JSON.stringify(newSlots)\n   289→        return null\n   290→      })\n   291→\n   292→      vueHook.updated!.call(mockHookContext)\n   293→\n   294→      expect(mockHookContext.vue.slots.default).toBeDefined()\n   295→      expect(mockHookContext.vue.slots.header).toBeDefined()\n   296→      expect(typeof mockHookContext.vue.slots.default).toBe(\"function\")\n   297→      expect(typeof mockHookContext.vue.slots.header).toBe(\"function\")\n   298→    })\n   299→\n   300→    it(\"should handle handlers in updated props\", () => {\n   301→      const newHandlers = { submit: '[[\"push\", {\"event\": \"form-submit\"}, \"phx-target\": null]]' }\n   302→\n   303→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   304→        if (name === \"data-use-diff\") return \"false\"\n   305→        if (name === \"data-props\") return JSON.stringify({ message: \"test\" })\n   306→        if (name === \"data-handlers\") return JSON.stringify(newHandlers)\n   307→        return null\n   308→      })\n   309→\n   310→      vueHook.updated!.call(mockHookContext)\n   311→\n   312→      expect(mockHookContext.vue.props.onSubmit).toBeDefined()\n   313→      expect(typeof mockHookContext.vue.props.onSubmit).toBe(\"function\")\n   314→    })\n   315→\n   316→    it(\"should execute handler when called\", () => {\n   317→      const mockHandlers = { click: '[[\"push\", {\"event\": \"test-click\"}]]' }\n   318→\n   319→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   320→        if (name === \"data-use-diff\") return \"false\"\n   321→        if (name === \"data-handlers\") return JSON.stringify(mockHandlers)\n   322→        if (name === \"data-props\") return \"{}\"\n   323→        return null\n   324→      })\n   325→\n   326→      vueHook.updated!.call(mockHookContext)\n   327→\n   328→      const clickHandler = mockHookContext.vue.props.onClick\n   329→      const mockEvent = { target: { value: \"test-value\" } }\n   330→\n   331→      clickHandler(mockEvent)\n   332→\n   333→      expect(mockHookContext.liveSocket.execJS).toHaveBeenCalledWith(\n   334→        mockHookContext.el,\n   335→        expect.stringContaining(\"test-click\")\n   336→      )\n   337→    })\n   338→  })\n   339→\n   340→  describe(\"destroyed lifecycle\", () => {\n   341→    beforeEach(async () => {\n   342→      // Set up a mounted component first\n   343→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   344→        if (name === \"data-name\") return \"TestComponent\"\n   345→        return null\n   346→      })\n   347→\n   348→      await vueHook.mounted!.call(mockHookContext)\n   349→    })\n   350→\n   351→    it(\"should set up unmount listener for Vue app\", () => {\n   352→      const mockApp = mockHookContext.vue.app\n   353→      const addEventListenerSpy = vi.spyOn(window, \"addEventListener\")\n   354→\n   355→      vueHook.destroyed!.call(mockHookContext)\n   356→\n   357→      expect(addEventListenerSpy).toHaveBeenCalledWith(\"phx:page-loading-stop\", expect.any(Function), { once: true })\n   358→    })\n   359→\n   360→    it(\"should call unmount when phx:page-loading-stop event fires\", () => {\n   361→      const mockApp = mockHookContext.vue.app\n   362→      mockApp.unmount = vi.fn()\n   363→\n   364→      let eventHandler: () => void\n   365→      const addEventListenerSpy = vi.spyOn(window, \"addEventListener\").mockImplementation((event, handler) => {\n   366→        if (event === \"phx:page-loading-stop\") {\n   367→          eventHandler = handler as () => void\n   368→        }\n   369→      })\n   370→\n   371→      vueHook.destroyed!.call(mockHookContext)\n   372→\n   373→      // Simulate the event firing\n   374→      eventHandler!()\n   375→\n   376→      expect(mockApp.unmount).toHaveBeenCalled()\n   377→    })\n   378→  })\n   379→\n   380→  describe(\"reactivity\", () => {\n   381→    it(\"should maintain reactive props during updates\", async () => {\n   382→      // Set up initial component\n   383→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   384→        if (name === \"data-name\") return \"TestComponent\"\n   385→        if (name === \"data-props\") return JSON.stringify({ message: \"initial\", count: 1 })\n   386→        return null\n   387→      })\n   388→\n   389→      await vueHook.mounted!.call(mockHookContext)\n   390→\n   391→      const propsReference = mockHookContext.vue.props\n   392→\n   393→      // Update props\n   394→      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n   395→        if (name === \"data-use-diff\") return \"false\"\n   396→        if (name === \"data-props\") return JSON.stringify({ message: \"updated\", count: 2 })\n   397→        return null\n   398→      })\n   399→\n   400→      vueHook.updated!.call(mockHookContext)\n   401→\n   402→      // Same reactive object should be maintained\n   403→      expect(mockHookContext.vue.props).toBe(propsReference)\n   404→      expect(mockHookContext.vue.props.message).toBe(\"updated\")\n   405→      expect(mockHookContext.vue.props.count).toBe(2)\n   406→    })\n   407→  })\n   408→})\n   409→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"f7614b6c-f448-43a7-8572-6bc7e0743cbe","uuid":"dd813127-6fed-445a-88e8-c89fdb69979b","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/hooks.test.ts","content":"import { describe, it, expect, vi, beforeEach } from \"vitest\"\nimport { ref, reactive, type App } from \"vue\"\nimport { getVueHook } from \"./hooks\"\nimport type { LiveViteApp, Hook } from \"./types\"\nimport { toUtf8Base64 } from \"./utils\"\n\n// Mock Vue component for testing\nconst MockComponent = {\n  template: \"<div>{{ message }}</div>\",\n  props: [\"message\", \"count\"],\n  setup(props: any) {\n    return { props }\n  },\n}\n\n// Mock LiveView hook context\nconst createMockLiveViewHook = (elementAttributes: Record<string, string> = {}) => {\n  const mockElement = {\n    getAttribute: vi.fn((name: string) => elementAttributes[name] || null),\n    setAttribute: vi.fn(),\n    removeAttribute: vi.fn(),\n  } as any\n\n  const mockLiveSocket = {\n    execJS: vi.fn(),\n  }\n\n  return {\n    el: mockElement,\n    liveSocket: mockLiveSocket,\n    vue: undefined as any,\n  } as any // Type assertion to avoid strict type checking for test mocks\n}\n\n// Mock LiveVite app configuration\nconst createMockLiveViteApp = (component = MockComponent): LiveViteApp => ({\n  resolve: vi.fn().mockResolvedValue(component),\n  setup: vi.fn(({ createApp, component, props, slots, plugin, el }) => {\n    const app = createApp({\n      render: () => null, // simplified for testing\n    })\n    app.use(plugin)\n\n    // Mock mount method to avoid DOM operations\n    app.mount = vi.fn().mockReturnValue(app)\n\n    return app\n  }),\n})\n\ndescribe(\"getVueHook\", () => {\n  let mockLiveViteApp: LiveViteApp\n  let mockHookContext: ReturnType<typeof createMockLiveViewHook>\n  let vueHook: Hook\n\n  beforeEach(() => {\n    vi.clearAllMocks()\n    mockLiveViteApp = createMockLiveViteApp()\n    mockHookContext = createMockLiveViewHook()\n    vueHook = getVueHook(mockLiveViteApp)\n  })\n\n  describe(\"mounted lifecycle\", () => {\n    it(\"should resolve component by name from data-name attribute\", async () => {\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-name\") return \"TestComponent\"\n        return null\n      })\n\n      await vueHook.mounted!.call(mockHookContext)\n\n      expect(mockLiveViteApp.resolve).toHaveBeenCalledWith(\"TestComponent\")\n    })\n\n    it(\"should create SSR app when data-ssr is true\", async () => {\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-name\") return \"TestComponent\"\n        if (name === \"data-ssr\") return \"true\"\n        return null\n      })\n\n      await vueHook.mounted!.call(mockHookContext)\n\n      // Verify setup was called with correct parameters\n      expect(mockLiveViteApp.setup).toHaveBeenCalledWith(\n        expect.objectContaining({\n          component: MockComponent,\n          ssr: false,\n        })\n      )\n    })\n\n    it(\"should create client app when data-ssr is not true\", async () => {\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-name\") return \"TestComponent\"\n        if (name === \"data-ssr\") return \"false\"\n        return null\n      })\n\n      await vueHook.mounted!.call(mockHookContext)\n\n      expect(mockLiveViteApp.setup).toHaveBeenCalledWith(\n        expect.objectContaining({\n          component: MockComponent,\n          ssr: false,\n        })\n      )\n    })\n\n    it(\"should parse props from data-props attribute\", async () => {\n      const mockProps = { message: \"Hello\", count: 42 }\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-name\") return \"TestComponent\"\n        if (name === \"data-props\") return JSON.stringify(mockProps)\n        return null\n      })\n\n      await vueHook.mounted!.call(mockHookContext)\n\n      expect(mockLiveViteApp.setup).toHaveBeenCalledWith(\n        expect.objectContaining({\n          props: expect.objectContaining(mockProps),\n        })\n      )\n    })\n\n    it(\"should parse handlers from data-handlers attribute\", async () => {\n      const mockHandlers = { click: '[[\"push\", {\"event\": \"test-event\"}, \"phx-target\": null]]' }\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-name\") return \"TestComponent\"\n        if (name === \"data-handlers\") return JSON.stringify(mockHandlers)\n        return null\n      })\n\n      await vueHook.mounted!.call(mockHookContext)\n\n      const setupCall = (mockLiveViteApp.setup as any).mock.calls[0][0]\n      expect(setupCall.props).toHaveProperty(\"onClick\")\n      expect(typeof setupCall.props.onClick).toBe(\"function\")\n    })\n\n    it(\"should parse slots from data-slots attribute\", async () => {\n      const mockSlots = { default: toUtf8Base64(\"<p>😸Slot content😸</p>\") }\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-name\") return \"TestComponent\"\n        if (name === \"data-slots\") return JSON.stringify(mockSlots)\n        return null\n      })\n\n      await vueHook.mounted!.call(mockHookContext)\n\n      const setupCall = (mockLiveViteApp.setup as any).mock.calls[0][0]\n      expect(setupCall.slots).toHaveProperty(\"default\")\n      expect(typeof setupCall.slots.default).toBe(\"function\")\n    })\n\n    it(\"should provide plugin with live hook context\", async () => {\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-name\") return \"TestComponent\"\n        return null\n      })\n\n      await vueHook.mounted!.call(mockHookContext)\n\n      const setupCall = (mockLiveViteApp.setup as any).mock.calls[0][0]\n      expect(setupCall.plugin).toBeDefined()\n\n      // Test plugin install function\n      const mockApp = {\n        provide: vi.fn(),\n        config: { globalProperties: {} },\n      } as any\n\n      setupCall.plugin.install(mockApp)\n      expect(mockApp.provide).toHaveBeenCalled()\n      expect(mockApp.config.globalProperties.$live).toBe(mockHookContext)\n    })\n\n    it(\"should store vue instance on hook context\", async () => {\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-name\") return \"TestComponent\"\n        return null\n      })\n\n      await vueHook.mounted!.call(mockHookContext)\n\n      expect(mockHookContext.vue).toBeDefined()\n      expect(mockHookContext.vue.app).toBeDefined()\n      expect(mockHookContext.vue.props).toBeDefined()\n      expect(mockHookContext.vue.slots).toBeDefined()\n    })\n  })\n\n  describe(\"updated lifecycle\", () => {\n    beforeEach(async () => {\n      // Set up a mounted component first\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-name\") return \"TestComponent\"\n        if (name === \"data-props\") return JSON.stringify({ message: \"initial\", count: 1 })\n        return null\n      })\n\n      await vueHook.mounted!.call(mockHookContext)\n    })\n\n    it(\"should apply props diff when data-use-diff is true\", async () => {\n      // Set up a more complex initial props structure\n      const complexInitialProps = {\n        user: {\n          name: \"John Doe\",\n          age: 30,\n          preferences: {\n            theme: \"light\",\n            notifications: true\n          }\n        },\n        items: [\"apple\", \"banana\", \"cherry\"],\n        count: 5,\n        message: \"Hello World\"\n      }\n\n      // Re-mount with complex initial props\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-name\") return \"TestComponent\"\n        if (name === \"data-props\") return JSON.stringify(complexInitialProps)\n        return null\n      })\n      await vueHook.mounted!.call(mockHookContext)\n\n      // Define a complex diff that modifies various parts of the props\n      const mockPropsDiff = [\n        [\"replace\", \"/user/name\", \"Jane Smith\"],\n        [\"replace\", \"/user/age\", 25],\n        [\"add\", \"/user/email\", \"jane@example.com\"],\n        [\"replace\", \"/user/preferences/theme\", \"dark\"],\n        [\"add\", \"/items/-\", \"orange\"], // Add to end of array\n        [\"remove\", \"/items/0\"], // Remove first item\n        [\"replace\", \"/message\", \"Updated message\"],\n        [\"add\", \"/newTopLevelProp\", \"brand new property\"]\n      ]\n\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-use-diff\") return \"true\"\n        if (name === \"data-props-diff\") return JSON.stringify(mockPropsDiff)\n        return null\n      })\n\n      vueHook.updated!.call(mockHookContext)\n\n      // Verify the complex diff was applied correctly\n      expect(mockHookContext.vue.props.user.name).toBe(\"Jane Smith\")\n      expect(mockHookContext.vue.props.user.age).toBe(25)\n      expect(mockHookContext.vue.props.user.email).toBe(\"jane@example.com\")\n      expect(mockHookContext.vue.props.user.preferences.theme).toBe(\"dark\")\n      expect(mockHookContext.vue.props.user.preferences.notifications).toBe(true) // unchanged\n      expect(mockHookContext.vue.props.items).toEqual([\"banana\", \"cherry\", \"orange\"]) // removed first, added last\n      expect(mockHookContext.vue.props.message).toBe(\"Updated message\")\n      expect(mockHookContext.vue.props.newTopLevelProp).toBe(\"brand new property\")\n      expect(mockHookContext.vue.props.count).toBe(5) // unchanged\n    })\n\n    it(\"should replace all props when data-use-diff is not true\", () => {\n      const newProps = { message: \"completely new\", different: \"prop\" }\n\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-use-diff\") return \"false\"\n        if (name === \"data-props\") return JSON.stringify(newProps)\n        if (name === \"data-handlers\") return null\n        return null\n      })\n\n      // Object.assign merges, doesn't replace, so we need to check the merged result\n      vueHook.updated!.call(mockHookContext)\n\n      expect(mockHookContext.vue.props.message).toBe(\"completely new\")\n      expect(mockHookContext.vue.props.different).toBe(\"prop\")\n      // count will still be there because Object.assign merges\n      expect(mockHookContext.vue.props.count).toBe(1)\n    })\n\n    it(\"should update slots\", () => {\n      const newSlots = {\n        default: toUtf8Base64(\"<p>Updated slot content</p>\"),\n        header: toUtf8Base64(\"<h1>Header</h1>\"),\n      }\n\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-slots\") return JSON.stringify(newSlots)\n        return null\n      })\n\n      vueHook.updated!.call(mockHookContext)\n\n      expect(mockHookContext.vue.slots.default).toBeDefined()\n      expect(mockHookContext.vue.slots.header).toBeDefined()\n      expect(typeof mockHookContext.vue.slots.default).toBe(\"function\")\n      expect(typeof mockHookContext.vue.slots.header).toBe(\"function\")\n    })\n\n    it(\"should handle handlers in updated props\", () => {\n      const newHandlers = { submit: '[[\"push\", {\"event\": \"form-submit\"}, \"phx-target\": null]]' }\n\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-use-diff\") return \"false\"\n        if (name === \"data-props\") return JSON.stringify({ message: \"test\" })\n        if (name === \"data-handlers\") return JSON.stringify(newHandlers)\n        return null\n      })\n\n      vueHook.updated!.call(mockHookContext)\n\n      expect(mockHookContext.vue.props.onSubmit).toBeDefined()\n      expect(typeof mockHookContext.vue.props.onSubmit).toBe(\"function\")\n    })\n\n    it(\"should execute handler when called\", () => {\n      const mockHandlers = { click: '[[\"push\", {\"event\": \"test-click\"}]]' }\n\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-use-diff\") return \"false\"\n        if (name === \"data-handlers\") return JSON.stringify(mockHandlers)\n        if (name === \"data-props\") return \"{}\"\n        return null\n      })\n\n      vueHook.updated!.call(mockHookContext)\n\n      const clickHandler = mockHookContext.vue.props.onClick\n      const mockEvent = { target: { value: \"test-value\" } }\n\n      clickHandler(mockEvent)\n\n      expect(mockHookContext.liveSocket.execJS).toHaveBeenCalledWith(\n        mockHookContext.el,\n        expect.stringContaining(\"test-click\")\n      )\n    })\n  })\n\n  describe(\"destroyed lifecycle\", () => {\n    beforeEach(async () => {\n      // Set up a mounted component first\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-name\") return \"TestComponent\"\n        return null\n      })\n\n      await vueHook.mounted!.call(mockHookContext)\n    })\n\n    it(\"should set up unmount listener for Vue app\", () => {\n      const mockApp = mockHookContext.vue.app\n      const addEventListenerSpy = vi.spyOn(window, \"addEventListener\")\n\n      vueHook.destroyed!.call(mockHookContext)\n\n      expect(addEventListenerSpy).toHaveBeenCalledWith(\"phx:page-loading-stop\", expect.any(Function), { once: true })\n    })\n\n    it(\"should call unmount when phx:page-loading-stop event fires\", () => {\n      const mockApp = mockHookContext.vue.app\n      mockApp.unmount = vi.fn()\n\n      let eventHandler: () => void\n      const addEventListenerSpy = vi.spyOn(window, \"addEventListener\").mockImplementation((event, handler) => {\n        if (event === \"phx:page-loading-stop\") {\n          eventHandler = handler as () => void\n        }\n      })\n\n      vueHook.destroyed!.call(mockHookContext)\n\n      // Simulate the event firing\n      eventHandler!()\n\n      expect(mockApp.unmount).toHaveBeenCalled()\n    })\n  })\n\n  describe(\"reactivity\", () => {\n    it(\"should maintain reactive props during updates\", async () => {\n      // Set up initial component\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-name\") return \"TestComponent\"\n        if (name === \"data-props\") return JSON.stringify({ message: \"initial\", count: 1 })\n        return null\n      })\n\n      await vueHook.mounted!.call(mockHookContext)\n\n      const propsReference = mockHookContext.vue.props\n\n      // Update props\n      mockHookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-use-diff\") return \"false\"\n        if (name === \"data-props\") return JSON.stringify({ message: \"updated\", count: 2 })\n        return null\n      })\n\n      vueHook.updated!.call(mockHookContext)\n\n      // Same reactive object should be maintained\n      expect(mockHookContext.vue.props).toBe(propsReference)\n      expect(mockHookContext.vue.props.message).toBe(\"updated\")\n      expect(mockHookContext.vue.props.count).toBe(2)\n    })\n  })\n})\n","numLines":409,"startLine":1,"totalLines":409}}}
