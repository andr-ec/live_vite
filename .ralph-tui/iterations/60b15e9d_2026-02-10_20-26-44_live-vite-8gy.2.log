{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CA5h3oK9rtogftdvcU1jhz","type":"tool_result","content":"     1→/*!\n     2→ * Simplified JSON Patch functionality extracted from https://github.com/Starcounter-Jack/JSON-Patch/blob/master/src/core.ts\n     3→ * (c) 2013-2021 Joachim Wester\n     4→ * MIT license\n     5→ */\n     6→\n     7→// Type definitions\n     8→export type Operation =\n     9→  | AddOperation\n    10→  | RemoveOperation\n    11→  | ReplaceOperation\n    12→  | MoveOperation\n    13→  | CopyOperation\n    14→  | TestOperation\n    15→  | UpsertOperation\n    16→  | LimitOperation\n    17→\n    18→export interface BaseOperation {\n    19→  path: string\n    20→}\n    21→\n    22→export interface AddOperation extends BaseOperation {\n    23→  op: \"add\"\n    24→  value: any\n    25→}\n    26→\n    27→export interface RemoveOperation extends BaseOperation {\n    28→  op: \"remove\"\n    29→}\n    30→\n    31→export interface ReplaceOperation extends BaseOperation {\n    32→  op: \"replace\"\n    33→  value: any\n    34→}\n    35→\n    36→export interface MoveOperation extends BaseOperation {\n    37→  op: \"move\"\n    38→  from: string\n    39→}\n    40→\n    41→export interface CopyOperation extends BaseOperation {\n    42→  op: \"copy\"\n    43→  from: string\n    44→}\n    45→\n    46→export interface TestOperation extends BaseOperation {\n    47→  op: \"test\"\n    48→  value: any\n    49→}\n    50→\n    51→export interface UpsertOperation extends BaseOperation {\n    52→  op: \"upsert\"\n    53→  value: any\n    54→}\n    55→\n    56→export interface LimitOperation extends BaseOperation {\n    57→  op: \"limit\"\n    58→  value: number\n    59→}\n    60→\n    61→// Helper functions\n    62→function deepClone<T>(obj: T): T {\n    63→  if (obj === null || typeof obj !== \"object\") return obj\n    64→  if (obj instanceof Date) return new Date(obj.getTime()) as any\n    65→  if (Array.isArray(obj)) return obj.map(item => deepClone(item)) as any\n    66→\n    67→  const cloned = {} as T\n    68→  for (const key in obj) {\n    69→    if (obj.hasOwnProperty(key)) {\n    70→      cloned[key] = deepClone(obj[key])\n    71→    }\n    72→  }\n    73→  return cloned\n    74→}\n    75→\n    76→function unescapePathComponent(path: string): string {\n    77→  return path.replace(/~1/g, \"/\").replace(/~0/g, \"~\")\n    78→}\n    79→\n    80→function areEquals(a: any, b: any): boolean {\n    81→  if (a === b) return true\n    82→  if (a && b && typeof a == \"object\" && typeof b == \"object\") {\n    83→    const arrA = Array.isArray(a)\n    84→    const arrB = Array.isArray(b)\n    85→\n    86→    if (arrA && arrB) {\n    87→      const length = a.length\n    88→      if (length != b.length) return false\n    89→      for (let i = length; i-- !== 0; ) {\n    90→        if (!areEquals(a[i], b[i])) return false\n    91→      }\n    92→      return true\n    93→    }\n    94→    if (arrA != arrB) return false\n    95→\n    96→    const keys = Object.keys(a)\n    97→    const length = keys.length\n    98→    if (length !== Object.keys(b).length) return false\n    99→\n   100→    for (let i = length; i-- !== 0; ) {\n   101→      if (!b.hasOwnProperty(keys[i])) return false\n   102→    }\n   103→\n   104→    for (let i = length; i-- !== 0; ) {\n   105→      const key = keys[i]\n   106→      if (!areEquals(a[key], b[key])) return false\n   107→    }\n   108→    return true\n   109→  }\n   110→  return a !== a && b !== b\n   111→}\n   112→\n   113→/**\n   114→ * Resolves a path component that may use special syntax for finding items by ID.\n   115→ * If the component starts with $$, it tries to find an array element with matching id.\n   116→ * Returns the resolved index or the original component if not using special syntax.\n   117→ */\n   118→function resolvePathComponent(component: string, arrayObj: any[]): string | null {\n   119→  if (!component.startsWith(\"$$\")) {\n   120→    return component\n   121→  }\n   122→\n   123→  // Extract the ID from $$<id> syntax\n   124→  const targetId = component.substring(2)\n   125→\n   126→  // Find the index of the element with matching __dom_id\n   127→  const index = arrayObj.findIndex(item => item && typeof item === \"object\" && item.__dom_id == targetId)\n   128→\n   129→  if (index === -1) {\n   130→    console.warn(`JSON Patch: Item with __dom_id \"${targetId}\" not found in array, skipping operation`)\n   131→    return null\n   132→  }\n   133→\n   134→  return index.toString()\n   135→}\n   136→\n   137→/**\n   138→ * Retrieves a value from a JSON document by a JSON pointer.\n   139→ */\n   140→export function getValueByPointer(document: any, pointer: string): any {\n   141→  if (pointer === \"\") return document\n   142→\n   143→  const keys = pointer.split(\"/\").slice(1) // remove empty first element\n   144→  let obj = document\n   145→\n   146→  for (const key of keys) {\n   147→    let resolvedKey = key.indexOf(\"~\") !== -1 ? unescapePathComponent(key) : key\n   148→\n   149→    if (Array.isArray(obj)) {\n   150→      // Handle special $$id syntax for arrays\n   151→      if (resolvedKey.startsWith(\"$$\")) {\n   152→        const resolved = resolvePathComponent(resolvedKey, obj)\n   153→        if (resolved === null) {\n   154→          return undefined // Item not found\n   155→        }\n   156→        resolvedKey = resolved\n   157→      }\n   158→      obj = obj[resolvedKey === \"-\" ? obj.length - 1 : parseInt(resolvedKey, 10)]\n   159→    } else {\n   160→      obj = obj[resolvedKey]\n   161→    }\n   162→  }\n   163→\n   164→  return obj\n   165→}\n   166→\n   167→/**\n   168→ * Apply a single JSON Patch Operation on a JSON document in-place.\n   169→ * Modifies the original document to maintain Vue reactivity.\n   170→ */\n   171→export function applyOperation<T>(document: T, operation: Operation): T {\n   172→  // Handle root operations\n   173→  if (operation.path === \"\") {\n   174→    switch (operation.op) {\n   175→      case \"add\":\n   176→      case \"replace\":\n   177→        return (operation as AddOperation | ReplaceOperation).value\n   178→      case \"move\":\n   179→      case \"copy\":\n   180→        return getValueByPointer(document, (operation as MoveOperation | CopyOperation).from)\n   181→      case \"test\":\n   182→        return document // Test always returns original document\n   183→      case \"remove\":\n   184→        return null as any\n   185→    }\n   186→  }\n   187→\n   188→  const keys = operation.path.split(\"/\").slice(1) // remove empty first element\n   189→  let obj = document as any\n   190→\n   191→  // Navigate to parent object\n   192→  for (let i = 0; i < keys.length - 1; i++) {\n   193→    let key = keys[i].indexOf(\"~\") !== -1 ? unescapePathComponent(keys[i]) : keys[i]\n   194→\n   195→    if (Array.isArray(obj)) {\n   196→      // Handle special $$id syntax for arrays\n   197→      if (key.startsWith(\"$$\")) {\n   198→        const resolved = resolvePathComponent(key, obj)\n   199→        if (resolved === null) {\n   200→          return document // Skip operation if id not found\n   201→        }\n   202→        key = resolved\n   203→      }\n   204→      obj = obj[key === \"-\" ? obj.length - 1 : parseInt(key, 10)]\n   205→    } else {\n   206→      obj = obj[key]\n   207→    }\n   208→  }\n   209→\n   210→  // Apply operation on final key\n   211→  const finalKey = keys[keys.length - 1]\n   212→  let unescapedKey = finalKey.indexOf(\"~\") !== -1 ? unescapePathComponent(finalKey) : finalKey\n   213→\n   214→  if (Array.isArray(obj)) {\n   215→    let index: number\n   216→\n   217→    // Handle special $$id syntax for arrays\n   218→    if (unescapedKey.startsWith(\"$$\")) {\n   219→      const resolved = resolvePathComponent(unescapedKey, obj)\n   220→      if (resolved === null) {\n   221→        return document // Skip operation if id not found\n   222→      }\n   223→      index = parseInt(resolved, 10)\n   224→    } else {\n   225→      index = unescapedKey === \"-\" ? obj.length : parseInt(unescapedKey, 10)\n   226→    }\n   227→\n   228→    switch (operation.op) {\n   229→      case \"add\":\n   230→        obj.splice(index, 0, (operation as AddOperation).value)\n   231→        break\n   232→      case \"remove\":\n   233→        obj.splice(index, 1)\n   234→        break\n   235→      case \"replace\":\n   236→        obj[index] = (operation as ReplaceOperation).value\n   237→        break\n   238→      case \"upsert\":\n   239→        const upsertValue = (operation as UpsertOperation).value\n   240→        // Check if item with same ID already exists in the array\n   241→        if (upsertValue && typeof upsertValue === \"object\" && \"__dom_id\" in upsertValue) {\n   242→          const existingIndex = obj.findIndex(\n   243→            item => item && typeof item === \"object\" && item.__dom_id === upsertValue.__dom_id\n   244→          )\n   245→\n   246→          if (existingIndex !== -1) {\n   247→            // Update existing item\n   248→            obj[existingIndex] = upsertValue\n   249→          } else {\n   250→            // Insert new item at specified index\n   251→            obj.splice(index, 0, upsertValue)\n   252→          }\n   253→        } else {\n   254→          // No ID to match against, just insert at specified index\n   255→          obj.splice(index, 0, upsertValue)\n   256→        }\n   257→        break\n   258→      case \"move\":\n   259→        const moveValue = getValueByPointer(document, (operation as MoveOperation).from)\n   260→        if (moveValue === undefined) {\n   261→          return document // Skip operation if source not found\n   262→        }\n   263→        applyOperation(document, { op: \"remove\", path: (operation as MoveOperation).from })\n   264→        obj.splice(index, 0, moveValue)\n   265→        break\n   266→      case \"copy\":\n   267→        const copyValue = getValueByPointer(document, (operation as CopyOperation).from)\n   268→        obj.splice(index, 0, deepClone(copyValue))\n   269→        break\n   270→      case \"test\":\n   271→        // Test operation - just return document unchanged\n   272→        break\n   273→      case \"limit\":\n   274→        const limitValue = (operation as LimitOperation).value\n   275→        if (limitValue >= 0) {\n   276→          // Positive limit: keep first N elements, remove the rest\n   277→          if (limitValue < obj.length) {\n   278→            obj.splice(limitValue)\n   279→          }\n   280→        } else {\n   281→          // Negative limit: keep last N elements, remove from the beginning\n   282→          const keepCount = Math.abs(limitValue)\n   283→          if (keepCount < obj.length) {\n   284→            obj.splice(0, obj.length - keepCount)\n   285→          }\n   286→        }\n   287→        break\n   288→    }\n   289→  } else {\n   290→    switch (operation.op) {\n   291→      case \"add\":\n   292→      case \"replace\":\n   293→        obj[unescapedKey] = (operation as AddOperation | ReplaceOperation).value\n   294→        break\n   295→      case \"remove\":\n   296→        delete obj[unescapedKey]\n   297→        break\n   298→      case \"move\":\n   299→        const moveValue = getValueByPointer(document, (operation as MoveOperation).from)\n   300→        applyOperation(document, { op: \"remove\", path: (operation as MoveOperation).from })\n   301→        obj[unescapedKey] = moveValue\n   302→        break\n   303→      case \"copy\":\n   304→        const copyValue = getValueByPointer(document, (operation as CopyOperation).from)\n   305→        obj[unescapedKey] = deepClone(copyValue)\n   306→        break\n   307→      case \"test\":\n   308→        // Test operation - just return document unchanged\n   309→        break\n   310→      case \"limit\":\n   311→        // Check if target is an array\n   312→        const targetArray = obj[unescapedKey]\n   313→        if (Array.isArray(targetArray)) {\n   314→          const limitValue = (operation as LimitOperation).value\n   315→          if (limitValue >= 0) {\n   316→            // Positive limit: keep first N elements, remove the rest\n   317→            if (limitValue < targetArray.length) {\n   318→              targetArray.splice(limitValue)\n   319→            }\n   320→          } else {\n   321→            // Negative limit: keep last N elements, remove from the beginning\n   322→            const keepCount = Math.abs(limitValue)\n   323→            if (keepCount < targetArray.length) {\n   324→              targetArray.splice(0, targetArray.length - keepCount)\n   325→            }\n   326→          }\n   327→        }\n   328→        break\n   329→    }\n   330→  }\n   331→\n   332→  return document\n   333→}\n   334→\n   335→/**\n   336→ * Apply a JSON-Patch sequence to a JSON document in-place.\n   337→ * Modifies the original document to maintain Vue reactivity.\n   338→ */\n   339→export function applyPatch<T>(document: T, patch: ReadonlyArray<Operation>): T {\n   340→  let result = document\n   341→\n   342→  for (const operation of patch) {\n   343→    result = applyOperation(result, operation)\n   344→  }\n   345→\n   346→  return result\n   347→}\n   348→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_0186sJbD2wUdJtBvguBQXVMf","session_id":"f7614b6c-f448-43a7-8572-6bc7e0743cbe","uuid":"61b260ae-f50a-4eb7-9674-2c8d274b2d41"}
