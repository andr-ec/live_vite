t_env(:live_vite, :ssr_module, nil) do\n      nil ->\n        %{preloadLinks: \"\", html: \"\"}\n\n      mod ->\n        meta = %{component: name, props: props, slots: slots, framework: framework}\n\n        body =\n          :telemetry.span([:live_vite, :ssr], meta, fn ->\n            {mod.render(name, props, slots, framework), meta}\n          end)\n\n        with body when is_binary(body) <- body do\n          case String.split(body, \"<!-- preload -->\", parts: 2) do\n            [links, html] -> %{preloadLinks: links, html: html}\n            [body] -> %{preloadLinks: \"\", html: body}\n          end\n        end\n    end\n  end\nend\n","numLines":60,"startLine":1,"totalLines":60}}}
