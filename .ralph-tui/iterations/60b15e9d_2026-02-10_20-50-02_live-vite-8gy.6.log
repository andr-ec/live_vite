ig option `config :live_vite, frameworks: [:vue, :react]` controls which frameworks are active\n\n<promise>COMPLETE</promise>","stop_reason":null,"session_id":"e2f12999-14cd-46c4-a527-8cc4c5a69867","total_cost_usd":1.7047320000000006,"usage":{"input_tokens":3059,"cache_creation_input_tokens":65208,"cache_read_input_tokens":1979228,"output_tokens":11010,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":65208,"ephemeral_5m_input_tokens":0}},"modelUsage":{"claude-opus-4-6":{"inputTokens":3059,"outputTokens":11010,"cacheReadInputTokens":1979228,"cacheCreationInputTokens":65208,"webSearchRequests":0,"costUSD":1.6877090000000006,"contextWindow":200000,"maxOutputTokens":32000},"claude-haiku-4-5-20251001":{"inputTokens":15523,"outputTokens":300,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"webSearchRequests":0,"costUSD":0.017023,"contextWindow":200000,"maxOutputTokens":64000}},"permission_denials":[],"uuid":"d9255917-9040-49b0-854a-fb457d1dcc50"}
