{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012ZayGGZpRDd7TgHruF2JU2","type":"tool_result","content":"     1→import { migrateToLiveViteApp } from \"./app.js\"\n     2→import type { ComponentMap, LiveViteApp, LiveViteOptions, Hook } from \"./types.js\"\n     3→import { mapValues, fromUtf8Base64 } from \"./utils.js\"\n     4→import type { Operation } from \"./jsonPatch.js\"\n     5→import type { FrameworkRenderer } from \"./renderer.js\"\n     6→import { createVueRenderer, type VueSetupFn } from \"./renderers/vue.js\"\n     7→\n     8→/**\n     9→ * Parses the JSON object from the element's attribute and returns them as an object.\n    10→ */\n    11→const getAttributeJson = (el: HTMLElement, attributeName: string): Record<string, any> | null => {\n    12→  const data = el.getAttribute(attributeName)\n    13→  return data ? JSON.parse(data) : null\n    14→}\n    15→\n    16→/**\n    17→ * Parses raw slot data from the element's attributes.\n    18→ * Returns slot name -> decoded HTML string pairs (framework-agnostic).\n    19→ */\n    20→const getRawSlots = (el: HTMLElement): Record<string, string> => {\n    21→  const dataSlots = getAttributeJson(el, \"data-slots\") || {}\n    22→  return mapValues(dataSlots, base64 => fromUtf8Base64(base64))\n    23→}\n    24→\n    25→const getDiff = (el: HTMLElement, attributeName: string): Operation[] => {\n    26→  const dataPropsDiff = getAttributeJson(el, attributeName) || []\n    27→  return dataPropsDiff.map(([op, path, value]: [string, string, any]) => ({\n    28→    op,\n    29→    path,\n    30→    value,\n    31→  }))\n    32→}\n    33→\n    34→/**\n    35→ * Parses the event handlers from the element's attributes and returns them as a record.\n    36→ * The handlers are parsed from the \"data-handlers\" attribute.\n    37→ * The handlers are converted to snake case and returned as a record.\n    38→ * A special case is made for the \"JS.push\" event, where the event is replaced with $event.\n