ow new Error(\"Vue setup function did not return an app!\")\n    94→\n    95→      return { props, slots, app }\n    96→    },\n    97→\n    98→    updateProps(state: RendererState<VueApp>, newProps: Record<string, any>): void {\n    99→      Object.assign(state.props, newProps)\n   100→    },\n   101→\n   102→    patchProps(state: RendererState<VueApp>, operations: Operation[]): void {\n   103→      applyPatch(state.props, operations)\n   104→    },\n   105→\n   106→    updateSlots(state: RendererState<VueApp>, newSlots: Record<string, string>): void {\n   107→      Object.assign(state.slots, htmlSlotsToVue(newSlots))\n   108→    },\n   109→\n   110→    unmount(state: RendererState<VueApp>): void {\n   111→      if (state.app) {\n   112→        window.addEventListener(\"phx:page-loading-stop\", () => state.app!.unmount(), { once: true })\n   113→      }\n   114→    },\n   115→\n   116→    async renderToString(ctx: RendererSSRContext): Promise<string> {\n   117→      // Dynamic import to avoid bundling server-only deps in client builds\n   118→      const { renderToString: vueRenderToString } = await import(\"vue/server-renderer\")\n   119→\n   120→      const component = ctx.component\n   121→      const slotComponents = htmlSlotsToVue(ctx.slots)\n   122→\n   123→      const ssrSetup = options.setup ?? ((makeApp, component, props, slots, plugin, el) => {\n   124→        const app = makeApp({ render: () => h(component, props, slots) })\n   125→        app.use(plugin)\n   126→        // Don't mount in SSR - no real DOM\n   127→        return app\n   128→      })\n   129→\n   130→      const plugin: Plugin<[]> = {\n   131→        install: (app: App) => {\n   132→          app.mount = (...args: unknown[]): any => undefined\n   133→          app.provide(\"_live_vite\", Object.assign({}, mockHook))\n   134→        },\n   135→      }\n   136→\n   137→      const app = ssrSetup(createSSRApp, component, ctx.props, slotComponents, plugin, {} as Element, true)\n   138→\n   139→      if (!app) throw new Error(\"Vue SSR setup function did not return an app!\")\n   140→\n   141→      const vueCtx: import(\"vue/server-renderer\").SSRContext = {}\n   142→      const html = await vueRenderToString(app, vueCtx)\n   143→\n   144→      // the SSR manifest generated by Vite contains module -> chunk/asset mapping\n   145→      // which we can then use to determine what files need to be preloaded for this request.\n   146→      const preloadLinks = renderPreloadLinks(vueCtx.modules ?? [], manifest)\n   147→      return preloadLinks + \"<!-- preload -->\" + html\n   148→    },\n   149→  }\n   150→}\n   151→\n   152→type SSRManifest = Record<string, string[]>\n   153→\n   154→function renderPreloadLinks(modules: string[], manifest: SSRManifest) {\n   155→  let links = \"\"\n   156→  const seen = new Set()\n   157→  modules.forEach((id: string) => {\n   158→    const files = manifest[id]\n   159→    if (files) {\n   160→      files.forEach(file => {\n   161→        if (!seen.has(file)) {\n   162→          seen.add(file)\n   163→          const filename = file.split(\"/\").pop() ?? file\n   164→          if (manifest[filename]) {\n   165→            for (const depFile of manifest[filename]) {\n   166→              links += renderPreloadLink(depFile)\n   167→              seen.add(depFile)\n   168→            }\n   169→          }\n   170→          links += renderPreloadLink(file)\n   171→        }\n   172→      })\n   173→    }\n   174→  })\n   175→  return links\n   176→}\n   177→\n   178→function renderPreloadLink(file: string) {\n   179→  if (file.endsWith(\".js\")) {\n   180→    return `<link rel=\"modulepreload\" crossorigin href=\"${file}\">`\n   181→  } else if (file.endsWith(\".css\")) {\n   182→    return `<link rel=\"stylesheet\" href=\"${file}\">`\n   183→  } else if (file.endsWith(\".woff\")) {\n   184→    return ` <link rel=\"preload\" href=\"${file}\" as=\"font\" type=\"font/woff\" crossorigin>`\n   185→  } else if (file.endsWith(\".woff2