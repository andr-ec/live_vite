enderer\n    80→  resolve: (name: string) => Promise<unknown> | unknown\n    81→}\n    82→\n    83→/**\n    84→ * Creates a framework-agnostic LiveView hook using the given renderer.\n    85→ *\n    86→ * This is a convenience for single-renderer setups. For multi-framework support,\n    87→ * use `getMultiRendererHook` instead.\n    88→ */\n    89→export const getRendererHook = (\n    90→  renderer: FrameworkRenderer,\n    91→  resolve: (name: string) => Promise<unknown> | unknown,\n    92→): Hook => getMultiRendererHook({ [renderer.name]: { renderer, resolve } })\n    93→\n    94→/**\n    95→ * Creates a LiveView hook that dispatches to the correct renderer\n    96→ * based on the `data-framework` attribute on the component element.\n    97→ *\n    98→ * This is the primary way to support multiple frameworks in the same project.\n    99→ * The hook handles DOM attribute parsing, prop diffing, and stream patches\n   100→ * (all framework-agnostic), while delegating framework-specific operations\n   101→ * to the resolved renderer.\n   102→ *\n   103→ * If only one renderer is registered, the `data-framework` attribute is optional\n   104→ * and the single renderer is used as a fallback.\n   105→ */\n   106→export const getMultiRendererHook = (\n   107→  renderers: Record<string, RendererEntry>,\n   108→): Hook => {\n   109→  const rendererNames = Object.keys(renderers)\n   110→\n   111→  const resolveRenderer = (el: HTMLElement): RendererEntry => {\n   112→    const framework = el.getAttribute(\"data-framework\")\n   113→\n   114→    if (framework && renderers[framework]) {\n   115→      return renderers[framework]\n   116→    }\n   117→\n   118→    // Fallback: if only one renderer is registered, use it regardless of attribute\n   119→    if (!framework && rendererNames.length === 1) {\n   120→      return renderers[rendererNames[0]]\n   121→    }\n   122→\n   123→    const available = rendererNames.join(\", \")\n   124→    throw new Error(\n   125→      framework