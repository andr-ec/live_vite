ents the `FrameworkRenderer` interface for React 18+.\n    50→ * Uses `createRoot`/`hydrateRoot` for mounting and re-renders the full\n    51→ * component tree on every prop/slot update via `root.render()`.\n    52→ *\n    53→ * Props are stored as a plain mutable object. Since React has no built-in\n    54→ * reactivity system, updates trigger an explicit re-render call.\n    55→ *\n    56→ * Slots are passed as React elements via `dangerouslySetInnerHTML`.\n    57→ */\n    58→export function createReactRenderer(options: ReactRendererOptions = {}): FrameworkRenderer<ReactRendererState> {\n    59→  return {\n    60→    name: \"react\",\n    61→\n    62→    mount(ctx: MountContext): RendererState<ReactRendererState> {\n    63→      const props = { ...ctx.props }\n    64→      const slots = htmlSlotsToReact(ctx.slots)\n    65→\n    66→      const element = createElement(ctx.component as any, {\n    67→        ...props,\n    68→        ...mapValues(slots, slotFn => slotFn()),\n    69→        live: ctx.hook,\n    70→      })\n    71→\n    72→      let root: Root\n    73→      if (ctx.ssr) {\n    74→        root = hydrateRoot(ctx.el, element)\n    75→      } else {\n    76→        root = createRoot(ctx.el)\n    77→        root.render(element)\n    78→      }\n    79→\n    80→      const state: RendererState<ReactRendererState> = {\n    81→        props,\n    82→        slots,\n    83→        app: { root, component: ctx.component, hook: ctx.hook },\n    84→      }\n    85→\n    86→      return state\n    87→    },\n    88→\n    89→    updateProps(state: RendererState<ReactRendererState>, newProps: Record<string, any>): void {\n    90→      Object.assign(state.props, newProps)\n    91→      renderComponent(state)\n    92→    },\n    93→\n    94→    patchProps(state: RendererState<ReactRendererState>, operations: Operation[]): void {\n    95→      applyPatch(state.props, operations)\n    96→      renderComponent(state)\n    97→    },\n    98→\n    99→    updateSlots(state: RendererState<ReactRendererState>, newSlots: Record<string, string>): void {\n   100→      Object.assign(state.slots, htmlSlotsToReact(newSlots))\n   101→      renderComponent(state)\n   102→    },\n   103→\n   104→    unmount(state: RendererState<ReactRendererState>): void {\n   105→      if (state.app) {\n   106→        window.addEventListener(\"phx:page-loading-stop\", () => state.app!.root.unmount(), { once: true })\n   107→      }\n   108→    },\n   109→\n   110→    async renderToString(ctx): Promise<string> {\n   111→      const { renderToString: reactRenderToString } = await import(\"react-dom/server\")\n   112→\n   113→      const slotElements = mapValues(htmlSlotsToReact(ctx.slots), slotFn => slotFn())\n   114→      const element = createElement(ctx.component as any, {\n   115→        ...ctx.props,\n   116→        ...slotElements,\n   117→      })\n   118→\n   119→      const html = reactRenderToString(element)\n   120→      return \"<!-- preload -->\" + html\n   121→    },\n   122→  }\n   123→}\n   124→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"b73fd4a2-8012-4e1e-a0ab-8b034a020bf8","uuid":"8f5962a3-3a24-4697-ba0a-10270531ffa6","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/renderers/react.ts","content":"import { createElement } from \"react\"\nimport { createRoot, hydrateRoot, type Root } from \"react-dom/client\"\nimport type { FrameworkRenderer, MountContext, RendererState } from \"../renderer.js\"\nimport { applyPatch, type Operation } from \"../jsonPatch.js\"\nimport { mapValues } from \"../utils.js\"\n\n/**\n * State specific to the React renderer.\n * We store the component and hook alongside the root so we can\n * re-render the full tree on every prop/slot update.\n */\ninterface ReactRendererState {\n  root: Root\n  component: unknown\n  hook: any\n}\n\n/**\n * Convert slot name -> HTML string into React elements.\n * Each slot renders as a span with dangerouslySetInnerHTML.\n */\nfunction htmlSlotsToReact(slots: Record<string, string>): Record<string, () => any> {\n  return mapValues(slots, html => () =>\n    createElement(\"span\", { dangerouslySetInnerHTML: { __html: html.trim() } })\n  )\n}\n\n/**\n * Re-render the React component tree with current props and slots.\n */\nfunction renderComponent(state: RendererState<ReactRendererState>): void {\n  const { root, component, hook } = state.app!\n  const element = createElement(component as any, {\n    ...state.props,\n    ...mapValues(state.slots, slotFn => slotFn()),\n    live: hook,\n  })\n  root.render(element)\n}\n\nexport interface ReactRendererOptions {\n  /** Vite SSR manifest for preload link generation (production builds only). */\n  manifest?: Record<string, string[]>\n}\n\n/**\n * Creates a React framework renderer.\n *\n * Implements the `FrameworkRenderer` interface for React 18+.\n * Uses `createRoot`/`hydrateRoot` for mounting and re-renders the full\n * component tree on every prop/slot update via `root.render()`.\n *\n * Props are stored as a plain mutable object. Since React has no built-in\n * reactivity system, updates trigger an explicit re-render call.\n *\n * Slots are passed as React elements via `dangerouslySetInnerHTML`.\n */\nexport function createReactRenderer(options: ReactRendererOptions = {}): FrameworkRenderer<ReactRendererState> {\n  return {\n    name: \"react\",\n\n    mount(ctx: MountContext): RendererState<ReactRendererState> {\n      const props = { ...ctx.props }\n      const slots = htmlSlotsToReact(ctx.slots)\n\n      const element = createElement(ctx.component as any, {\n        ...props,\n        ...mapValues(slots, slotFn => slotFn()),\n        live: ctx.hook,\n      })\n\n      let root: Root\n      if (ctx.ssr) {\n        root = hydrateRoot(ctx.el, element)\n      } else {\n        root = createRoot(ctx.el)\n        root.render(element)\n      }\n\n      const state: RendererState<ReactRendererState> = {\n        props,\n        slots,\n        app: { root, component: ctx.component, hook: ctx.hook },\n      }\n\n      return state\n    },\n\n    updateProps(state: RendererState<ReactRendererState>, newProps: Record<string, any>): void {\n      Object.assign(state.props, newProps)\n      renderComponent(state)\n    },\n\n    patchProps(state: RendererState<ReactRendererState>, operations: Operation[]): void {\n      applyPatch(state.props, operations)\n      renderComponent(state)\n    },\n\n    updateSlots(state: RendererState<ReactRendererState>, newSlots: Record<string, string>): void {\n      Object.assign(state.slots, htmlSlotsToReact(newSlots))\n      renderComponent(state)\n    },\n\n    unmount(state: RendererState<ReactRendererState>): void {\n      if (state.app) {\n        window.addEventListener(\"phx:page-loading-stop\", () => state.app!.root.unmount(), { once: true })\n      }\n    },\n\n    async renderToString(ctx): Promise<string> {\n      const { renderToString: reactRenderToString } = await import(\"react-dom/server\")\n\n      const slotElements = mapValues(htmlSlotsToReact(ctx.slots), slotFn => slotFn())\n      const element = createElement(ctx.component as any, {\n        ...ctx.props,\n        ...slotElements,\n      })\n\n      const html = reactRenderToString(element)\n      return \"<!-- preload -->\" + html\n    },\n  }\n}\n","numLines":124,"startLine":1,"totalLines":124}}}
