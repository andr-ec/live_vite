{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B5PVc7btLpQ9cUyDKuFCiC","type":"tool_result","content":"     1→import { describe, it, expect, vi, beforeEach } from \"vitest\"\n     2→import { reactive, type App } from \"vue\"\n     3→import { getRendererHook, getMultiRendererHook } from \"./hooks\"\n     4→import type { FrameworkRenderer, RendererState, MountContext } from \"./renderer\"\n     5→import type { Hook } from \"./types\"\n     6→import { toUtf8Base64 } from \"./utils\"\n     7→\n     8→/**\n     9→ * Creates a mock FrameworkRenderer for testing the hook integration.\n    10→ * All methods are vi.fn() so we can assert on calls.\n    11→ */\n    12→const createMockRenderer = (name = \"mock\"): FrameworkRenderer => {\n    13→  const mockState: RendererState = {\n    14→    props: { message: \"hello\" },\n    15→    slots: { default: () => \"slot\" },\n    16→    app: { unmount: vi.fn() },\n    17→  }\n    18→\n    19→  return {\n    20→    name,\n    21→    mount: vi.fn().mockResolvedValue(mockState),\n    22→    updateProps: vi.fn(),\n    23→    patchProps: vi.fn(),\n    24→    updateSlots: vi.fn(),\n    25→    unmount: vi.fn(),\n    26→  }\n    27→}\n    28→\n    29→const createMockHookContext = (elementAttributes: Record<string, string> = {}) => {\n    30→  const mockElement = {\n    31→    getAttribute: vi.fn((name: string) => elementAttributes[name] || null),\n    32→    setAttribute: vi.fn(),\n    33→    removeAttribute: vi.fn(),\n    34→  } as any\n    35→\n    36→  const mockLiveSocket = {\n    37→    execJS: vi.fn(),\n    38→  }\n    39→\n    40→  return {\n    41→    el: mockElement,\n    42→    liveSocket: mockLiveSocket,\n    43→    vue: undefined as any,\n    44→  } as any\n    45→}\n    46→\n    47→describe(\"getRendererHook\", () => {\n    48→  let renderer: FrameworkRenderer\n    49→  let hookContext: ReturnType<typeof createMockHookContext>\n    50→  let resolve: ReturnType<typeof vi.fn>\n    51→  let hook: Hook\n    52→\n    53→  beforeEach(() => {\n    54→    vi.clearAllMocks()\n    55→    renderer = createMockRenderer()\n    56→    resolve = vi.fn().mockResolvedValue({ template: \"<div/>\" })\n    57→    hook = getRendererHook(renderer, resolve)\n    58→  })\n    59→\n    60→  describe(\"mounted lifecycle\", () => {\n    61→    it(\"should resolve the component by name from data-name\", async () => {\n    62→      hookContext = createMockHookContext({ \"data-name\": \"Counter\" })\n    63→      await hook.mounted!.call(hookContext)\n    64→\n    65→      expect(resolve).toHaveBeenCalledWith(\"Counter\")\n    66→    })\n    67→\n    68→    it(\"should call renderer.mount with parsed props and slots\", async () => {\n    69→      const props = { count: 42, label: \"test\" }\n    70→      const slots = { default: toUtf8Base64(\"<p>Hello</p>\") }\n    71→\n    72→      hookContext = createMockHookContext({\n    73→        \"data-name\": \"Counter\",\n    74→        \"data-props\": JSON.stringify(props),\n    75→        \"data-slots\": JSON.stringify(slots),\n    76→      })\n    77→\n    78→      await hook.mounted!.call(hookContext)\n    79→\n    80→      expect(renderer.mount).toHaveBeenCalledWith(\n    81→        expect.objectContaining({\n    82→          props: expect.objectContaining(props),\n    83→          slots: expect.objectContaining({ default: expect.any(String) }),\n    84→          el: hookContext.el,\n    85→          ssr: false,\n    86→          hook: hookContext,\n    87→        })\n    88→      )\n    89→    })\n    90→\n    91→    it(\"should pass ssr=true when data-ssr attribute is true\", async () => {\n    92→      hookContext = createMockHookContext({\n    93→        \"data-name\": \"Counter\",\n    94→        \"data-ssr\": \"true\",\n    95→      })\n    96→\n    97→      await hook.mounted!.call(hookContext)\n    98→\n    99→      expect(renderer.mount).toHaveBeenCalledWith(\n   100→        expect.objectContaining({ ssr: true })\n   101→      )\n   102→    })\n   103→\n   104→    it(\"should apply initial stream diffs after mount\", async () => {\n   105→      const streamDiff = [[\"replace\", \"/items\", [{ id: 1, name: \"test\" }]]]\n   106→\n   107→      hookContext = createMockHookContext({\n   108→        \"data-name\": \"Counter\",\n   109→        \"data-streams-diff\": JSON.stringify(streamDiff),\n   110→      })\n   111→\n   112→      await hook.mounted!.call(hookContext)\n   113→\n   114→      expect(renderer.patchProps).toHaveBeenCalledWith(\n   115→        expect.any(Object),\n   116→        [{ op: \"replace\", path: \"/items\", value: [{ id: 1, name: \"test\" }] }]\n   117→      )\n   118→    })\n   119→\n   120→    it(\"should store renderer state on this.vue\", async () => {\n   121→      hookContext = createMockHookContext({ \"data-name\": \"Counter\" })\n   122→      await hook.mounted!.call(hookContext)\n   123→\n   124→      expect(hookContext.vue).toBeDefined()\n   125→      expect(hookContext.vue.props).toBeDefined()\n   126→      expect(hookContext.vue.slots).toBeDefined()\n   127→      expect(hookContext.vue.app).toBeDefined()\n   128→    })\n   129→\n   130→    it(\"should merge handlers into props\", async () => {\n   131→      const handlers = { click: '[[\"push\", {\"event\": \"clicked\"}]]' }\n   132→\n   133→      hookContext = createMockHookContext({\n   134→        \"data-name\": \"Counter\",\n   135→        \"data-handlers\": JSON.stringify(handlers),\n   136→      })\n   137→\n   138→      await hook.mounted!.call(hookContext)\n   139→\n   140→      const mountCall = (renderer.mount as any).mock.calls[0][0] as MountContext\n   141→      expect(mountCall.props).toHaveProperty(\"onClick\")\n   142→      expect(typeof mountCall.props.onClick).toBe(\"function\")\n   143→    })\n   144→  })\n   145→\n   146→  describe(\"updated lifecycle\", () => {\n   147→    beforeEach(async () => {\n   148→      hookContext = createMockHookContext({ \"data-name\": \"Counter\" })\n   149→      await hook.mounted!.call(hookContext)\n   150→      vi.clearAllMocks()\n   151→    })\n   152→\n   153→    it(\"should call renderer.patchProps when diff mode is enabled\", () => {\n   154→      const diff = [[\"replace\", \"/count\", 10]]\n   155→\n   156→      hookContext.el.getAttribute.mockImplementation((name: string) => {\n   157→        if (name === \"data-use-diff\") return \"true\"\n   158→        if (name === \"data-props-diff\") return JSON.stringify(diff)\n   159→        return null\n   160→      })\n   161→\n   162→      hook.updated!.call(hookContext)\n   163→\n   164→      expect(renderer.patchProps).toHaveBeenCalledWith(\n   165→        hookContext.vue,\n   166→        [{ op: \"replace\", path: \"/count\", value: 10 }]\n   167→      )\n   168→    })\n   169→\n   170→    it(\"should call renderer.updateProps when diff mode is disabled\", () => {\n   171→      const newProps = { count: 99, label: \"updated\" }\n   172→\n   173→      hookContext.el.getAttribute.mockImplementation((name: string) => {\n   174→        if (name === \"data-use-diff\") return \"false\"\n   175→        if (name === \"data-props\") return JSON.stringify(newProps)\n   176→        return null\n   177→      })\n   178→\n   179→      hook.updated!.call(hookContext)\n   180→\n   181→      expect(renderer.updateProps).toHaveBeenCalledWith(\n   182→        hookContext.vue,\n   183→        expect.objectContaining(newProps)\n   184→      )\n   185→    })\n   186→\n   187→    it(\"should always apply stream diffs\", () => {\n   188→      const streamDiff = [[\"add\", \"/items/-\", { id: 2 }]]\n   189→\n   190→      hookContext.el.getAttribute.mockImplementation((name: string) => {\n   191→        if (name === \"data-streams-diff\") return JSON.stringify(streamDiff)\n   192→        return null\n   193→      })\n   194→\n   195→      hook.updated!.call(hookContext)\n   196→\n   197→      // patchProps should be called for stream diffs\n   198→      expect(renderer.patchProps).toHaveBeenCalledWith(\n   199→        hookContext.vue,\n   200→        [{ op: \"add\", path: \"/items/-\", value: { id: 2 } }]\n   201→      )\n   202→    })\n   203→\n   204→    it(\"should call renderer.updateSlots with raw HTML\", () => {\n   205→      const slots = { header: toUtf8Base64(\"<h1>Title</h1>\") }\n   206→\n   207→      hookContext.el.getAttribute.mockImplementation((name: string) => {\n   208→        if (name === \"data-slots\") return JSON.stringify(slots)\n   209→        return null\n   210→      })\n   211→\n   212→      hook.updated!.call(hookContext)\n   213→\n   214→      expect(renderer.updateSlots).toHaveBeenCalledWith(\n   215→        hookContext.vue,\n   216→        expect.objectContaining({ header: expect.any(String) })\n   217→      )\n   218→    })\n   219→  })\n   220→\n   221→  describe(\"destroyed lifecycle\", () => {\n   222→    it(\"should call renderer.unmount\", async () => {\n   223→      hookContext = createMockHookContext({ \"data-name\": \"Counter\" })\n   224→      await hook.mounted!.call(hookContext)\n   225→\n   226→      hook.destroyed!.call(hookContext)\n   227→\n   228→      expect(renderer.unmount).toHaveBeenCalledWith(hookContext.vue)\n   229→    })\n   230→  })\n   231→})\n   232→\n   233→describe(\"getMultiRendererHook\", () => {\n   234→  let vueRenderer: FrameworkRenderer\n   235→  let reactRenderer: FrameworkRenderer\n   236→  let vueResolve: ReturnType<typeof vi.fn>\n   237→  let reactResolve: ReturnType<typeof vi.fn>\n   238→  let hook: Hook\n   239→\n   240→  beforeEach(() => {\n   241→    vi.clearAllMocks()\n   242→    vueRenderer = createMockRenderer(\"vue\")\n   243→    reactRenderer = createMockRenderer(\"react\")\n   244→    vueResolve = vi.fn().mockResolvedValue({ template: \"<div/>\" })\n   245→    reactResolve = vi.fn().mockResolvedValue({ default: () => \"react component\" })\n   246→  })\n   247→\n   248→  describe(\"with multiple renderers\", () => {\n   249→    beforeEach(() => {\n   250→      hook = getMultiRendererHook({\n   251→        vue: { renderer: vueRenderer, resolve: vueResolve },\n   252→        react: { renderer: reactRenderer, resolve: reactResolve },\n   253→      })\n   254→    })\n   255→\n   256→    it(\"should dispatch to vue renderer when data-framework is vue\", async () => {\n   257→      const hookContext = createMockHookContext({\n   258→        \"data-name\": \"Counter\",\n   259→        \"data-framework\": \"vue\",\n   260→      })\n   261→\n   262→      await hook.mounted!.call(hookContext)\n   263→\n   264→      expect(vueRenderer.mount).toHaveBeenCalled()\n   265→      expect(reactRenderer.mount).not.toHaveBeenCalled()\n   266→      expect(vueResolve).toHaveBeenCalledWith(\"Counter\")\n   267→    })\n   268→\n   269→    it(\"should dispatch to react renderer when data-framework is react\", async () => {\n   270→      const hookContext = createMockHookContext({\n   271→        \"data-name\": \"Button\",\n   272→        \"data-framework\": \"react\",\n   273→      })\n   274→\n   275→      await hook.mounted!.call(hookContext)\n   276→\n   277→      expect(reactRenderer.mount).toHaveBeenCalled()\n   278→      expect(vueRenderer.mount).not.toHaveBeenCalled()\n   279→      expect(reactResolve).toHaveBeenCalledWith(\"Button\")\n   280→    })\n   281→\n   282→    it(\"should throw on unknown framework\", async () => {\n   283→      const hookContext = createMockHookContext({\n   284→        \"data-name\": \"Widget\",\n   285→        \"data-framework\": \"svelte\",\n   286→      })\n   287→\n   288→      await expect(hook.mounted!.call(hookContext)).rejects.toThrow(\n   289→        'Unknown framework \"svelte\". Registered renderers: vue, react'\n   290→      )\n   291→    })\n   292→\n   293→    it(\"should throw when data-framework is missing with multiple renderers\", async () => {\n   294→      const hookContext = createMockHookContext({\n   295→        \"data-name\": \"Widget\",\n   296→      })\n   297→\n   298→      await expect(hook.mounted!.call