{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0154kXGfam6A8ZkpjbURKMEP","type":"tool_result","content":"     1→import { isProxy, isReactive, isRef, toRaw } from \"vue\"\n     2→import type { ComponentMap, ComponentOrComponentPromise } from \"./types.js\"\n     3→\n     4→/**\n     5→ * Maps the values of an object using a callback function and returns a new object with the mapped values.\n     6→ * @returns A new object with the mapped values.\n     7→ */\n     8→export const mapValues = <T, U>(\n     9→  object: Record<string, T>,\n    10→  cb: (value: T, key: string, object: Record<string, T>) => U\n    11→): Record<string, U> =>\n    12→  Object.entries(object).reduce((acc, [key, value]) => {\n    13→    acc[key] = cb(value, key, object)\n    14→    return acc\n    15→  }, {} as Record<string, U>)\n    16→\n    17→/**\n    18→ * Flattens the keys of an object using a callback function and returns a new object with the flattened keys.\n    19→ * @returns A new object with the flattened keys.\n    20→ */\n    21→export const flatMapKeys = <T>(\n    22→  object: Record<string, T>,\n    23→  cb: (key: string, value: any, object: Record<string, T>) => string[]\n    24→): Record<string, T> =>\n    25→  Object.entries(object).reduce((acc, [key, value]) => {\n    26→    const newKeys = cb(key, value, object)\n    27→    for (const newKey of newKeys) acc[newKey] = value\n    28→    return acc\n    29→  }, {} as Record<string, T>)\n    30→\n    31→/**\n    32→ * Finds a component by name or path suffix.\n    33→ * @returns The component if found, otherwise throws an error with a list of available components.\n    34→ */\n    35→export const findComponent = (components: ComponentMap, name: string): ComponentOrComponentPromise => {\n    36→  const nameParts = name.replace(/\\.vue$/, '').split('/').filter(part => part !== 'index')\n    37→  const matches: [string, ComponentOrComponentPromise][] = []\n    38→\n    39→  for (const [key, value] of Object.entries(components)) {\n    40→    let keyParts = key.split('/')\n    41→    \n    42→    if (keyParts[keyParts.length - 1] === 'index.vue') {\n    43→      keyParts = keyParts.slice(0, -1)\n    44→    } else {\n    45→      keyParts[keyParts.length - 1] = keyParts[keyParts.length - 1].replace(/\\.vue$/, '')\n    46→    }\n    47→    \n    48→    if (nameParts.length <= keyParts.length) {\n    49→      let isMatch = true\n    50→      for (let i = 0; i < nameParts.length; i++) {\n    51→        const keyPart = keyParts[keyParts.length - nameParts.length + i]\n    52→        if (nameParts[i] !== keyPart) {\n    53→          isMatch = false\n    54→          break\n    55→        }\n    56→      }\n    57→      \n    58→      if (isMatch) {\n    59→        matches.push([key, value])\n    60→      }\n    61→    }\n    62→  }\n    63→\n    64→  if (matches.length === 1) return matches[0][1]\n    65→\n    66→  if (matches.length > 1) {\n    67→    const matchList = matches.map(([key]) => key).join('\\n')\n    68→    throw new Error(`Component '${name}' is ambiguous. Found multiple matches:\\n\\n${matchList}\\n\\n`)\n    69→  }\n    70→\n    71→  // a helpful message for the user\n    72→\n    73→  const availableComponents = Object.keys(components)\n    74→    .map(key => key.replace(\"../../lib/\", \"\").replace(\"/index.vue\", \"\").replace(\".vue\", \"\").replace(\"./\", \"\"))\n    75→    .filter(key => !key.startsWith(\"_build\"))\n    76→    .join(\"\\n\")\n    77→\n    78→  throw new Error(`Component '${name}' not found! Available components:\\n\\n${availableComponents}\\n\\n`)\n    79→}\n    80→\n    81→export function deepToRaw<T>(sourceObj: T): T {\n    82→  const objectIterator = (input: any): any => {\n    83→    if (Array.isArray(input)) {\n    84→      return input.map(item => objectIterator(item))\n    85→    }\n    86→    if (isRef(input) || isReactive(input) || isProxy(input)) {\n    87→      return objectIterator(toRaw(input))\n    88→    }\n    89→    if (input && typeof input === \"object\") {\n    90→      return Object.keys(input).reduce((acc, key) => {\n    91→        acc[key as keyof typeof acc] = objectIterator(input[key])\n    92→        return acc\n    93→      }, {} as T)\n    94→    }\n    95→    return input\n    96→  }\n    97→\n    98→  return objectIterator(sourceObj)\n    99→}\n   100→\n   101→function assignArray(targetArray: any[], sourceArray: any[]) {\n   102→  // Adjust the length of the target array to match the source array\n   103→  targetArray.length = sourceArray.length\n   104→\n   105→  sourceArray.forEach((item, index) => {\n   106→    if (typeof item === \"object\" && item !== null) {\n   107→      if (index in targetArray && targetArray[index] !== null && targetArray[index] !== undefined) {\n   108→        // Deep assign existing items\n   109→        deepAssign(targetArray[index], item)\n   110→      } else {\n   111→        // Create a new item if it doesn't exist in the target\n   112→        targetArray[index] = deepAssign(Array.isArray(item) ? [] : {}, item)\n   113→      }\n   114→    } else {\n   115→      // For primitive values, simply assign\n   116→      targetArray[index] = item\n   117→    }\n   118→  })\n   119→}\n   120→\n   121→function clearObject(targetObject: any) {\n   122→  if (Array.isArray(targetObject)) {\n   123→    targetObject.length = 0\n   124→  } else {\n   125→    Object.values(targetObject).forEach(value => {\n   126→      clearObject(value)\n   127→    })\n   128→  }\n   129→}\n   130→\n   131→function assignObject(targetObject: any, sourceObject: any) {\n   132→  Object.keys(sourceObject).forEach(key => {\n   133→    const sourceValue = toRaw(sourceObject[key])\n   134→    targetObject[key] =\n   135→      typeof sourceValue === \"object\" && sourceValue !== null && targetObject !== null\n   136→        ? deepAssign(targetObject[key] ?? (Array.isArray(sourceValue) ? [] : {}), sourceValue)\n   137→        : sourceValue\n   138→  })\n   139→\n   140→  // Remove properties from target that are not in source\n   141→  Object.keys(targetObject).forEach(key => {\n   142→    if (!(key in sourceObject)) {\n   143→      clearObject(targetObject[key])\n   144→    }\n   145→  })\n   146→}\n   147→\n   148→export function deepAssign(target: any, source: any) {\n   149→  if (Array.isArray(source)) {\n   150→    assignArray(target, source)\n   151→  } else if (typeof source === \"object\" && source !== null) {\n   152→    assignObject(target, source)\n   153→  } else {\n   154→    target = source\n   155→  }\n   156→\n   157→  return target\n   158→}\n   159→\n   160→export function deepCopy<T>(obj: T): T {\n   161→  if (structuredClone) {\n   162→    return structuredClone(deepToRaw(obj))\n   163→  } else {\n   164→    return JSON.parse(JSON.stringify(obj))\n   165→  }\n   166→}\n   167→\n   168→import { ref, computed, type ComputedRef } from \"vue\"\n   169→\n   170→export const debounce = <T extends (...args: any[]) => any>(\n   171→  func: T,\n   172→  wait?: number\n   173→): {\n   174→  debouncedFn: (...args: Parameters<T>) => Promise<Awaited<ReturnType<T>>>\n   175→  isPending: ComputedRef<boolean>\n   176→} => {\n   177→  if (!wait || wait <= 0) {\n   178→    return {\n   179→      debouncedFn: func,\n   180→      isPending: computed(() => false),\n   181→    }\n   182→  }\n   183→\n   184→  let timeout: ReturnType<typeof setTimeout> | null = null\n   185→  let executingCount = 0\n   186→  let pendingResolvers: Array<{\n   187→    resolve: (value: Awaited<ReturnType<T>>) => void\n   188→    reject: (error: any) => void\n   189→  }> = []\n   190→\n   191→  const timeoutRef = ref<ReturnType<typeof setTimeout> | null>(null)\n   192→  const executingCountRef = ref(0)\n   193→\n   194→  const debouncedFn = (...args: Parameters<T>) => {\n   195→    return new Promise<Awaited<ReturnType<T>>>((resolve, reject) => {\n   196→      pendingResolvers.push({ resolve, reject })\n   197→\n   198→      if (timeout !== null) clearTimeout(timeout)\n   199→\n   200→      timeout = setTimeout(async () => {\n   201→        const currentResolvers = pendingResolvers\n   202→        pendingResolvers = []\n   203→        timeout = null\n   204→        timeoutRef.value = null\n   205→        executingCount++\n   206→        executingCountRef.value++\n   207→\n   208→        try {\n   209→          const result = await func(...args)\n   210→          currentResolvers.forEach(({ resolve }) => resolve(result))\n   211→        } catch (error) {\n   212→          currentResolvers.forEach(({ reject }) => reject(error))\n   213→        } finally {\n   214→          executingCount--\n   215→          executingCountRef.value--\n   216→        }\n   217→      }, wait)\n   218→\n   219→      timeoutRef.value = timeout\n   220→    })\n   221→  }\n   222→\n   223→  const isPending = computed(() => timeoutRef.value !== null || executingCountRef.value > 0)\n   224→\n   225→  return { debouncedFn, isPending }\n   226→}\n   227→\n   228→export const cacheOnAccessProxy = <T extends object>(createFunc: (key: keyof T) => any) =>\n   229→  new Proxy(\n   230→    {},\n   231→    {\n   232→      // @ts-expect-error proxy get always expect string key\n   233→      get: (fields, key: keyof T) => {\n   234→        if (typeof key === \"string\" && key.startsWith(\"__\")) {\n   235→          return Reflect.get(fields, key)\n   236→        }\n   237→        if (!Reflect.has(fields, key)) {\n   238→          Reflect.set(fields, key, createFunc(key))\n   239→        }\n   240→        return Reflect.get(fields, key)\n   241→      },\n   242→    }\n   243→  )\n   244→\n   245→/**\n   246→ * Parses a path string like \"user.items[0].name\" into an array of keys\n   247→ */\n   248→export function parsePath(path: string): (string | number)[] {\n   249→  if (!path) return []\n   250→\n   251→  const keys: (string | number)[] = []\n   252→  let current = \"\"\n   253→  let i = 0\n   254→\n   255→  while (i < path.length) {\n   256→    const char = path[i]\n   257→\n   258→    if (char === \".\") {\n   259→      if (current) {\n   260→        keys.push(current)\n   261→        current = \"\"\n   262→      }\n   263→    } else if (char === \"[\") {\n   264→      if (current) {\n   265→        keys.push(current)\n   266→        current = \"\"\n   267→      }\n   268→\n   269→      // Find the closing bracket\n   270→      i++\n   271→      let bracketContent = \"\"\n   272→      while (i < path.length && path[i] !== \"]\") {\n   273→        bracketContent += path[i]\n   274→        i++\n   275→      }\n   276→\n   277→      if (path[i] === \"]\") {\n   278→        const index = parseInt(bracketContent, 10)\n   279→        if (!isNaN(index)) {\n   280→          keys.push(index)\n   281→        } else {\n   282→          keys.push(bracketContent) // String key in brackets\n   283→        }\n   284→      }\n   285→    } else {\n   286→      current += char\n   287→    }\n   288→\n   289→    i++\n   290→  }\n   291→\n   292→  if (current) {\n   293→    keys.push(current)\n   294→  }\n   295→\n   296→  return keys\n   297→}\n   298→\n   299→/**\n   300→ * Gets a value from an object using a parsed path\n   301→ */\n   302→export function getValueByPath(obj: any, keys: (string | number)[]): any {\n   303→  let current = obj\n   304→\n   305→  for (const key of keys) {\n   306→    if (current == null) return undefined\n   307→    current = current[key]\n   308→  }\n   309→\n   310→  return current\n   311→}\n   312→\n   313→/**\n   314→ * Sets a value in an object using a parsed path\n   315→ */\n   316→export function setValueByPath(obj: any, keys: (string | number)[], value: any): void {\n   317→  if (keys.length === 0) return\n   318→\n   319→  let current = obj\n   320→\n   321→  for (let i = 0; i < keys.length - 1; i++) {\n   322→    const key = keys[i]\n   323→    if (current[key] == null) {\n   324→      // Create object or array based on next key type\n   325→      const nextKey = keys[i + 1]\n   326→      current[key] = typeof nextKey === \"number\" ? [] : {}\n   327→    }\n   328→    current = current[key]\n   329→  }\n   330→\n   331→  const lastKey = keys[keys.length - 1]\n   332→  current[lastKey] = value\n   333→}\n   334→\n   335→/**\n   336→ * Deep clone utility - alias for existing deepCopy function for consistency\n   337→ */\n   338→export const deepClone = deepCopy\n   339→\n   340→/**\n   341→ * Helper function to replace reactive object contents while preserving reactivity\n   342→ */\n   343→export function replaceReactiveObject(target: any, source: any) {\n   344→  // Remove properties that exist in target but not in source\n   345→  for (const key in target) {\n   346→    if (!(key in source)) {\n   347→      delete target[key]\n   348→    }\n   349→  }\n   350→\n   351→  // Recursively update/add properties from source\n   352→  for (const key in source) {\n   353→    if (typeof source[key] === \"object\" && source[key] !== null && !Array.isArray(source[key])) {\n   354→      // Handle nested objects\n   355→      if (!target[key] || typeof target[key] !== \"object\" || Array.isArray(target[key])) {\n   356→        target[key] = {}\n   357→      }\n   358→      replaceReactiveObject(target[key], source[key])\n   359→    } else {\n   360→      // Handle primitive values and arrays\n   361→      target[key] = source[key]\n   362→    }\n   363→  }\n   364→}\n   365→\n   366→/**\n   367→ * Deep equality comparison for objects\n   368→ */\n   369→export function deepEqual(a: any, b: any): boolean {\n   370→  if (a === b) return true\n   371→  if (a == null || b == null) return false\n   372→  if (typeof a !== 'object' || typeof b !== 'object') return false\n   373→  \n   374→  const keysA = Object.keys(a).sort()\n   375→  const keysB = Object.keys(b).sort()\n   376→  \n   377→  if (keysA.length !== keysB.length) return false\n   378→  \n   379→  for (let i = 0; i < keysA.length; i++) {\n   380→    if (keysA[i] !== keysB[i]) return false\n   381→    if (!deepEqual(a[keysA[i]], b[keysB[i]])) return false\n   382→  }\n   383→  \n   384→  return true\n   385→}\n   386→\n   387→/**\n   388→ * Sanitizes a string for use as an HTML ID attribute\n   389→ */\n   390→export function sanitizeId(input: string): string {\n   391→  return input.replace(/\\./g, \"_\").replace(/\\[|\\]/g, \"_\").replace(/_+/g, \"_\").replace(/^_|_$/g, \"\")\n   392→}\n   393→\n   394→/**\n   395→ * Takes a string that has been encoded in UTF-8 and then Base64 and returns\n   396→ * a decoded JS string.\n   397→ */\n   398→export const fromUtf8Base64 = (base64: string) => {\n   399→  // atob decodes the Base64 string, but returns each UTF-8 byte as an ASCII\n   400→  // character. So we need to get the values of these characters, put them in\n   401→  // a Uint8Array and then decode that back into a string. Ideally, we'd use\n   402→  // the Uint8Array.fromBase64 function, but this isn't widely available yet\n   403→  const utf8AsciiString = atob(base64);\n   404→  const utf8Uint8Array = new Uint8Array(utf8AsciiString.length);\n   405→  for (let i = 0; i < utf8AsciiString.length; i++) {\n   406→    utf8Uint8Array[i] = utf8AsciiString.charCodeAt(i);\n   407→  }\n   408→  return new TextDecoder(\"utf-8\").decode(utf8Uint8Array);\n   409→}\n   410→\n   411→/**\n   412→ * Encodes a JS string in UTF-8 and Base64. Only here for testing purposes:\n   413→ * because it uses the spread operator, it will break on strings whose\n   414→ * UTF-8 encoding is longer than 64KiB, so it is NOT suitable for production\n   415→ * use!\n   416→ */\n   417→export const toUtf8Base64 = (str: string) => {\n   418→  const utf8Uint8Array = new TextEncoder().encode(str);\n   419→  return btoa(String.fromCharCode(...utf8Uint8Array));\n   420→}\n   421→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"7e54f64e-01ee-4d8c-b9c5-40d315771686","uuid":"060698be-9ca1-4bf8-aa88-14d58c8a5591","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/utils.ts","content":"import { isProxy, isReactive, isRef, toRaw } from \"vue\"\nimport type { ComponentMap, ComponentOrComponentPromise } from \"./types.js\"\n\n/**\n * Maps the values of an object using a callback function and returns a new object with the mapped values.\n * @returns A new object with the mapped values.\n */\nexport const mapValues = <T, U>(\n  object: Record<string, T>,\n  cb: (value: T, key: string, object: Record<string, T>) => U\n): Record<string, U> =>\n  Object.entries(object).reduce((acc, [key, value]) => {\n    acc[key] = cb(value, key, object)\n    return acc\n  }, {} as Record<string, U>)\n\n/**\n * Flattens the keys of an object using a callback function and returns a new object with the flattened keys.\n * @returns A new object with the flattened keys.\n */\nexport const flatMapKeys = <T>(\n  object: Record<string, T>,\n  cb: (key: string, value: any, object: Record<string, T>) => string[]\n): Record<string, T> =>\n  Object.entries(object).reduce((acc, [key, value]) => {\n    const newKeys = cb(key, value, object)\n    for (const newKey of newKeys) acc[newKey] = value\n    return acc\n  }, {} as Record<string, T>)\n\n/**\n * Finds a component by name or path suffix.\n * @returns The component if found, otherwise throws an error with a list of available components.\n */\nexport const findComponent = (components: ComponentMap, name: string): ComponentOrComponentPromise => {\n  const nameParts = name.replace(/\\.vue$/, '').split('/').filter(part => part !== 'index')\n  const matches: [string, ComponentOrComponentPromise][] = []\n\n  for (const [key, value] of Object.entries(components)) {\n    let keyParts = key.split('/')\n    \n    if (keyParts[keyParts.length - 1] === 'index.vue') {\n      keyParts = keyParts.slice(0, -1)\n    } else {\n      keyParts[keyParts.length - 1] = keyParts[keyParts.length - 1].replace(/\\.vue$/, '')\n    }\n    \n    if (nameParts.length <= keyParts.length) {\n      let isMatch = true\n      for (let i = 0; i < nameParts.length; i++) {\n        const keyPart = keyParts[keyParts.length - nameParts.length + i]\n        if (nameParts[i] !== keyPart) {\n          isMatch = false\n          break\n        }\n      }\n      \n      if (isMatch) {\n        matches.push([key, value])\n      }\n    }\n  }\n\n  if (matches.length === 1) return matches[0][1]\n\n  if (matches.length > 1) {\n    const matchList = matches.map(([key]) => key).join('\\n')\n    throw new Error(`Component '${name}' is ambiguous. Found multiple matches:\\n\\n${matchList}\\n\\n`)\n  }\n\n  // a helpful message for the user\n\n  const availableComponents = Object.keys(components)\n    .map(key => key.replace(\"../../lib/\", \"\").replace(\"/index.vue\", \"\").replace(\".vue\", \"\").replace(\"./\", \"\"))\n    .filter(key => !key.startsWith(\"_build\"))\n    .join(\"\\n\")\n\n  throw new Error(`Component '${name}' not found! Available components:\\n\\n${availableComponents}\\n\\n`)\n}\n\nexport function deepToRaw<T>(sourceObj: T): T {\n  const objectIterator = (input: any): any => {\n    if (Array.isArray(input)) {\n      return input.map(item => objectIterator(item))\n    }\n    if (isRef(input) || isReactive(input) || isProxy(input)) {\n      return objectIterator(toRaw(input))\n    }\n    if (input && typeof input === \"object\") {\n      return Object.keys(input).reduce((acc, key) => {\n        acc[key as keyof typeof acc] = objectIterator(input[key])\n        return acc\n      }, {} as T)\n    }\n    return input\n  }\n\n  return objectIterator(sourceObj)\n}\n\nfunction assignArray(targetArray: any[], sourceArray: any[]) {\n  // Adjust the length of the target array to match the source array\n  targetArray.length = sourceArray.length\n\n  sourceArray.forEach((item, index) => {\n    if (typeof item === \"object\" && item !== null) {\n      if (index in targetArray && targetArray[index] !== null && targetArray[index] !== undefined) {\n        // Deep assign existing items\n        deepAssign(targetArray[index], item)\n      } else {\n        // Create a new item if it doesn't exist in the target\n        targetArray[index] = deepAssign(Array.isArray(item) ? [] : {}, item)\n      }\n    } else {\n      // For primitive values, simply assign\n      targetArray[index] = item\n    }\n  })\n}\n\nfunction clearObject(targetObject: any) {\n  if (Array.isArray(targetObject)) {\n    targetObject.length = 0\n  } else {\n    Object.values(targetObject).forEach(value => {\n      clearObject(value)\n    })\n  }\n}\n\nfunction assignObject(targetObject: any, sourceObject: any) {\n  Object.keys(sourceObject).forEach(key => {\n    const sourceValue = toRaw(sourceObject[key])\n    targetObject[key] =\n      typeof sourceValue === \"object\" && sourceValue !== null && targetObject !== null\n        ? deepAssign(targetObject[key] ?? (Array.isArray(sourceValue) ? [] : {}), sourceValue)\n        : sourceValue\n  })\n\n  // Remove properties from target that are not in source\n  Object.keys(targetObject).forEach(key => {\n    if (!(key in sourceObject)) {\n      clearObject(targetObject[key])\n    }\n  })\n}\n\nexport function deepAssign(target: any, source: any) {\n  if (Array.isArray(source)) {\n    assignArray(target, source)\n  } else if (typeof source === \"object\" && source !== null) {\n    assignObject(target, source)\n  } else {\n    target = source\n  }\n\n  return target\n}\n\nexport function deepCopy<T>(obj: T): T {\n  if (structuredClone) {\n    return structuredClone(deepToRaw(obj))\n  } else {\n    return JSON.parse(JSON.stringify(obj))\n  }\n}\n\nimport { ref, computed, type ComputedRef } from \"vue\"\n\nexport const debounce = <T extends (...args: any[]) => any>(\n  func: T,\n  wait?: number\n): {\n  debouncedFn: (...args: Parameters<T>) => Promise<Awaited<ReturnType<T>>>\n  isPending: ComputedRef<boolean>\n} => {\n  if (!wait || wait <= 0) {\n    return {\n      debouncedFn: func,\n      isPending: computed(() => false),\n    }\n  }\n\n  let timeout: ReturnType<typeof setTimeout> | null = null\n  let executingCount = 0\n  let pendingResolvers: Array<{\n    resolve: (value: Awaited<ReturnType<T>>) => void\n    reject: (error: any) => void\n  }> = []\n\n  const timeoutRef = ref<ReturnType<typeof setTimeout> | null>(null)\n  const executingCountRef = ref(0)\n\n  const debouncedFn = (...args: Parameters<T>) => {\n    return new Promise<Awaited<ReturnType<T>>>((resolve, reject) => {\n      pendingResolvers.push({ resolve, reject })\n\n      if (timeout !== null) clearTimeout(timeout)\n\n      timeout = setTimeout(async () => {\n        const currentResolvers = pendingResolvers\n        pendingResolvers = []\n        timeout = null\n        timeoutRef.value = null\n        executingCount++\n        executingCountRef.value++\n\n        try {\n          const result = await func(...args)\n          currentResolvers.forEach(({ resolve }) => resolve(result))\n        } catch (error) {\n          currentResolvers.forEach(({ reject }) => reject(error))\n        } finally {\n          executingCount--\n          executingCountRef.value--\n        }\n      }, wait)\n\n      timeoutRef.value = timeout\n    })\n  }\n\n  const isPending = computed(() => timeoutRef.value !== null || executingCountRef.value > 0)\n\n  return { debouncedFn, isPending }\n}\n\nexport const cacheOnAccessProxy = <T extends object>(createFunc: (key: keyof T) => any) =>\n  new Proxy(\n    {},\n    {\n      // @ts-expect-error proxy get always expect string key\n      get: (fields, key: keyof T) => {\n        if (typeof key === \"string\" && key.startsWith(\"__\")) {\n          return Reflect.get(fields, key)\n        }\n        if (!Reflect.has(fields, key)) {\n          Reflect.set(fields, key, createFunc(key))\n        }\n        return Reflect.get(fields, key)\n      },\n    }\n  )\n\n/**\n * Parses a path string like \"user.items[0].name\" into an array of keys\n */\nexport function parsePath(path: string): (string | number)[] {\n  if (!path) return []\n\n  const keys: (string | number)[] = []\n  let current = \"\"\n  let i = 0\n\n  while (i < path.length) {\n    const char = path[i]\n\n    if (char === \".\") {\n      if (current) {\n        keys.push(current)\n        current = \"\"\n      }\n    } else if (char === \"[\") {\n      if (current) {\n        keys.push(current)\n        current = \"\"\n      }\n\n      // Find the closing bracket\n      i++\n      let bracketContent = \"\"\n      while (i < path.length && path[i] !== \"]\") {\n        bracketContent += path[i]\n        i++\n      }\n\n      if (path[i] === \"]\") {\n        const index = parseInt(bracketContent, 10)\n        if (!isNaN(index)) {\n          keys.push(index)\n        } else {\n          keys.push(bracketContent) // String key in brackets\n        }\n      }\n    } else {\n      current += char\n    }\n\n    i++\n  }\n\n  if (current) {\n    keys.push(current)\n  }\n\n  return keys\n}\n\n/**\n * Gets a value from an object using a parsed path\n */\nexport function getValueByPath(obj: any, keys: (string | number)[]): any {\n  let current = obj\n\n  for (const key of keys) {\n    if (current == null) return undefined\n    current = current[key]\n  }\n\n  return current\n}\n\n/**\n * Sets a value in an object using a parsed path\n */\nexport function setValueByPath(obj: any, keys: (string | number)[], value: any): void {\n  if (keys.length === 0) return\n\n  let current = obj\n\n  for (let i = 0; i < keys.length - 1; i++) {\n    const key = keys[i]\n    if (current[key] == null) {\n      // Create object or array based on next key type\n      const nextKey = keys[i + 1]\n      current[key] = typeof nextKey === \"number\" ? [] : {}\n    }\n    current = current[key]\n  }\n\n  const lastKey = keys[keys.length - 1]\n  current[lastKey] = value\n}\n\n/**\n * Deep clone utility - alias for existing deepCopy function for consistency\n */\nexport const deepClone = deepCopy\n\n/**\n * Helper function to replace reactive object contents while preserving reactivity\n */\nexport function replaceReactiveObject(target: any, source: any) {\n  // Remove properties that exist in target but not in source\n  for (const key in target) {\n    if (!(key in source)) {\n      delete target[key]\n    }\n  }\n\n  // Recursively update/add properties from source\n  for (const key in source) {\n    if (typeof source[key] === \"object\" && source[key] !== null && !Array.isArray(source[key])) {\n      // Handle nested objects\n      if (!target[key] || typeof target[key] !== \"object\" || Array.isArray(target[key])) {\n        target[key] = {}\n      }\n      replaceReactiveObject(target[key], source[key])\n    } else {\n      // Handle primitive values and arrays\n      target[key] = source[key]\n    }\n  }\n}\n\n/**\n * Deep equality comparison for objects\n */\nexport function deepEqual(a: any, b: any): boolean {\n  if (a === b) return true\n  if (a == null || b == null) return false\n  if (typeof a !== 'object' || typeof b !== 'object') return false\n  \n  const keysA = Object.keys(a).sort()\n  const keysB = Object.keys(b).sort()\n  \n  if (keysA.length !== keysB.length) return false\n  \n  for (let i = 0; i < keysA.length; i++) {\n    if (keysA[i] !== keysB[i]) return false\n    if (!deepEqual(a[keysA[i]], b[keysB[i]])) return false\n  }\n  \n  return true\n}\n\n/**\n * Sanitizes a string for use as an HTML ID attribute\n */\nexport function sanitizeId(input: string): string {\n  return input.replace(/\\./g, \"_\").replace(/\\[|\\]/g, \"_\").replace(/_+/g, \"_\").replace(/^_|_$/g, \"\")\n}\n\n/**\n * Takes a string that has been encoded in UTF-8 and then Base64 and returns\n * a decoded JS string.\n */\nexport const fromUtf8Base64 = (base64: string) => {\n  // atob decodes the Base64 string, but returns each UTF-8 byte as an ASCII\n  // character. So we need to get the values of these characters, put them in\n  // a Uint8Array and then decode that back into a string. Ideally, we'd use\n  // the Uint8Array.fromBase64 function, but this isn't widely available yet\n  const utf8AsciiString = atob(base64);\n  const utf8Uint8Array = new Uint8Array(utf8AsciiString.length);\n  for (let i = 0; i < utf8AsciiString.length; i++) {\n    utf8Uint8Array[i] = utf8AsciiString.charCodeAt(i);\n  }\n  return new TextDecoder(\"utf-8\").decode(utf8Uint8Array);\n}\n\n/**\n * Encodes a JS string in UTF-8 and Base64. Only here for testing purposes:\n * because it uses the spread operator, it will break on strings whose\n * UTF-8 encoding is longer than 64KiB, so it is NOT suitable for production\n * use!\n */\nexport const toUtf8Base64 = (str: string) => {\n  const utf8Uint8Array = new TextEncoder().encode(str);\n  return btoa(String.fromCharCode(...utf8Uint8Array));\n}\n","numLines":421,"startLine":1,"totalLines":421}}}
