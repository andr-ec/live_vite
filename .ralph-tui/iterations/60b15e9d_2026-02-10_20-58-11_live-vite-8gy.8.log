   56→\t\t\thandler() {\n    57→\t\t\t\treturn {\n    58→\t\t\t\t\tcode: `export default {\n    59→\t\t\t\t\t\texperimentalReactChildren: ${JSON.stringify(experimentalReactChildren)},\n    60→\t\t\t\t\t\texperimentalDisableStreaming: ${JSON.stringify(experimentalDisableStreaming)}\n    61→\t\t\t\t\t}`,\n    62→\t\t\t\t};\n    63→\t\t\t},\n    64→\t\t},\n    65→\t};\n    66→}\n    67→\n    68→function getViteConfiguration(\n    69→\t{\n    70→\t\tinclude,\n    71→\t\texclude,\n    72→\t\tbabel,\n    73→\t\texperimentalReactChildren,\n    74→\t\texperimentalDisableStreaming,\n    75→\t}: ReactIntegrationOptions = {},\n    76→\treactConfig: ReactVersionConfig,\n    77→) {\n    78→\treturn {\n    79→\t\tplugins: [\n    80→\t\t\treact({ include, exclude, babel }),\n    81→\t\t\toptionsPlugin({\n    82→\t\t\t\texperimentalReactChildren: !!experimentalReactChildren,\n    83→\t\t\t\texperimentalDisableStreaming: !!experimentalDisableStreaming,\n    84→\t\t\t}),\n    85→\t\t\tconfigEnvironmentPlugin(reactConfig),\n    86→\t\t],\n    87→\t\tssr: {\n    88→\t\t\tnoExternal: [\n    89→\t\t\t\t// These are all needed to get mui to work.\n    90→\t\t\t\t'@mui/material',\n    91→\t\t\t\t'@mui/base',\n    92→\t\t\t\t'@babel/runtime',\n    93→\t\t\t\t'use-immer',\n    94→\t\t\t\t'@material-tailwind/react',\n    95→\t\t\t],\n    96→\t\t},\n    97→\t};\n    98→}\n    99→\n   100→function configEnvironmentPlugin(reactConfig: ReactVersionConfig): vite.Plugin {\n   101→\treturn {\n   102→\t\tname: '@astrojs/react:environment',\n   103→\t\tconfigEnvironment(environmentName, options): EnvironmentOptions {\n   104→\t\t\tconst finalOptions: EnvironmentOptions = {\n   105→\t\t\t\tresolve: {\n   106→\t\t\t\t\tdedupe: ['react', 'react-dom'],\n   107→\t\t\t\t},\n   108→\t\t\t\toptimizeDeps: {},\n   109→\t\t\t};\n   110→\n   111→\t\t\tif (\n   112→\t\t\t\tenvironmentName === 'client' ||\n   113→\t\t\t\t((environmentName === 'ssr' || environmentName === 'prerender') &&\n   114→\t\t\t\t\toptions.optimizeDeps?.noDiscovery === false)\n   115→\t\t\t) {\n   116→\t\t\t\t// SAFETY: we initialized it before\n   117→\t\t\t\tfinalOptions.optimizeDeps!.include = [\n   118→\t\t\t\t\t'react',\n   119→\t\t\t\t\t'react/jsx-runtime',\n   120→\t\t\t\t\t'react/jsx-dev-runtime',\n   121→\t\t\t\t\t'react-dom',\n   122→\t\t\t\t];\n   123→\t\t\t\tfinalOptions.optimizeDeps!.exclude = [reactConfig.server];\n   124→\t\t\t\tif (environmentName === 'ssr' || environmentName === 'prerender') {\n   125→\t\t\t\t\tfinalOptions.optimizeDeps!.include.push('react-dom/server');\n   126→\t\t\t\t\tif (!options.resolve?.noExternal) {\n   127→\t\t\t\t\t\tfinalOptions.resolve!.noExternal = [\n   128→\t\t\t\t\t\t\t// These are all needed to get mui to work.\n   129→\t\t\t\t\t\t\t'@mui/material',\n   130→\t\t\t\t\t\t\t'@mui/base',\n   131→\t\t\t\t\t\t\t'@babel/runtime',\n   132→\t\t\t\t\t\t\t'use-immer',\n   133→\t\t\t\t\t\t\t'@material-tailwind/react',\n   134→\t\t\t\t\t\t];\n   135→\t\t\t\t\t}\n   136→\t\t\t\t}\n   137→\t\t\t\tif (environmentName === 'client') {\n   138→\t\t\t\t\tfinalOptions.optimizeDeps!.include.push('react-dom/client');\n   139→\t\t\t\t\tfinalOptions.optimizeDeps!.include.push(reactConfig.client);\n   140→\t\t\t\t}\n   141→\t\t\t}\n   142→\n   143→\t\t\treturn finalOptions;\n   144→\t\t},\n   145→\t};\n   146→}\n   147→\n   148→export default function ({\n   149→\tinclude,\n   150→\texclude,\n   151→\tbabel,\n   152→\texperimentalReactChildren,\n   153→\texperimentalDisableStreaming,\n   154→}: ReactIntegrationOptions = {}): AstroIntegration {\n   155→\tconst majorVersion = getReactMajorVersion();\n   156→\tif (!isSupportedReactVersion(majorVersion)) {\n   157→\t\tthrow new Error(`Unsupported React version: ${majorVersion}.`);\n   158→\t}\n   159→\tconst versionConfig = versionsConfig[majorVersion];\n   160→\n   161→\treturn {\n   162→\t\tname: '@astrojs/react',\n   163→\t\thooks: {\n   164→\t\t\t'astro:config:setup': ({ command, addRenderer, updateConfig, injectScript }) => {\n   165→\t\t\t\taddRenderer(getRenderer(versionConfig));\n   166→\t\t\t\tupdateConfig({\n   167→\t\t\t\t\tvite: getViteConfiguration(\n   168→\t\t\t\t\t\t{ include, exclude, babel, experimentalReactChildren, experimentalDisableStreaming },\n   169→\t\t\t\t\t\tversionConfig,\n   170→\t\t\t\t\t),\n   171→\t\t\t\t});\n   172→\t\t\t\tif (command === 'dev') {\n   173→\t\t\t\t\tconst preamble = FAST_REFRESH_PREAMBLE.replace(`__BASE__`, '/');\n   174→\t\t\t\t\tinjectScript('before-hydration', preamble);\n   175→\t\t\t\t}\n   176→\t\t\t},\n   177→\t\t\t'astro:config:done': ({ logger, config }) => {\n   178→\t\t\t\tconst knownJsxRenderers = ['@astrojs/react', '@astrojs/preact', '@astrojs/solid-js'];\n   179→\t\t\t\tconst enabledKnownJsxRenderers = config.integrations.filter((renderer) =>\n   180→\t\t\t\t\tknownJsxRenderers.includes(renderer.name),\n   181→\t\t\t\t);\n   182→\n   183→\t\t\t\tif (enabledKnownJsxRenderers.length > 1 && !include && !exclude) {\n   184→\t\t\t\t\tlogger.warn(\n   185→\t\t\t\t\t\t'More than one JSX renderer is enabled. This will lead to unexpected behavior unless you set the `include` or `exclude` option. See https://docs.astro.build/en/guides/integrations-guide/react/#combining-multiple-jsx-frameworks for more information.',\n   186→\t\t\t\t\t);\n   187→\t\t\t\t}\n   188→\t\t\t},\n   189→\t\t},\n   190→\t};\n   191→}\n   192→\n   193→export function getContainerRenderer(): AstroRenderer {\n   194→\tconst majorVersion = getReactMajorVersion();\n   195→\tif (!isSupportedReactVersion(majorVersion)) {\n   196→\t\tthrow new Error(`Unsupported React version: ${majorVersion}.`);\n   197→\t}\n   198→\treturn getRenderer(versionsConfig[majorVersion]);\n   199→}\n   200→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer ques