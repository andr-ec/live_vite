;\n    49→\t} else if (childString) {\n    50→\t\treturn createElement(StaticHtml, { value: childString });\n    51→\t} else {\n    52→\t\treturn undefined;\n    53→\t}\n    54→}\n    55→\n    56→// Keep a map of roots so we can reuse them on re-renders\n    57→let rootMap = new WeakMap<HTMLElement, Root>();\n    58→const getOrCreateRoot = (element: HTMLElement, creator: () => Root) => {\n    59→\tlet root = rootMap.get(element);\n    60→\tif (!root) {\n    61→\t\troot = creator();\n    62→\t\trootMap.set(element, root);\n    63→\t}\n    64→\treturn root;\n    65→};\n    66→\n    67→export default (element: HTMLElement) =>\n    68→\t(\n    69→\t\tComponent: any,\n    70→\t\tprops: Record<string, any>,\n    71→\t\t{ default: children, ...slotted }: Record<string, any>,\n    72→\t\t{ client }: Record<string, string>,\n    73→\t) => {\n    74→\t\tif (!element.hasAttribute('ssr')) return;\n    75→\n    76→\t\tconst actionKey = element.getAttribute('data-action-key');\n    77→\t\tconst actionName = element.getAttribute('data-action-name');\n    78→\t\tconst stringifiedActionResult = element.getAttribute('data-action-result');\n    79→\n    80→\t\tconst formState =\n    81→\t\t\tactionKey && actionName && stringifiedActionResult\n    82→\t\t\t\t? [JSON.parse(stringifiedActionResult), actionKey, actionName]\n    83→\t\t\t\t: undefined;\n    84→\n    85→\t\tconst renderOptions = {\n    86→\t\t\tidentifierPrefix: element.getAttribute('prefix'),\n    87→\t\t\tformState,\n    88→\t\t};\n    89→\t\tfor (const [key, value] of Object.entries(slotted)) {\n    90→\t\t\tprops[key] = createElement(StaticHtml, { value, name: key });\n    91→\t\t}\n    92→\n    93→\t\tconst componentEl = createElement(\n    94→\t\t\tComponent,\n    95→\t\t\tprops,\n    96→\t\t\tgetChildren(children, element.hasAttribute('data-react-children')),\n    97→\t\t);\n    98→\t\tconst rootKey = isAlreadyHydrated(element);\n    99→\t\t// HACK: delete internal react marker for nested components to suppress aggre