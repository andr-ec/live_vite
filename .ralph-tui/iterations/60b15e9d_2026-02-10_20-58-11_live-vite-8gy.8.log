h `useActionState()` call.\n   141→\t * @example \"k511f74df5a35d32e7cf266450d85cb6c\"\n   142→\t */\n   143→\tconst actionKey = formData.get('$ACTION_KEY')?.toString();\n   144→\t/**\n   145→\t * The action name returned by an action's `toString()` property.\n   146→\t * This matches the endpoint path.\n   147→\t * @example \"/_actions/blog.like\"\n   148→\t */\n   149→\tconst actionName = searchParams.get('_action');\n   150→\n   151→\tif (!actionKey || !actionName) return undefined;\n   152→\n   153→\treturn [actionResult, actionKey, actionName];\n   154→}\n   155→\n   156→async function renderToPipeableStreamAsync(vnode: any, options: Record<string, any>) {\n   157→\tconst Writable = await getNodeWritable();\n   158→\tlet html = '';\n   159→\treturn new Promise<string>((resolve, reject) => {\n   160→\t\tlet error = undefined;\n   161→\t\tlet stream = ReactDOM.renderToPipeableStream(vnode, {\n   162→\t\t\t...options,\n   163→\t\t\tonError(err) {\n   164→\t\t\t\terror = err;\n   165→\t\t\t\treject(error);\n   166→\t\t\t},\n   167→\t\t\tonAllReady() {\n   168→\t\t\t\tstream.pipe(\n   169→\t\t\t\t\tnew Writable({\n   170→\t\t\t\t\t\twrite(chunk, _encoding, callback) {\n   171→\t\t\t\t\t\t\thtml += chunk.toString('utf-8');\n   172→\t\t\t\t\t\t\tcallback();\n   173→\t\t\t\t\t\t},\n   174→\t\t\t\t\t\tdestroy() {\n   175→\t\t\t\t\t\t\tresolve(html);\n   176→\t\t\t\t\t\t},\n   177→\t\t\t\t\t}),\n   178→\t\t\t\t);\n   179→\t\t\t},\n   180→\t\t});\n   181→\t});\n   182→}\n   183→\n   184→/**\n   185→ * Use a while loop instead of \"for await\" due to cloudflare and Vercel Edge issues\n   186→ * See https://github.com/facebook/react/issues/24169\n   187→ */\n   188→async function readResult(stream: ReactDOM.ReactDOMServerReadableStream) {\n   189→\tconst reader = stream.getReader();\n   190→\tlet result = '';\n   191→\tconst decoder = new TextDecoder('utf-8');\n   192→\twhile (true) {\n   193→\t\tconst { done, value } = await reader.read();\n   194→\t\tif (done) {\n   195→\t\t\tif (value) {\n   196→\t\t\t\tresult += decoder.decode(value);\n   197→\t\t\t} else {\n   198→\t\t\t\t// This closes the decoder\n   199→\t\t\t\tdecoder.decode(new Uint8Array());\n   200→\t\t\t}\n   201→\n   202→\t\t\treturn result;\n   203→\t\t}\n   204→\t\tresult += decoder.decode(value, { stream: true });\n   205→\t}\n   206→}\n   207→\n   208→async function renderToReadableStreamAsync(vnode: any, options: Record<string, any>) {\n   209→\treturn await readResult(await ReactDOM.renderToReadableStream(vnode, options));\n   210→}\n   211→\n   212→const formContentTypes = ['application/x-www-form-urlencoded', 'multipart/form-data'];\n   213→\n   214→function isFormRequest(contentType: string | null) {\n   215→\t// Split off parameters like charset or boundary\n   216→\t// https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Content-Type#content-type_in_html_forms\n   217→\tconst type = contentType?.split(';')[0].toLowerCase();\n   218→\n   219→\treturn formContentTypes.some((t) => type === t);\n   220→}\n   221→\n   222→const renderer: NamedSSRLoadedRendererValue = {\n   223→\tname: '@astrojs/react',\n   224→\tcheck,\n   225→\trenderToStaticMarkup,\n   226→\tsupportsAstroStaticSlot: true,\n   227→};\n   228→\n   229→export default renderer;\n   230→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_018cewbrAQTiCboLWeF2v3xv","session_id":"7e54f64e-01ee-4d8c-b9c5-40d315771686","uuid":"422a7bfa-8791-42db-9a6c-b062daaa0cee"}
