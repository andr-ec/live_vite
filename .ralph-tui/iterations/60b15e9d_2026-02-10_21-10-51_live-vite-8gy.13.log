{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013oW31EyyQdEmuAcpdeKSVF","type":"tool_result","content":"     1→import {\n     2→  createContext,\n     3→  useCallback,\n     4→  useContext,\n     5→  useEffect,\n     6→  useMemo,\n     7→  useRef,\n     8→  useState,\n     9→} from \"react\"\n    10→import { useLive } from \"./useReact.js\"\n    11→import {\n    12→  parsePath,\n    13→  getValueByPath,\n    14→  setValueByPath,\n    15→  sanitizeId,\n    16→} from \"./utils.js\"\n    17→import type { Form, FormErrors, FormOptions, FieldOptions } from \"./useLiveForm.js\"\n    18→\n    19→// Deep clone utility (framework-agnostic)\n    20→function deepClone<T>(obj: T): T {\n    21→  if (typeof structuredClone === \"function\") {\n    22→    return structuredClone(obj)\n    23→  }\n    24→  return JSON.parse(JSON.stringify(obj))\n    25→}\n    26→\n    27→// Deep equality comparison\n    28→function deepEqual(a: any, b: any): boolean {\n    29→  if (a === b) return true\n    30→  if (a == null || b == null) return false\n    31→  if (typeof a !== \"object\" || typeof b !== \"object\") return false\n    32→\n    33→  const keysA = Object.keys(a).sort()\n    34→  const keysB = Object.keys(b).sort()\n    35→\n    36→  if (keysA.length !== keysB.length) return false\n    37→\n    38→  for (let i = 0; i < keysA.length; i++) {\n    39→    if (keysA[i] !== keysB[i]) return false\n    40→    if (!deepEqual(a[keysA[i]], b[keysB[i]])) return false\n    41→  }\n    42→\n    43→  return true\n    44→}\n    45→\n    46→// Replace object contents in-place (for mutable state updates)\n    47→function replaceObject(target: any, source: any) {\n    48→  for (const key in target) {\n    49→    if (!(key in source)) {\n    50→      delete target[key]\n    51→    }\n    52→  }\n    53→  for (const key in source) {\n    54→    if (typeof source[key] === \"object\" && source[key] !== null && !Array.isArray(source[key])) {\n    55→      if (!target[key] || typeof target[key] !== \"object\" || Array.isArray(target[key])) {\n    56→        target[key] = {}\n    57→      }\n    58→      replaceObject(target[key], source[key])\n    59→    } else {\n    60→      target[key] = source[key]\n    61→    }\n    62→  }\n    63→}\n    64→\n    65→// Helper to check if any errors exist in nested error structure\n    66→function hasAnyErrors(errors: any): boolean {\n    67→  if (Array.isArray(errors)) {\n    68→    if (errors.length === 0) return false\n    69→    if (typeof errors[0] === \"string\") return errors.length > 0\n    70→    return errors.some((item: any) => hasAnyErrors(item))\n    71→  }\n    72→  if (typeof errors === \"object\" && errors !== null) {\n    73→    return Object.values(errors).some((value: any) => hasAnyErrors(value))\n    74→  }\n    75→  return false\n    76→}\n    77→\n    78→// ─── React FormField interface (mirrors Vue but without Refs) ───\n    79→\n    80→export interface ReactFormField<T> {\n    81→  value: T\n    82→  errors: string[]\n    83→  errorMessage: string | undefined\n    84→  isValid: boolean\n    85→  isDirty: boolean\n    86→  isTouched: boolean\n    87→  setValue: (newValue: T) => void\n    88→  blur: () => void\n    89→\n    90→  inputProps: {\n    91→    value: any\n    92→    onChange: (event: any) => void\n    93→    onBlur: () => void\n    94→    name: string\n    95→    id: string\n    96→    type?: string\n    97→    checked?: boolean\n    98→    \"aria-invalid\": boolean\n    99→    \"aria-describedby\"?: string\n   100→  }\n   101→\n   102→  field<K extends keyof T>(\n   103→    key: K,\n   104→    options?: FieldOptions\n   105→  ): T[K] extends readonly (infer U)[] ? ReactFormFieldArray<U> : ReactFormField<T[K]>\n   106→\n   107→  fieldArray<K extends keyof T>(\n   108→    key: K\n   109→  ): T[K] extends readonly (infer U)[] ? ReactFormFieldArray<U> : never\n   110→}\n   111→\n   112→export interface ReactFormFieldArray<T> extends Omit<ReactFormField<T[]>, \"field\" | \"fieldArray\"> {\n   113→  add: (item?: Partial<T>) => Promise<any>\n   114→  remove: (index: number) => Promise<any>\n   115→  move: (from: number, to: number) => Promise<any>\n   116→  fields: ReactFormField<T>[]\n   117→\n   118→  field: <P extends string | number>(path: P, options?: FieldOptions) => ReactFormField<any>\n   119→  fieldArray: <P extends string | number>(path: P) => ReactFormFieldArray<any>\n   120→}\n   121→\n   122→export interface UseLiveFormReactReturn<T extends object> {\n   123→  isValid: boolean\n   124→  isDirty: boolean\n   125→  isTouched: boolean\n   126→  isValidating: boolean\n   127→  submitCount: number\n   128→  initialValues: Readonly<T>\n   129→\n   130→  field<P extends string>(path: P, options?: FieldOptions): ReactFormField<any>\n   131→  fieldArray<P extends string>(path: P): ReactFormFieldArray<any>\n   132→\n   133→  submit: () => Promise<any>\n   134→  reset: () => void\n   135→}\n   136→\n   137→// ─── React Context for form injection into children ───\n   138→\n   139→export const LiveFormContext = createContext<{\n   140→  field: (path: string, options?: FieldOptions) => ReactFormField<any>\n   141→  fieldArray: (path: string) => ReactFormFieldArray<any>\n   142→} | null>(null)\n   143→\n   144→// ─── Main hook ───\n   145→\n   146→export function useLiveForm<T extends object>(\n   147→  form: Form<T>,\n   148→  options: FormOptions = {}\n   149→): UseLiveFormReactReturn<T> {\n   150→  const {\n   151→    changeEvent = null,\n   152→    submitEvent = \"submit\",\n   153→    debounceInMiliseconds = 300,\n   154→    prepareData = (data: any) => data,\n   155→  } = options\n   156→\n   157→  // Get LiveView hook\n   158→  let live: ReturnType<typeof useLive> | null = null\n   159→  try {\n   160→    live = useLive()\n   161→  } catch {\n   162→    // Not inside a LiveVite context — form still works for local state\n   163→  }\n   164→\n   165→  // ─── Mutable state stored in refs (avoids stale closures) ───\n   166→  // We use a single \"version\" counter to trigger re-renders when internal\n   167→  // mutable state changes, rather than storing the entire form state in\n   168→  // React state (which would require deep cloning on every field change).\n   169→\n   170→  const [, setVersion] = useState(0)\n   171→  const rerender = useCallback(() => setVersion(v => v + 1), [])\n   172→\n   173→  const initialValuesRef = useRef<T>(deepClone(form.values))\n   174→  const currentValuesRef = useRef<T>(deepClone(form.values))\n   175→  const currentErrorsRef = useRef<FormErrors<T>>(deepClone(form.errors))\n   176→  const touchedFieldsRef = useRef<Set<string>>(new Set())\n   177→  const submitCountRef = useRef(0)\n   178→\n   179→  // Track debounce/validation state\n   180→  const debounceTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null)\n   181→  const isValidatingRef = useRef(false)\n   182→\n   183→  // Memoization caches\n   184→  const fieldCacheRef = useRef(new Map<string, ReactFormField<any>[]>())\n   185→  const fieldArrayCacheRef = useRef(new Map<string, ReactFormFieldArray<any>>())\n   186→\n   187→  // Track previous form to detect server updates\n   188→  const prevFormRef = useRef(form)\n   189→\n   190→  // ─── Server update handling ───\n   191→\n   192→  useEffect(() => {\n   193→    if (prevFormRef.current === form) return\n   194→    prevFormRef.current = form\n   195→\n   196→    // Always update errors\n   197→    currentErrorsRef.current = deepClone(form.errors)\n   198→\n   199→    // Only update values if no validation is in progress\n   200→    if (!isValidatingRef.current) {\n   201→      currentValuesRef.current = deepClone(form.values)\n   202→    }\n   203→\n   204→    rerender()\n   205→  }, [form, rerender])\n   206→\n   207→  // ─── Send changes to server (debounced) ───\n   208→\n   209→  const sendChanges = useCallback(() => {\n   210→    if (!changeEvent || !live) return Promise.resolve(null)\n   211→\n   212→    const formName = form.name\n   213→    const values = deepClone(currentValuesRef.current)\n   214→    const data = prepareData(values)\n   215→\n   216→    return new Promise(resolve => {\n   217→      live!.pushEvent(changeEvent, { [formName]: data }, (result: any) => {\n   218→        resolve(result)\n   219→      })\n   220→    })\n   221→  }, [changeEvent, live, form.name, prepareData])\n   222→\n   223→  const debouncedSendChanges = useCallback(() => {\n   224→    if (!changeEvent) return\n   225→\n   226→    const wait = live && changeEvent ? debounceInMiliseconds : 0\n   227→    if (wait <= 0) {\n   228→      isValidatingRef.current = true\n   229→      sendChanges().finally(() => {\n   230→        isValidatingRef.current = false\n   231→      })\n   232→      return\n   233→    }\n   234→\n   235→    if (debounceTimerRef.current !== null) {\n   236→      clearTimeout(debounceTimerRef.current)\n   237→    }\n   238→\n   239→    isValidatingRef.current = true\n   240→    debounceTimerRef.current = setTimeout(() => {\n   241→      debounceTimerRef.current = null\n   242→      sendChanges().finally(() => {\n   243→        isValidatingRef.current = false\n   244→      })\n   245→    }, wait)\n   246→  }, [changeEvent, live, debounceInMiliseconds, sendChanges])\n   247→\n   248→  // Cleanup debounce timer on unmount\n   249→  useEffect(() => {\n   250→    return () => {\n   251→      if (debounceTimerRef.current !== null) {\n   252→        clearTimeout(debounceTimerRef.current)\n   253→      }\n   254→    }\n   255→  }, [])\n   256→\n   257→  // ─── Field creation ───\n   258→\n   259→  const createFormField = useCallback(<V,>(path: string, options: FieldOptions = {}): ReactFormField<V> => {\n   260→    const cache = fieldCacheRef.current\n   261→    if (!cache.has(path)) {\n   262→      cache.set(path, [])\n   263→    }\n   264→    const fieldsForPath = cache.get(path)!\n   265→    const existing = fieldsForPath.find(f => deepEqual((f as any)._options, options))\n   266→    if (existing) return existing as ReactFormField<V>\n   267→\n   268→    const keys = parsePath(path)\n   269→    const fieldId = sanitizeId(path) + (options.value !== undefined ? `_${sanitizeId(String(options.value))}` : \"\")\n   270→\n   271→    const field: ReactFormField<V> = {\n   272→      get value(): V {\n   273→        return getValueByPath(currentValuesRef.current, keys)\n   274→      },\n   275→\n   276→      get errors(): string[] {\n   277→        const errs = getValueByPath(currentErrorsRef.current, keys)\n   278→        return Array.isArray(errs) ? errs : []\n   279→      },\n   280→\n   281→      get errorMessage(): string | undefined {\n   282→        const errs = field.errors\n   283→        return errs.length > 0 ? errs[0] : undefined\n   284→      },\n   285→\n   286→      get isValid(): boolean {\n   287→        return field.errors.length === 0\n   288→      },\n   289→\n   290→      get isDirty(): boolean {\n   291→        const initialVal = getValueByPath(initialValuesRef.current, keys)\n   292→        return JSON.stringify(field.value) !== JSON.stringify(initialVal)\n   293→      },\n   294→\n   295→      get isTouched(): boolean {\n   296→        return submitCountRef.current > 0 || touchedFieldsRef.current.has(path)\n   297→      },\n   298→\n   299→      setValue(newValue: V) {\n   300→        setValueByPath(currentValuesRef.current, keys, newValue)\n   301→        debouncedSendChanges()\n   302→        rerender()\n   303→      },\n   304→\n   305→      blur() {\n   306→        touchedFieldsRef.current.add(path)\n   307→        rerender()\n   308→      },\n   309→\n   310→      get inputProps() {\n   311→        const isMultiCheckbox = options.type === \"checkbox\" && Array.isArray(field.value)\n   312→\n   313→        const baseProps = {\n   314→          name: path,\n   315→          id: fieldId,\n   316→          type: options.type,\n   317→          onBlur: () => field.blur(),\n   318→          \"aria-invalid\": !field.isValid as boolean,\n   319→          ...(field.errors.length > 0 ? { \"aria-describedby\": `${fieldId}-error` } : {}),\n   320→        }\n   321→\n   322→        if (isMultiCheckbox) {\n   323→          return {\n   324→            ...baseProps,\n   325→            value: options.value,\n   326→            checked: ((field.value as any[]) || []).includes(options.value),\n   327→            onChange: (event: any) => {\n   328→              const target = event.target as HTMLInputElement\n   329→              const currentArray = [...((field.value as any[]) || [])]\n   330→              const idx = currentArray.indexOf(options.value)\n   331→              if (target.checked && idx === -1) {\n   332→                currentArray.push(options.value)\n   333→              } else if (!target.checked && idx !== -1) {\n   334→                currentArray.splice(idx, 1)\n   335→              }\n   336→              field.setValue(currentArray as any)\n   337→            },\n   338→          }\n   339→        } else if (options.type === \"checkbox\") {\n   340→          const optionsValue = options.value !== undefined ? options.value : true\n   341→          return {\n   342→            ...baseProps,\n   343→            value: options.value,\n   344→            checked: field.value === optionsValue,\n   345→            onChange: (event: any) => {\n   346→              const target = event.target as HTMLInputElement\n   347→              field.setValue((target.checked ? optionsValue : null) as any)\n   348→            },\n   349→          }\n   350→        } else {\n   351→          return {\n   352→            ...baseProps,\n   353→            value: field.value,\n   354→            onChange: (event: any) => {\n   355→              const target = event.target as HTMLInputElement\n   356→              field.setValue(target.value as any)\n   357→            },\n   358→          }\n   359→        }\n   360→      },\n   361→\n   362→      field(key: any, opts?: FieldOptions) {\n   363→        const subPath = path ? `${path}.${String(key)}` : String(key)\n   364→        return createFormField(subPath, opts) as any\n   365→      },\n   366→\n   367→      fieldArray(key: any) {\n   368→        const subPath = path ? `${path}.${String(key)}` : String(key)\n   369→        return createFormFieldArray(subPath) as any\n   370→      },\n   371→    }\n   372→\n   373→    // Store options for cache comparison\n   374→    ;(field as any)._options = options\n   375→    fieldsForPath.push(field)\n   376→\n   377→    return field\n   378→  }, [debouncedSendChanges, rerender])\n   379→\n   380→  const createFormFieldArray = useCallback(<V,>(path: string): ReactFormFieldArray<V> => {\n   381→    const cache = fieldArrayCacheRef.current\n   382→    if (cache.has(path)) {\n   383→      return cache.get(path) as ReactFormFieldArray<V>\n   384→    }\n   385→\n   386→    const baseField = createFormField<V[]>(path)\n   387→    const keys = parsePath(path)\n   388→\n   389→    const updateArray = (newArray: V[]) => {\n   390→      setValueByPath(currentValuesRef.current, keys, newArray)\n   391→      debouncedSendChanges()\n   392→      rerender()\n   393→      return Promise.resolve()\n   394→    }\n   395→\n   396→    const fieldArray: ReactFormFieldArray<V> = {\n   397→      get value() { return baseField.value },\n   398→      get errors() { return baseField.errors },\n   399→      get errorMessage() { return baseField.errorMessage },\n   400→      get isValid() { return baseField.isValid },\n   401→      get isDirty() { return baseField.isDirty },\n   402→      get isTouched() { return baseField.isTouched },\n   403→      setValue: baseField.setValue,\n   404→      blur: baseField.blur,\n   405→      get inputProps() { return baseField.inputProps },\n   406→\n   407→      add(item?: Partial<V>) {\n   408→        const currentArray = baseField.value || []\n   409→        return updateArray([...currentArray, item as V])\n   410→      },\n   411→\n   412→      remove(index: number) {\n   413→        const currentArray = baseField.value || []\n   414→        return updateArray(currentArray.filter((_: any, i: number) => i !== index))\n   415→      },\n   416→\n   417→      move(from: number, to: number) {\n   418→        const currentArray = [...(baseField.value || [])]\n   419→        if (from >= 0 && from < currentArray.length && to >= 0 && to < currentArray.length) {\n   420→          const item = currentArray.splice(from, 1)[0]\n   421→          currentArray.splice(to, 0, item)\n   422→          return updateArray(currentArray)\n   423→        }\n   424→        return Promise.resolve()\n   425→      },\n   426→\n   427→      get fields(): ReactFormField<V>[] {\n   428→        const array = baseField.value || []\n   429→        return array.map((_: any, index: number) => createFormField<V>(`${path}[${index}]`))\n   430→      },\n   431→\n   432→      field(pathOrIndex: any, options?: FieldOptions) {\n   433→        if (typeof pathOrIndex === \"number\") {\n   434→          return createFormField(`${path}[${pathOrIndex}]`, options)\n   435→        }\n   436→        return createFormField(`${path}${pathOrIndex}`, options)\n   437→      },\n   438→\n   439→      fieldArray(pathOrIndex: any) {\n   440→        if (typeof pathOrIndex === \"number\") {\n   441→          return createFormFieldArray(`${path}[${pathOrIndex}]`)\n   442→        }\n   443→        return createFormFieldArray(`${path}${pathOrIndex}`)\n   444→      },\n   445→    }\n   446→\n   447→    cache.set(path, fieldArray)\n   448→    return fieldArray\n   449→  }, [createFormField, debouncedSendChanges, rerender])\n   450→\n   451→  // ─── Form actions ───\n   452→\n   453→  const submit = useCallback(async () => {\n   454→    submitCountRef.current += 1\n   455→    rerender()\n   456→\n   457→    if (live) {\n   458→      const data = prepareData(deepClone(currentValuesRef.current))\n   459→\n   460→      return await new Promise<any>(resolve => {\n   461→        live!.pushEvent(submitEvent, { [form.name]: data }, (result: any) => {\n   462→          if (result && result.reset) {\n   463→            setTimeout(() => {\n   464→              Object.assign(initialValuesRef.current, deepClone(currentValuesRef.current))\n   465→              // Reset form state\n   466→              Object.assign(currentValuesRef.current, deepClone(initialValuesRef.current))\n   467→              touchedFieldsRef.current.clear()\n   468→              submitCountRef.current = 0\n   469→              rerender()\n   470→            }, 0)\n   471→          }\n   472→          resolve(result)\n   473→        })\n   474→      })\n   475→    } else {\n   476→      console.warn(\"LiveView hook not available, form submission skipped\")\n   477→      return Promise.resolve(undefined)\n   478→    }\n   479→  }, [live, submitEvent, form.name, prepareData, rerender])\n   480→\n   481→  const reset = useCallback(() => {\n   482→    Object.assign(currentValuesRef.current, deepClone(initialValuesRef.current))\n   483→    touchedFieldsRef.current.clear()\n   484→    submitCountRef.current = 0\n   485→    rerender()\n   486→  }, [rerender])\n   487→\n   488→  // ─── Build return value ───\n   489→\n   490→  const formInstance: UseLiveFormReactReturn<T> = {\n   491→    get isValid() { return !hasAnyErrors(currentErrorsRef.current) },\n   492→    get isDirty() { return JSON.stringify(currentValuesRef.current) !== JSON.stringify(initialValuesRef.current) },\n   493→    get isTouched() { return submitCountRef.current > 0 || touchedFieldsRef.current.size > 0 },\n   494→    get isValidating() { return isValidatingRef.current },\n   495→    get submitCount() { return submitCountRef.current },\n   496→    get initialValues() { return initialValuesRef.current as Readonly<T> },\n   497→\n   498→    field(path: string, options?: FieldOptions) {\n   499→      return createFormField(path, options)\n   500→    },\n   501→\n   502→    fieldArray(path: string) {\n   503→      return createFormFieldArray(path)\n   504→    },\n   505→\n   506→    submit,\n   507→    reset,\n   508→  }\n   509→\n   510→  return formInstance\n   511→}\n   512→\n   513→// ─── Child-component hooks ───\n   514→\n   515→export function useField<T = any>(path: string, options?: FieldOptions): ReactFormField<T> {\n   516→  const form = useContext(LiveFormContext)\n   517→  if (!form) {\n   518→    throw new Error(\n   519→      \"useField() can only be used inside components where a LiveFormContext.Provider is rendered. \" +\n   520→        \"Make sure to use useLiveForm() in a parent component and wrap children with LiveFormContext.Provider.\"\n   521→    )\n   522→  }\n   523→  return form.field(path, options) as ReactFormField<T>\n   524→}\n   525→\n   526→export function useArrayField<T = any>(path: string): ReactFormFieldArray<T> {\n   527→  const form = useContext(LiveFormContext)\n   528→  if (!form) {\n   529→    throw new Error(\n   530→      \"useArrayField() can only be used inside components where a LiveFormContext.Provider is rendered. \" +\n   531→        \"Make sure to use useLiveForm() in a parent component and wrap children with LiveFormContext.Provider.\"\n   532→    )\n   533→  }\n   534→  return form.fieldArray(path) as ReactFormFieldArray<T>\n   535→}\n   536→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ca373184-55de-43ea-b9dc-c45b48d70f8a","uuid":"085c4a1c-0979-405f-84a3-bba01fae575b","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/useLiveFormReact.ts","content":"import {\n  createContext,\n  useCallback,\n  useContext,\n  useEffect,\n  useMemo,\n  useRef,\n  useState,\n} from \"react\"\nimport { useLive } from \"./useReact.js\"\nimport {\n  parsePath,\n  getValueByPath,\n  setValueByPath,\n  sanitizeId,\n} from \"./utils.js\"\nimport type { Form, FormErrors, FormOptions, FieldOptions } from \"./useLiveForm.js\"\n\n// Deep clone utility (framework-agnostic)\nfunction deepClone<T>(obj: T): T {\n  if (typeof structuredClone === \"function\") {\n    return structuredClone(obj)\n  }\n  return JSON.parse(JSON.stringify(obj))\n}\n\n// Deep equality comparison\nfunction deepEqual(a: any, b: any): boolean {\n  if (a === b) return true\n  if (a == null || b == null) return false\n  if (typeof a !== \"object\" || typeof b !== \"object\") return false\n\n  const keysA = Object.keys(a).sort()\n  const keysB = Object.keys(b).sort()\n\n  if (keysA.length !== keysB.length) return false\n\n  for (let i = 0; i < keysA.length; i++) {\n    if (keysA[i] !== keysB[i]) return false\n    if (!deepEqual(a[keysA[i]], b[keysB[i]])) return false\n  }\n\n  return true\n}\n\n// Replace object contents in-place (for mutable state updates)\nfunction replaceObject(target: any, source: any) {\n  for (const key in target) {\n    if (!(key in source)) {\n      delete target[key]\n    }\n  }\n  for (const key in source) {\n    if (typeof source[key] === \"object\" && source[key] !== null && !Array.isArray(source[key])) {\n      if (!target[key] || typeof target[key] !== \"object\" || Array.isArray(target[key])) {\n        target[key] = {}\n      }\n      replaceObject(target[key], source[key])\n    } else {\n      target[key] = source[key]\n    }\n  }\n}\n\n// Helper to check if any errors exist in nested error structure\nfunction hasAnyErrors(errors: any): boolean {\n  if (Array.isArray(errors)) {\n    if (errors.length === 0) return false\n    if (typeof errors[0] === \"string\") return errors.length > 0\n    return errors.some((item: any) => hasAnyErrors(item))\n  }\n  if (typeof errors === \"object\" && errors !== null) {\n    return Object.values(errors).some((value: any) => hasAnyErrors(value))\n  }\n  return false\n}\n\n// ─── React FormField interface (mirrors Vue but without Refs) ───\n\nexport interface ReactFormField<T> {\n  value: T\n  errors: string[]\n  errorMessage: string | undefined\n  isValid: boolean\n  isDirty: boolean\n  isTouched: boolean\n  setValue: (newValue: T) => void\n  blur: () => void\n\n  inputProps: {\n    value: any\n    onChange: (event: any) => void\n    onBlur: () => void\n    name: string\n    id: string\n    type?: string\n    checked?: boolean\n    \"aria-invalid\": boolean\n    \"aria-describedby\"?: string\n  }\n\n  field<K extends keyof T>(\n    key: K,\n    options?: FieldOptions\n  ): T[K] extends readonly (infer U)[] ? ReactFormFieldArray<U> : ReactFormField<T[K]>\n\n  fieldArray<K extends keyof T>(\n    key: K\n  ): T[K] extends readonly (infer U)[] ? ReactFormFieldArray<U> : never\n}\n\nexport interface ReactFormFieldArray<T> extends Omit<ReactFormField<T[]>, \"field\" | \"fieldArray\"> {\n  add: (item?: Partial<T>) => Promise<any>\n  remove: (index: number) => Promise<any>\n  move: (from: number, to: number) => Promise<any>\n  fields: ReactFormField<T>[]\n\n  field: <P extends string | number>(path: P, options?: FieldOptions) => ReactFormField<any>\n  fieldArray: <P extends string | number>(path: P) => ReactFormFieldArray<any>\n}\n\nexport interface UseLiveFormReactReturn<T extends object> {\n  isValid: boolean\n  isDirty: boolean\n  isTouched: boolean\n  isValidating: boolean\n  submitCount: number\n  initialValues: Readonly<T>\n\n  field<P extends string>(path: P, options?: FieldOptions): ReactFormField<any>\n  fieldArray<P extends string>(path: P): ReactFormFieldArray<any>\n\n  submit: () => Promise<any>\n  reset: () => void\n}\n\n// ─── React Context for form injection into children ───\n\nexport const LiveFormContext = createContext<{\n  field: (path: string, options?: FieldOptions) => ReactFormField<any>\n  fieldArray: (path: string) => ReactFormFieldArray<any>\n} | null>(null)\n\n// ─── Main hook