{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HzubgUitPuJDXFXoHH2Fkv","type":"tool_result","content":"     1→import {\n     2→  ref,\n     3→  reactive,\n     4→  computed,\n     5→  toValue,\n     6→  watch,\n     7→  onScopeDispose,\n     8→  nextTick,\n     9→  provide,\n    10→  inject,\n    11→  type Ref,\n    12→  type MaybeRefOrGetter,\n    13→  type InjectionKey,\n    14→  readonly,\n    15→  type ComputedRef,\n    16→} from \"vue\"\n    17→import { useLiveVite } from \"./use\"\n    18→import {\n    19→  parsePath,\n    20→  getValueByPath,\n    21→  setValueByPath,\n    22→  deepClone,\n    23→  debounce,\n    24→  replaceReactiveObject,\n    25→  deepToRaw,\n    26→  deepEqual,\n    27→  sanitizeId,\n    28→} from \"./utils\"\n    29→\n    30→// Injection key for providing form instances to child components\n    31→export const LIVE_FORM_INJECTION_KEY = Symbol(\"LiveForm\") as InjectionKey<{\n    32→  field: (path: string, options?: FieldOptions) => FormField<any>\n    33→  fieldArray: (path: string) => FormFieldArray<any>\n    34→}>\n    35→\n    36→/**\n    37→ * Maps form field structure to a corresponding structure for validation errors\n    38→ * For each field in the original form, creates an array of error strings\n    39→ */\n    40→export type FormErrors<T extends object> = {\n    41→  [K in keyof T]?: T[K] extends object ? FormErrors<T[K]> : string[]\n    42→}\n    43→\n    44→/**\n    45→ * Base form interface representing the data coming from the server\n    46→ * @template T - The type of form values\n    47→ */\n    48→export interface Form<T extends object> {\n    49→  /** Unique identifier for the form */\n    50→  name: string\n    51→  /** Form field values */\n    52→  values: T\n    53→  /** Validation errors for form fields */\n    54→  errors: FormErrors<T>\n    55→  /** Whether the form is valid */\n    56→  valid: boolean\n    57→}\n    58→\n    59→// TypeScript utility types for path safety\n    60→type PathsToStringProps<T> = T extends string | number | boolean | Date\n    61→  ? never\n    62→  : T extends readonly (infer U)[]\n    63→  ? U extends object\n    64→    ? `[${number}]` | `[${number}].${PathsToStringProps<U>}`\n    65→    : `[${number}]`\n    66→  : T extends object\n    67→  ? {\n    68→      [K in keyof T]: K extends string | number\n    69→        ? T[K] extends readonly (infer U)[]\n    70→          ? U extends object\n    71→            ? `${K}` | `${K}[${number}]` | `${K}[${number}].${PathsToStringProps<U>}`\n    72→            : `${K}` | `${K}[${number}]`\n    73→          : T[K] extends object\n    74→          ? `${K}` | `${K}.${PathsToStringProps<T[K]>}`\n    75→          : `${K}`\n    76→        : never\n    77→    }[keyof T]\n    78→  : never\n    79→\n    80→// Get type at path\n    81→type PathValue<T, P extends string> = P extends `${infer Key}[${infer Index}].${infer Rest}`\n    82→  ? Key extends keyof T\n    83→    ? T[Key] extends readonly (infer U)[]\n    84→      ? PathValue<U, Rest>\n    85→      : never\n    86→    : never\n    87→  : P extends `${infer Key}[${infer Index}]`\n    88→  ? Key extends keyof T\n    89→    ? T[Key] extends readonly (infer U)[]\n    90→      ? U\n    91→      : never\n    92→    : never\n    93→  : P extends `${infer Key}.${infer Rest}`\n    94→  ? Key extends keyof T\n    95→    ? PathValue<T[Key], Rest>\n    96→    : never\n    97→  : P extends `[${infer Index}]`\n    98→  ? T extends readonly (infer U)[]\n    99→    ? U\n   100→    : never\n   101→  : P extends keyof T\n   102→  ? T[P]\n   103→  : never\n   104→\n   105→// Helper type to resolve array field types from relative paths\n   106→type ArrayFieldPath<T, P extends string | number> = P extends number\n   107→  ? FormField<T>\n   108→  : P extends `[${number}]`\n   109→  ? FormField<T>\n   110→  : P extends `[${number}].${infer Rest}`\n   111→  ? PathValue<T, Rest> extends readonly (infer U)[]\n   112→    ? FormFieldArray<U>\n   113→    : FormField<PathValue<T, Rest>>\n   114→  : P extends keyof T\n   115→  ? T[P] extends readonly (infer U)[]\n   116→    ? FormFieldArray<U>\n   117→    : FormField<T[P]>\n   118→  : FormField<any>\n   119→\n   120→// Helper type for array field array paths\n   121→type ArrayFieldArrayPath<T, P extends string | number> = P extends number\n   122→  ? never\n   123→  : P extends `[${number}]`\n   124→  ? never\n   125→  : P extends `[${number}].${infer Rest}`\n   126→  ? PathValue<T, Rest> extends readonly (infer U)[]\n   127→    ? FormFieldArray<U>\n   128→    : never\n   129→  : P extends keyof T\n   130→  ? T[P] extends readonly (infer U)[]\n   131→    ? FormFieldArray<U>\n   132→    : never\n   133→  : never\n   134→\n   135→export interface FieldOptions {\n   136→  /** HTML input type - supports any valid input type */\n   137→  type?: string\n   138→  /** For checkbox/radio: the value this input represents when selected */\n   139→  value?: any\n   140→}\n   141→\n   142→export interface FormOptions {\n   143→  /** Event name to send to the server when form values change. Set to null to disable validation events */\n   144→  changeEvent?: string | null\n   145→  /** Event name to send to the server when form is submitted */\n   146→  submitEvent?: string\n   147→  /** Delay in milliseconds before sending change events to reduce server load */\n   148→  debounceInMiliseconds?: number\n   149→  /** Function to transform form data before sending to server */\n   150→  prepareData?: (data: any) => any\n   151→}\n   152→\n   153→export interface FormField<T> {\n   154→  // Reactive state (using reactive + toRefs for clean syntax)\n   155→  value: Ref<T> // field.value instead of field.value.value\n   156→  errors: Readonly<Ref<string[]>> // Read-only, from backend\n   157→  errorMessage: Readonly<Ref<string | undefined>> // First error, read-only\n   158→  isValid: Ref<boolean>\n   159→  isDirty: Ref<boolean>\n   160→  isTouched: Ref<boolean>\n   161→\n   162→  // Input