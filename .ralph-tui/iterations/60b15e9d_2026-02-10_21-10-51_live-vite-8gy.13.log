{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DxqmkMimCkmkaPbjGrnF5v","type":"tool_result","content":"     1→import { createContext, useCallback, useContext, useEffect, useRef } from \"react\"\n     2→import type { HookInterface } from \"./phoenixFallbackTypes.js\"\n     3→\n     4→/**\n     5→ * React context for the LiveView hook instance.\n     6→ * Used by the React renderer to provide the hook to descendant components.\n     7→ */\n     8→export const LiveContext = createContext<HookInterface | null>(null)\n     9→\n    10→/**\n    11→ * Returns the LiveView hook instance.\n    12→ * Can be used to access pushEvent, handleEvent, the DOM element, and liveSocket\n    13→ * from within a LiveVite React component.\n    14→ *\n    15→ * Mirrors the Vue `useLiveVite()` composable.\n    16→ */\n    17→export function useLive(): HookInterface {\n    18→  const live = useContext(LiveContext)\n    19→  if (!live) throw new Error(\"LiveContext not provided. Are you using this inside a LiveVite component?\")\n    20→  return live\n    21→}\n    22→\n    23→/**\n    24→ * Subscribes to a server-sent event and automatically cleans up on unmount.\n    25→ * Mirrors the Vue `useLiveEvent()` composable.\n    26→ *\n    27→ * @param event - The event name to listen for.\n    28→ * @param callback - The callback invoked with the event payload.\n    29→ */\n    30→export function useLiveEvent<T>(event: string, callback: (data: T) => void): void {\n    31→  const live = useLive()\n    32→  // Use a ref so the effect doesn't re-run when the callback identity changes\n    33→  const callbackRef = useRef(callback)\n    34→  callbackRef.current = callback\n    35→\n    36→  useEffect(() => {\n    37→    const ref = live.handleEvent(event, (payload: T) => {\n    38→      callbackRef.current(payload)\n    39→    })\n    40→    return () => {\n    41→      live.removeHandleEvent(ref)\n    42→    }\n    43→  }, [live, event])\n    44→}\n    45→\n    46→/**\n    47→ * Provides `patch()` and `navigate()` helpers for LiveView navigation.\n    48→ * Mirrors the Vue `useLiveNavigation()` composable.\n    49→ *\n    50→ * - `patch(href | queryParams, opts?)` – updates the current LiveView URL\n    51→ *   (equivalent to `live_patch`).\n    52→ * - `navigate(href, opts?)` – performs a full LiveView redirect\n    53→ *   (equivalent to `live_redirect`).\n    54→ *\n    55→ * @returns An object with `patch` and `navigate` functions.\n    56→ */\n    57→export function useLiveNavigation() {\n    58→  const live = useLive()\n    59→  const liveSocket = live.liveSocket\n    60→  if (!liveSocket) throw new Error(\"LiveSocket not initialized\")\n    61→\n    62→  const patch = useCallback(\n    63→    (hrefOrQueryParams: string | Record<string, string>, opts: { replace?: boolean } = {}) => {\n    64→      let href = typeof hrefOrQueryParams === \"string\" ? hrefOrQueryParams : window.location.pathname\n    65→      if (typeof hrefOrQueryParams === \"object\") {\n    66→        const queryParams = new URLSearchParams(hrefOrQueryParams)\n    67→        href = `${href}?${queryParams.toString()}`\n    68→      }\n    69→      liveSocket.pushHistoryPatch(new Event(\"click\"), href, opts.replace ? \"replace\" : \"push\", null)\n    70→    },\n    71→    [liveSocket],\n    72→  )\n    73→\n    74→  const navigate = useCallback(\n    75→    (href: string, opts: { replace?: boolean } = {}) => {\n    76→      liveSocket.historyRedirect(new Event(\"click\"), href, opts.replace ? \"replace\" : \"push\", null, null)\n    77→    },\n    78→    [liveSocket],\n    79→  )\n    80→\n    81→  return { patch, navigate }\n    82→}\n    83→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ca373184-55de-43ea-b9dc-c45b48d70f8a","uuid":"97ef7c84-4c01-477e-8d95-1c91c390cc33","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/useReact.ts","content":"import { createContext, useCallback, useContext, useEffect, useRef } from \"react\"\nimport type { HookInterface } from \"./phoenixFallbackTypes.js\"\n\n/**\n * React context for the LiveView hook instance.\n * Used by the React renderer to provide the hook to descendant components.\n */\nexport const LiveContext = createContext<HookInterface | null>(null)\n\n/**\n * Returns the LiveView hook instance.\n * Can be used to access pushEvent, handleEvent, the DOM element, and liveSocket\n * from within a LiveVite React component.\n *\n * Mirrors the Vue `useLiveVite()` composable.\n */\nexport function useLive(): HookInterface {\n  const live = useContext(LiveContext)\n  if (!live) throw new Error(\"LiveContext not provided. Are you using this inside a LiveVite component?\")\n  return live\n}\n\n/**\n * Subscribes to a server-sent event and automatically cleans up on unmount.\n * Mirrors the Vue `useLiveEvent()` composable.\n *\n * @param event - The event name to listen for.\n * @param callback - The callback invoked with the event payload.\n */\nexport function useLiveEvent<T>(event: string, callback: (data: T) => void): void {\n  const live = useLive()\n  // Use a ref so the effect doesn't re-run when the callback identity changes\n  const callbackRef = useRef(callback)\n  callbackRef.current = callback\n\n  useEffect(() => {\n    const ref = live.handleEvent(event, (payload: T) => {\n      callbackRef.current(payload)\n    })\n    return () => {\n      live.removeHandleEvent(ref)\n    }\n  }, [live, event])\n}\n\n/**\n * Provides `patch()` and `navigate()` helpers for LiveView navigation.\n * Mirrors the Vue `useLiveNavigation()` composable.\n *\n * - `patch(href | queryParams, opts?)` – updates the current LiveView URL\n *   (equivalent to `live_patch`).\n * - `navigate(href, opts?)` – performs a full LiveView redirect\n *   (equivalent to `live_redirect`).\n *\n * @returns An object with `patch` and `navigate` functions.\n */\nexport function useLiveNavigation() {\n  const live = useLive()\n  const liveSocket = live.liveSocket\n  if (!liveSocket) throw new Error(\"LiveSocket not initialized\")\n\n  const patch = useCallback(\n    (hrefOrQueryParams: string | Record<string, string>, opts: { replace?: boolean } = {}) => {\n      let href = typeof hrefOrQueryParams === \"string\" ? hrefOrQueryParams : window.location.pathname\n      if (typeof hrefOrQueryParams === \"object\") {\n        const queryParams = new URLSearchParams(hrefOrQueryParams)\n        href = `${href}?${queryParams.toString()}`\n      }\n      liveSocket.pushHistoryPatch(new Event(\"click\"), href, opts.replace ? \"replace\" : \"push\", null)\n    },\n    [liveSocket],\n  )\n\n  const navigate = useCallback(\n    (href: string, opts: { replace?: boolean } = {}) => {\n      liveSocket.historyRedirect(new Event(\"click\"), href, opts.replace ? \"replace\" : \"push\", null, null)\n    },\n    [liveSocket],\n  )\n\n  return { patch, navigate }\n}\n","numLines":83,"startLine":1,"totalLines":83}}}
