{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X2hDokzvXtqfDRMmLiqe16","type":"tool_result","content":"     1→import { describe, it, expect, beforeEach, vi } from \"vitest\"\n     2→import { ref, nextTick, effectScope } from \"vue\"\n     3→\n     4→// Mock useLiveVite to prevent injection errors\n     5→vi.mock(\"./use\", () => ({\n     6→  useLiveVite: vi.fn(),\n     7→}))\n     8→\n     9→// Mock provide() to prevent warnings in tests\n    10→vi.mock(\"vue\", async () => {\n    11→  const actual = await vi.importActual(\"vue\")\n    12→  return {\n    13→    ...actual,\n    14→    provide: vi.fn(), // Mock provide to do nothing in tests\n    15→  }\n    16→})\n    17→\n    18→import { useLiveForm, type Form, type FormErrors } from \"./useLiveForm\"\n    19→import { useLiveVite } from \"./use\"\n    20→\n    21→const mockUseLiveVite = useLiveVite as any\n    22→let mockLiveVite: any\n    23→\n    24→// Helper to create forms within effect scope to avoid onScopeDispose warnings\n    25→function createFormInScope<T extends object>(formRef: any, options?: any) {\n    26→  let form: any\n    27→  const scope = effectScope()\n    28→  scope.run(() => {\n    29→    form = useLiveForm(formRef, options)\n    30→  })\n    31→  return form\n    32→}\n    33→\n    34→interface TestForm {\n    35→  name: string\n    36→  email: string\n    37→  age: number\n    38→  profile: {\n    39→    bio: string\n    40→    skills: string[]\n    41→  }\n    42→  items: Array<{\n    43→    name: string\n    44→    tags: string[]\n    45→  }>\n    46→  // Additional fields for checkbox tests\n    47→  acceptTerms?: boolean\n    48→  plan?: string | boolean | null\n    49→  preferences?: string[]\n    50→}\n    51→\n    52→// Simple function to create a valid form ref\n    53→function createFormRef(overrides: Partial<Form<TestForm>> = {}) {\n    54→  const baseForm: Form<TestForm> = {\n    55→    name: \"test_form\",\n    56→    values: {\n    57→      name: \"John Doe\",\n    58→      email: \"john@example.com\",\n    59→      age: 30,\n    60→      profile: {\n    61→        bio: \"Software developer\",\n    62→        skills: [\"JavaScript\", \"TypeScript\"],\n    63→      },\n    64→      items: [\n    65→        { name: \"Item 1\", tags: [\"tag1\", \"tag2\"] },\n    66→        { name: \"Item 2\", tags: [\"tag3\"] },\n    67→      ],\n    68→    },\n    69→    errors: {} as FormErrors<TestForm>, // Empty object when no errors, like in Phoenix\n    70→    valid: true,\n    71→  }\n    72→\n    73→  return ref({ ...baseForm, ...overrides, errors: (overrides.errors || {}) as FormErrors<TestForm> })\n    74→}\n    75→\n    76→// Function to create form with errors\n    77→function createFormWithErrors() {\n    78→  return createFormRef({\n    79→    errors: {\n    80→      name: [\"Name is required\"],\n    81→      email: [\"Invalid email format\"],\n    82→      age: [],\n    83→      profile: {\n    84→        bio: [\"Bio is too short\"],\n    85→        skills: [],\n    86→      },\n    87→      items: [\n    88→        { name: [\"Item name required\"], tags: [] },\n    89→        { name: [], tags: [] },\n    90→      ],\n    91→    },\n    92→  })\n    93→}\n    94→\n    95→describe(\"useLiveForm - Integration Tests\", () => {\n    96→  beforeEach(() => {\n    97→    // Setup fresh mock LiveVite instance for each test\n    98→    mockLiveVite = {\n    99→      pushEvent: vi.fn().mockImplementation((_event: any, _payload: any, callback: any) => {\n   100→        // Simulate async callback behavior with successful reset response\n   101→        if (callback) {\n   102→          setTimeout(() => callback({ reset: true }), 0)\n   103→        }\n   104→        return Promise.resolve({ reset: true })\n   105→      }),\n   106→    }\n   107→    mockUseLiveVite.mockReturnValue(mockLiveVite)\n   108→  })\n   109→\n   110→  describe(\"basic form initialization\", () => {\n   111→    it(\"should initialize form with proper state\", () => {\n   112→      const formRef = createFormRef()\n   113→      const form = createFormInScope(formRef)\n   114→\n   115→      expect(form.initialValues).toEqual(formRef.value.values)\n   116→      expect(form.isValid.value).toBe(true)\n   117→      expect(form.isDirty.value).toBe(false)\n   118→      expect(form.isTouched.value).toBe(false)\n   119→    })\n   120→\n   121→    it(\"should create deep copy of initial values\", () => {\n   122→      const formRef = createFormRef()\n   123→      const form = createFormInScope(formRef)\n   124→\n   125→      // Modify the original\n   126→      formRef.value.values.name = \"Modified\"\n   127→\n   128→      // Form should still have original value\n   129→      expect(form.initialValues.name).toBe(\"John Doe\")\n   130→    })\n   131→  })\n   132→\n   133→  describe(\"field creation and path resolution\", () => {\n   134→    it(\"should create field for simple property\", () => {\n   135→      const formRef = createFormRef()\n   136→      const form = createFormInScope(formRef)\n   137→      const nameField = form.field(\"name\")\n   138→\n   139→      expect(nameField.value.value).toBe(\"John Doe\")\n   140→      expect(nameField.errors.value).toEqual([])\n   141→      expect(nameField.errorMessage.value).toBeUndefined()\n   142→      expect(nameField.isValid.value).toBe(true)\n   143→      expect(nameField.isDirty.value).toBe(false)\n   144→      expect(nameField.isTouched.value).toBe(false)\n   145→    })\n   146→\n   147→    it(\"should create field for nested property\", () => {\n   148→      const formRef = createFormRef()\n   149→      const form = createFormInScope(formRef)\n   150→      const bioField = form.field(\"profile.bio\")\n   151→\n   152→      expect(bioField.value.value).toBe(\"Software developer\")\n   153→      expect(bioField.isValid.value).toBe(true)\n   154→    })\n   155→\n   156→    it(\"should create field for array element\", () => {\n   157→      const formRef = createFormRef()\n   158→      const form = createFormInScope(formRef)\n   159→      const itemNameField = form.field(\"items[0].name\")\n   160→\n   161→      expect(itemNameField.value.value).toBe(\"Item 1\")\n   162→      expect(itemNameField.isValid.value).toBe(true)\n   163→    })\n   164→\n   165→    it(\"should create field for nested array element\", () => {\n   166→      const formRef = createFormRef()\n   167→      const form = createFormInScope(formRef)\n   168→      const tagField = form.field(\"items[0].tags[0]\")\n   169→\n   170→      expect(tagField.value.value).toBe(\"tag1\")\n   171→    })\n   172→  })\n   173→\n   174→  describe(\"field value updates\", () => {\n   175→    it(\"should update field value reactively\", async () => {\n   176→      const formRef = createFormRef()\n   177→      const form = createFormInScope(formRef)\n   178→      const nameField = form.field(\"name\")\n   179→\n   180→      nameField.value.value = \"Jane Doe\"\n   181→      await nextTick()\n   182→\n   183→      expect(nameField.value.value).toBe(\"Jane Doe\")\n   184→    })\n   185→\n   186→    it(\"should update nested field value reactively\", async () => {\n   187→      const formRef = createFormRef()\n   188→      const form = createFormInScope(formRef)\n   189→      const bioField = form.field(\"profile.bio\")\n   190→\n   191→      bioField.value.value = \"Updated bio\"\n   192→      await nextTick()\n   193→\n   194→      expect(bioField.value.value).toBe(\"Updated bio\")\n   195→    })\n   196→\n   197→    it(\"should update array element reactively\", async () => {\n   198→      const formRef = createFormRef()\n   199→      const form = createFormInScope(formRef)\n   200→      const itemNameField = form.field(\"items[0].name\")\n   201→\n   202→      itemNameField.value.value = \"Updated Item\"\n   203→      await nextTick()\n   204→\n   205→      expect(itemNameField.value.value).toBe(\"Updated Item\")\n   206→    })\n   207→  })\n   208→\n   209→  describe(\"sub-field creation (fluent interface)\", () => {\n   210→    it(\"should create sub-field from object field\", () => {\n   211→      const formRef = createFormRef()\n   212→      const form = createFormInScope(formRef)\n   213→      const profileField = form.field(\"profile\")\n   214→      const bioField = profileField.field(\"bio\")\n   215→\n   216→      expect(bioField.value.value).toBe(\"Software developer\")\n   217→    })\n   218→\n   219→    it(\"should create sub-field from array field\", () => {\n   220→      const formRef = createFormRef()\n   221→      const form = createFormInScope(formRef)\n   222→      const itemsArray = form.fieldArray(\"items\")\n   223→      // Use field(index) to access array item\n   224→      const firstItemField = itemsArray.field(0)\n   225→      const nameField = firstItemField.field(\"name\")\n   226→\n   227→      expect(nameField.value.value).toBe(\"Item 1\")\n   228→    })\n   229→  })\n   230→\n   231→  describe(\"field state tracking\", () => {\n   232→    it(\"should track touched state when blur is called\", async () => {\n   233→      const formRef = createFormRef()\n   234→      const form = createFormInScope(formRef)\n   235→      const nameField = form.field(\"name\")\n   236→\n   237→      expect(nameField.isTouched.value).toBe(false)\n   238→      expect(form.isTouched.value).toBe(false)\n   239→\n   240→      // Blur should set touched\n   241→      nameField.blur()\n   242→      await nextTick()\n   243→      expect(nameField.isTouched.value).toBe(true)\n   244→      expect(form.isTouched.value).toBe(true)\n   245→    })\n   246→\n   247→    it(\"should track dirty state when value changes\", async () => {\n   248→      const formRef = createFormRef()\n   249→      const form = createFormInScope(formRef)\n   250→      const nameField = form.field(\"name\")\n   251→\n   252→      expect(nameField.isDirty.value).toBe(false)\n   253→\n   254→      nameField.value.value = \"Jane Doe\"\n   255→      await nextTick()\n   256→\n   257→      expect(nameField.isDirty.value).toBe(true)\n   258→    })\n   259→\n   260→    it(\"should not be dirty when value is same as initial\", async () => {\n   261→      const formRef = createFormRef()\n   262→      const form = createFormInScope(formRef)\n   263→      const nameField = form.field(\"name\")\n   264→\n   265→      nameField.value.value = \"Jane Doe\"\n   266→      await nextTick()\n   267→      expect(nameField.isDirty.value).toBe(true)\n   268→\n   269→      nameField.value.value = \"John Doe\" // Back to original\n   270→      await nextTick()\n   271→      expect(nameField.isDirty.value).toBe(false)\n   272→    })\n   273→  })\n   274→\n   275→  describe(\"form reset\", () => {\n   276→    it(\"should reset all values to initial state\", async () => {\n   277→      const formRef = createFormRef()\n   278→      const form = createFormInScope(formRef)\n   279→      const nameField = form.field(\"name\")\n   280→      const bioField = form.field(\"profile.bio\")\n   281→\n   282→      // Make changes\n   283→      nameField.value.value = \"Jane Doe\"\n   284→      bioField.value.value = \"Updated bio\"\n   285→      nameField.blur()\n   286→\n   287→      await nextTick()\n   288→\n   289→      expect(nameField.value.value).toBe(\"Jane Doe\")\n   290→      expect(bioField.value.value).toBe(\"Updated bio\")\n   291→      expect(nameField.isTouched.value).toBe(true)\n   292→\n   293→      // Reset\n   294→      form.reset()\n   295→      await nextTick()\n   296→\n   297→      expect(nameField.value.value).toBe(\"John Doe\")\n   298→      expect(bioField.value.value).toBe(\"Software developer\")\n   299→      expect(nameField.isTouched.value).toBe(false)\n   300→      expect(form.isTouched.value).toBe(false)\n   301→    })\n   302→  })\n   303→\n   304→  describe(\"validation and error handling\", () => {\n   305→    it(\"should reflect validation errors from server\", () => {\n   306→      const formRef = createFormWithErrors()\n   307→      const form = createFormInScope(formRef)\n   308→\n   309→      expect(form.isValid.value).toBe(false)\n   310→\n   311→      const nameField = form.field(\"name\")\n   312→      expect(nameField.errors.value).toEqual([\"Name is required\"])\n   313→      expect(nameField.errorMessage.value).toBe(\"Name is required\")\n   314→      expect(nameField.isValid.value).toBe(false)\n   315→\n   316→      const emailField = form.field(\"email\")\n   317→      expect(emailField.errors.value).toEqual([\"Invalid email format\"])\n   318→      expect(emailField.isValid.value).toBe(false)\n   319→\n   320→      const ageField = form.field(\"age\")\n   321→      expect(ageField.errors.value).toEqual([])\n   322→      expect(ageField.isValid.value).toBe(true)\n   323→\n   324→      const bioField = form.field(\"profile.bio\")\n   325→      expect(bioField.errors.value).toEqual([\"Bio is too short\"])\n   326→      expect(bioField.isValid.value).toBe(false)\n   327→\n   328→      const itemNameField = form.field(\"items[0].name\")\n   329→      expect(itemNameField.errors.value).toEqual([\"Item name required\"])\n   330→      expect(itemNameField.isValid.value).toBe(false)\n   331→    })\n   332→\n   333→    it(\"should handle multiple errors on single field\", () => {\n   334→      const formRef = createFormRef({\n   335→        errors: {\n   336→          name: [\"Name is required\", \"Name must be at least 2 characters\"],\n   337→        },\n   338→      })\n   339→\n   340→      const form = createFormInScope(formRef)\n   341→      const nameField = form.field(\"name\")\n   342→\n   343→      expect(nameField.errors.value).toEqual([\"Name is required\", \"Name must be at least 2 characters\"])\n   344→      expect(nameField.errorMessage.value).toBe(\"Name is required\") // First error\n   345→      expect(nameField.isValid.value).toBe(false)\n   346→    })\n   347→  })\n   348→\n   349→  describe(\"inputAttrs helper\", () => {\n   350→    it(\"should provide basic input attributes\", () => {\n   351→      const formRef = createFormRef()\n   352→      const form = createFormInScope(formRef)\n   353→      const nameField = form.field(\"name\")\n   354→\n   355→      const attrs = nameField.inputAttrs.value\n   356→\n   357→      expect(attrs.value).toBe(\"John Doe\")\n   358→      expect(attrs.name).toBe(\"name\")\n   359→      expect(attrs.id).toBe(\"name\")\n   360→      expect(attrs[\"aria-invalid\"]).toBe(false)\n   361→      expect(attrs[\"aria-describedby\"]).toBeUndefined()\n   362→      expect(typeof attrs.onBlur).toBe(\"function\")\n   363→      expect(typeof attrs.onInput).toBe(\"function\")\n   364→    })\n   365→\n   366→    it(\"should sanitize path for ID attribute\", () => {\n   367→      const formRef = createFormRef()\n   368→      const form = createFormInScope(formRef)\n   369→\n   370→      // Test nested property\n   371→      const bioField = form.field(\"profile.bio\")\n   372→      expect(bioField.inputAttrs.value.id).toBe(\"profile_bio\")\n   373→      expect(bioField.inputAttrs.value.name).toBe(\"profile.bio\")\n   374→\n   375→      // Test array element\n   376→      const itemNameField = form.field(\"items[0].name\")\n   377→      expect(itemNameField.inputAttrs.value.id).toBe(\"items_0_name\")\n   378→      expect(itemNameField.inputAttrs.value.name).toBe(\"items[0].name\")\n   379→\n   380→      // Test complex nested array\n   381→      const tagField = form.field(\"items[1].tags[0]\")\n   382→      expect(tagField.inputAttrs.value.id).toBe(\"items_1_tags_0\")\n   383→      expect(tagField.inputAttrs.value.name).toBe(\"items[1].tags[0]\")\n   384→    })\n   385→\n   386→    it(\"should handle modelValue updates\", async () => {\n   387→      const formRef = createFormRef()\n   388→      const form = createFormInScope(formRef)\n   389→      const nameField = form.field(\"name\")\n   390→\n   391→      const attrs = nameField.inputAttrs.value\n   392→\n   393→      // Test updating via onInput\n   394→      const mockEvent = { target: { value: \"New Name\" } } as unknown as Event\n   395→      attrs.onInput(mockEvent)\n   396→      await nextTick()\n   397→\n   398→      expect(nameField.value.value).toBe(\"New Name\")\n   399→      expect(nameField.inputAttrs.value.value).toBe(\"New Name\")\n   400→    })\n   401→\n   402→    it(\"should handle blur event\", async () => {\n   403→      const formRef = createFormRef()\n   404→      const form = createFormInScope(formRef)\n   405→      const nameField = form.field(\"name\")\n   406→\n   407→      const attrs = nameField.inputAttrs.value\n   408→\n   409→      expect(nameField.isTouched.value).toBe(false)\n   410→\n   411→      // Test blur\n   412→      attrs.onBlur()\n   413→      await nextTick()\n   414→      expect(nameField.isTouched.value).toBe(true) // Should be touched after blur\n   415→    })\n   416→\n   417→    it(\"should set aria-invalid when field has errors\", () => {\n   418→      const formRef = createFormWithErrors()\n   419→      const form = createFormInScope(formRef)\n   420→\n   421→      const nameField = form.field(\"name\")\n   422→      const emailField = form.field(\"email\")\n   423→      const ageField = form.field(\"age\")\n   424→\n   425→      expect(nameField.inputAttrs.value[\"aria-invalid\"]).toBe(true)\n   426→      expect(emailField.inputAttrs.value[\"aria-invalid\"]).toBe(true)\n   427→      expect(ageField.inputAttrs.value[\"aria-invalid\"]).toBe(false)\n   428→    })\n   429→\n   430→    it(\"should set aria-describedby when field has errors\", () => {\n   431→      const formRef = createFormWithErrors()\n   432→      const form = createFormInScope(formRef)\n   433→\n   434→      const nameField = form.field(\"name\")\n   435→      const ageField = form.field(\"age\")\n   436→\n   437→      expect(nameField.inputAttrs.value[\"aria-describedby\"]).toBe(\"name-error\")\n   438→      expect(ageField.inputAttrs.value[\"aria-describedby\"]).toBeUndefined()\n   439→\n   440→      // Test complex path\n   441→      const bioField = form.field(\"profile.bio\")\n   442→      expect(bioField.inputAttrs.value[\"aria-describedby\"]).toBe(\"profile_bio-error\")\n   443→    })\n   444→\n   445→    it(\"should reactively update aria attributes when errors change\", async () => {\n   446→      const formRef = createFormRef()\n   447→      const form = createFormInScope(formRef)\n   448→      const nameField = form.field(\"name\")\n   449→\n   450→      // Initially no errors\n   451→      expect(nameField.inputAttrs.value[\"aria-invalid\"]).toBe(false)\n   452→      expect(nameField.inputAttrs.value[\"aria-describedby\"]).toBeUndefined()\n   453→\n   454→      // Add errors via server update\n   455→      formRef.value = {\n   456→        ...formRef.value,\n   457→        errors: {\n   458→          name: [\"Name is required\"],\n   459→        } as unknown as FormErrors<TestForm>,\n   460→      }\n   461→\n   462→      await nextTick()\n   463→      // Wait a bit for any pending operations to complete\n   464→      await new Promise(resolve => setTimeout(resolve, 50))\n   465→\n   466→      expect(nameField.inputAttrs.value[\"aria-invalid\"]).toBe(true)\n   467→      expect(nameField.inputAttrs.value[\"aria-describedby\"]).toBe(\"name-error\")\n   468→\n   469→      // Note: Error clearing is tested in other tests that work with form.reset()\n   470→      // The scope-based approach here makes the reactive watcher behavior different\n   471→    })\n   472→\n   473→    it(\"should work with array fields\", () => {\n   474→      const formRef = createFormRef()\n   475→      const form = createFormInScope(formRef)\n   476→      const skillsArray = form.fieldArray(\"profile.skills\")\n   477→      const firstSkillField = skillsArray.field(0)\n   478→\n   479→      const attrs = firstSkillField.inputAttrs.value\n   480→\n   481→      expect(attrs.value).toBe(\"JavaScript\")\n   482→      expect(attrs.name).toBe(\"profile.skills[0]\")\n   483→      expect(attrs.id).toBe(\"profile_skills_0\")\n   484→      expect(attrs[\"aria-invalid\"]).toBe(false)\n   485→    })\n   486→\n   487→    it(\"should allow chaining with sub-fields\", () => {\n   488→      const formRef = createFormRef()\n   489→      const form = createFormInScope(formRef)\n   490→      const profileField = form.field(\"profile\")\n   491→      const bioField = profileField.field(\"bio\")\n   492→\n   493→      const attrs = bioField.inputAttrs.value\n   494→\n   495→      expect(attrs.value).toBe(\"Software developer\")\n   496→      expect(attrs.name).toBe(\"profile.bio\")\n   497→      expect(attrs.id).toBe(\"profile_bio\")\n   498→    })\n   499→  })\n   500→\n   501→  describe(\"form-level dirty tracking\", () => {\n   502→    it(\"should track form as dirty when any field changes\", async () => {\n   503→      const formRef = createFormRef()\n   504→      const form = createFormInScope(formRef)\n   505→\n   506→      expect(form.isDirty.value).toBe(false)\n   507→\n   508→      const nameField = form.field(\"name\")\n   509→      nameField.value.value = \"Jane Doe\"\n   510→      await nextTick()\n   511→\n   512→      expect(form.isDirty.value).toBe(true)\n   513→    })\n   514→\n   515→    it(\"should track form as dirty when nested field changes\", async () => {\n   516→      const formRef = createFormRef()\n   517→      const form = createFormInScope(formRef)\n   518→\n   519→      expect(form.isDirty.value).toBe(false)\n   520→\n   521→      const bioField = form.field(\"profile.bio\")\n   522→      bioField.value.value = \"Updated bio\"\n   523→      await nextTick()\n   524→\n   525→      expect(form.isDirty.value).toBe(true)\n   526→    })\n   527→\n   528→    it(\"should track form as dirty when array field changes\", async () => {\n   529→      const formRef = createFormRef()\n   530→      const form = createFormInScope(formRef)\n   531→\n   532→      expect(form.isDirty.value).toBe(false)\n   533→\n   534→      const skillsArray = form.fieldArray(\"profile.skills\")\n   535→      skillsArray.add(\"Vue.js\")\n   536→      await nextTick()\n   537→\n   538→      expect(form.isDirty.value).toBe(true)\n   539→    })\n   540→\n   541→    it(\"should not be dirty when reset to initial values\", async () => {\n   542→      const formRef = createFormRef()\n   543→      const form = createFormInScope(formRef)\n   544→      const nameField = form.field(\"name\")\n   545→\n   546→      nameField.value.value = \"Jane Doe\"\n   547→      await nextTick()\n   548→      expect(form.isDirty.value).toBe(true)\n   549→\n   550→      form.reset()\n   551→      await nextTick()\n   552→      expect(form.isDirty.value).toBe(false)\n   553→    })\n   554→  })\n   555→\n   556→  describe(\"array field creation\", () => {\n   557→    it(\"should create array field with proper methods\", () => {\n   558→      const formRef = createFormRef()\n   559→      const form = createFormInScope(formRef)\n   560→      const skillsArray = form.fieldArray(\"profile.skills\")\n   561→\n   562→      expect(skillsArray.value.value).toEqual([\"JavaScript\", \"TypeScript\"])\n   563→      expect(skillsArray.fields.value).toHaveLength(2)\n   564→      expect(skillsArray.fields.value[0].value.value).toBe(\"JavaScript\")\n   565→      expect(skillsArray.fields.value[1].value.value).toBe(\"TypeScript\")\n   566→    })\n   567→\n   568→    it(\"should add items to array\", async () => {\n   569→      const formRef = createFormRef()\n   570→      const form = createFormInScope(formRef)\n   571→      const skillsArray = form.fieldArray(\"profile.skills\")\n   572→\n   573→      skillsArray.add(\"Vue.js\")\n   574→      await nextTick()\n   575→\n   576→      expect(skillsArray.value.value).toEqual([\"JavaScript\", \"TypeScript\", \"Vue.js\"])\n   577→      expect(skillsArray.fields.value).toHaveLength(3)\n   578→    })\n   579→\n   580→    it(\"should remove items from array\", async () => {\n   581→      const formRef = createFormRef()\n   582→      const form = createFormInScope(formRef)\n   583→      const skillsArray = form.fieldArray(\"profile.skills\")\n   584→\n   585→      skillsArray.remove(0)\n   586→      await nextTick()\n   587→\n   588→      expect(skillsArray.value.value).toEqual([\"TypeScript\"])\n   589→      expect(skillsArray.fields.value).toHaveLength(1)\n   590→    })\n   591→\n   592→    it(\"should move items in array\", async () => {\n   593→      const formRef = createFormRef()\n   594→      const form = createFormInScope(formRef)\n   595→      const skillsArray = form.fieldArray(\"profile.skills\")\n   596→\n   597→      skillsArray.move(0, 1)\n   598→      await nextTick()\n   599→\n   600→      expect(skillsArray.value.value).toEqual([\"TypeScript\", \"JavaScript\"])\n   601→    })\n   602→\n   603→    it(\"should handle complex nested array operations\", async () => {\n   604→      const formRef = createFormRef()\n   605→      const form = createFormInScope(formRef)\n   606→      const itemsArray = form.fieldArray(\"items\")\n   607→\n   608→      expect(itemsArray.fields.value).toHaveLength(2)\n   609→      expect(itemsArray.fields.value[0].field(\"name\").value.value).toBe(\"Item 1\")\n   610→      expect(itemsArray.fields.value[1].field(\"name\").value.value).toBe(\"Item 2\")\n   611→\n   612→      // Add new item\n   613→      itemsArray.add({ name: \"Item 3\", tags: [\"tag4\"] })\n   614→      await nextTick()\n   615→\n   616→      expect(itemsArray.fields.value).toHaveLength(3)\n   617→      expect(itemsArray.fields.value[2].field(\"name\").value.value).toBe(\"Item 3\")\n   618→\n   619→      // Test field and fieldArray methods on array items\n   620→      const secondItem = itemsArray.field(\"[1].name\")\n   621→      expect(secondItem.value.value).toBe(\"Item 2\")\n   622→\n   623→      const firstItemTags = itemsArray.fieldArray(\"[0].tags\")\n   624→      expect(firstItemTags.value.value).toEqual([\"tag1\", \"tag2\"])\n   625→    })\n   626→\n   627→    it(\"should maintain reactivity when array items are modified\", async () => {\n   628→      const formRef = createFormRef()\n   629→      const form = createFormInScope(formRef)\n   630→      const itemsArray = form.fieldArray(\"items\")\n   631→\n   632→      // Modify first item's name\n   633→      const firstItemNameField = itemsArray.fields.value[0].field(\"name\")\n   634→      firstItemNameField.value.value = \"Modified Item 1\"\n   635→      await nextTick()\n   636→\n   637→      // Check that the change is reflected in multiple ways of accessing the same field\n   638→      expect(itemsArray.field(\"[0].name\").value.value).toBe(\"Modified Item 1\")\n   639→      expect(itemsArray.field(0).field(\"name\").value.value).toBe(\"Modified Item 1\")\n   640→      expect(form.field(\"items[0].name\").value.value).toBe(\"Modified Item 1\")\n   641→    })\n   642→\n   643→    it(\"should handle array move operations correctly\", async () => {\n   644→      const formRef = createFormRef()\n   645→      const form = createFormInScope(formRef)\n   646→      const skillsArray = form.fieldArray(\"profile.skills\")\n   647→\n   648→      expect(skillsArray.value.value).toEqual([\"JavaScript\", \"TypeScript\"])\n   649→\n   650→      skillsArray.move(0, 1)\n   651→      await nextTick()\n   652→\n   653→      expect(skillsArray.value.value).toEqual([\"TypeScript\", \"JavaScript\"])\n   654→      expect(skillsArray.fields.value[0].value.value).toBe(\"TypeScript\")\n   655→      expect(skillsArray.fields.value[1].value.value).toBe(\"JavaScript\")\n   656→    })\n   657→\n   658→    it(\"should track dirty state for array operations\", async () => {\n   659→      const formRef = createFormRef()\n   660→      const form = createFormInScope(formRef)\n   661→      const skillsArray = form.fieldArray(\"profile.skills\")\n   662→\n   663→      expect(skillsArray.isDirty.value).toBe(false)\n   664→      expect(form.isDirty.value).toBe(false)\n   665→\n   666→      skillsArray.add(\"Vue.js\")\n   667→      await nextTick()\n   668→\n   669→      expect(skillsArray.isDirty.value).toBe(true)\n   670→      expect(form.isDirty.value).toBe(true)\n   671→\n   672→      // Remove the added item to restore original state\n   673→      skillsArray.remove(2)\n   674→      await nextTick()\n   675→\n   676→      expect(skillsArray.isDirty.value).toBe(false)\n   677→      expect(form.isDirty.value).toBe(false)\n   678→    })\n   679→\n   680→    it(\"should handle array validation errors\", () => {\n   681→      const formRef = createFormRef({\n   682→        errors: {\n   683→          items: [\n   684→            { name: [\"First item name is required\"], tags: [] },\n   685→            { name: [], tags: [[\"Invalid tag format\"]] },\n   686→          ],\n   687→        },\n   688→      })\n   689→\n   690→      const form = createFormInScope(formRef)\n   691→      const itemsArray = form.fieldArray(\"items\")\n   692→\n   693→      expect(form.isValid.value).toBe(false)\n   694→      expect(itemsArray.isValid.value).toBe(false)\n   695→\n   696→      const firstItemName = itemsArray.field(\"[0].name\")\n   697→      expect(firstItemName.errors.value).toEqual([\"First item name is required\"])\n   698→      expect(firstItemName.isValid.value).toBe(false)\n   699→\n   700→      const secondItemTags = itemsArray.fieldArray(\"[1].tags\")\n   701→      expect(secondItemTags.errors.value).toEqual([[\"Invalid tag format\"]])\n   702→      expect(secondItemTags.isValid.value).toBe(false)\n   703→\n   704→      const secondItemTagsFirstTag = secondItemTags.field(0)\n   705→      expect(secondItemTagsFirstTag.errors.value).toEqual([\"Invalid tag format\"])\n   706→      expect(secondItemTagsFirstTag.isValid.value).toBe(false)\n   707→    })\n   708→\n   709→    it(\"should support both string paths and number shortcuts in array field API\", () => {\n   710→      const formRef = createFormRef()\n   711→      const form = createFormInScope(formRef)\n   712→      const itemsArray = form.fieldArray(\"items\")\n   713→\n   714→      // Test string path syntax\n   715→      const firstItemNameByStringPath = itemsArray.field(\"[0].name\")\n   716→      expect(firstItemNameByStringPath.value.value).toBe(\"Item 1\")\n   717→\n   718→      const firstItemTagsByStringPath = itemsArray.fieldArray(\"[0].tags\")\n   719→      expect(firstItemTagsByStringPath.value.value).toEqual([\"tag1\", \"tag2\"])\n   720→\n   721→      // Test number shortcut syntax (equivalent to \"[0]\")\n   722→      const firstItemByNumber = itemsArray.field(0)\n   723→      expect(firstItemByNumber.field(\"name\").value.value).toBe(\"Item 1\")\n   724→\n   725→      const firstItemTagsArrayByNumber = itemsArray.field(0).fieldArray(\"tags\")\n   726→      expect(firstItemTagsArrayByNumber.value.value).toEqual([\"tag1\", \"tag2\"])\n   727→\n   728→      // Both approaches should access the same underlying field\n   729→      expect(firstItemNameByStringPath.value.value).toBe(firstItemByNumber.field(\"name\").value.value)\n   730→    })\n   731→  })\n   732→\n   733→  describe(\"integration tests - LiveView form lifecycle\", () => {\n   734→    it(\"should follow complete form lifecycle: initial -> update -> validate -> server response\", async () => {\n   735→      // 1. Initial state - form is valid with no errors\n   736→      const formRef = createFormRef()\n   737→      const form = createFormInScope(formRef, {\n   738→        changeEvent: \"validate\",\n   739→        debounceInMiliseconds: 100,\n   740→      })\n   741→\n   742→      const nameField = form.field(\"name\")\n   743→\n   744→      // Assert initial state\n   745→      expect(nameField.value.value).toBe(\"John Doe\")\n   746→      expect(nameField.errors.value).toEqual([])\n   747→      expect(form.isValid.value).toBe(true)\n   748→      expect(form.isDirty.value).toBe(false)\n   749→\n   750→      // 2. User updates field (simulating active editing)\n   751→      nameField.value.value = \"Jane Smith\"\n   752→      await nextTick()\n   753→\n   754→      expect(form.isDirty.value).toBe(true)\n   755→\n   756→      // 3. Wait for debounced validation event to be sent\n   757→      await new Promise(resolve => setTimeout(resolve, 150))\n   758→\n   759→      expect(mockLiveVite.pushEvent).toHaveBeenCalledWith(\"validate\", {\n   760→        test_form: expect.objectContaining({\n   761→          name: \"Jane Smith\",\n   762→          email: \"john@example.com\",\n   763→        }),\n   764→      }, expect.any(Function))\n   765→\n   766→      // 4. Server responds with updated values and validation errors\n   767→      formRef.value = {\n   768→        ...formRef.value,\n   769→        values: {\n   770→          ...formRef.value.values,\n   771→          name: \"Jane Smith\",\n   772→          email: \"john@example.com\",\n   773→        },\n   774→        errors: {\n   775→          name: [\"Name must be at least 3 characters\"],\n   776→        } as unknown as FormErrors<TestForm>,\n   777→      }\n   778→\n   779→      await nextTick()\n   780→      // Wait a bit more for debounced execution to fully complete\n   781→      await new Promise(resolve => setTimeout(resolve, 50))\n   782→\n   783→      // Field should now show server error\n   784→      expect(nameField.errors.value).toEqual([\"Name must be at least 3 characters\"])\n   785→      expect(nameField.isValid.value).toBe(false)\n   786→      expect(form.isValid.value).toBe(false)\n   787→\n   788→      // With \"last update wins\", server response overwrites user edit (server sent original values + errors)\n   789→      expect(nameField.value.value).toBe(\"Jane Smith\")\n   790→    })\n   791→\n   792→    it(\"should handle form submission with server validation\", async () => {\n   793→      const formRef = createFormRef()\n   794→      const form = createFormInScope(formRef, {\n   795→        submitEvent: \"submit_form\",\n   796→      })\n   797→\n   798→      // Submit the form\n   799→      await form.submit()\n   800→\n   801→      expect(mockLiveVite.pushEvent).toHaveBeenCalledWith(\"submit_form\", {\n   802→        test_form: expect.objectContaining({\n   803→          name: \"John Doe\",\n   804→          email: \"john@example.com\",\n   805→        }),\n   806→      }, expect.any(Function))\n   807→    })\n   808→\n   809→    it(\"should use prepareData function before sending to server\", async () => {\n   810→      const formRef = createFormRef()\n   811→      const prepareData = vi.fn(data => ({ transformed: data }))\n   812→      const form = createFormInScope(formRef, { prepareData })\n   813→\n   814→      const nameField = form.field(\"name\")\n   815→      nameField.value.value = \"Modified Name\"\n   816→\n   817→      await form.submit()\n   818→\n   819→      expect(prepareData).toHaveBeenCalledWith(\n   820→        expect.objectContaining({\n   821→          name: \"Modified Name\",\n   822→        })\n   823→      )\n   824→      expect(mockLiveVite.pushEvent).toHaveBeenCalledWith(\"submit\", {\n   825→        test_form: { transformed: expect.objectContaining({ name: \"Modified Name\" }) },\n   826→      }, expect.any(Function))\n   827→    })\n   828→\n   829→    it(\"should handle cases when LiveView is not available\", async () => {\n   830→      mockUseLiveVite.mockReturnValue(null)\n   831→\n   832→      const formRef = createFormRef()\n   833→      const form = createFormInScope(formRef)\n   834→\n   835→      // Should not throw and should resolve\n   836→      await expect(form.submit()).resolves.toBeUndefined()\n   837→    })\n   838→\n   839→    it(\"should update all fields reactively when server form changes\", async () => {\n   840→      const formRef = createFormRef()\n   841→      const form = createFormInScope(formRef)\n   842→\n   843→      const nameField = form.field(\"name\")\n   844→      const emailField = form.field(\"email\")\n   845→      const bioField = form.field(\"profile.bio\")\n   846→      const itemNameField = form.field(\"items[0].name\")\n   847→\n   848→      // Initial values\n   849→      expect(nameField.value.value).toBe(\"John Doe\")\n   850→      expect(emailField.value.value).toBe(\"john@example.com\")\n   851→      expect(bioField.value.value).toBe(\"Software developer\")\n   852→      expect(itemNameField.value.value).toBe(\"Item 1\")\n   853→      expect(nameField.errors.value).toEqual([])\n   854→\n   855→      // Update the reactive form (simulating server update with new values and errors)\n   856→      formRef.value = {\n   857→        name: \"updated_form\",\n   858→        values: {\n   859→          name: \"Jane Smith\",\n   860→          email: \"jane@example.com\",\n   861→          age: 25,\n   862→          profile: {\n   863→            bio: \"Product designer\",\n   864→            skills: [\"Figma\", \"Sketch\"],\n   865→          },\n   866→          items: [\n   867→            { name: \"Design mockups\", tags: [\"ui\", \"ux\"] },\n   868→            { name: \"User research\", tags: [\"research\"] },\n   869→          ],\n   870→        },\n   871→        errors: {\n   872→          name: [\"Name already taken\"],\n   873→          email: [],\n   874→        } as unknown as FormErrors<TestForm>,\n   875→        valid: false,\n   876→      }\n   877→\n   878→      await nextTick()\n   879→      // Wait a bit for any pending validation to complete\n   880→      await new Promise(resolve => setTimeout(resolve, 50))\n   881→\n   882→      // All fields should be updated\n   883→      expect(nameField.value.value).toBe(\"Jane Smith\")\n   884→      expect(emailField.value.value).toBe(\"jane@example.com\")\n   885→      expect(bioField.value.value).toBe(\"Product designer\")\n   886→      expect(itemNameField.value.value).toBe(\"Design mockups\")\n   887→\n   888→      // Errors should be updated\n   889→      expect(nameField.errors.value).toEqual([\"Name already taken\"])\n   890→      expect(emailField.errors.value).toEqual([])\n   891→    })\n   892→\n   893→    it(\"should properly debounce validation events during typing\", async () => {\n   894→      const formRef = createFormRef()\n   895→      const form = createFormInScope(formRef, {\n   896→        changeEvent: \"validate_field\",\n   897→        debounceInMiliseconds: 10,\n   898→      })\n   899→\n   900→      const nameField = form.field(\"name\")\n   901→\n   902→      // Simulate rapid typing\n   903→      nameField.value.value = \"J\"\n   904→      await nextTick()\n   905→      nameField.value.value = \"Ja\"\n   906→      await nextTick()\n   907→      nameField.value.value = \"Jan\"\n   908→      await nextTick()\n   909→      nameField.value.value = \"Jane\"\n   910→      await nextTick()\n   911→\n   912→      // Should not have sent any events yet\n   913→      expect(mockLiveVite.pushEvent).not.toHaveBeenCalled()\n   914→\n   915→      // Wait for debounce delay\n   916→      await new Promise(resolve => setTimeout(resolve, 15))\n   917→\n   918→      // Should have sent only one validation event with final value\n   919→      expect(mockLiveVite.pushEvent).toHaveBeenCalledTimes(1)\n   920→      expect(mockLiveVite.pushEvent).toHaveBeenCalledWith(\"validate_field\", {\n   921→        test_form: expect.objectContaining({\n   922→          name: \"Jane\",\n   923→        }),\n   924→      }, expect.any(Function))\n   925→    })\n   926→\n   927→    it(\"should not send validation events when changeEvent is null\", async () => {\n   928→      const formRef = createFormRef()\n   929→      const form = createFormInScope(formRef, {\n   930→        changeEvent: null, // Disable validation events\n   931→        debounceInMiliseconds: 10,\n   932→      })\n   933→\n   934→      const nameField = form.field(\"name\")\n   935→      nameField.value.value = \"Modified Name\"\n   936→      await nextTick()\n   937→\n   938→      // Wait for debounce delay\n   939→      await new Promise(resolve => setTimeout(resolve, 15))\n   940→\n   941→      // Should not have sent any validation events\n   942→      expect(mockLiveVite.pushEvent).not.toHaveBeenCalled()\n   943→    })\n   944→\n   945→    it(\"should not send duplicate change events when server updates the form\", async () => {\n   946→      const formRef = createFormRef()\n   947→      const form = createFormInScope(formRef, {\n   948→        changeEvent: \"validate\",\n   949→        debounceInMiliseconds: 10,\n   950→      })\n   951→\n   952→      const nameField = form.field(\"name\")\n   953→\n   954→      // Clear any initial calls\n   955→      vi.clearAllMocks()\n   956→\n   957→      // User changes a field\n   958→      nameField.value.value = \"John Updated\"\n   959→      await nextTick()\n   960→\n   961→      // Wait for debounced change event\n   962→      await new Promise(resolve => setTimeout(resolve, 15))\n   963→\n   964→      // Should have sent one change event\n   965→      expect(mockLiveVite.pushEvent).toHaveBeenCalledTimes(1)\n   966→      expect(mockLiveVite.pushEvent).toHaveBeenCalledWith(\"validate\", {\n   967→        test_form: expect.objectContaining({\n   968→          name: \"John Updated\",\n   969→        }),\n   970→      }, expect.any(Function))\n   971→\n   972→      // Clear the mock to track subsequent calls\n   973→      vi.clearAllMocks()\n   974→\n   975→      // Server updates the form (simulating server response with updated values)\n   976→      formRef.value = {\n   977→        ...formRef.value,\n   978→        values: {\n   979→          ...formRef.value.values,\n   980→          name: \"John Server Updated\",\n   981→          email: \"updated@server.com\",\n   982→        },\n   983→      }\n   984→\n   985→      await nextTick()\n   986→\n   987→      // Wait for any potential debounced events\n   988→      await new Promise(resolve => setTimeout(resolve, 15))\n   989→\n   990→      // Should NOT have sent any additional change events (this was the bug)\n   991→      expect(mockLiveVite.pushEvent).not.toHaveBeenCalled()\n   992→\n   993→      // Verify the field was updated from server\n   994→      expect(nameField.value.value).toBe(\"John Server Updated\")\n   995→    })\n   996→\n   997→    it(\"should use form name as key in event payload instead of 'data'\", async () => {\n   998→      const formRef = createFormRef({\n   999→        name: \"user_form\", // Custom form name\n  1000→      })\n  1001→      const form = createFormInScope(formRef, {\n  1002→        changeEvent: \"validate\",\n  1003→        submitEvent: \"save\",\n  1004→        debounceInMiliseconds: 10,\n  1005→      })\n  1006→\n  1007→      const nameField = form.field(\"name\")\n  1008→      nameField.value.value = \"New Name\"\n  1009→      await nextTick()\n  1010→\n  1011→      // Wait for debounce delay for change event\n  1012→      await new Promise(resolve => setTimeout(resolve, 15))\n  1013→\n  1014→      expect(mockLiveVite.pushEvent).toHaveBeenCalledWith(\"validate\", {\n  1015→        user_form: expect.objectContaining({\n  1016→          name: \"New Name\",\n  1017→        }),\n  1018→      }, expect.any(Function))\n  1019→\n  1020→      // Test submit event as well\n  1021→      await form.submit()\n  1022→\n  1023→      expect(mockLiveVite.pushEvent).toHaveBeenCalledWith(\"save\", {\n  1024→        user_form: expect.objectContaining({\n  1025→          name: \"New Name\",\n  1026→        }),\n  1027→      }, expect.any(Function))\n  1028→    })\n  1029→\n  1030→    it(\"should clear field errors when server removes them\", async () => {\n  1031→      // Start with a form that has errors\n  1032→      const formRef = createFormRef({\n  1033→        errors: {\n  1034→          name: [\"Name is required\"],\n  1035→          email: [\"Invalid email format\"],\n  1036→          profile: {\n  1037→            bio: [\"Bio is too short\"],\n  1038→          },\n  1039→        },\n  1040→      })\n  1041→\n  1042→      const form = createFormInScope(formRef)\n  1043→      const nameField = form.field(\"name\")\n  1044→      const emailField = form.field(\"email\")\n  1045→      const bioField = form.field(\"profile.bio\")\n  1046→\n  1047→      // Verify initial error state\n  1048→      expect(nameField.errors.value).toEqual([\"Name is required\"])\n  1049→      expect(emailField.errors.value).toEqual([\"Invalid email format\"])\n  1050→      expect(bioField.errors.value).toEqual([\"Bio is too short\"])\n  1051→      expect(form.isValid.value).toBe(false)\n  1052→\n  1053→      // Server clears some errors (simulating successful validation)\n  1054→      formRef.value = {\n  1055→        ...formRef.value,\n  1056→        errors: {\n  1057→          email: [\"Invalid email format\"], // Keep email error\n  1058→          // name and profile.bio errors are cleared (not present)\n  1059→        } as unknown as FormErrors<TestForm>,\n  1060→      }\n  1061→\n  1062→      await nextTick()\n  1063→      // Wait a bit for any pending operations to complete\n  1064→      await new Promise(resolve => setTimeout(resolve, 50))\n  1065→\n  1066→      // Cleared errors should now be empty arrays\n  1067→      expect(nameField.errors.value).toEqual([])\n  1068→      expect(bioField.errors.value).toEqual([])\n  1069→      expect(nameField.isValid.value).toBe(true)\n  1070→      expect(bioField.isValid.value).toBe(true)\n  1071→\n  1072→      // Remaining error should still be present\n  1073→      expect(emailField.errors.value).toEqual([\"Invalid email format\"])\n  1074→      expect(emailField.isValid.value).toBe(false)\n  1075→\n  1076→      // Form should be invalid due to remaining email error\n  1077→      expect(form.isValid.value).toBe(false)\n  1078→\n  1079→      // Clear all errors\n  1080→      formRef.value = {\n  1081→        ...formRef.value,\n  1082→        errors: {} as FormErrors<TestForm>,\n  1083→      }\n  1084→\n  1085→      await nextTick()\n  1086→      // Wait a bit for any pending operations to complete\n  1087→      await new Promise(resolve => setTimeout(resolve, 50))\n  1088→\n  1089→      // All errors should now be cleared\n  1090→      expect(nameField.errors.value).toEqual([])\n  1091→      expect(emailField.errors.value).toEqual([])\n  1092→      expect(bioField.errors.value).toEqual([])\n  1093→      expect(form.isValid.value).toBe(true)\n  1094→    })\n  1095→\n  1096→    it(\"should mark all fields as touched when submit is called, then reset on success\", async () => {\n  1097→      const formRef = createFormRef()\n  1098→      const form = createFormInScope(formRef)\n  1099→\n  1100→      // Create various field types to test comprehensive touched state\n  1101→      const nameField = form.field(\"name\")\n  1102→      const emailField = form.field(\"email\")\n  1103→      const bioField = form.field(\"profile.bio\")\n  1104→      const skillsArray = form.fieldArray(\"profile.skills\")\n  1105→      const firstSkillField = skillsArray.field(0)\n  1106→      const itemNameField = form.field(\"items[0].name\")\n  1107→      const itemTagField = form.field(\"items[0].tags[0]\")\n  1108→\n  1109→      // Initially no fields should be touched\n  1110→      expect(nameField.isTouched.value).toBe(false)\n  1111→      expect(emailField.isTouched.value).toBe(false)\n  1112→      expect(bioField.isTouched.value).toBe(false)\n  1113→      expect(firstSkillField.isTouched.value).toBe(false)\n  1114→      expect(itemNameField.isTouched.value).toBe(false)\n  1115→      expect(itemTagField.isTouched.value).toBe(false)\n  1116→      expect(form.isTouched.value).toBe(false)\n  1117→\n  1118→      // Submit the form (succeeds and resets touched state)\n  1119→      await form.submit()\n  1120→      // Wait for the reset timeout to complete\n  1121→      await new Promise(resolve => setTimeout(resolve, 10))\n  1122→\n  1123→      // After successful submit, all fields should be reset to untouched\n  1124→      expect(nameField.isTouched.value).toBe(false)\n  1125→      expect(emailField.isTouched.value).toBe(false)\n  11