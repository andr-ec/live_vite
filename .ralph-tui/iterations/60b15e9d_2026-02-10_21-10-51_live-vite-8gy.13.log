afe field factory functions\n   215→  field<P extends PathsToStringProps<T>>(path: P, options?: FieldOptions): FormField<PathValue<T, P>>\n   216→  fieldArray<P extends PathsToStringProps<T>>(\n   217→    path: P\n   218→  ): PathValue<T, P> extends readonly (infer U)[] ? FormFieldArray<U> : never\n   219→\n   220→  // Form actions\n   221→  submit: () => Promise<Form<T>>\n   222→  reset: () => void\n   223→}\n   224→\n   225→export function useLiveForm<T extends object>(\n   226→  form: MaybeRefOrGetter<Form<T>>,\n   227→  options: FormOptions = {}\n   228→): UseLiveFormReturn<T> {\n   229→  const {\n   230→    changeEvent = null,\n   231→    submitEvent = \"submit\",\n   232→    debounceInMiliseconds = 300,\n   233→    prepareData = (data: any) => data,\n   234→  } = options\n   235→\n   236→  // Get initial form data\n   237→  const initialForm = toValue(form)\n   238→  const initialValues = reactive(deepClone(initialForm.values)) as T\n   239→  const currentValues = reactive(deepClone(initialForm.values)) as T\n   240→  const currentErrors = reactive(deepClone(initialForm.errors)) as FormErrors<T>\n   241→\n   242→  // Form-level state tracking\n   243→  const touchedFields = reactive<Set<string>>(new Set())\n   244→  const submitCount = ref(0)\n   245→\n   246→  // Memoization for field instances to prevent recreation\n   247→  const fieldCache = new Map<string, FormField<any>[]>()\n   248→  const fieldArrayCache = new Map<string, FormFieldArray<any>>()\n   249→\n   250→  // Helper function to check if any errors exist in nested error structure\n   251→  function hasAnyErrors(errors: any): boolean {\n   252→    if (Array.isArray(errors)) {\n   253→      // Check if it's an array of strings (field errors) or array of objects (nested form errors)\n   254→      if (errors.length === 0) return false\n   255→\n   256→      // If first item is string, it's a field error array\n   257→      if (typeof errors[0] === \"string\") {\n   258→        return errors.length > 0\n   259→      }\n   260→\n   261→      // If first item is object, it's an array of nested error objects\n   262→      return errors.some(item => hasAnyErrors(item))\n   263→    }\n   264→    if (typeof errors === \"object\" && errors !== null) {\n   265→      return Object.values(errors).some(value => hasAnyErrors(value))\n   266→    }\n   267→    return false\n   268→  }\n   269→\n   270→  // Form-level computed properties\n   271→  const isValid = computed(() => !hasAnyErrors(currentErrors))\n   272→\n   273→  const isDirty = computed(() => {\n   274→    return JSON.stringify(currentValues) !== JSON.stringify(initialValues)\n   275→  })\n   276→\n   277→  const isTouched = computed(() => {\n   278→    return submitCount.value > 0 || touchedFields.size > 0\n   279→  })\n   280→\n   281→  // LiveView integration\n   282→  const live = useLiveVite()\n   283→\n   284→  // Immediate change handler\n   285→  const sendChanges = async (): Promise<any> => {\n   286→    if (changeEvent) {\n   287→      const values = deepToRaw(currentValues)\n   288→      const data = prepareData(values)\n   289→      return new Promise(resolve =>\n   290→        live.pushEvent(changeEvent, { [initialForm.name]: data }, (result: any) => {\n   291→          resolve(result)\n   292→        })\n   293→      )\n   294→    } else {\n   295→      return Promise.resolve(null)\n   296→    }\n   297→  }\n   298→\n   299→  // Create debounced change handler with validation status\n   300→  const debounceWait = live && changeEvent ? debounceInMiliseconds : 0\n   301→  const { debouncedFn: debouncedSendChanges, isPending: isValidatingChanges } = debounce(sendChanges, debounceWait)\n   302→\n   303→  // Create a form field for a given path\n   304→  function createFormField<V>(path: string, options: FieldOptions = {}): FormField<V> {\n   305→    // Get or create array of fields for this path\n   306→    if (!fieldCache.has(path)) {\n   307→      fieldCache.set(path, [])\n   308→    }\n   309→    const fieldsForPath = fieldCache.get(path)!\n   310→\n   311→    // Find existing field with matching options\n   312→    const existingField = fieldsForPath.find(f => deepEqual(f._options, options))\n   313→    if (existingField) {\n   314→      return existingField as FormField<V>\n   315→    }\n   316→\n   317→    // For checkboxes with values, determine multi-checkbox behavior based on current value type\n   318→\n   319→    const keys = parsePath(path)\n   320→    const fieldId = sanitizeId(path) + (options.value !== undefined ? `_${sanitizeId(String(options.value))}` : \"\")\n   321→\n   322→    const fieldValue = computed({\n   323→      get(): V {\n   324→        return getValueByPath(currentValues, keys)\n   325→      },\n   326→      set(newValue: V) {\n   327→        setValueByPath(currentValues, keys, newValue)\n   328→        debouncedSendChanges()\n   329→      },\n   330→    })\n   331→\n   332→    const fieldErrors = computed(() => {\n   333→      const errors = getValueByPath(currentErrors, keys)\n   334→      return Array.isArray(errors) ? errors : []\n   335→    })\n   336→\n   337→    const fieldErrorMessage = computed(() => {\n   338→      const errors = fieldErrors.value\n   339→      return errors.length > 0 ? errors[0] : undefined\n   340→    })\n   341→\n   342→    const fieldIsValid = computed(() => fieldErrors.value.length === 0)\n   343→    const fieldIsTouched = computed(() => submitCount.value > 0 || touchedFields.has(path))\n   344→    const fieldIsDirty = computed(() => {\n   345→      const initialVal = getValueByPath(initialValues, keys)\n   346→      return JSON.stringify(fieldValue.value) !== JSON.stringify(initialVal)\n   347→    })\n   348→\n   349→    const setTouched = () => touchedFields.add(path)\n   350→    const isMultiCheckboxValue = options.type === \"checkbox\" && Array.isArray(fieldValue.value)\n   351→\n   352→    const fieldInputAttrs = computed(() => {\n   353→      const baseAttrs = {\n   354→        name: path,\n   355→        id: fieldId,\n   356→        type: options.type,\n   357→        onBlur: setTouched,\n   358→        \"aria-invalid\": !fieldIsValid.value,\n   359→        ...(fieldErrors.value.length > 0 ? { \"aria-describedby\": `${fieldId}-error` } : {}),\n   360→      }\n   361→\n   362→      // if it's a multi-checkbox, we need to set or unset the value in the array\n   363→      if (isMultiCheckboxValue) {\n   364→        return {\n   365→          ...baseAttrs,\n   366→          value: options.value,\n   367→          checked: ((fieldValue.value as V[]) || []).includes(options.value),\n   368→          onInput: (event: Event) => {\n   369→            const target = event.target as HTMLInputElement\n   370→            const currentArray = fieldValue.value as V[]\n   371→            const idx = currentArray.indexOf(options.value)\n   372→            if (target.checked && idx === -1) {\n   373→              currentArray.push(options.value)\n   374→            } else if (!target.checked && idx !== -1) {\n   375→              currentArray.splice(idx, 1)\n   376→            }\n   377→          },\n   378→        }\n   379→      } else if (options.type === \"checkbox\") {\n   380→        const optionsValue = options.value !== undefined ? options.value : true\n   381→        return {\n   382→          ...baseAttrs,\n   383→          value: options.value,\n   384→          checked: fieldValue.value === optionsValue,\n   385→          onInput: (event: Event) => {\n   386→            const target = event.target as HTMLInputElement\n   387→            fieldValue.value = target.checked ? optionsValue : null\n   388→          },\n   389→        }\n   390→      } else {\n   391→        // Regular input\n   392→        return {\n   393→          ...baseAttrs,\n   394→          value: fieldValue.value,\n   395→          onInput: (event: Event) => {\n   396→            const target = event.target as HTMLInputElement\n   397→            fieldValue.value = target.value as V\n   398→          },\n   399→        }\n   400→      }\n   401→    })\n   402→\n   403→    const field: FormField<V> = {\n   404→      value: fieldValue,\n   405→      errors: fieldErrors as Readonly<Ref<string[]>>,\n   406→      errorMessage: fieldErrorMessage as Readonly<Ref<string | undefined>>,\n   407→      isValid: fieldIsValid,\n   408→      isDirty: fieldIsDirty,\n   409→      isTouched: fieldIsTouched,\n   410→      inputAttrs: fieldInputAttrs,\n   411→      _options: options,\n   412→\n   413→      field<K extends keyof V>(\n   414→        key: K,\n   415→        options?: FieldOptions\n   416→      ): V[K] extends readonly (infer U)[] ? FormFieldArray<U> : FormField<V[K]> {\n   417→        const subPath = path ? `${path}.${String(key)}` : String(key)\n   418→        return createFormField(subPath, options) as V[K] extends readonly (infer U)[]\n   419→          ? FormFieldArray<U>\n   420→          : FormField<V[K]>\n   421→      },\n   422→\n   423→      fieldArray<K extends keyof V>(key: K): V[K] extends readonly (infer U)[] ? FormFieldArray<U> : never {\n   424→        const subPath = path ? `${path}.${String(key)}` : String(key)\n   425→        return createFormFieldArray(subPath) as V[K] extends readonly (infer U)[] ? FormFieldArray<U> : never\n   426→      },\n   427→\n   428→      blur() {\n   429→        touchedFields.add(path)\n   430→      },\n   431→    }\n   432→\n   433→    // Add to cache\n   434→    fieldsForPath.push(field)\n   435→\n   436→    return field\n   437→  }\n   438→\n   439→  function createFormFieldArray<V>(path: string): FormFieldArray<V> {\n   440→    // Check cache first\n   441→    if (fieldArrayCache.has(path)) {\n   442→      return fieldArrayCache.get(path) as FormFieldArray<V>\n   443→    }\n   444→\n   445→    const baseField = createFormField<V[]>(path)\n   446→    const keys = parsePath(path)\n   447→\n   448→    const updateArray = (newArray: V[]) => {\n   449→      setValueByPath(currentValues, keys, newArray)\n   450→      return debouncedSendChanges()\n   451→    }\n   452→\n   453→    const fieldArray = {\n   454→      ...baseField,\n   455→\n   456→      add(item?: Partial<V>) {\n   457→        // we don't want to add item immediately, rather we want to send it to the server if validation is enabled\n   458→        const currentArray = baseField.value.value || []\n   459→        return updateArray([...currentArray, item as V])\n   460→      },\n   461→\n   462→      remove(index: number) {\n   463→        const currentArray = baseField.value.value || []\n   464→        return updateArray(currentArray.filter((_, i) => i !== index))\n   465→      },\n   466→\n   467→      move(from: number, to: number) {\n   468→        const currentArray = [...(baseField.value.value || [])]\n   469→        if (from >= 0 && from < currentArray.length && to >= 0 && to < currentArray.length) {\n   470→          const item = currentArray.splice(from, 1)[0]\n   471→          currentArray.splice(to, 0, item)\n   472→          return updateArray(currentArray)\n   473→        } else {\n   474→          return Promise.resolve()\n   475→        }\n   476→      },\n   477→\n   478→      fields: computed(() => {\n   479→        const array = baseField.value.value || []\n   480→        return array.map((_, index) => createFormField<V>(`${path}[${index}]`))\n   481→      }) as Readonly<Ref<FormField<V>[]>>,\n   482→\n   483→      field<P extends string | number>(pathOrIndex: P, options?: FieldOptions): ArrayFieldPath<V, P> {\n   484→        // Handle number shortcut: convert 0 to \"[0]\"\n   485→        if (typeof pathOrIndex === \"number\") {\n   486→          return createFormField(`${path}[${pathOrIndex}]`, options) as ArrayFieldPath<V, P>\n   487→        }\n   488→        // Handle string path: use as-is, could be \"[0]\", \"[0].name\", etc.\n   489→        return createFormField(`${path}${pathOrIndex}`, options) as ArrayFieldPath<V, P>\n   490→      },\n   491→\n   492→      fieldArray<P extends string | number>(pathOrIndex: P): ArrayFieldArrayPath<V, P> {\n   493→        // Handle number shortcut: convert 0 to \"[0]\"\n   494→        if (typeof pathOrIndex === \"number\") {\n   495→          return createFormFieldArray(`${path}[${pathOrIndex}]`) as ArrayFieldArrayPath<V, P>\n   496→        }\n   497→        // Handle string path: use as-is, could be \"[0]\", \"[0].tags\", etc.\n   498→        return createFormFieldArray(`${path}${pathOrIndex}`) as ArrayFieldArrayPath<V, P>\n   499→      },\n   500→    }\n   501→\n   502→    // Cache the field array instance\n   503→    fieldArrayCache.set(path, fieldArray)\n   504→    return fieldArray\n   505→  }\n   506→\n   507→  // Method to update form state from server\n   508→  function updateFromServer(newForm: Form<T>) {\n   509→    // Always update errors, we don't want to lose them\n   510→    replaceReactiveObject(currentErrors, deepClone(newForm.errors))\n   511→\n   512→    // Only apply value updates if no validation is in progress\n   513→    // Otherwise we could overwrite local client data with server data\n   514→    if (!isValidatingChanges.value) {\n   515→      Object.assign(currentValues, deepClone(newForm.values))\n   516→    }\n   517→  }\n   518→\n   519→  // Watch for server updates to the form\n   520→  // setTimeout ensures updates are processed after current execution cycle\n   521→  const stopWatchingForm = watch(\n   522→    () => toValue(form),\n   523→    () => setTimeout(() => updateFromServer(toValue(form)), 0),\n   524→    { deep: true }\n   525→  )\n   526→\n   527→  const reset = () => {\n   528→    Object.assign(currentValues, deepClone(initialValues))\n   529→    touchedFields.clear()\n   530→    submitCount.value = 0\n   531→  }\n   532→\n   533→  const submit = async () => {\n   534→    // Increment submit count to mark all fields as touched\n   535→    submitCount.value += 1\n   536→\n   537→    if (live) {\n   538→      const data = prepareData(deepToRaw(currentValues))\n   539→\n   540→      return await new Promise<Form<T>>(resolve => {\n   541→        // Send submit event to LiveView\n   542→        live.pushEvent(submitEvent, { [initialForm.name]: data }, (result: any) => {\n   543→          // if it was successful, we want to reset the form, but it's hard to determine if it was successfull or not in an automated way\n   544→          // because eg initial form might have errors\n   545→          // so, user should reset his form manually if it was successfull\n   546→          // we provide a shortcut: if there's a reply with {reset: true},\n   547→          // it means it should be resetted on the client side as well\n   548→          if (result && result.reset) {\n   549→            setTimeout(() => {\n   550→              // let's wait for update from the server to be processed\n   551→              Object.assign(initialValues, deepClone(currentValues))\n   552→              reset()\n   553→            }, 0)\n   554→          }\n   555→          resolve(result)\n   556→        })\n   557→      })\n   558→    } else {\n   559→      // Fallback when not in LiveView context\n   560→      console.warn(\"LiveView hook not available, form submission skipped\")\n   561→      return Promise.resolve(undefined as any)\n   562→    }\n   563→  }\n   564→\n   565→  // Clean up watchers when component unmounts\n   566→  onScopeDispose(() => {\n   567→    stopWatchingForm()\n   568→  })\n   569→\n   570→  const formInstance = {\n   571→    isValid,\n   572→    isDirty,\n   573→    isTouched,\n   574→    isValidating: readonly(isValidatingChanges) as Readonly<Ref<boolean>>,\n   575→    submitCount: readonly(submitCount),\n   576→    initialValues: readonly(initialValues) as Readonly<T>,\n   577→    submit: submit,\n   578→    reset: reset,\n   579→    field<P extends PathsToStringProps<T>>(path: P, options?: FieldOptions): FormField<PathValue<T, P>> {\n   580→      return createFormField<PathValue<T, P>>(path as string, options)\n   581→    },\n   582→\n   583→    fieldArray<P extends PathsToStringProps<T>>(path: P): any {\n   584→      return createFormFieldArray(path as string)\n   585→    },\n   586→  }\n   587→\n   588→  // Provide the form instance to child components\n   589→  provide(LIVE_FORM_INJECTION_KEY, formInstance as any)\n   590→\n   591→  return formInstance\n   592→}\n   593→\n   594→/**\n   595→ * Hook to access form fields from an injected form instance\n   596→ * @param path - The field path (e.g., \"name\", \"user.email\", \"items[0].title\")\n   597→ * @throws Error if no form was provided via inject\n   598→ * @returns FormField instance for the specified path\n   599→ */\n   600→export function useField<T = any>(path: string, options?: FieldOptions): FormField<T> {\n   601→  const form = inject(LIVE_FORM_INJECTION_KEY)\n   602→\n   603→  if (!form) {\n   604→    throw new Error(\n   605→      \"useField() can only be used inside components where a form has been provided. \" +\n   606→        \"Make sure to use useLiveForm() in a parent component.\"\n   607→    )\n   608→  }\n   609→\n   610→  return form.field(path, options) as FormField<T>\n   611→}\n   612→\n   613→/**\n   614→ * Hook to access form array fields from an injected form instance\n   615→ * @param path - The field path for an array field (e.g., \"items\", \"user.tags\", \"posts[0].comments\")\n   616→ * @throws Error if no form was provided via inject\n   617→ * @returns FormFieldArray instance for the specified path\n   618→ */\n   619→export function useArrayField<T = any>(path: string): FormFieldArray<T> {\n   620→  const form = inject(LIVE_FORM_INJECTION_KEY)\n   621→\n   622→  if (!form) {\n   623→    throw new Error(\n   624→      \"useArrayField() can only be used inside components where a form has been provided. \" +\n   625→        \"Make sure to use useLiveForm() in a parent component.\"\n   626→    )\n   627→  }\n   628→\n   629→  return form.fieldArray(path) as FormFieldArray<T>\n   630→}\n   631→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ca373184-55de-43ea-b9dc-c45b48d70f8a","uuid":"b6da67d3-93a3-4fd4-aaa9-8edb1709b0c3","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/useLiveForm.ts","content":"import {\n  ref,\n  reactive,\n  computed,\n  toValue,\n  watch,\n  onScopeDispose,\n  nextTick,\n  provide,\n  inject,\n  type Ref,\n  type MaybeRefOrGetter,\n  type InjectionKey,\n  readonly,\n  type ComputedRef,\n} from \"vue\"\nimport { useLiveVite } from \"./use\"\nimport {\n  parsePath,\n  getValueByPath,\n  setValueByPath,\n  deepClone,\n  debounce,\n  replaceReactiveObject,\n  deepToRaw,\n  deepEqual,\n  sanitizeId,\n} from \"./utils\"\n\n// Injection key for providing form instances to child components\nexport const LIVE_FORM_INJECTION_KEY = Symbol(\"LiveForm\") as InjectionKey<{\n  field: (path: string, options?: FieldOptions) => FormField<any>\n  fieldArray: (path: string) => FormFieldArray<any>\n}>\n\n/**\n * Maps form field structure to a corresponding structure for validation errors\n * For each field in the original form, creates an array of error strings\n */\nexport type FormErrors<T extends object> = {\n  [K in keyof T]?: T[K] extends object ? FormErrors<T[K]> : string[]\n}\n\n/**\n * Base form interface representing the data coming from the server\n * @template T - The type of form values\n */\nexport interface Form<T extends object> {\n  /** Unique identifier for the form */\n  name: string\n  /** Form field values */\n  values: T\n  /** Validation errors for form fields */\n  errors: FormErrors<T>\n  /** Whether the form is valid */\n  valid: boolean\n}\n\n// TypeScript utility types for path safety\ntype PathsToStringProps<T> = T extends string | number | boolean | Date\n  ? never\n  : T extends readonly (infer U)[]\n  ? U extends object\n    ? `[${number}]` | `[${number}].${PathsToStringProps<U>}`\n    : `[${number}]`\n  : T extends object\n  ? {\n      [K in keyof T]: K extends string | number\n        ? T[K] extends readonly (infer U)[]\n          ? U extends object\n            ? `${K}` | `${K}[${number}]` | `${K}[${number}].${PathsToStringProps<U>}`\n            : `${K}` | `${K}[${number}]`\n          : T[K] extends object\n          ? `${K}` | `${K}.${PathsToStringProps<T[K]>}`\n          : `${K}`\n        : never\n    }[keyof T]\n  : never\n\n// Get type at path\ntype PathValue<T, P extends string> = P extends `${infer Key}[${infer Index}].${infer Rest}`\n  ? Key extends keyof T\n    ? T[Key] extends readonly (infer U)[]\n      ? PathValue<U, Rest>\n      : never\n    : never\n  : P extends `${infer Key}[${infer Index}]`\n  ? Key extends keyof T\n    ? T[Key] extends readonly (infer U)[]\n      ? U\n      : never\n    : never\n  : P extends `${infer Key}.${infer Rest}`\n  ? Key extends keyof T\n    ? PathValue<T[Key], Rest>\n    : never\n  : P extends `[${infer Index}]`\n  ? T extends readonly (infer U)[]\n    ? U\n    : never\n  : P extends keyof T\n  ? T[P]\n  : never\n\n// Helper type to resolve array field types from relative paths\ntype ArrayFieldPath<T, P extends string | number> = P extends number\n  ? FormField<T>\n  : P extends `[${number}]`\n  ? FormField<T>\n  : P extends `[${number}].${infer Rest}`\n  ? PathValue<T, Rest> extends readonly (infer U)[]\n    ? FormFieldArray<U>\n    : FormField<PathValue<T, Rest>>\n  : P extends keyof T\n  ? T[P] extends readonly (infer U)[]\n    ? FormFieldArray<U>\n    : FormField<T[P]>\n  : FormField<any>\n\n// Helper type for array field array paths\ntype ArrayFieldArrayPath<T, P extends string | number> = P extends number\n  ? never\n  : P extends `[${number}]`\n  ? never\n  : P extends `[${number}].${infer Rest}`\n  ? PathValue<T, Rest> extends readonly (infer U)[]\n    ? FormFieldArray<U>\n    : never\n  : P extends keyof T\n  ? T[P] extends readonly (infer U)[]\n    ? FormFieldArray<U>\n    : never\n  : never\n\nexport interface FieldOptions {\n  /** HTML input type - supports any valid input type */\n  type?: string\n  /** For checkbox/radio: the value this input represents when selected */\n  value?: any\n}\n\nexport interface FormOptions {\n  /** Event name to send to the server when form values change. Set to null to disable validation events */\n  changeEvent?: string | null\n  /** Event name to send to the server when form is submitted */\n  submitEvent?: string\n  /** Delay in milliseconds before sending change events to reduce server load */\n  debounceInMiliseconds?: number\n  /** Function to transform form data before sending to server */\n  prepareData?: (data: any) => any\n}\n\nexport interface FormField<T> {\n  // Reactive state (using reactive + toRefs for clean syntax)\n  value: Ref<T> // field.value instead of field.value.value\n  errors: Readonly<Ref<string[]>> // Read-only, from backend\n  errorMessage: Readonly<Ref<string | undefined>> // First error, read-only\n  isValid: Ref<boolean>\n  isDirty: Ref<boolean>\n  isTouched: Ref<boolean>\n\n  // Input binding helper\n  inputAttrs: Readonly<\n    Ref<{\n      value: T\n      onInput: (event: Event) => void\n      onBlur: () => void\n      name: string\n      id: string\n      type?: string\n      checked?: boolean\n      \"aria-invalid\": boolean\n      \"aria-describedby\"?: string\n    }>\n  >\n\n  // Internal options storage (for cache comparison)\n  _options: FieldOptions\n\n  // Type-safe sub-field creation (enables fluent interface)\n  field<K extends keyof T>(\n    key: K,\n    options?: FieldOptions\n  ): T[K] extends readonly (infer U)[] ? FormFieldArray<U> : FormField<T[K]>\n  fieldArray<K extends keyof T>(key: K): T[K] extends readonly (infer U)[] ? FormFieldArray<U> : never\n\n  // Field actions\n  blur: () => void // Unsets as currently editing\n}\n\nexport interface FormFieldArray<T> extends Omit<FormField<T[]>, \"field\" | \"fieldArray\"> {\n  // Array-specific methods\n  add: (item?: Partial<T>) => Promise<any>\n  remove: (index: number) => Promise<any>\n  move: (from: number, to: number) => Promise<any>\n\n  // Reactive array of field instances for iteration\n  fields: Readonly<Ref<FormField<T>[]>>\n\n  // Get individual array item fields\n  field: <P extends string | number>(path: P, options?: FieldOptions) => ArrayFieldPath<T, P>\n  fieldArray: <P extends string | number>(path: P) => ArrayFieldArrayPath<T, P>\n}\n\nexport interface UseLiveFormReturn<T extends object> {\n  // Form-level state\n  isValid: Ref<boolean>\n  isDirty: Ref<boolean>\n  isTouched: Ref<boolean>\n  isValidating: Readonly<Ref<boolean>>\n  submitCount: Readonly<Ref<number>>\n  initialValues: Readonly<T>\n\n  // Type-safe field factory functions\n  field<P extends PathsToStringProps<T>>(path: P, options?: FieldOptions): FormField<PathValue<T, P>>\n  fieldArray<P extends PathsToStringProps<T>>(\n    path: P\n  ): PathValue<T, P> extends readonly (infer U)[] ? FormFieldArray<U> : never\n\n  // Form actions\n  submit: () => Promise<Form<T>>\n  reset: () => void\n}\n\nexport function useLiveForm<T extends object>(\n  form: MaybeRefOrGetter<Form<T>>,\n  options: FormOptions = {}\n): UseLiveFormReturn<T> {\n  const {\n    changeEvent = null,\n    submitEvent = \"submit\",\n    debounceInMiliseconds = 300,\n    prepareData = (data: any) => data,\n  } = options\n\n  // Get initial form data\n  const initialForm = toValue(form)\n  const initialValues = reactive(deepClone(initialForm.values)) as T\n  const currentValues = reactive(deepClone(initialForm.values)) as T\n  const currentErrors = reactive(deepClone(initialForm.errors)) as FormErrors<T>\n\n  // Form-level state tracking\n  const touchedFields = reactive<Set<string>>(new Set())\n  const submitCount = ref(0)\n\n  // Memoization for field instances to prevent recreation\n  const fieldCache = new Map<string, FormField<any>[]>()\n  const fieldArrayCache = new Map<string, FormFieldArray<any>>()\n\n  // Helper function to check if any errors exist in nested error structure\n  function hasAnyErrors(errors: any): boolean {\n    if (Array.isArray(errors)) {\n      // Check if it's an array of strings (field errors) or array of objects (nested form errors)\n      if (errors.length === 0) return false\n\n      // If first item is string, it's a field error array\n      if (typeof errors[0] === \"string\") {\n        return errors.length > 0\n      }\n\n      // If first item is object, it's an array of nested error objects\n      return errors.some(item => hasAnyErrors(item))\n    }\n    if (typeof errors === \"object\" && errors !== null) {\n      return Object.values(errors).some(value => hasAnyErrors(value))\n    }\n    return false\n  }\n\n  // Form-level computed properties\n  const isValid = computed(() => !hasAnyErrors(currentErrors))\n\n  const isDirty = computed(() => {\n    return JSON.stringify(currentValues) !== JSON.stringify(initialValues)\n  })\n\n  const isTouched = computed(() => {\n    return submitCount.value > 0 || touchedFields.size > 0\n  })\n\n  // LiveView integration\n  const live = useLiveVite()\n\n  // Immediate change handler\n  const sendChanges = async (): Promise<any> => {\n    if (changeEvent) {\n      const values = deepToRaw(currentValues)\n      const data = prepareData(values)\n      return new Promise(resolve =>\n        live.pushEvent(changeEvent, { [initialForm.name]: data }, (result: any) => {\n          resolve(result)\n        })\n      )\n    } else {\n      return Promise.resolve(null)\n    }\n  }\n\n  // Create debounced change handler with validation status\n  const debounceWait = live && changeEvent ? debounceInMiliseconds : 0\n  const { debouncedFn: debouncedSendChanges, isPending: isValidatingChanges } = debounce(sendChanges, debounceWait)\n\n  // Create a form field for a given path\n  function createFormField<V>(path: string, options: FieldOptions = {}): FormField<V> {\n    // Get or create array of fields for this path\n    if (!fieldCache.has(path)) {\n      fieldCache.set(path, [])\n    }\n    const fieldsForPath = fieldCache.get(path)!\n\n    // Find existing field with matching options\n    const existingField = fieldsForPath.find(f => deepEqual(f._options, options))\n    if (existingField) {\n      return existingField as FormField<V>\n    }\n\n    // For checkboxes with values, determine multi-checkbox behavior based on current value type\n\n    const keys = parsePath(path)\n    const fieldId = sanitizeId(path) + (options.value !== undefined ? `_${sanitizeId(String(options.value))}` : \"\")\n\n    const fieldValue = computed({\n      get(): V {\n        return getValueByPath(currentValues, keys)\n      },\n      set(newValue: V) {\n        setValueByPath(currentValues, keys, newValue)\n        debouncedSendChanges()\n      },\n    })\n\n    const fieldErrors = computed(() => {\n      const errors = getValueByPath(currentErrors, keys)\n      return Array.isArray(errors) ? errors : []\n    })\n\n    const fieldErrorMessage = computed(() => {\n      const errors = fieldErrors.value\n      return errors.length > 0 ? errors[0] : undefined\n    })\n\n    const fieldIsValid = computed(() => fieldErrors.value.length === 0)\n    const fieldIsTouched = computed(() => submitCount.value > 0 || touchedFields.has(path))\n    const fieldIsDirty = computed(() => {\n      const initialVal = getValueByPath(initialValues, keys)\n      return JSON.stringify(fieldValue.value) !== JSON.stringify(initialVal)\n    })\n\n    const setTouched = () => touchedFields.add(path)\n    const isMultiCheckboxValue = options.type === \"checkbox\" && Array.isArray(fieldValue.value)\n\n    const fieldInputAttrs = computed(() => {\n      const baseAttrs = {\n        name: path,\n        id: fieldId,\n        type: options.type,\n        onBlur: setTouched,\n        \"aria-invalid\": !fieldIsValid.value,\n        ...(fieldErrors.value.length > 0 ? { \"aria-describedby\": `${fieldId}-error` } : {}),\n      }\n\n      // if it's a multi-checkbox, we need to set or unset the value in the array\n      if (isMultiCheckboxValue) {\n        return {\n          ...baseAttrs,\n          value: options.value,\n          checked: ((fieldValue.value as V[]) || []).includes(options.value),\n          onInput: (event: Event) => {\n            const target = event.target as HTMLInputElement\n            const currentArray = fieldValue.value as V[]\n            const idx = currentArray.indexOf(options.value)\n            if (target.checked && idx === -1) {\n              currentArray.push(options.value)\n            } else if (!target.checked && idx !== -1) {\n              currentArray.splice(idx, 1)\n            }\n          },\n        }\n      } else if (options.type === \"checkbox\") {\n        const optionsValue = options.value !== undefined ? options.value : true\n        return {\n          ...baseAttrs,\n          value: options.value,\n          checked: fieldValue.value === optionsValue,\n          onInput: (event: Event) => {\n            const target = event.target as HTMLInputElement\n            fieldValue.value = target.checked ? optionsValue : null\n          },\n        }\n      } else {\n        // Regular input\n        return {\n          ...baseAttrs,\n          value: fieldValue.value,\n          onInput: (event: Event) => {\n            const target = event.target as HTMLInputElement\n            fieldValue.value = target.value as V\n          },\n        }\n      }\n    })\n\n    const field: FormField<V> = {\n      value: fieldValue,\n      errors: fieldErrors as Readonly<Ref<string[]>>,\n      errorMessage: fieldErrorMessage as Readonly<Ref<string | undefined>>,\n      isValid: fieldIsValid,\n      isDirty: fieldIsDirty,\n      isTouched: fieldIsTouched,\n      inputAttrs: fieldInputAttrs,\n      _options: options,\n\n      field<K extends keyof V>(\n        key: K,\n        options?: FieldOptions\n      ): V[K] extends readonly (infer U)[] ? FormFieldArray<U> : FormField<V[K]> {\n        const subPath = path ? `${path}.${String(key)}` : String(key)\n        return createFormField(subPath, options) as V[K] extends readonly (infer U)[]\n          ? FormFieldArray<U>\n          : FormField<V[K]>\n      },\n\n      fieldArray<K extends keyof V>(key: K): V[K] extends readonly (infer U)[] ? FormFieldArray<U> : never {\n        const subPath = path ? `${path}.${String(key)}` : String(key)\n        return createFormFieldArray(subPath) as V[K] extends readonly (infer U)[] ? FormFieldArray<U> : never\n      },\n\n      blur() {\n        touchedFields.add(path)\n      },\n    }\n\n    // Add to cache\n    fieldsForPath.push(field)\n\n    return field\n  }\n\n  function createFormFieldArray<V>(path: string): FormFieldArray<V> {\n    // Check cache first\n    if (fieldArrayCache.has(path)) {\n      return fieldArrayCache.get(path) as FormFieldArray<V>\n    }\n\n    const baseField = createFormField<V[]>(path)\n    const keys = parsePath(path)\n\n    const updateArray = (newArray: V[]) => {\n      setValueByPath(currentValues, keys, newArray)\n      return debouncedSendChanges()\n    }\n\n    const fieldArray = {\n      ...baseField,\n\n      add(item?: Partial<V>) {\n        // we don't want to add item immediately, rather we want to send it to the server if validation is enabled\n        const currentArray = baseField.value.value || []\n        return updateArray([...currentArray, item as V])\n      },\n\n      remove(index: number) {\n        const currentArray = baseField.value.value || []\n        return updateArray(currentArray.filter((_, i) => i !== index))\n      },\n\n      move(from: number, to: number) {\n        const currentArray = [...(baseField.value.value || [])]\n        if (from >= 0 && from < currentArray.length && to >= 0 && to < currentArray.length) {\n          const item = currentArray.splice(from, 1)[0]\n          currentArray.splice(to, 0, item)\n          return updateArray(currentArray)\n        } else {\n          return Promise.resolve()\n        }\n      },\n\n      fields: computed(() => {\n        const array = baseField.value.value || []\n        return array.map((_, index) => createFormField<V>(`${path}[${index}]`))\n      }) as Readonly<Ref<FormField<V>[]>>,\n\n      field<P extends string | number>(pathOrIndex: P, options?: FieldOptions): ArrayFieldPath<V, P> {\n        // Handle number shortcut: convert 0 to \"[0]\"\n        if (typeof pathOrIndex === \"number\") {\n          return createFormField(`${path}[${pathOrIndex}]`, options) as ArrayFieldPath<V, P>\n        }\n        // Handle string path: use as-is, could be \"[0]\", \"[0].name\", etc.\n        return createFormField(`${path}${pathOrIndex}`, options) as ArrayFieldPath<V, P>\n      },\n\n      fieldArray<P extends string | number>(pathOrIndex: P): ArrayFieldArrayPath<V, P> {\n        // Handle number shortcut: convert 0 to \"[0]\"\n        if (typeof pathOrIndex === \"number\") {\n          return createFormFieldArray(`${path}[${pathOrIndex}]`) as ArrayFieldArrayPath<V, P>\n        }\n        // Handle string path: use as-is, could be \"[0]\", \"[0].tags\", etc.\n        return createFormFieldArray(`${path}${pathOrIndex}`) as ArrayFieldArrayPath<V, P>\n      },\n    }\n\n    // Cache the field array instance\n    fieldArrayCache.set(path, fieldArray)\n    return fieldArray\n  }\n\n  // Method to update form state from server\n  function updateFromServer(newForm: Form<T>) {\n    // Always update errors, we don't want to lose them\n    replaceReactiveObject(currentErrors, deepClone(newForm.errors))\n\n    // Only apply value updates if no validation is in progress\n    // Otherwise we could overwrite local client data with server data\n    if (!isValidatingChanges.value) {\n      Object.assign(currentValues, deepClone(newForm.values))\n    }\n  }\n\n  // Watch for server updates to the form\n  // setTimeout ensures updates are processed after current execution cycle\n  const stopWatchingForm = watch(\n    () => toValue(form),\n    () => setTimeout(() => updateFromServer(toValue(form)), 0),\n    { deep: true }\n  )\n\n  const reset = () => {\n    Object.assign(currentValues, deepClone(initialValues))\n    touchedFields.clear()\n    submitCount.value = 0\n  }\n\n  const submit = async () => {\n    // Increment submit count to mark all fields as touched\n    submitCount.value += 1\n\n    if (live) {\n      const data = prepareData(deepToRaw(currentValues))\n\n      return await new Promise<Form<T>>(resolve => {\n        // Send submit event to LiveView\n        live.pushEvent(submitEvent, { [initialForm.name]: data }, (result: any) => {\n          // if it was successful, we want to reset the form, but it's hard to determine if it was successfull or not in an automated way\n          // because eg initial form might have errors\n          // so, user should reset his form manually if it was successfull\n          // we provide a shortcut: if there's a reply with {reset: true},\n          // it means it should be resetted on the client side as well\n          if (result && result.reset) {\n            setTimeout(() => {\n              // let's wait for update from the server to be processed\n              Object.assign(initialValues, deepClone(currentValues))\n              reset()\n            }, 0)\n          }\n          resolve(result)\n        })\n      })\n    } else {\n      // Fallback when not in LiveView context\n      console.warn(\"LiveView hook not available, form submission skipped\")\n      return Promise.resolve(undefined as any)\n    }\n  }\n\n  // Clean up watchers when component unmounts\n  onScopeDispose(() => {\n    stopWatchingForm()\n  })\n\n  const formInstance = {\n    isValid,\n    isDirty,\n    isTouched,\n    isValidating: readonly(isValidatingChanges) as Readonly<Ref<boolean>>,\n    submitCount: readonly(submitCount),\n    initialValues: readonly(initialValues) as Readonly<T>,\n    submit: submit,\n    reset: reset,\n    field<P extends PathsToStringProps<T>>(path: P, options?: FieldOptions): FormField<PathValue<T, P>> {\n      return createFormField<PathValue<T, P>>(path as string, options)\n    },\n\n    fieldArray<P extends PathsToStringProps<T>>(path: P): any {\n      return createFormFieldArray(path as string)\n    },\n  }\n\n  // Provide the form instance to child components\n  provide(LIVE_FORM_INJECTION_KEY, formInstance as any)\n\n  return formInstance\n}\n\n/**\n * Hook to access form fields from an injected form instance\n * @param path - The field path (e.g., \"name\", \"user.email\", \"items[0].title\")\n * @throws Error if no form was provided via inject\n * @returns FormField instance for the specified path\n */\nexport function useField<T = any>(path: string, options?: FieldOptions): FormField<T> {\n  const form = inject(LIVE_FORM_INJECTION_KEY)\n\n  if (!form) {\n    throw new Error(\n      \"useField() can only be used inside components where a form has been provided. \" +\n        \"Make sure to use useLiveForm() in a parent component.\"\n    )\n  }\n\n  return form.field(path, options) as FormField<T>\n}\n\n/**\n * Hook to access form array fields from an injected form instance\n * @param path - The field path for an array field (e.g., \"items\", \"user.tags\", \"posts[0].comments\")\n * @throws Error if no form was provided via inject\n * @returns FormFieldArray instance for the specified path\n */\nexport function useArrayField<T = any>(path: string): FormFieldArray<T> {\n  const form = inject(LIVE_FORM_INJECTION_KEY)\n\n  if (!form) {\n    throw new Error(\n      \"useArrayField() can only be used inside components where a form has been provided. \" +\n        \"Make sure to use useLiveForm() in a parent component.\"\n    )\n  }\n\n  return form.fieldArray(path) as FormFieldArray<T>\n}\n","numLines":631,"startLine":1,"totalLines":631}}}
