imeout(timeout)\n   199→\n   200→      timeout = setTimeout(async () => {\n   201→        const currentResolvers = pendingResolvers\n   202→        pendingResolvers = []\n   203→        timeout = null\n   204→        timeoutRef.value = null\n   205→        executingCount++\n   206→        executingCountRef.value++\n   207→\n   208→        try {\n   209→          const result = await func(...args)\n   210→          currentResolvers.forEach(({ resolve }) => resolve(result))\n   211→        } catch (error) {\n   212→          currentResolvers.forEach(({ reject }) => reject(error))\n   213→        } finally {\n   214→          executingCount--\n   215→          executingCountRef.value--\n   216→        }\n   217→      }, wait)\n   218→\n   219→      timeoutRef.value = timeout\n   220→    })\n   221→  }\n   222→\n   223→  const isPending = computed(() => timeoutRef.value !== null || executingCountRef.value > 0)\n   224→\n   225→  return { debouncedFn, isPending }\n   226→}\n   227→\n   228→export const cacheOnAccessProxy = <T extends object>(createFunc: (key: keyof T) => any) =>\n   229→  new Proxy(\n   230→    {},\n   231→    {\n   232→      // @ts-expect-error proxy get always expect string key\n   233→      get: (fields, key: keyof T) => {\n   234→        if (typeof key === \"string\" && key.startsWith(\"__\")) {\n   235→          return Reflect.get(fields, key)\n   236→        }\n   237→        if (!Reflect.has(fields, key)) {\n   238→          Reflect.set(fields, key, createFunc(key))\n   239→        }\n   240→        return Reflect.get(fields, key)\n   241→      },\n   242→    }\n   243→  )\n   244→\n   245→/**\n   246→ * Parses a path string like \"user.items[0].name\" into an array of keys\n   247→ */\n   248→export function parsePath(path: string): (string | number)[] {\n   249→  if (!path) return []\n   250→\n   251→  const keys: (string | number)[] = []\n   252→  let current = \"\"\n   253→  let i = 0\n   254→\n   255→  while (i < path.length) {\n   256→    const char = path[i]\n   257→\n   258→    if (char === \".\") {\n   259→      if (current) {\n   260→        keys.push(current)\n   261→        current = \"\"\n   262→      }\n   263→    } else if (char === \"[\") {\n   264→      if (current) {\n   265→        keys.push(current)\n   266→        current = \"\"\n   267→      }\n   268→\n   269→      // Find the closing bracket\n   270→      i++\n   271→      let bracketContent = \"\"\n   272→      while (i < path.length && path[i] !== \"]\") {\n   273→        bracketContent += path[i]\n   274→        i++\n   275→      }\n   276→\n   277→      if (path[i] === \"]\") {\n   278→        const index = parseInt(bracketContent, 10)\n   279→        if (!isNaN(index)) {\n   280→          keys.push(index)\n   281→        } else {\n   282→          keys.push(bracketContent) // String key in brackets\n   283→        }\n   284→      }\n   285→    } else {\n   286→      current += char\n   287→    }\n   288→\n   289→    i++\n   290→  }\n   291→\n   292→  if (current) {\n   293→    keys.push(current)\n   294→  }\n   295→\n   296→  return keys\n   297→}\n   298→\n   299→/**\n   300→ * Gets a value from an object using a parsed path\n   301→ */\n   302→export function getValueByPath(obj: any, keys: (string | number)[]): any {\n   303→  let current = obj\n   304→\n   305→  for (const key of keys) {\n   306→    if (current == null) return undefined\n   307→    current = current[key]\n   308→  }\n   309→\n   310→  return current\n   311→}\n   312→\n   313→/**\n   314→ * Sets a value in an object using a parsed path\n   315→ */\n   316→export function setValueByPath(obj: any, keys: (string | number)[], value: any): void {\n   317→  if (keys.length === 0) return\n   318→\n   319→  let current = obj\n   320→\n   321→  for (let i = 0; i < keys.length - 1; i++) {\n   322→    const key = keys[i]\n   323→    if (current[key] == null) {\n   324→      // Create object or array based on next key type\n   325→      const nextKey = keys[i + 1]\n   326→      current[key] = typeof nextKey === \"number\" ? [] : {}\n   327→    }\n   328→    current = current[key]\n   329→  }\n   330→\n   331→  const lastKey = keys[keys.length - 1]\n   332→  current[lastKey] = value\n   333→}\n   334→\n   335→/**\n   336→ * Deep clone utility - alias for existing deepCopy function for consistency\n   337→ */\n   338→export const deepClone = deepCopy\n   339→\n   340→/**\n   341→ * Helper function to replace reactive object contents while preserving reactivity\n   342→ */\n   343→export function replaceReactiveObject(target: any, source: any) {\n   344→  // Remove properties that exist in target but not in source\n   345→  for (const key in target) {\n   346→    if (!(key in source)) {\n   347→      delete target[key]\n   348→    }\n   349→  }\n   350→\n   351→  // Recursively update/add properties from source\n   352→  for (const key in source) {\n   353→    if (typeof source[key] === \"object\" && source[key] !== null && !Array.isArray(source[key])) {\n   354→      // Handle nested objects\n   355→      if (!target[key] || typeof target[key] !== \"object\" || Array.isArray(target[key])) {\n   356→        target[key] = {}\n   357→      }\n   358→      replaceReactiveObject(target[key], source[key])\n   359→    } else {\n   360→      // Handle primitive values and arrays\n   361→      target[key] = source[key]\n   362→    }\n   363→  }\n   364→}\n   365→\n   366→/**\n   367→ * Deep equality comparison for objects\n   368→ */\n   369→export function deepEqual(a: any, b: any): boolean {\n   370→  if (a === b) return true\n   371→  if (a == null || b == null) return false\n   372→  if (typeof a !== 'object' || typeof b !== 'object') return false\n   373→  \n   374→  const keysA = Object.keys(a).sort()\n   375→  const keysB = Object.keys(b).sort()\n   376→  \n   377→  if (keysA.length !== keysB.length) return false\n   378→  \n   379→  for (let i = 0; i < keysA.length; i++) {\n   380→    if (keysA[i] !== keysB[i]) return false\n   381→    if (!deepEqual(a[keysA[i]], b[keysB[i]])) return false\n   382→  }\n   383→  \n   384→  return true\n   385→}\n   386→\n   387→/**\n   388→ * Sanitizes a string for use as an HTML ID attribute\n   389→ */\n   390→export function sanitizeId(input: string): string {\n   391→  return input.replace(/\\./g, \"_\").replace(/\\[|\\]/g, \"_\").replace(/_+/g, \"_\").replace(/^_|_$/g, \"\")\n   392→}\n   393→\n   394→/**\n   395→ * Takes a string that has been encoded in UTF-8 and then Base64 and returns\n   396→ * a decoded JS string.\n   397→ */\n   398→export const fromUtf8Base64 = (base64: string) => {\n   399→  // atob decodes the Base64 string, but returns each UTF-8 byte as an ASCII\n   400→  // character. So we need to get the values of these characters, put them in\n   401→  // a Uint8Array and then decode that back into a string. Ideally, we'd use\n   402→  // the Uint8Array.fromBase64 function, but this isn't widely available yet\n   403→  const utf8AsciiString = atob(base64);\n   404→  const utf8Uint8Array = new Uint8Array(utf8AsciiString.length);\n   405→  for (let i = 0; i < utf8AsciiString.length; i++) {\n   406→    utf8Uint8Array[i] = utf8AsciiString.charCodeAt(i);\n   407→  }\n   408→  return new TextDecoder(\"utf-8\").decode(utf8Uint8Array);\n   409→}\n   410→\n   411→/**\n   412→ * Encodes a JS string in UTF-8 and Base64. Only here for testing purposes:\n   413→ * because it uses the spread operator, it will break on strings whose\n   414→ * UTF-8 encoding is longer than 64KiB, so it is NOT suitable for production\n   415→ * use!\n   416→ */\n   417→export const toUtf8Base64 = (str: string) => {\n   418→  const utf8Uint8Array = new TextEncoder().encode(str);\n   419→  return btoa(String.fromCharCode(...utf8Uint8Array));\n   420→}\n   421→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the c