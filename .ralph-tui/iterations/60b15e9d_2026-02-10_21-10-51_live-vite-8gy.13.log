53→    expect(renderer.name).toBe(\"react\")\n    54→  })\n    55→\n    56→  describe(\"mount\", () => {\n    57→    it(\"returns a RendererState with props, slots, and app\", () => {\n    58→      const state = mountComponent({ props: { count: 0, message: \"hello\" } })\n    59→\n    60→      expect(state.props).toBeDefined()\n    61→      expect(state.slots).toBeDefined()\n    62→      expect(state.app).toBeDefined()\n    63→    })\n    64→\n    65→    it(\"stores initial props on the state\", () => {\n    66→      const state = mountComponent({ props: { count: 5, message: \"test\" } })\n    67→\n    68→      expect(state.props.count).toBe(5)\n    69→      expect(state.props.message).toBe(\"test\")\n    70→    })\n    71→\n    72→    it(\"converts slot HTML strings to render functions\", () => {\n    73→      const state = mountComponent({\n    74→        slots: { default: \"<p>Hello</p>\", header: \"<h1>Title</h1>\" },\n    75→      })\n    76→\n    77→      expect(typeof state.slots.default).toBe(\"function\")\n    78→      expect(typeof state.slots.header).toBe(\"function\")\n    79→    })\n    80→\n    81→    it(\"renders content into the DOM element\", () => {\n    82→      const el = document.createElement(\"div\")\n    83→      document.body.appendChild(el)\n    84→\n    85→      mountComponent({ props: { count: 42, message: \"rendered\" }, el })\n    86→\n    87→      expect(el.textContent).toContain(\"rendered: 42\")\n    88→\n    89→      document.body.removeChild(el)\n    90→    })\n    91→  })\n    92→\n    93→  describe(\"updateProps\", () => {\n    94→    it(\"merges new props into the state\", () => {\n    95→      const state = mountComponent({ props: { count: 0, message: \"hello\" } })\n    96→\n    97→      act(() => {\n    98→        renderer.updateProps(state, { count: 42, message: \"updated\" })\n    99→      })\n   100→\n   101→      expect(state.props.count).toBe(42)\n   102→      expect(state.props.message).toBe(\"updated\")\n   103→    })\n   104→\n   105→    it(\"preserves the same object reference\", () => {\n   106→      const state = mountComponent({ props: { count: 0 } })\n   107→\n   108→      const propsRef = state.props\n   109→      act(() => {\n   110→        renderer.updateProps(state, { count: 10 })\n   111→      })\n   112→\n   113→      expect(state.props).toBe(propsRef)\n   114→    })\n   115→  })\n   116→\n   117→  describe(\"patchProps\", () => {\n   118→    it(\"applies JSON Patch operations in-place\", () => {\n   119→      const state = mountComponent({ props: { count: 0, nested: { value: \"original\" } } })\n   120→\n   121→      act(() => {\n   122→        renderer.patchProps(state, [\n   123→          { op: \"replace\", path: \"/count\", value: 99 },\n   124→          { op: \"replace\", path: \"/nested/value\", value: \"patched\" },\n   125→        ])\n   126→      })\n   127→\n   128→      expect(state.props.count).toBe(99)\n   129→      expect(state.props.nested.value).toBe(\"patched\")\n   130→    })\n   131→\n   132→    it(\"preserves the same object reference\", () => {\n   133→      const state = mountComponent({ props: { count: 0 } })\n   134→\n   135→      const propsRef = state.props\n   136→      act(() => {\n   137→        renderer.patchProps(state, [{ op: \"replace\", path: \"/count\", value: 5 }])\n   138→      })\n   139→\n   140→      expect(state.props).toBe(propsRef)\n   141→    })\n   142→  })\n   143→\n   144→  describe(\"updateSlots\", () => {\n   145→    it(\"converts HTML strings and merges into slots\", () => {\n   146→      const state = mountComponent({ slots: { default: \"<p>Original</p>\" } })\n   147→\n   148→      act(() => {\n   149→        renderer.updateSlots(state, { default: \"<p>Updated</p>\", footer: \"<div>Footer</div>\" })\n   150→      })\n   151→\n   152→      expect(typeof state.slots.default).toBe(\"function\")\n   153→      expect(typeof state.slots.footer).toBe(\"function\")\n   154→    })\n   155→  })\n   156→\n   157→  describe(\"unmount\", () => {\n   158→    it(\"registers a page-loading-stop listener to unmount the root\", () => {\n   159→      const state = mountComponent()\n   160→\n   161→      const addEventListenerSpy = vi.spyOn(window, \"addEventListener\")\n   162→\n   163→      renderer.unmount(state)\n   164→\n   165→      expect(addEventListenerSpy).toHaveBeenCalledWith(\n   166→        \"phx:page-loading-stop\",\n   167→        expect.any(Function),\n   168→        { once: true }\n   169→      )\n   170→    })\n   171→  })\n   172→\n   173→  describe(\"renderToString\", () => {\n   174→    it(\"is defined on the renderer\", () => {\n   175→      expect(typeof renderer.renderToString).toBe(\"function\")\n   176→    })\n   177→\n   178→    it(\"renders a component to an HTML string\", async () => {\n   179→      const html = await renderer.renderToString!({\n   180→        component: TestComponent,\n   181→        props: { count: 42, message: \"ssr\" },\n   182→        slots: {},\n   183→      })\n   184→\n   185→      expect(html).toContain(\"ssr: 42\")\n   186→    })\n   187→\n   188→    it(\"returns HTML with preload separator\", async () => {\n   189→      const html = await renderer.renderToString!({\n   190→        component: TestComponent,\n   191→        props: { count: 0, message: \"test\" },\n   192→        slots: {},\n   193→      })\n   194→\n   195→      expect(html).toContain(\"<!-- preload -->\")\n   196→      const [preloadLinks, content] = html.split(\"<!-- preload -->\")\n   197→      expect(preloadLinks).toBe(\"\")\n   198→      expect(content).toContain(\"test: 0\")\n   199→    })\n   200→\n   201→    it(\"renders slots as React elements with dangerouslySetInnerHTML\", async () => {\n   202→      function SlotComponent(props: { header?: any }) {\n   203→        return createElement(\"div\", null, props.header || \"no slot\")\n   204→      }\n   205→\n   206→      const html = await renderer.renderToString!({\n   207→        component: SlotComponent,\n   208→        props: {},\n   209→        slots: { header: \"<h1>Slot Content</h1>\" },\n   210→      })\n   211→\n   212→      expect(html).toContain(\"Slot Content\")\n   213→    })\n   214→\n   215→    it(\"renders with empty props and slots\", async () => {\n   216→      function EmptyComponent() {\n   217→        return createElement(\"div\", null, \"empty\")\n   218→      }\n   219→\n   220→      const html = await renderer.renderToString!({\n   221→        component: EmptyComponent,\n   222→        props: {},\n   223→        slots: {},\n   224→      })\n   225→\n   226→      expect(html).toContain(\"empty\")\n   227→    })\n   228→  })\n   229→})\n   230→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ca373184-55de-43ea-b9dc-c45b48d70f8a","uuid":"59fcea27-75b5-469a-a8a1-36031bd12c97","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/renderers/react.test.ts","content":"import { describe, it, expect, vi, beforeEach, afterEach } from \"vitest\"\nimport { createElement, act } from \"react\"\nimport { createReactRenderer } from \"./react\"\nimport type { FrameworkRenderer, RendererState } from \"../renderer\"\n\n// Enable React act() environment for jsdom\nglobalThis.IS_REACT_ACT_ENVIRONMENT = true\n\nfunction TestComponent(props: { count?: number; message?: string }) {\n  return createElement(\"div\", null, `${props.message}: ${props.count}`)\n}\n\ndescribe(\"createReactRenderer\", () => {\n  let renderer: FrameworkRenderer\n  let roots: RendererState[] = []\n\n  beforeEach(() => {\n    renderer = createReactRenderer()\n    roots = []\n  })\n\n  afterEach(() => {\n    // Unmount all roots to prevent React scheduler from running after teardown\n    act(() => {\n      for (const state of roots) {\n        if (state.app) {\n          (state.app as any).root.unmount()\n          state.app = null\n        }\n      }\n    })\n  })\n\n  function mountComponent(overrides: Partial<Parameters<typeof renderer.mount>[0]> = {}): RendererState {\n    const el = overrides.el ?? document.createElement(\"div\")\n    let state: RendererState\n    act(() => {\n      state = renderer.mount({\n        component: TestComponent,\n        props: {},\n        slots: {},\n        el,\n        ssr: false,\n        hook: { el },\n        ...overrides,\n      }) as RendererState\n    })\n    roots.push(state!)\n    return state!\n  }\n\n  it(\"has name 'react'\", () => {\n    expect(renderer.name).toBe(\"react\")\n  })\n\n  describe(\"mount\", () => {\n    it(\"returns a RendererState with props, slots, and app\", () => {\n      const state = mountComponent({ props: { count: 0, message: \"hello\" } })\n\n      expect(state.props).toBeDefined()\n      expect(state.slots).toBeDefined()\n      expect(state.app).toBeDefined()\n    })\n\n    it(\"stores initial props on the state\", () => {\n      const state = mountComponent({ props: { count: 5, message: \"test\" } })\n\n      expect(state.props.count).toBe(5)\n      expect(state.props.message).toBe(\"test\")\n    })\n\n    it(\"converts slot HTML strings to render functions\", () => {\n      const state = mountComponent({\n        slots: { default: \"<p>Hello</p>\", header: \"<h1>Title</h1>\" },\n      })\n\n      expect(typeof state.slots.default).toBe(\"function\")\n      expect(typeof state.slots.header).toBe(\"function\")\n    })\n\n    it(\"renders content into the DOM element\", () => {\n      const el = document.createElement(\"div\")\n      document.body.appendChild(el)\n\n      mountComponent({ props: { count: 42, message: \"rendered\" }, el })\n\n      expect(el.textContent).toContain(\"rendered: 42\")\n\n      document.body.removeChild(el)\n    })\n  })\n\n  describe(\"updateProps\", () => {\n    it(\"merges new props into the state\", () => {\n      const state = mountComponent({ props: { count: 0, message: \"hello\" } })\n\n      act(() => {\n        renderer.updateProps(state, { count: 42, message: \"updated\" })\n      })\n\n      expect(state.props.count).toBe(42)\n      expect(state.props.message).toBe(\"updated\")\n    })\n\n    it(\"preserves the same object reference\", () => {\n      const state = mountComponent({ props: { count: 0 } })\n\n      const propsRef = state.props\n      act(() => {\n        renderer.updateProps(state, { count: 10 })\n      })\n\n      expect(state.props).toBe(propsRef)\n    })\n  })\n\n  describe(\"patchProps\", () => {\n    it(\"applies JSON Patch operations in-place\", () => {\n      const state = mountComponent({ props: { count: 0, nested: { value: \"original\" } } })\n\n      act(() => {\n        renderer.patchProps(state, [\n          { op: \"replace\", path: \"/count\", value: 99 },\n          { op: \"replace\", path: \"/nested/value\", value: \"patched\" },\n        ])\n      })\n\n      expect(state.props.count).toBe(99)\n      expect(state.props.nested.value).toBe(\"patched\")\n    })\n\n    it(\"preserves the same object reference\", () => {\n      const state = mountComponent({ props: { count: 0 } })\n\n      const propsRef = state.props\n      act(() => {\n        renderer.patchProps(state, [{ op: \"replace\", path: \"/count\", value: 5 }])\n      })\n\n      expect(state.props).toBe(propsRef)\n    })\n  })\n\n  describe(\"updateSlots\", () => {\n    it(\"converts HTML strings and merges into slots\", () => {\n      const state = mountComponent({ slots: { default: \"<p>Original</p>\" } })\n\n      act(() => {\n        renderer.updateSlots(state, { default: \"<p>Updated</p>\", footer: \"<div>Footer</div>\" })\n      })\n\n      expect(typeof state.slots.default).toBe(\"function\")\n      expect(typeof state.slots.footer).toBe(\"function\")\n    })\n  })\n\n  describe(\"unmount\", () => {\n    it(\"registers a page-loading-stop listener to unmount the root\", () => {\n      const state = mountComponent()\n\n      const addEventListenerSpy = vi.spyOn(window, \"addEventListener\")\n\n      renderer.unmount(state)\n\n      expect(addEventListenerSpy).toHaveBeenCalledWith(\n        \"phx:page-loading-stop\",\n        expect.any(Function),\n        { once: true }\n      )\n    })\n  })\n\n  describe(\"renderToString\", () => {\n    it(\"is defined on the renderer\", () => {\n      expect(typeof renderer.renderToString).toBe(\"function\")\n    })\n\n    it(\"renders a component to an HTML string\", async () => {\n      const html = await renderer.renderToString!({\n        component: TestComponent,\n        props: { count: 42, message: \"ssr\" },\n        slots: {},\n      })\n\n      expect(html).toContain(\"ssr: 42\")\n    })\n\n    it(\"returns HTML with preload separator\", async () => {\n      const html = await renderer.renderToString!({\n        component: TestComponent,\n        props: { count: 0, message: \"test\" },\n        slots: {},\n      })\n\n      expect(html).toContain(\"<!-- preload -->\")\n      const [preloadLinks, content] = html.split(\"<!-- preload -->\")\n      expect(preloadLinks).toBe(\"\")\n      expect(content).toContain(\"test: 0\")\n    })\n\n    it(\"renders slots as React elements with dangerouslySetInnerHTML\", async () => {\n      function SlotComponent(props: { header?: any }) {\n        return createElement(\"div\", null, props.header || \"no slot\")\n      }\n\n      const html = await renderer.renderToString!({\n        component: SlotComponent,\n        props: {},\n        slots: { header: \"<h1>Slot Content</h1>\" },\n      })\n\n      expect(html).toContain(\"Slot Content\")\n    })\n\n    it(\"renders with empty props and slots\", async () => {\n      function EmptyComponent() {\n        return createElement(\"div\", null, \"empty\")\n      }\n\n      const html = await renderer.renderToString!({\n        component: EmptyComponent,\n        props: {},\n        slots: {},\n      })\n\n      expect(html).toContain(\"empty\")\n    })\n  })\n})\n","numLines":230,"startLine":1,"totalLines":230}}}
