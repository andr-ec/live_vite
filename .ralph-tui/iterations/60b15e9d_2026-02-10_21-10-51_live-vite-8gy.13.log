53→      return createElement(\"div\", null, \"test\")\n    54→    }\n    55→\n    56→    act(() => {\n    57→      root = createRoot(container)\n    58→      root.render(\n    59→        createElement(LiveContext.Provider, { value: mockHook as any },\n    60→          createElement(TestComponent)\n    61→        )\n    62→      )\n    63→    })\n    64→\n    65→    expect(capturedLive).toBe(mockHook)\n    66→  })\n    67→\n    68→  it(\"throws when used outside a LiveContext provider\", () => {\n    69→    const errors: Error[] = []\n    70→\n    71→    function TestComponent() {\n    72→      try {\n    73→        useLive()\n    74→      } catch (e) {\n    75→        errors.push(e as Error)\n    76→      }\n    77→      return createElement(\"div\", null, \"test\")\n    78→    }\n    79→\n    80→    act(() => {\n    81→      root = createRoot(container)\n    82→      root.render(createElement(TestComponent))\n    83→    })\n    84→\n    85→    expect(errors.length).toBe(1)\n    86→    expect(errors[0].message).toContain(\"LiveContext not provided\")\n    87→  })\n    88→\n    89→  it(\"provides access to pushEvent\", () => {\n    90→    const mockHook = createMockHook()\n    91→    let capturedLive: any\n    92→\n    93→    function TestComponent() {\n    94→      capturedLive = useLive()\n    95→      return createElement(\"div\", null, \"test\")\n    96→    }\n    97→\n    98→    act(() => {\n    99→      root = createRoot(container)\n   100→      root.render(\n   101→        createElement(LiveContext.Provider, { value: mockHook as any },\n   102→          createElement(TestComponent)\n   103→        )\n   104→      )\n   105→    })\n   106→\n   107→    capturedLive.pushEvent(\"my-event\", { data: 1 })\n   108→    expect(mockHook.pushEvent).toHaveBeenCalledWith(\"my-event\", { data: 1 })\n   109→  })\n   110→})\n   111→\n   112→describe(\"useLiveEvent\", () => {\n   113→  let container: HTMLDivElement\n   114→  let root: Root\n   115→\n   116→  beforeEach(() => {\n   117→    container = document.createElement(\"div\")\n   118→    document.body.appendChild(container)\n   119→  })\n   120→\n   121→  afterEach(() => {\n   122→    act(() => {\n   123→      root?.unmount()\n   124→    })\n   125→    document.body.removeChild(container)\n   126→  })\n   127→\n   128→  it(\"registers an event handler on mount\", () => {\n   129→    const mockHook = createMockHook()\n   130→    const callback = vi.fn()\n   131→\n   132→    function TestComponent() {\n   133→      useLiveEvent(\"server-event\", callback)\n   134→      return createElement(\"div\", null, \"test\")\n   135→    }\n   136→\n   137→    act(() => {\n   138→      root = createRoot(container)\n   139→      root.render(\n   140→        createElement(LiveContext.Provider, { value: mockHook as any },\n   141→          createElement(TestComponent)\n   142→        )\n   143→      )\n   144→    })\n   145→\n   146→    expect(mockHook.handleEvent).toHaveBeenCalledWith(\"server-event\", expect.any(Function))\n   147→  })\n   148→\n   149→  it(\"calls the callback when the event fires\", () => {\n   150→    const mockHook = createMockHook()\n   151→    const callback = vi.fn()\n   152→\n   153→    function TestComponent() {\n   154→      useLiveEvent(\"server-event\", callback)\n   155→      return createElement(\"div\", null, \"test\")\n   156→    }\n   157→\n   158→    act(() => {\n   159→      root = createRoot(container)\n   160→      root.render(\n   161→        createElement(LiveContext.Provider, { value: mockHook as any },\n   162→          createElement(TestComponent)\n   163→        )\n   164→      )\n   165→    })\n   166→\n   167→    // Simulate the server sending an event\n   168→    const registeredCallback = mockHook.handleEvent.mock.calls[0][1]\n   169→    registeredCallback({ value: 42 })\n   170→\n   171→    expect(callback).toHaveBeenCalledWith({ value: 42 })\n   172→  })\n   173→\n   174→  it(\"removes the event handler on unmount\", () => {\n   175→    const moc