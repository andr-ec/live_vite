{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019BNpPXi4uK7CPMMCCvGxoj","type":"tool_result","content":"   348→  @doc false\n   349→  @deprecated \"~V sigil is deprecated, please use ~VUE instead.\"\n   350→  defmacro sigil_V(term, modifiers) do\n   351→    do_sigil(term, modifiers, :vue, __CALLER__)\n   352→  end\n   353→\n   354→  @doc \"\"\"\n   355→  Inlines a Vue single-file component inside a LiveView.\n   356→\n   357→  Writes the template to `./assets/vue/_build/{module}.vue` at compile time\n   358→  and renders it using `LiveVite.vue/1`.\n   359→\n   360→  ## Example\n   361→\n   362→      def render(assigns) do\n   363→        ~VUE\\\"\\\"\\\"\n   364→        <template>\n   365→          <div>{{ message }}</div>\n   366→        </template>\n   367→\n   368→        <script setup>\n   369→          defineProps({ message: String })\n   370→        </script>\n   371→        \\\"\\\"\\\"\n   372→      end\n   373→  \"\"\"\n   374→  defmacro sigil_VUE(term, modifiers) do\n   375→    do_sigil(term, modifiers, :vue, __CALLER__)\n   376→  end\n   377→\n   378→  @doc \"\"\"\n   379→  Inlines a React component (TSX) inside a LiveView.\n   380→\n   381→  Writes the template to `./assets/vue/_build/{module}.tsx` at compile time\n   382→  and renders it using `LiveVite.react/1`.\n   383→\n   384→  ## Example\n   385→\n   386→      def render(assigns) do\n   387→        ~REACT\\\"\\\"\\\"\n   388→        export default function({ message }: { message: string }) {\n   389→          return <div>{message}</div>\n   390→        }\n   391→        \\\"\\\"\\\"\n   392→      end\n   393→  \"\"\"\n   394→  defmacro sigil_REACT(term, modifiers) do\n   395→    do_sigil(term, modifiers, :react, __CALLER__)\n   396→  end\n   397→\n   398→  @framework_sigil_config %{\n   399→    vue: %{extension: \".vue\"},\n   400→    react: %{extension: \".tsx\"}\n   401→  }\n   402→\n   403→  defp do_sigil({:<<>>, _meta, [string]}, [], framework, caller) do\n   404→    config = @framework_sigil_config[framework]\n   405→    path = \"./assets/vue/_build/#{caller.module}#{config.extension}\"\n   406→\n   407→    with :ok <- File.mkdir_p(Path.dirname(path)) do\n   408→      File.write!(path, string)\n   409→    end\n   410→\n   411→    do_sigil_template(framework)\n   412→  end\n   413→\n   414→  defp do_sigil_template(:vue) do\n   415→    quote do\n   416→      ~H\"\"\"\n   417→      <LiveVite.vue\n   418→        class={get_in(assigns, [:vue_opts, :class])}\n   419→        v-component={\"_build/#{__MODULE__}\"}\n   420→        v-socket={get_socket(assigns)}\n   421→        v-ssr={get_in(assigns, [:vue_opts, :ssr]) != false}\n   422→        {Map.drop(assigns, [:vue_opts, :socket, :flash, :live_action])}\n   423→      />\n   424→      \"\"\"\n   425→    end\n   426→  end\n   427→\n   428→  defp do_sigil_template(:react) do\n   429→    quote do\n   430→      ~H\"\"\"\n   431→      <LiveVite.react\n   432→        class={get_in(assigns, [:vue_opts, :class])}\n   433→        v-component={\"_build/#{__MODULE__}\"}\n   434→        v-socket={get_socket(assigns)}\n   435→        v-ssr={get_in(assigns, [:vue_opts, :ssr]) != false}\n   436→        {Map.drop(assigns, [:vue_opts, :socket, :flash, :live_action])}\n   437→      />\n   438→      \"\"\"\n   439→    end\n   440→  end\n   441→end\n   442→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5ac10091-ab71-4c98-8d1a-2ddf315e307c","uuid":"36c5fb47-3ea2-4b86-970b-5bfd7c496126","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/lib/live_vite.ex","content":"  @doc false\n  @deprecated \"~V sigil is deprecated, please use ~VUE instead.\"\n  defmacro sigil_V(term, modifiers) do\n    do_sigil(term, modifiers, :vue, __CALLER__)\n  end\n\n  @doc \"\"\"\n  Inlines a Vue single-file component inside a LiveView.\n\n  Writes the template to `./assets/vue/_build/{module}.vue` at compile time\n  and renders it using `LiveVite.vue/1`.\n\n  ## Example\n\n      def render(assigns) do\n        ~VUE\\\"\\\"\\\"\n        <template>\n          <div>{{ message }}</div>\n        </template>\n\n        <script setup>\n          defineProps({ message: String })\n        </script>\n        \\\"\\\"\\\"\n      end\n  \"\"\"\n  defmacro sigil_VUE(term, modifiers) do\n    do_sigil(term, modifiers, :vue, __CALLER__)\n  end\n\n  @doc \"\"\"\n  Inlines a React component (TSX) inside a LiveView.\n\n  Writes the template to `./assets/vue/_build/{module}.tsx` at compile time\n  and renders it using `LiveVite.react/1`.\n\n  ## Example\n\n      def render(assigns) do\n        ~REACT\\\"\\\"\\\"\n        export default function({ message }: { message: string }) {\n          return <div>{message}</div>\n        }\n        \\\"\\\"\\\"\n      end\n  \"\"\"\n  defmacro sigil_REACT(term, modifiers) do\n    do_sigil(term, modifiers, :react, __CALLER__)\n  end\n\n  @framework_sigil_config %{\n    vue: %{extension: \".vue\"},\n    react: %{extension: \".tsx\"}\n  }\n\n  defp do_sigil({:<<>>, _meta, [string]}, [], framework, caller) do\n    config = @framework_sigil_config[framework]\n    path = \"./assets/vue/_build/#{caller.module}#{config.extension}\"\n\n    with :ok <- File.mkdir_p(Path.dirname(path)) do\n      File.write!(path, string)\n    end\n\n    do_sigil_template(framework)\n  end\n\n  defp do_sigil_template(:vue) do\n    quote do\n      ~H\"\"\"\n      <LiveVite.vue\n        class={get_in(assigns, [:vue_opts, :class])}\n        v-component={\"_build/#{__MODULE__}\"}\n        v-socket={get_socket(assigns)}\n        v-ssr={get_in(assigns, [:vue_opts, :ssr]) != false}\n        {Map.drop(assigns, [:vue_opts, :socket, :flash, :live_action])}\n      />\n      \"\"\"\n    end\n  end\n\n  defp do_sigil_template(:react) do\n    quote do\n      ~H\"\"\"\n      <LiveVite.react\n        class={get_in(assigns, [:vue_opts, :class])}\n        v-component={\"_build/#{__MODULE__}\"}\n        v-socket={get_socket(assigns)}\n        v-ssr={get_in(assigns, [:vue_opts, :ssr]) != false}\n        {Map.drop(assigns, [:vue_opts, :socket, :flash, :live_action])}\n      />\n      \"\"\"\n    end\n  end\nend\n","numLines":95,"startLine":348,"totalLines":442}}}
