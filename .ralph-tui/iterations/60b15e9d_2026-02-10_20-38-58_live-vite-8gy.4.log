{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012vw9Yy3LPVwpkbGAMYvYP1","type":"tool_result","content":"     1→defmodule LiveVite do\n     2→  @moduledoc \"\"\"\n     3→  LiveVite provides seamless integration between Phoenix LiveView and Vue.js components.\n     4→\n     5→  ## Installation and Configuration\n     6→\n     7→  See README.md for installation instructions and usage.\n     8→\n     9→  ## Component Options\n    10→\n    11→  When using the `vue/1` component or `~V` sigil, the following options are supported:\n    12→\n    13→  ### Required Attributes\n    14→    * `v-component` (string) - Name of the Vue component (e.g., \"YourComponent\", \"directory/Example\")\n    15→\n    16→  > #### Tip {: .tip}\n    17→  >\n    18→  > Value of `v-component` will be directly passed to `resolve` function of the `createLiveVite` instance.\n    19→  > It should return Vue component or a promise that resolves to a Vue component.\n    20→  > In a standard setup, you can find it in `assets/vue/index.js`.\n    21→\n    22→  ### Optional Attributes\n    23→    * `id` (string) - Explicit ID of the wrapper component. If not provided, a random one will be\n    24→      generated. Useful to keep ID consistent in development (e.g., \"vue-1\")\n    25→    * `class` (string) - CSS class(es) to apply to the Vue component wrapper\n    26→      (e.g., \"my-class\" or \"my-class another-class\")\n    27→    * `v-ssr` (boolean) - Whether to render the component on the server. Defaults to the value set\n    28→      in config (default: true)\n    29→    * `v-socket` (LiveView.Socket) - LiveView socket, should be provided when rendering inside LiveView\n    30→\n    31→  ### Event Handlers\n    32→    * `v-on:*` - Vue event handlers can be attached using the `v-on:` prefix\n    33→      (e.g., `v-on:click`, `v-on:input`)\n    34→\n    35→  ### Props and Slots\n    36→    * All other attributes are passed as props to the Vue component\n    37→    * Slots can be passed as regular Phoenix slots\n    38→  \"\"\"\n    39→\n    40→  use Phoenix.Component\n    41→\n    42→  import Phoenix.HTML\n    43→\n    44→  alias LiveVite.Encoder\n    45→  alias LiveVite.Slots\n    46→  alias LiveVite.SSR\n    47→  alias Phoenix.LiveView\n    48→  alias Phoenix.LiveView.LiveStream\n    49→\n    50→  require Logger\n    51→\n    52→  @ssr_default Application.compile_env(:live_vite, :ssr, true)\n    53→  @diff_default Application.compile_env(:live_vite, :enable_props_diff, true)\n    54→\n    55→  defmacro __using__(_opts) do\n    56→    quote do\n    57→      import LiveVite\n    58→    end\n    59→  end\n    60→\n    61→  @doc \"\"\"\n    62→  Renders a Vue component within Phoenix LiveView.\n    63→\n    64→  ## Examples\n    65→\n    66→      <.vue\n    67→        v-component=\"MyComponent\"\n    68→        message=\"Hello\"\n    69→        v-on:click=\"handleClick\"\n    70→        class=\"my-component\"\n    71→      />\n    72→\n    73→      <.vue\n    74→        v-component=\"nested/Component\"\n    75→        v-ssr={false}\n    76→        items={@items}\n    77→      >\n    78→        <:default>Default slot content</:default>\n    79→        <:named>Named slot content</:named>\n    80→      </.vue>\n    81→  \"\"\"\n    82→  def vue(assigns) do\n    83→    init = assigns.__changed__ == nil\n    84→    dead = assigns[:\"v-socket\"] == nil or not LiveView.connected?(assigns[:\"v-socket\"])\n    85→    use_diff = Map.get(assigns, :\"v-diff\", @diff_default)\n    86→    use_streams_diff = Enum.any?(assigns, fn {_k, v} -> match?(%LiveStream{}, v) end)\n    87→    render_ssr? = init and dead and Map.get(assigns, :\"v-ssr\", @ssr_default)\n    88→\n    89→    # if we enable diffs, we use only changed props for all the remaining calculations\n    90→    base_assigns =\n    91→      if use_diff do\n    92→        Enum.filter(assigns, fn {k, _v} -> key_changed(assigns, k) end)\n    93→      else\n    94→        assigns\n    95→      end\n    96→\n    97→    props = extract(base_assigns, :props)\n    98→    streams = extract(base_assigns, :streams)\n    99→    slots = extract(base_assigns, :slots)\n   100→    handlers = extract(base_assigns, :handlers)\n   101→    props_diff = if use_diff, do: calculate_props_diff(props, assigns), else: []\n   102→    streams_diff = if use_streams_diff, do: calculate_streams_diff(streams, init or dead), else: []\n   103→\n   104→    assigns =\n   105→      assigns\n   106→      |> Map.put_new(:class, nil)\n   107→      |> Map.put(:__component_name, Map.get(assigns, :\"v-component\"))\n   108→      |> Map.put(:props, props)\n   109→      # let's compress it a little bit, and decompress it on the client side\n   110→      |> Map.put(:props_diff, Enum.map(props_diff, &prepare_diff/1))\n   111→      |> Map.put(:streams_diff, Enum.map(streams_diff, &prepare_diff/1))\n   112→      |> Map.put(:handlers, handlers)\n   113→      |> Map.put(:slots, Slots.rendered_slot_map(slots))\n   114→      |> Map.put(:use_diff, use_diff)\n   115→\n   116→    assigns =\n   117→      Map.put(assigns, :ssr_render, if(render_ssr?, do: ssr_render(assigns)))\n   118→\n   119→    computed_changed =\n   120→      %{\n   121→        # we send initial props only on initial render, later we send only changed props\n   122→        props: init or dead or not use_diff,\n   123→        ssr_render: render_ssr?,\n   124→        slots: slots != %{},\n   125→        handlers: handlers != %{},\n   126→        # we want to send props_diff always but not on initial render\n   127→        props_diff: not init and not dead and use_diff,\n   128→        # we want to send stream_diffs always when there's at least one stream in assigns\n   129→        streams_diff: use_streams_diff\n   130→      }\n   131→\n   132→    assigns =\n   133→      update_in(assigns.__changed__, fn\n   134→        nil -> nil\n   135→        changed -> for {k, true} <- computed_changed, into: changed, do: {k, true}\n   136→      end)\n   137→\n   138→    # optimizing diffs by using string interpolation\n   139→    # https://elixirforum.com/t/heex-attribute-value-in-quotes-send-less-data-than-values-in-braces/63274\n   140→    ~H\"\"\"\n   141→    {raw(@ssr_render[:preloadLinks])}\n   142→    <div\n   143→      id={assigns[:id] || id(@__component_name)}\n   144→      data-name={@__component_name}\n   145→      data-props={\"#{json(Encoder.encode(@props))}\"}\n   146→      data-props-diff={\"#{json(@props_diff)}\"}\n   147→      data-streams-diff={\"#{json(@streams_diff)}\"}\n   148→      data-ssr={(@ssr_render != nil) |> to_string()}\n   149→      data-use-diff={@use_diff |> to_string()}\n   150→      data-handlers={\"#{for({k, v} <- @handlers, into: %{}, do: {k, json(v.ops)}) |> json()}\"}\n   151→      data-slots={\"#{@slots |> Slots.base_encode_64() |> json}\"}\n   152→      phx-update=\"ignore\"\n   153→      phx-hook=\"VueHook\"\n   154→      phx-no-format\n   155→      class={@class}\n   156→    ><%= raw(@ssr_render[:html]) %></div>\n   157→    \"\"\"\n   158→  end\n   159→\n   160→  # Calculates minimal JSON Patch operations for changed props only.\n   161→  # Uses Phoenix LiveView's __changed__ tracking to identify what props have changed.\n   162→  # For simple values, generates direct replace operations.\n   163→  # For complex values (maps, lists), uses Jsonpatch.diff to find minimal changes.\n   164→  # Uses LiveVite.Encoder to safely encode structs before diffing.\n   165→  defp calculate_props_diff(props, %{__changed__: changed}) do\n   166→    # For simple types: changed[k] == true\n   167→    # For complex types: changed[k] is the old value\n   168→    props\n   169→    |> Enum.flat_map(fn {k, new_value} ->\n   170→      case changed[k] do\n   171→        nil ->\n   172→          []\n   173→\n   174→        # For simple types, generate replace operation\n   175→        true ->\n   176→          [%{op: \"replace\", path: \"/#{k}\", value: Encoder.encode(new_value)}]\n   177→\n   178→        # For complex types which didn't change type, use Jsonpatch to find minimal diff\n   179→        old_value ->\n   180→          Jsonpatch.diff(old_value, new_value,\n   181→            ancestor_path: \"/#{k}\",\n   182→            prepare_map: fn\n   183→              struct when is_struct(struct) -> Encoder.encode(struct)\n   184→              rest -> rest\n   185→            end,\n   186→            object_hash: &object_hash/1\n   187→          )\n   188→      end\n   189→    end)\n   190→    # let's add a harmless test operation to ensure we never have the same diff as before\n   191→    |> then(fn diff -> [%{op: \"test\", path: \"\", value: :rand.uniform(10_000_000)} | diff] end)\n   192→  end\n   193→\n   194→  # Generates JSON patch operations for LiveStream changes\n   195→  # Handles insertions and deletions for Phoenix LiveView streams\n   196→  defp calculate_streams_diff(streams, initial)\n   197→\n   198→  defp calculate_streams_diff(streams, true) do\n   199→    # for initial render, we want to reset all streams, and then apply the diffs\n   200→    init = Enum.map(streams, fn {k, _} -> %{op: \"replace\", path: \"/#{k}\", value: []} end)\n   201→    diffs = Enum.flat_map(streams, fn {k, stream} -> generate_stream_patches(k, stream) end)\n   202→    init ++ diffs\n   203→  end\n   204→\n   205→  defp calculate_streams_diff(streams, false) do\n   206→    streams\n   207→    |> Enum.flat_map(fn {k, stream} -> generate_stream_patches(k, stream) end)\n   208→    |> then(fn diff -> [%{op: \"test\", path: \"\", value: :rand.uniform(10_000_000)} | diff] end)\n   209→  end\n   210→\n   211→  # this function tells which field of the struct should be used as a key for the diff\n   212→  # right now it's hardcoded as id, maybe in the future I'll add a way to configure it,\n   213→  # depending on the user's needs\n   214→  defp object_hash(%{id: id}), do: id\n   215→  defp object_hash(_), do: nil\n   216→\n   217→  # Generates JSON patch operations for LiveStream changes\n   218→  # Handles insertions and deletions for Phoenix LiveView streams\n   219→  defp generate_stream_patches(stream_name, %LiveStream{} = stream) do\n   220→    patches = []\n   221→\n   222→    # Handle reset operation first\n   223→    patches =\n   224→      if stream.reset?,\n   225→        do: [%{op: \"replace\", path: \"/#{stream_name}\", value: []} | patches],\n   226→        else: patches\n   227→\n   228→    # Handle deletions second\n   229→    patches =\n   230→      Enum.reduce(stream.deletes, patches, fn dom_id, patches ->\n   231→        [%{op: \"remove\", path: \"/#{stream_name}/$$#{dom_id}\"} | patches]\n   232→      end)\n   233→\n   234→    # Handle insertions third, but reversed - inserts at -1 should be correctly ordered, inserts at 0 should be reversed\n   235→    # see https://hexdocs.pm/phoenix_live_view/Phoenix.LiveView.html#stream/4 :at option\n   236→    stream.inserts\n   237→    |> Enum.reverse()\n   238→    |> Enum.reduce(patches, fn {dom_id, at, item, limit, update_only}, patches ->\n   239→      item = Map.put(Encoder.encode(item), :__dom_id, dom_id)\n   240→\n   241→      patches =\n   242→        if update_only,\n   243→          do: [%{op: \"replace\", path: \"/#{stream_name}/$$#{dom_id}\", value: item} | patches],\n   244→          else: [%{op: \"upsert\", path: \"/#{stream_name}/#{if at == -1, do: \"-\", else: at}\", value: item} | patches]\n   245→\n   246→      if limit,\n   247→        do: [%{op: \"limit\", path: \"/#{stream_name}\", value: limit} | patches],\n   248→        else: patches\n   249→    end)\n   250→    |> Enum.reverse()\n   251→  end\n   252→\n   253→  # we compress the diff to make it smaller, so it's faster to send to the client\n   254→  # then, it's decompressed on the client side\n   255→  defp prepare_diff(%{op: op, path: p, value: value}), do: [op, p, value]\n   256→  defp prepare_diff(%{op: op, path: p}), do: [op, p]\n   257→\n   258→  defp extract(assigns, type) do\n   259→    Enum.reduce(assigns, %{}, fn {key, value}, acc ->\n   260→      case normalize_key(key, value) do\n   261→        ^type -> Map.put(acc, key, value)\n   262→        {^type, k} -> Map.put(acc, k, value)\n   263→        _ -> acc\n   264→      end\n   265→    end)\n   266→  end\n   267→\n   268→  defp normalize_key(key, _val) when key in ~w\"id class v-ssr v-diff v-component v-socket __changed__ __given__\"a,\n   269→    do: :special\n   270→\n   271→  defp normalize_key(_key, [%{__slot__: _}]), do: :slots\n   272→  defp normalize_key(key, val) when is_atom(key), do: key |> to_string() |> normalize_key(val)\n   273→  defp normalize_key(\"v-on:\" <> key, _val), do: {:handlers, key}\n   274→  defp normalize_key(_key, %LiveStream{}), do: :streams\n   275→  defp normalize_key(_key, _val), do: :props\n   276→\n   277→  defp key_changed(%{__changed__: nil}, _key), do: true\n   278→  defp key_changed(%{__changed__: changed}, key), do: changed[key] != nil\n   279→\n   280→  defp ssr_render(assigns) do\n   281→    name = assigns[:\"v-component\"]\n   282→    encoded_props = Encoder.encode(assigns.props)\n   283→\n   284→    case SSR.render(name, encoded_props, assigns.slots) do\n   285→      {:error, message} ->\n   286→        Logger.error(\"Vue SSR error: #{message}\")\n   287→        nil\n   288→\n   289→      %{preloadLinks: links, html: html} ->\n   290→        %{preloadLinks: links, html: html}\n   291→    end\n   292→  rescue\n   293→    SSR.NotConfigured ->\n   294→      nil\n   295→  end\n   296→\n   297→  defp json(data), do: Jason.encode!(data, escape: :html_safe)\n   298→\n   299→  defp id(name) do\n   300→    # a small trick to avoid collisions of IDs but keep them consistent across dead and live render\n   301→    # id(name) is called only once during the whole LiveView lifecycle because it's not using any assigns\n   302→    number = Process.get(:live_vite_counter, 1)\n   303→    Process.put(:live_vite_counter, number + 1)\n   304→    \"#{name}-#{number}\"\n   305→  end\n   306→\n   307→  @doc false\n   308→  def get_socket(assigns) do\n   309→    case get_in(assigns, [:vue_opts, :socket]) || assigns[:socket] do\n   310→      %LiveView.Socket{} = socket -> socket\n   311→      _ -> nil\n   312→    end\n   313→  end\n   314→\n   315→  @doc false\n   316→  @deprecated \"~V sigil is deprecated, please use ~VUE instead.\"\n   317→  defmacro sigil_V(term, modifiers) do\n   318→    do_sigil(term, modifiers, __CALLER__)\n   319→  end\n   320→\n   321→  @doc \"\"\"\n   322→  Inlines a Vue single-file component inside a LiveView. This is the new recommended way over the `~V` sigil.\n   323→  \"\"\"\n   324→  defmacro sigil_VUE(term, modifiers) do\n   325→    do_sigil(term, modifiers, __CALLER__)\n   326→  end\n   327→\n   328→  defp do_sigil({:<<>>, _meta, [string]}, [], caller) do\n   329→    path = \"./assets/vue/_build/#{caller.module}.vue\"\n   330→\n   331→    with :ok <- File.mkdir_p(Path.dirname(path)) do\n   332→      File.write!(path, string)\n   333→    end\n   334→\n   335→    quote do\n   336→      ~H\"\"\"\n   337→      <LiveVite.vue\n   338→        class={get_in(assigns, [:vue_opts, :class])}\n   339→        v-component={\"_build/#{__MODULE__}\"}\n   340→        v-socket={get_socket(assigns)}\n   341→        v-ssr={get_in(assigns, [:vue_opts, :ssr]) != false}\n   342→        {Map.drop(assigns, [:vue_opts, :socket, :flash, :live_action])}\n   343→      />\n   344→      \"\"\"\n   345→    end\n   346→  end\n   347→end\n   348→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"571f89cf-2268-4dd3-867b-270213f0982f","uuid":"663787e0-2399-43e5-8639-3e9a67d2c29e","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/lib/live_vite.ex","content":"defmodule LiveVite do\n  @moduledoc \"\"\"\n  LiveVite provides seamless integration between Phoenix LiveView and Vue.js components.\n\n  ## Installation and Configuration\n\n  See README.md for installation instructions and usage.\n\n  ## Component Options\n\n  When using the `vue/1` component or `~V` sigil, the following options are supported:\n\n  ### Required Attributes\n    * `v-component` (string) - Name of the Vue component (e.g., \"YourComponent\", \"directory/Example\")\n\n  > #### Tip {: .tip}\n  >\n  > Value of `v-component` will be directly passed to `resolve` function of the `createLiveVite` instance.\n  > It should return Vue component or a promise that resolves to a Vue component.\n  > In a standard setup, you can find it in `assets/vue/index.js`.\n\n  ### Optional Attributes\n    * `id` (string) - Explicit ID of the wrapper component. If not provided, a random one will be\n      generated. Useful to keep ID consistent in development (e.g., \"vue-1\")\n    * `class` (string) - CSS class(es) to apply to the Vue component wrapper\n      (e.g., \"my-class\" or \"my-class another-class\")\n    * `v-ssr` (boolean) - Whether to render the component on the server. Defaults to the value set\n      in config (default: true)\n    * `v-socket` (LiveView.Socket) - LiveView socket, should be provided when rendering inside LiveView\n\n  ### Event Handlers\n    * `v-on:*` - Vue event handlers can be attached using the `v-on:` prefix\n      (e.g., `v-on:click`, `v-on:input`)\n\n  ### Props and Slots\n    * All other attributes are passed as props to the Vue component\n    * Slots can be passed as regular Phoenix slots\n  \"\"\"\n\n  use Phoenix.Component\n\n  import Phoenix.HTML\n\n  alias LiveVite.Encoder\n  alias LiveVite.Slots\n  alias LiveVite.SSR\n  alias Phoenix.LiveView\n  alias Phoenix.LiveView.LiveStream\n\n  require Logger\n\n  @ssr_default Application.compile_env(:live_vite, :ssr, true)\n  @diff_default Application.compile_env(:live_vite, :enable_props_diff, true)\n\n  defmacro __using__(_opts) do\n    quote do\n      import LiveVite\n    end\n  end\n\n  @doc \"\"\"\n  Renders a Vue component within Phoenix LiveView.\n\n  ## Examples\n\n      <.vue\n        v-component=\"MyComponent\"\n        message=\"Hello\"\n        v-on:click=\"handleClick\"\n        class=\"my-component\"\n      />\n\n      <.vue\n        v-component=\"nested/Component\"\n        v-ssr={false}\n        items={@items}\n      >\n        <:default>Default slot content</:default>\n        <:named>Named slot content</:named>\n      </.vue>\n  \"\"\"\n  def vue(assigns) do\n    init = assigns.__changed__ == nil\n    dead = assigns[:\"v-socket\"] == nil or not LiveView.connected?(assigns[:\"v-socket\"])\n    use_diff = Map.get(assigns, :\"v-diff\", @diff_default)\n    use_streams_diff = Enum.any?(assigns, fn {_k, v} -> match?(%LiveStream{}, v) end)\n    render_ssr? = init and dead and Map.get(assigns, :\"v-ssr\", @ssr_default)\n\n    # if we enable diffs, we use only changed props for all the remaining calculations\n    base_assigns =\n      if use_diff do\n        Enum.filter(assigns, fn {k, _v} -> key_changed(assigns, k) end)\n      else\n        assigns\n      end\n\n    props = extract(base_assigns, :props)\n    streams = extract(base_assigns, :streams)\n    slots = extract(base_assigns, :slots)\n    handlers = extract(base_assigns, :handlers)\n    props_diff = if use_diff, do: calculate_props_diff(props, assigns), else: []\n    streams_diff = if use_streams_diff, do: calculate_streams_diff(streams, init or dead), else: []\n\n    assigns =\n      assigns\n      |> Map.put_new(:class, nil)\n      |> Map.put(:__component_name, Map.get(assigns, :\"v-component\"))\n      |> Map.put(:props, props)\n      # let's compress it a little bit, and decompress it on the client side\n      |> Map.put(:props_diff, Enum.map(props_diff, &prepare_diff/1))\n      |> Map.put(:streams_diff, Enum.map(streams_diff, &prepare_diff/1))\n      |> Map.put(:handlers, handlers)\n      |> Map.put(:slots, Slots.rendered_slot_map(slots))\n      |> Map.put(:use_diff, use_diff)\n\n    assigns =\n      Map.put(assigns, :ssr_render, if(render_ssr?, do: ssr_render(assigns)))\n\n    computed_changed =\n      %{\n        # we send initial props only on initial render, later we send only changed props\n        props: init or dead or not use_diff,\n        ssr_render: render_ssr?,\n        slots: slots != %{},\n        handlers: handlers != %{},\n        # we want to send props_diff always but not on initial render\n        props_diff: not init and not dead and use_diff,\n        # we want to send stream_diffs always when there's at least one stream in assigns\n        streams_diff: use_streams_diff\n      }\n\n    assigns =\n      update_in(assigns.__changed__, fn\n        nil -> nil\n        changed -> for {k, true} <- computed_changed, into: changed, do: {k, true}\n      end)\n\n    # optimizing diffs by using string interpolation\n    # https://elixirforum.com/t/heex-attribute-value-in-quotes-send-less-data-than-values-in-braces/63274\n    ~H\"\"\"\n    {raw(@ssr_render[:preloadLinks])}\n    <div\n      id={assigns[:id] || id(@__component_name)}\n      data-name={@__component_name}\n      data-props={\"#{json(Encoder.encode(@props))}\"}\n      data-props-diff={\"#{json(@props_diff)}\"}\n      data-streams-diff={\"#{json(@streams_diff)}\"}\n      data-ssr={(@ssr_render != nil) |> to_string()}\n      data-use-diff={@use_diff |> to_string()}\n      data-handlers={\"#{for({k, v} <- @handlers, into: %{}, do: {k, json(v.ops)}) |> json()}\"}\n      data-slots={\"#{@slots |> Slots.base_encode_64() |> json}\"}\n      phx-update=\"ignore\"\n      phx-hook=\"VueHook\"\n      phx-no-format\n      class={@class}\n    ><%= raw(@ssr_render[:html]) %></div>\n    \"\"\"\n  end\n\n  # Calculates minimal JSON Patch operations for changed props only.\n  # Uses Phoenix LiveView's __changed__ tracking to identify what props have changed.\n  # For simple values, generates direct replace operations.\n  # For complex values (maps, lists), uses Jsonpatch.diff to find minimal changes.\n  # Uses LiveVite.Encoder to safely encode structs before diffing.\n  defp calculate_props_diff(props, %{__changed__: changed}) do\n    # For simple types: changed[k] == true\n    # For complex types: changed[k] is the old value\n    props\n    |> Enum.flat_map(fn {k, new_value} ->\n      case changed[k] do\n        nil ->\n          []\n\n        # For simple types, generate replace operation\n        true ->\n          [%{op: \"replace\", path: \"/#{k}\", value: Encoder.encode(new_value)}]\n\n        # For complex types which didn't change type, use Jsonpatch to find minimal diff\n        old_value ->\n          Jsonpatch.diff(old_value, new_value,\n            ancestor_path: \"/#{k}\",\n            prepare_map: fn\n              struct when is_struct(struct) -> Encoder.encode(struct)\n              rest -> rest\n            end,\n            object_hash: &object_hash/1\n          )\n      end\n    end)\n    # let's add a harmless test operation to ensure we never have the same diff as before\n    |> then(fn diff -> [%{op: \"test\", path: \"\", value: :rand.uniform(10_000_000)} | diff] end)\n  end\n\n  # Generates JSON patch operations for LiveStream changes\n  # Handles insertions and deletions for Phoenix LiveView streams\n  defp calculate_streams_diff(streams, initial)\n\n  defp calculate_streams_diff(streams, true) do\n    # for initial render, we want to reset all streams, and then apply the diffs\n    init = Enum.map(streams, fn {k, _} -> %{op: \"replace\", path: \"/#{k}\", value: []} end)\n    diffs = Enum.flat_map(streams, fn {k, stream} -> generate_stream_patches(k, stream) end)\n    init ++ diffs\n  end\n\n  defp calculate_streams_diff(streams, false) do\n    streams\n    |> Enum.flat_map(fn {k, stream} -> generate_stream_patches(k, stream) end)\n    |> then(fn diff -> [%{op: \"test\", path: \"\", value: :rand.uniform(10_000_000)} | diff] end)\n  end\n\n  # this function tells which field of the struct should be used as a key for the diff\n  # right now it's hardcoded as id, maybe in the future I'll add a way to configure it,\n  # depending on the user's needs\n  defp object_hash(%{id: id}), do: id\n  defp object_hash(_), do: nil\n\n  # Generates JSON patch operations for LiveStream changes\n  # Handles insertions and deletions for Phoenix LiveView streams\n  defp generate_stream_patches(stream_name, %LiveStream{} = stream) do\n    patches = []\n\n    # Handle reset operation first\n    patches =\n      if stream.reset?,\n        do: [%{op: \"replace\", path: \"/#{stream_name}\", value: []} | patches],\n        else: patches\n\n    # Handle deletions second\n    patches =\n      Enum.reduce(stream.deletes, patches, fn dom_id, patches ->\n        [%{op: \"remove\", path: \"/#{stream_name}/$$#{dom_id}\"} | patches]\n      end)\n\n    # Handle insertions third, but reversed - inserts at -1 should be correctly ordered, inserts at 0 should be reversed\n    # see https://hexdocs.pm/phoenix_live_view/Phoenix.LiveView.html#stream/4 :at option\n    stream.inserts\n    |> Enum.reverse()\n    |> Enum.reduce(patches, fn {dom_id, at, item, limit, update_only}, patches ->\n      item = Map.put(Encoder.encode(item), :__dom_id, dom_id)\n\n      patches =\n        if update_only,\n          do: [%{op: \"replace\", path: \"/#{stream_name}/$$#{dom_id}\", value: item} | patches],\n          else: [%{op: \"upsert\", path: \"/#{stream_name}/#{if at == -1, do: \"-\", else: at}\", value: item} | patches]\n\n      if limit,\n        do: [%{op: \"limit\", path: \"/#{stream_name}\", value: limit} | patches],\n        else: patches\n    end)\n    |> Enum.reverse()\n  end\n\n  # we compress the diff to make it smaller, so it's faster to send to the client\n  # then, it's decompressed on the client side\n  defp prepare_diff(%{op: op, path: p, value: value}), do: [op, p, value]\n  defp prepare_diff(%{op: op, path: p}), do: [op, p]\n\n  defp extract(assigns, type) do\n    Enum.reduce(assigns, %{}, fn {key, value}, acc ->\n      case normalize_key(key, value) do\n        ^type -> Map.put(acc, key, value)\n        {^type, k} -> Map.put(acc, k, value)\n        _ -> acc\n      end\n    end)\n  end\n\n  defp normalize_key(key, _val) when key in ~w\"id class v-ssr v-diff v-component v-socket __changed__ __given__\"a,\n    do: :special\n\n  defp normalize_key(_key, [%{__slot__: _}]), do: :slots\n  defp normalize_key(key, val) when is_atom(key), do: key |> to_string() |> normalize_key(val)\n  defp normalize_key(\"v-on:\" <> key, _val), do: {:handlers, key}\n  defp normalize_key(_key, %LiveStream{}), do: :streams\n  defp normalize_key(_key, _val), do: :props\n\n  defp key_changed(%{__changed__: nil}, _key), do: true\n  defp key_changed(%{__changed__: changed}, key), do: changed[key] != nil\n\n  defp ssr_render(assigns) do\n    name = assigns[:\"v-component\"]\n    encoded_props = Encoder.encode(assigns.props)\n\n    case SSR.render(name, encoded_props, assigns.slots) do\n      {:error, message} ->\n        Logger.error(\"Vue SSR error: #{message}\")\n        nil\n\n      %{preloadLinks: links, html: html} ->\n        %{preloadLinks: links, html: html}\n    end\n  rescue\n    SSR.NotConfigured ->\n      nil\n  end\n\n  defp json(data), do: Jason.encode!(data, escape: :html_safe)\n\n  defp id(name) do\n    # a small trick to avoid collisions of IDs but keep them consistent across dead and live render\n    # id(name) is called only once during the whole LiveView lifecycle because it's not using any assigns\n    number = Process.get(:live_vite_counter, 1)\n    Process.put(:live_vite_counter, number + 1)\n    \"#{name}-#{number}\"\n  end\n\n  @doc false\n  def get_socket(assigns) do\n    case get_in(assigns, [:vue_opts, :socket]) || assigns[:socket] do\n      %LiveView.Socket{} = socket -> socket\n      _ -> nil\n    end\n  end\n\n  @doc false\n  @deprecated \"~V sigil is deprecated, please use ~VUE instead.\"\n  defmacro sigil_V(term, modifiers) do\n    do_sigil(term, modifiers, __CALLER__)\n  end\n\n  @doc \"\"\"\n  Inlines a Vue single-file component inside a LiveView. This is the new recommended way over the `~V` sigil.\n  \"\"\"\n  defmacro sigil_VUE(term, modifiers) do\n    do_sigil(term, modifiers, __CALLER__)\n  end\n\n  defp do_sigil({:<<>>, _meta, [string]}, [], caller) do\n    path = \"./assets/vue/_build/#{caller.module}.vue\"\n\n    with :ok <- File.mkdir_p(Path.dirname(path)) do\n      File.write!(path, string)\n    end\n\n    quote do\n      ~H\"\"\"\n      <LiveVite.vue\n        class={get_in(assigns, [:vue_opts, :class])}\n        v-component={\"_build/#{__MODULE__}\"}\n        v-socket={get_socket(assigns)}\n        v-ssr={get_in(assigns, [:vue_opts, :ssr]) != false}\n        {Map.drop(assigns, [:vue_opts, :socket, :flash, :live_action])}\n      />\n      \"\"\"\n    end\n  end\nend\n","numLines":348,"startLine":1,"totalLines":348}}}
