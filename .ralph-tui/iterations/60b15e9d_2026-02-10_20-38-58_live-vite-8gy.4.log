h(() => {\n    54→    vi.clearAllMocks()\n    55→    renderer = createMockRenderer()\n    56→    resolve = vi.fn().mockResolvedValue({ template: \"<div/>\" })\n    57→    hook = getRendererHook(renderer, resolve)\n    58→  })\n    59→\n    60→  describe(\"mounted lifecycle\", () => {\n    61→    it(\"should resolve the component by name from data-name\", async () => {\n    62→      hookContext = createMockHookContext({ \"data-name\": \"Counter\" })\n    63→      await hook.mounted!.call(hookContext)\n    64→\n    65→      expect(resolve).toHaveBeenCalledWith(\"Counter\")\n    66→    })\n    67→\n    68→    it(\"should call renderer.mount with parsed props and slots\", async () => {\n    69→      const props = { count: 42, label: \"test\" }\n    70→      const slots = { default: toUtf8Base64(\"<p>Hello</p>\") }\n    71→\n    72→      hookContext = createMockHookContext({\n    73→        \"data-name\": \"Counter\",\n    74→        \"data-props\": JSON.stringify(props),\n    75→        \"data-slots\": JSON.stringify(slots),\n    76→      })\n    77→\n    78→      await hook.mounted!.call(hookContext)\n    79→\n    80→      expect(renderer.mount).toHaveBeenCalledWith(\n    81→        expect.objectContaining({\n    82→          props: expect.objectContaining(props),\n    83→          slots: expect.objectContaining({ default: expect.any(String) }),\n    84→          el: hookContext.el,\n    85→          ssr: false,\n    86→          hook: hookContext,\n    87→        })\n    88→      )\n    89→    })\n    90→\n    91→    it(\"should pass ssr=true when data-ssr attribute is true\", async () => {\n    92→      hookContext = createMockHookContext({\n    93→        \"data-name\": \"Counter\",\n    94→        \"data-ssr\": \"true\",\n    95→      })\n    96→\n    97→      await hook.mounted!.call(hookContext)\n    98→\n    99→      expect(renderer.mount).toHaveBeenCalledWith(\n   100→        expect.objectContaining({ ssr: true })\n   101→      )\n   102→    })\n   103→\n   104→    it(\"should apply initial stream diffs after mount\", async () => {\n   105→      const streamDiff = [[\"replace\", \"/items\", [{ id: 1, name: \"test\" }]]]\n   106→\n   107→      hookContext = createMockHookContext({\n   108→        \"data-name\": \"Counter\",\n   109→        \"data-streams-diff\": JSON.stringify(streamDiff),\n   110→      })\n   111→\n   112→      await hook.mounted!.call(hookContext)\n   113→\n   114→      expect(renderer.patchProps).toHaveBeenCalledWith(\n   115→        expect.any(Object),\n   116→        [{ op: \"replace\", path: \"/items\", value: [{ id: 1, name: \"test\" }] }]\n   117→      )\n   118→    })\n   119→\n   120→    it(\"should store renderer state on this.vue\", async () => {\n   121→      hookContext = createMockHookContext({ \"data-name\": \"Counter\" })\n   122→      await hook.mounted!.call(hookContext)\n   123→\n   124→      expect(hookContext.vue).toBeDefined()\n   125→      expect(hookContext.vue.props).toBeDefined()\n   126→      expect(hookContext.vue.slots).toBeDefined()\n   127→      expect(hookContext.vue.app).toBeDefined()\n   128→    })\n   129→\n   130→    it(\"should merge handlers into props\", async () => {\n   131→      const handlers = { click: '[[\"push\", {\"event\": \"clicked\"}]]' }\n   132→\n   133→      hookContext = createMockHookContext({\n   134→        \"data-name\": \"Counter\",\n   135→        \"data-handlers\": JSON.stringify(handlers),\n   136→      })\n   137→\n   138→      await hook.mounted!.call(hookContext)\n   139→\n   140→      const mountCall = (renderer.mount as any).mock.calls[0][0] as MountContext\n   141→      expect(mountCall.props).toHaveProperty(\"onClick\")\n   142→      expect(typeof mountCall.props.onClick).toBe(\"function\")\n   143→    })\n   144→  })\n   145→\n   146→  describe(\"updated lifecycle\", () => {\n   147→    beforeEach(async () => {\n   148→      hookContext = createMockHookContext({ \"data-name\": \"Counter\" })\n   149→      await hook.mounted!.call(hookContext)\n   150→      vi.clearAllMocks()\n   151→    })\n   152→\n   153→    it(\"should call renderer.patchProps when diff mode is enabled\", () => {\n   154→      const diff = [[\"replace\", \"/count\", 10]]\n   155→\n   156→      hookContext.el.getAttribute.mockImplementation((name: string) => {\n   157→        if (name === \"data-use-diff\") return \"true\"\n   158→        if (name === \"data-props-diff\") return JSON.stringify(diff)\n   159→        return null\n   160→      })\n   161→\n   162→      hook.updated!.call(hookContext)\n   163→\n   164→      expect(renderer.patchProps).toHaveBeenCalledWith(\n   165→        hookContext.vue,\n   166→        [{ op: \"replace\", path: \"/count\", value: 10 }]\n   167→      )\n   168→    })\n   169→\n   170→    it(\"should call renderer.updateProps when diff mode is disabled\", () => {\n   171→      const newProps = { count: 99, label: \"updated\" }\n   172→\n   173→      hookContext.el.getAttribute.mockImplementation((name: string) => {\n   174→        if (name === \"data-use-diff\") return \"false\"\n   175→        if (name === \"data-props\") return JSON.stringify(newProps)\n   176→        return null\n   177→      })\n   178→\n   179→      hook.updated!.call(hookContext)\n   180→\n   181→      expect(renderer.updateProps).toHaveBeenCalledWith(\n   182→        hookContext.vue,\n   183→        expect.objectContaining(newProps)\n   184→      )\n   185→    })\n   186→\n   187→    it(\"should always apply stream diffs\", () => {\n   188→      const streamDiff = [[\"add\", \"/items/-\", { id: 2 }]]\n   189→\n   190→      hookContext.el.getAttribute.mockImplementation((name: string) => {\n   191→        if (name === \"data-streams-diff\") return JSON.stringify(streamDiff)\n   192→        return null\n   193→      })\n   194→\n   195→      hook.updated!.call(hookContext)\n   196→\n   197→      // patchProps should be called for stream diffs\n   198→      expect(renderer.patchProps).toHaveBeenCalledWith(\n   199→        hookContext.vue,\n   200→        [{ op: \"add\", path: \"/items/-\", value: { id: 2 } }]\n   201→      )\n   202→    })\n   203→\n   204→    it(\"should call renderer.updateSlots with raw HTML\", () => {\n   205→      const slots = { header: toUtf8Base64(\"<h1>Title</h1>\") }\n   206→\n   207→      hookContext.el.getAttribute.mockImplementation((name: string) => {\n   208→        if (name === \"data-slots\") return JSON.stringify(slots)\n   209→        return null\n   210→      })\n   211→\n   212→      hook.updated!.call(hookContext)\n   213→\n   214→      expect(renderer.updateSlots).toHaveBeenCalledWith(\n   215→        hookContext.vue,\n   216→        expect.objectContaining({ header: expect.any(String) })\n   217→      )\n   218→    })\n   219→  })\n   220→\n   221→  describe(\"destroyed lifecycle\", () => {\n   222→    it(\"should call renderer.unmount\", async () => {\n   223→      hookContext = createMockHookContext({ \"data-name\": \"Counter\" })\n   224→      await hook.mounted!.call(hookContext)\n   225→\n   226→      hook.destroyed!.call(hookContext)\n   227→\n   228→      expect(renderer.unmount).toHaveBeenCalledWith(hookContext.vue)\n   229→    })\n   230→  })\n   231→})\n   232→\n   233→describe(\"FrameworkRenderer interface contract\", () => {\n   234→  it(\"requires name, mount, updateProps, patchProps, updateSlots, unmount\", () => {\n   235→    // This is a compile-time check but we verify runtime shape too\n   236→    const renderer = createMockRenderer()\n   237→\n   238→    expect(renderer.name).toBe(\"mock\")\n   239→    expect(typeof renderer.mount).toBe(\"function\")\n   240→    expect(typeof renderer.updateProps).toBe(\"function\")\n   241→    expect(typeof renderer.patchProps).toBe(\"function\")\n   242→    expect(typeof renderer.updateSlots).toBe(\"function\")\n   243→    expect(typeof renderer.unmount).toBe(\"function\")\n   244→  })\n   245→\n   246→  it(\"renderToString is optional\", () => {\n   247→    const renderer = createMockRenderer()\n   248→    // renderToString is not set on mock, should be undefined\n   249→    expect(renderer.renderToString).toBeUndefined()\n   250→  })\n   251→})\n   252→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"571f89cf-2268-4dd3-867b-270213f0982f","uuid":"5548eac6-c2d7-4a23-b75c-2ef98ac15e60","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/renderer.test.ts","content":"import { describe, it, expect, vi, beforeEach } from \"vitest\"\nimport { reactive, type App } from \"vue\"\nimport { getRendererHook } from \"./hooks\"\nimport type { FrameworkRenderer, RendererState, MountContext } from \"./renderer\"\nimport type { Hook } from \"./types\"\nimport { toUtf8Base64 } from \"./utils\"\n\n/**\n * Creates a mock FrameworkRenderer for testing the hook integration.\n * All methods are vi.fn() so we can assert on calls.\n */\nconst createMockRenderer = (): FrameworkRenderer => {\n  const mockState: RendererState = {\n    props: { message: \"hello\" },\n    slots: { default: () => \"slot\" },\n    app: { unmount: vi.fn() },\n  }\n\n  return {\n    name: \"mock\",\n    mount: vi.fn().mockResolvedValue(mockState),\n    updateProps: vi.fn(),\n    patchProps: vi.fn(),\n    updateSlots: vi.fn(),\n    unmount: vi.fn(),\n  }\n}\n\nconst createMockHookContext = (elementAttributes: Record<string, string> = {}) => {\n  const mockElement = {\n    getAttribute: vi.fn((name: string) => elementAttributes[name] || null),\n    setAttribute: vi.fn(),\n    removeAttribute: vi.fn(),\n  } as any\n\n  const mockLiveSocket = {\n    execJS: vi.fn(),\n  }\n\n  return {\n    el: mockElement,\n    liveSocket: mockLiveSocket,\n    vue: undefined as any,\n  } as any\n}\n\ndescribe(\"getRendererHook\", () => {\n  let renderer: FrameworkRenderer\n  let hookContext: ReturnType<typeof createMockHookContext>\n  let resolve: ReturnType<typeof vi.fn>\n  let hook: Hook\n\n  beforeEach(() => {\n    vi.clearAllMocks()\n    renderer = createMockRenderer()\n    resolve = vi.fn().mockResolvedValue({ template: \"<div/>\" })\n    hook = getRendererHook(renderer, resolve)\n  })\n\n  describe(\"mounted lifecycle\", () => {\n    it(\"should resolve the component by name from data-name\", async () => {\n      hookContext = createMockHookContext({ \"data-name\": \"Counter\" })\n      await hook.mounted!.call(hookContext)\n\n      expect(resolve).toHaveBeenCalledWith(\"Counter\")\n    })\n\n    it(\"should call renderer.mount with parsed props and slots\", async () => {\n      const props = { count: 42, label: \"test\" }\n      const slots = { default: toUtf8Base64(\"<p>Hello</p>\") }\n\n      hookContext = createMockHookContext({\n        \"data-name\": \"Counter\",\n        \"data-props\": JSON.stringify(props),\n        \"data-slots\": JSON.stringify(slots),\n      })\n\n      await hook.mounted!.call(hookContext)\n\n      expect(renderer.mount).toHaveBeenCalledWith(\n        expect.objectContaining({\n          props: expect.objectContaining(props),\n          slots: expect.objectContaining({ default: expect.any(String) }),\n          el: hookContext.el,\n          ssr: false,\n          hook: hookContext,\n        })\n      )\n    })\n\n    it(\"should pass ssr=true when data-ssr attribute is true\", async () => {\n      hookContext = createMockHookContext({\n        \"data-name\": \"Counter\",\n        \"data-ssr\": \"true\",\n      })\n\n      await hook.mounted!.call(hookContext)\n\n      expect(renderer.mount).toHaveBeenCalledWith(\n        expect.objectContaining({ ssr: true })\n      )\n    })\n\n    it(\"should apply initial stream diffs after mount\", async () => {\n      const streamDiff = [[\"replace\", \"/items\", [{ id: 1, name: \"test\" }]]]\n\n      hookContext = createMockHookContext({\n        \"data-name\": \"Counter\",\n        \"data-streams-diff\": JSON.stringify(streamDiff),\n      })\n\n      await hook.mounted!.call(hookContext)\n\n      expect(renderer.patchProps).toHaveBeenCalledWith(\n        expect.any(Object),\n        [{ op: \"replace\", path: \"/items\", value: [{ id: 1, name: \"test\" }] }]\n      )\n    })\n\n    it(\"should store renderer state on this.vue\", async () => {\n      hookContext = createMockHookContext({ \"data-name\": \"Counter\" })\n      await hook.mounted!.call(hookContext)\n\n      expect(hookContext.vue).toBeDefined()\n      expect(hookContext.vue.props).toBeDefined()\n      expect(hookContext.vue.slots).toBeDefined()\n      expect(hookContext.vue.app).toBeDefined()\n    })\n\n    it(\"should merge handlers into props\", async () => {\n      const handlers = { click: '[[\"push\", {\"event\": \"clicked\"}]]' }\n\n      hookContext = createMockHookContext({\n        \"data-name\": \"Counter\",\n        \"data-handlers\": JSON.stringify(handlers),\n      })\n\n      await hook.mounted!.call(hookContext)\n\n      const mountCall = (renderer.mount as any).mock.calls[0][0] as MountContext\n      expect(mountCall.props).toHaveProperty(\"onClick\")\n      expect(typeof mountCall.props.onClick).toBe(\"function\")\n    })\n  })\n\n  describe(\"updated lifecycle\", () => {\n    beforeEach(async () => {\n      hookContext = createMockHookContext({ \"data-name\": \"Counter\" })\n      await hook.mounted!.call(hookContext)\n      vi.clearAllMocks()\n    })\n\n    it(\"should call renderer.patchProps when diff mode is enabled\", () => {\n      const diff = [[\"replace\", \"/count\", 10]]\n\n      hookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-use-diff\") return \"true\"\n        if (name === \"data-props-diff\") return JSON.stringify(diff)\n        return null\n      })\n\n      hook.updated!.call(hookContext)\n\n      expect(renderer.patchProps).toHaveBeenCalledWith(\n        hookContext.vue,\n        [{ op: \"replace\", path: \"/count\", value: 10 }]\n      )\n    })\n\n    it(\"should call renderer.updateProps when diff mode is disabled\", () => {\n      const newProps = { count: 99, label: \"updated\" }\n\n      hookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-use-diff\") return \"false\"\n        if (name === \"data-props\") return JSON.stringify(newProps)\n        return null\n      })\n\n      hook.updated!.call(hookContext)\n\n      expect(renderer.updateProps).toHaveBeenCalledWith(\n        hookContext.vue,\n        expect.objectContaining(newProps)\n      )\n    })\n\n    it(\"should always apply stream diffs\", () => {\n      const streamDiff = [[\"add\", \"/items/-\", { id: 2 }]]\n\n      hookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-streams-diff\") return JSON.stringify(streamDiff)\n        return null\n      })\n\n      hook.updated!.call(hookContext)\n\n      // patchProps should be called for stream diffs\n      expect(renderer.patchProps).toHaveBeenCalledWith(\n        hookContext.vue,\n        [{ op: \"add\", path: \"/items/-\", value: { id: 2 } }]\n      )\n    })\n\n    it(\"should call renderer.updateSlots with raw HTML\", () => {\n      const slots = { header: toUtf8Base64(\"<h1>Title</h1>\") }\n\n      hookContext.el.getAttribute.mockImplementation((name: string) => {\n        if (name === \"data-slots\") return JSON.stringify(slots)\n        return null\n      })\n\n      hook.updated!.call(hookContext)\n\n      expect(renderer.updateSlots).toHaveBeenCalledWith(\n        hookContext.vue,\n        expect.objectContaining({ header: expect.any(String) })\n      )\n    })\n  })\n\n  describe(\"destroyed lifecycle\", () => {\n    it(\"should call renderer.unmount\", async () => {\n      hookContext = createMockHookContext({ \"data-name\": \"Counter\" })\n      await hook.mounted!.call(hookContext)\n\n      hook.destroyed!.call(hookContext)\n\n      expect(renderer.unmount).toHaveBeenCalledWith(hookContext.vue)\n    })\n  })\n})\n\ndescribe(\"FrameworkRenderer interface contract\", () => {\n  it(\"requires name, mount, updateProps, patchProps, updateSlots, unmount\", () => {\n    // This is a compile-time check but we verify runtime shape too\n    const renderer = createMockRenderer()\n\n    expect(renderer.name).toBe(\"mock\")\n    expect(typeof renderer.mount).toBe(\"function\")\n    expect(typeof renderer.updateProps).toBe(\"function\")\n    expect(typeof renderer.patchProps).toBe(\"function\")\n    expect(typeof renderer.updateSlots).toBe(\"function\")\n    expect(typeof renderer.unmount).toBe(\"function\")\n  })\n\n  it(\"renderToString is optional\", () => {\n    const renderer = createMockRenderer()\n    // renderToString is not set on mock, should be undefined\n    expect(renderer.renderToString).toBeUndefined()\n  })\n})\n","numLines":252,"startLine":1,"totalLines":252}}}
