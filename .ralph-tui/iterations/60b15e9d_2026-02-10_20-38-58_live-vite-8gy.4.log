he hook handles DOM attribute parsing, prop diffing, and stream patches,\n    80→ * while delegating all framework-specific operations to the renderer.\n    81→ */\n    82→export const getRendererHook = (\n    83→  renderer: FrameworkRenderer,\n    84→  resolve: (name: string) => Promise<unknown> | unknown,\n    85→): Hook => ({\n    86→  async mounted() {\n    87→    const componentName = this.el.getAttribute(\"data-name\") as string\n    88→    const component = await resolve(componentName)\n    89→    const ssr = this.el.getAttribute(\"data-ssr\") === \"true\"\n    90→\n    91→    const props = getProps(this.el, this.liveSocket)\n    92→    const slots = getRawSlots(this.el)\n    93→\n    94→    const state = await renderer.mount({\n    95→      component,\n    96→      props,\n    97→      slots,\n    98→      el: this.el,\n    99→      ssr,\n   100→      hook: this,\n   101→    })\n   102→\n   103→    // apply initial stream diff after mount, since all stream changes are sent in that attribute\n   104→    renderer.patchProps(state, getDiff(this.el, \"data-streams-diff\"))\n   105→\n   106→    this.vue = state\n   107→  },\n   108→  updated() {\n   109→    if (this.el.getAttribute(\"data-use-diff\") === \"true\") {\n   110→      renderer.patchProps(this.vue, getDiff(this.el, \"data-props-diff\"))\n   111→    } else {\n   112→      renderer.updateProps(this.vue, getProps(this.el, this.liveSocket))\n   113→    }\n   114→    // we're always applying streams diff, since all stream changes are sent in that attribute\n   115→    renderer.patchProps(this.vue, getDiff(this.el, \"data-streams-diff\"))\n   116→    renderer.updateSlots(this.vue, getRawSlots(this.el))\n   117→  },\n   118→  destroyed() {\n   119→    renderer.unmount(this.vue)\n   120→  },\n   121→})\n   122→\n   123→export const getVueHook = ({ resolve, setup }: LiveViteApp): Hook => {\n   124→  // Adapt the LiveViteApp setup (object arg) to the VueSetupFn (positional args)\n   125→  const vueSetup: VueSetu