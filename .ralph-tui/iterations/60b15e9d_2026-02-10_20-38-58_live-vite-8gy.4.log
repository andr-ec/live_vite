{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0148A2Qh6kBgXB6HUYB8sSqS","type":"tool_result","content":"     1→import { createApp, createSSRApp, h, reactive, type App, type Plugin } from \"vue\"\n     2→import type { FrameworkRenderer, MountContext, RendererState, SSRContext as RendererSSRContext } from \"../renderer.js\"\n     3→import { applyPatch, type Operation } from \"../jsonPatch.js\"\n     4→import { liveInjectKey } from \"../use.js\"\n     5→import { mapValues } from \"../utils.js\"\n     6→\n     7→type VueApp = App<Element>\n     8→\n     9→/**\n    10→ * Convert slot name -> HTML string into Vue slot functions.\n    11→ * Each slot renders as a div with innerHTML set to the decoded HTML.\n    12→ */\n    13→function htmlSlotsToVue(slots: Record<string, string>): Record<string, () => any> {\n    14→  return mapValues(slots, html => () => h(\"div\", { innerHTML: html.trim() }))\n    15→}\n    16→\n    17→/**\n    18→ * The default Vue setup function. Creates a Vue app, installs the LiveVite\n    19→ * plugin, and mounts it. Users can override this via `createLiveVite({ setup })`.\n    20→ */\n    21→export const defaultVueSetup = (\n    22→  makeApp: typeof createApp | typeof createSSRApp,\n    23→  component: any,\n    24→  props: Record<string, any>,\n    25→  slots: Record<string, () => any>,\n    26→  plugin: Plugin<[]>,\n    27→  el: Element,\n    28→): VueApp => {\n    29→  const app = makeApp({ render: () => h(component, props, slots) })\n    30→  app.use(plugin)\n    31→  app.mount(el)\n    32→  return app\n    33→}\n    34→\n    35→export type VueSetupFn = (\n    36→  makeApp: typeof createApp | typeof createSSRApp,\n    37→  component: any,\n    38→  props: Record<string, any>,\n    39→  slots: Record<string, () => any>,\n    40→  plugin: Plugin<[]>,\n    41→  el: Element,\n    42→  ssr: boolean,\n    43→) => VueApp\n    44→\n    45→export interface VueRendererOptions {\n    46→  /** Custom setup function for creating the Vue app. Defaults to `defaultVueSetup`. */\n    47→  setup?: VueSetupFn\n    48→  /** Vite SSR manifest for preload link generation (production builds only). */\n    49→  manifest?: Record<string, string[]>\n    50→}\n    51→\n    52→/** Mock LiveView hook used during SSR (no real socket available) */\n    53→const mockHook = {\n    54→  el: {},\n    55→  liveSocket: { socket: { connectionState: () => \"closed\" } } as any,\n    56→  pushEvent: () => Promise.resolve(0),\n    57→  pushEventTo: () => Promise.resolve([]),\n    58→  handleEvent: () => ({ event: \"\", callback: () => {} }),\n    59→  removeHandleEvent: () => {},\n    60→  upload: () => {},\n    61→  uploadTo: () => {},\n    62→  vue: { props: {}, slots: {}, app: {} },\n    63→}\n    64→\n    65→/**\n    66→ * Creates a Vue framework renderer.\n    67→ *\n    68→ * This is the reference implementation of the `FrameworkRenderer` interface.\n    69→ * It handles Vue-specific concerns: `reactive()` for props, `h()` for slots,\n    70→ * `createApp`/`createSSRApp` for mounting, and `app.unmount()` for cleanup.\n    71→ */\n    72→export function createVueRenderer(options: VueRendererOptions = {}): FrameworkRenderer<VueApp> {\n    73→  const setup = options.setup ?? defaultVueSetup\n    74→  const manifest = options.manifest ?? {}\n    75→\n    76→  return {\n    77→    name: \"vue\",\n    78→\n    79→    mount(ctx: MountContext): RendererState<VueApp> {\n    80→      const makeApp = ctx.ssr ? createSSRApp : createApp\n    81→      const props = reactive(ctx.props)\n    82→      const slots = reactive(htmlSlotsToVue(ctx.slots))\n    83→\n    84→      const plugin: Plugin<[]> = {\n    85→        install: (app: App) => {\n    86→          app.provide(liveInjectKey, ctx.hook)\n    87→          app.config.globalProperties.$live = ctx.hook\n    88→        },\n    89→      }\n    90→\n    91→      const app = setup(makeApp, ctx.component, props, slots, plugin, ctx.el, ctx.ssr)\n    92→\n    93→      if (!app) throw new Error(\"Vue setup function did not return an app!\")\n    94→\n    95→      return { props, slots, app }\n    96→    },\n    97→\n    98→    updateProps(state: RendererState<VueApp>, newProps: Record<string, any>): void {\n    99→      Object.assign(state.props, newProps)\n   100→    },\n   101→\n   102→    patchProps(state: RendererState<VueApp>, operations: Operation[]): void {\n   103→      applyPatch(state.props, operations)\n   104→    },\n   105→\n   106→    updateSlots(state: RendererState<VueApp>, newSlots: Record<string, string>): void {\n   107→      Object.assign(state.slots, htmlSlotsToVue(newSlots))\n   108→    },\n   109→\n   110→    unmount(state: RendererState<VueApp>): void {\n   111→      if (state.app) {\n   112→        window.addEventListener(\"phx:page-loading-stop\", () => state.app!.unmount(), { once: true })\n   113→      }\n   114→    },\n   115→\n   116→    async renderToString(ctx: RendererSSRContext): Promise<string> {\n   117→      // Dynamic import to avoid bundling server-only deps in client builds\n   118→      const { renderToString: vueRenderToString } = await import(\"vue/server-renderer\")\n   119→\n   120→      const component = ctx.component\n   121→      const slotComponents = htmlSlotsToVue(ctx.slots)\n   122→\n   123→      const ssrSetup = options.setup ?? ((makeApp, component, props, slots, plugin, el) => {\n   124→        const app = makeApp({ render: () => h(component, props, slots) })\n   125→        app.use(plugin)\n   126→        // Don't mount in SSR - no real DOM\n   127→        return app\n   128→      })\n   129→\n   130→      const plugin: Plugin<[]> = {\n   131→        install: (app: App) => {\n   132→          app.mount = (...args: unknown[]): any => undefined\n   133→          app.provide(\"_live_vite\", Object.assign({}, mockHook))\n   134→        },\n   135→      }\n   136→\n   137→      const app = ssrSetup(createSSRApp, component, ctx.props, slotComponents, plugin, {} as Element, true)\n   138→\n   139→      if (!app) throw new Error(\"Vue SSR setup function did not return an app!\")\n   140→\n   141→      const vueCtx: import(\"vue/server-renderer\").SSRContext = {}\n   142→      const html = await vueRenderToString(app, vueCtx)\n   143→\n   144→      // the SSR manifest generated by Vite contains module -> chunk/asset mapping\n   145→      // which we can then use to determine what files need to be preloaded for this request.\n   146→      const preloadLinks = renderPreloadLinks(vueCtx.modules ?? [], manifest)\n   147→      return preloadLinks + \"<!-- preload -->\" + html\n   148→    },\n   149→  }\n   150→}\n   151→\n   152→type SSRManifest = Record<string, string[]>\n   153→\n   154→function renderPreloadLinks(modules: string[], manifest: SSRManifest) {\n   155→  let links = \"\"\n   156→  const seen = new Set()\n   157→  modules.forEach((id: string) => {\n   158→    const files = manifest[id]\n   159→    if (files) {\n   160→      files.forEach(file => {\n   161→        if (!seen.has(file)) {\n   162→          seen.add(file)\n   163→          const filename = file.split(\"/\").pop() ?? file\n   164→          if (manifest[filename]) {\n   165→            for (const depFile of manifest[filename]) {\n   166→              links += renderPreloadLink(depFile)\n   167→              seen.add(depFile)\n   168→            }\n   169→          }\n   170→          links += renderPreloadLink(file)\n   171→        }\n   172→      })\n   173→    }\n   174→  })\n   175→  return links\n   176→}\n   177→\n   178→function renderPreloadLink(file: string) {\n   179→  if (file.endsWith(\".js\")) {\n   180→    return `<link rel=\"modulepreload\" crossorigin href=\"${file}\">`\n   181→  } else if (file.endsWith(\".css\")) {\n   182→    return `<link rel=\"stylesheet\" href=\"${file}\">`\n   183→  } else if (file.endsWith(\".woff\")) {\n   184→    return ` <link rel=\"preload\" href=\"${file}\" as=\"font\" type=\"font/woff\" crossorigin>`\n   185→  } else if (file.endsWith(\".woff2\")) {\n   186→    return ` <link rel=\"preload\" href=\"${file}\" as=\"font\" type=\"font/woff2\" crossorigin>`\n   187→  } else if (file.endsWith(\".gif\")) {\n   188→    return ` <link rel=\"preload\" href=\"${file}\" as=\"image\" type=\"image/gif\">`\n   189→  } else if (file.endsWith(\".jpg\") || file.endsWith(\".jpeg\")) {\n   190→    return ` <link rel=\"preload\" href=\"${file}\" as=\"image\" type=\"image/jpeg\">`\n   191→  } else if (file.endsWith(\".png\")) {\n   192→    return ` <link rel=\"preload\" href=\"${file}\" as=\"image\" type=\"image/png\">`\n   193→  } else {\n   194→    return \"\"\n   195→  }\n   196→}\n   197→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"571f89cf-2268-4dd3-867b-270213f0982f","uuid":"4b40d833-a8c5-4f08-9188-cc70375c9083","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/renderers/vue.ts","content":"import { createApp, createSSRApp, h, reactive, type App, type Plugin } from \"vue\"\nimport type { FrameworkRenderer, MountContext, RendererState, SSRContext as RendererSSRContext } from \"../renderer.js\"\nimport { applyPatch, type Operation } from \"../jsonPatch.js\"\nimport { liveInjectKey } from \"../use.js\"\nimport { mapValues } from \"../utils.js\"\n\ntype VueApp = App<Element>\n\n/**\n * Convert slot name -> HTML string into Vue slot functions.\n * Each slot renders as a div with innerHTML set to the decoded HTML.\n */\nfunction htmlSlotsToVue(slots: Record<string, string>): Record<string, () => any> {\n  return mapValues(slots, html => () => h(\"div\", { innerHTML: html.trim() }))\n}\n\n/**\n * The default Vue setup function. Creates a Vue app, installs the LiveVite\n * plugin, and mounts it. Users can override this via `createLiveVite({ setup })`.\n */\nexport const defaultVueSetup = (\n  makeApp: typeof createApp | typeof createSSRApp,\n  component: any,\n  props: Record<string, any>,\n  slots: Record<string, () => any>,\n  plugin: Plugin<[]>,\n  el: Element,\n): VueApp => {\n  const app = makeApp({ render: () => h(component, props, slots) })\n  app.use(plugin)\n  app.mount(el)\n  return app\n}\n\nexport type VueSetupFn = (\n  makeApp: typeof createApp | typeof createSSRApp,\n  component: any,\n  props: Record<string, any>,\n  slots: Record<string, () => any>,\n  plugin: Plugin<[]>,\n  el: Element,\n  ssr: boolean,\n) => VueApp\n\nexport interface VueRendererOptions {\n  /** Custom setup function for creating the Vue app. Defaults to `defaultVueSetup`. */\n  setup?: VueSetupFn\n  /** Vite SSR manifest for preload link generation (production builds only). */\n  manifest?: Record<string, string[]>\n}\n\n/** Mock LiveView hook used during SSR (no real socket available) */\nconst mockHook = {\n  el: {},\n  liveSocket: { socket: { connectionState: () => \"closed\" } } as any,\n  pushEvent: () => Promise.resolve(0),\n  pushEventTo: () => Promise.resolve([]),\n  handleEvent: () => ({ event: \"\", callback: () => {} }),\n  removeHandleEvent: () => {},\n  upload: () => {},\n  uploadTo: () => {},\n  vue: { props: {}, slots: {}, app: {} },\n}\n\n/**\n * Creates a Vue framework renderer.\n *\n * This is the reference implementation of the `FrameworkRenderer` interface.\n * It handles Vue-specific concerns: `reactive()` for props, `h()` for slots,\n * `createApp`/`createSSRApp` for mounting, and `app.unmount()` for cleanup.\n */\nexport function createVueRenderer(options: VueRendererOptions = {}): FrameworkRenderer<VueApp> {\n  const setup = options.setup ?? defaultVueSetup\n  const manifest = options.manifest ?? {}\n\n  return {\n    name: \"vue\",\n\n    mount(ctx: MountContext): RendererState<VueApp> {\n      const makeApp = ctx.ssr ? createSSRApp : createApp\n      const props = reactive(ctx.props)\n      const slots = reactive(htmlSlotsToVue(ctx.slots))\n\n      const plugin: Plugin<[]> = {\n        install: (app: App) => {\n          app.provide(liveInjectKey, ctx.hook)\n          app.config.globalProperties.$live = ctx.hook\n        },\n      }\n\n      const app = setup(makeApp, ctx.component, props, slots, plugin, ctx.el, ctx.ssr)\n\n      if (!app) throw new Error(\"Vue setup function did not return an app!\")\n\n      return { props, slots, app }\n    },\n\n    updateProps(state: RendererState<VueApp>, newProps: Record<string, any>): void {\n      Object.assign(state.props, newProps)\n    },\n\n    patchProps(state: RendererState<VueApp>, operations: Operation[]): void {\n      applyPatch(state.props, operations)\n    },\n\n    updateSlots(state: RendererState<VueApp>, newSlots: Record<string, string>): void {\n      Object.assign(state.slots, htmlSlotsToVue(newSlots))\n    },\n\n    unmount(state: RendererState<VueApp>): void {\n      if (state.app) {\n        window.addEventListener(\"phx:page-loading-stop\", () => state.app!.unmount(), { once: true })\n      }\n    },\n\n    async renderToString(ctx: RendererSSRContext): Promise<string> {\n      // Dynamic import to avoid bundling server-only deps in client builds\n      const { renderToString: vueRenderToString } = await import(\"vue/server-renderer\")\n\n      const component = ctx.component\n      const slotComponents = htmlSlotsToVue(ctx.slots)\n\n      const ssrSetup = options.setup ?? ((makeApp, component, props, slots, plugin, el) => {\n        const app = makeApp({ render: () => h(component, props, slots) })\n        app.use(plugin)\n        // Don't mount in SSR - no real DOM\n        return app\n      })\n\n      const plugin: Plugin<[]> = {\n        install: (app: App) => {\n          app.mount = (...args: unknown[]): any => undefined\n          app.provide(\"_live_vite\", Object.assign({}, mockHook))\n        },\n      }\n\n      const app = ssrSetup(createSSRApp, component, ctx.props, slotComponents, plugin, {} as Element, true)\n\n      if (!app) throw new Error(\"Vue SSR setup function did not return an app!\")\n\n      const vueCtx: import(\"vue/server-renderer\").SSRContext = {}\n      const html = await vueRenderToString(app, vueCtx)\n\n      // the SSR manifest generated by Vite contains module -> chunk/asset mapping\n      // which we can then use to determine what files need to be preloaded for this request.\n      const preloadLinks = renderPreloadLinks(vueCtx.modules ?? [], manifest)\n      return preloadLinks + \"<!-- preload -->\" + html\n    },\n  }\n}\n\ntype SSRManifest = Record<string, string[]>\n\nfunction renderPreloadLinks(modules: string[], manifest: SSRManifest) {\n  let links = \"\"\n  const seen = new Set()\n  modules.forEach((id: string) => {\n    const files = manifest[id]\n    if (files) {\n      files.forEach(file => {\n        if (!seen.has(file)) {\n          seen.add(file)\n          const filename = file.split(\"/\").pop() ?? file\n          if (manifest[filename]) {\n            for (const depFile of manifest[filename]) {\n              links += renderPreloadLink(depFile)\n              seen.add(depFile)\n            }\n          }\n          links += renderPreloadLink(file)\n        }\n      })\n    }\n  })\n  return links\n}\n\nfunction renderPreloadLink(file: string) {\n  if (file.endsWith(\".js\")) {\n    return `<link rel=\"modulepreload\" crossorigin href=\"${file}\">`\n  } else if (file.endsWith(\".css\")) {\n    return `<link rel=\"stylesheet\" href=\"${file}\">`\n  } else if (file.endsWith(\".woff\")) {\n    return ` <link rel=\"preload\" href=\"${file}\" as=\"font\" type=\"font/woff\" crossorigin>`\n  } else if (file.endsWith(\".woff2\")) {\n    return ` <link rel=\"preload\" href=\"${file}\" as=\"font\" type=\"font/woff2\" crossorigin>`\n  } else if (file.endsWith(\".gif\")) {\n    return ` <link rel=\"preload\" href=\"${file}\" as=\"image\" type=\"image/gif\">`\n  } else if (file.endsWith(\".jpg\") || file.endsWith(\".jpeg\")) {\n    return ` <link rel=\"preload\" href=\"${file}\" as=\"image\" type=\"image/jpeg\">`\n  } else if (file.endsWith(\".png\")) {\n    return ` <link rel=\"preload\" href=\"${file}\" as=\"image\" type=\"image/png\">`\n  } else {\n    return \"\"\n  }\n}\n","numLines":197,"startLine":1,"totalLines":197}}}
