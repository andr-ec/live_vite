tElement | null>(null)\n    41→  const [, setVersion] = useState(0)\n    42→  const rerender = useCallback(() => setVersion(v => v + 1), [])\n    43→\n    44→  // Keep a ref to the latest uploadConfig so the DOM update effect can read it\n    45→  const configRef = useRef(uploadConfig)\n    46→  configRef.current = uploadConfig\n    47→\n    48→  // Create and manage the hidden file input element with Phoenix upload attributes\n    49→  useEffect(() => {\n    50→    const form = document.createElement(\"form\")\n    51→    if (options.changeEvent) form.setAttribute(\"phx-change\", options.changeEvent)\n    52→    form.setAttribute(\"phx-submit\", options.submitEvent)\n    53→    form.style.display = \"none\"\n    54→\n    55→    const input = document.createElement(\"input\")\n    56→    input.type = \"file\"\n    57→    input.id = uploadConfig.ref\n    58→    input.name = uploadConfig.name\n    59→\n    60→    // Phoenix LiveView upload attributes\n    61→    input.setAttribute(\"data-phx-hook\", \"Phoenix.LiveFileUpload\")\n    62→    input.setAttribute(\"data-phx-update\", \"ignore\")\n    63→    input.setAttribute(\"data-phx-upload-ref\", uploadConfig.ref)\n    64→    form.appendChild(input)\n    65→\n    66→    if (uploadConfig.accept && typeof uploadConfig.accept === \"string\") {\n    67→      input.accept = uploadConfig.accept\n    68→    }\n    69→\n    70→    if (uploadConfig.auto_upload) {\n    71→      input.setAttribute(\"data-phx-auto-upload\", \"true\")\n    72→    }\n    73→\n    74→    if (uploadConfig.max_entries > 1) {\n    75→      input.multiple = true\n    76→    }\n    77→\n    78→    live.el.appendChild(form)\n    79→    inputElRef.current = input\n    80→    rerender()\n    81→\n    82→    return () => {\n    83→      form.remove()\n    84→      inputElRef.current = null\n    85→    }\n    86→  }, []) // eslint-disable-line react-hooks/exhaustive-deps -- mount once\n    87→\n    88→  // Update entry ref attributes when config changes\n    89