{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011jjevPVzqjCCSvLrB5DkVk","type":"tool_result","content":"     1→import { inject, onMounted, onUnmounted, ref, computed, watchEffect, toValue, type ComputedRef, type Ref } from \"vue\"\n     2→import type { MaybeRefOrGetter } from \"vue\"\n     3→import type { LiveHook, UploadConfig, UploadEntry, UploadOptions } from \"./types.js\"\n     4→\n     5→export const liveInjectKey = \"_live_vite\"\n     6→\n     7→/**\n     8→ * Returns the LiveVite instance.\n     9→ * Can be used to access the LiveVite instance from within a LiveVite component.\n    10→ * It allows to e.g. push events to the LiveView.\n    11→ */\n    12→export const useLiveVite = (): LiveHook => {\n    13→  const live = inject<LiveHook>(liveInjectKey)\n    14→  if (!live) throw new Error(\"LiveVite not provided. Are you using this inside a LiveVite component?\")\n    15→  return live\n    16→}\n    17→\n    18→/**\n    19→ * Registers a callback to be called when an event is received from the server.\n    20→ * It automatically removes the callback when the component is unmounted.\n    21→ * @param event - The event name.\n    22→ * @param callback - The callback to call when the event is received.\n    23→ */\n    24→export function useLiveEvent<T>(event: string, callback: (data: T) => void) {\n    25→  let callbackRef: ReturnType<LiveHook[\"handleEvent\"]> | null = null\n    26→  onMounted(() => {\n    27→    const live = useLiveVite()\n    28→    callbackRef = live.handleEvent(event, callback)\n    29→  })\n    30→  onUnmounted(() => {\n    31→    const live = useLiveVite()\n    32→    if (callbackRef) live.removeHandleEvent(callbackRef)\n    33→    callbackRef = null\n    34→  })\n    35→}\n    36→\n    37→/**\n    38→ * A composable for navigation.\n    39→ * It uses the LiveSocket instance to navigate to a new location.\n    40→ * Works in the same way as the `live_patch` and `live_redirect` functions in LiveView.\n    41→ * @returns An object with `patch` and `navigate` functions.\n    42→ */\n    43→export const useLiveNavigation = () => {\n    44→  const live = useLiveVite()\n    45→  const liveSocket = live.liveSocket\n    46→  if (!liveSocket) throw new Error(\"LiveSocket not initialized\")\n    47→\n    48→  /**\n    49→   * Patches the current LiveView.\n    50→   * @param hrefOrQueryParams - The URL or query params to navigate to.\n    51→   * @param opts - The options for the navigation.\n    52→   */\n    53→  const patch = (hrefOrQueryParams: string | Record<string, string>, opts: { replace?: boolean } = {}) => {\n    54→    let href = typeof hrefOrQueryParams === \"string\" ? hrefOrQueryParams : window.location.pathname\n    55→    if (typeof hrefOrQueryParams === \"object\") {\n    56→      const queryParams = new URLSearchParams(hrefOrQueryParams)\n    57→      href = `${href}?${queryParams.toString()}`\n    58→    }\n    59→    liveSocket.pushHistoryPatch(new Event(\"click\"), href, opts.replace ? \"replace\" : \"push\", null)\n    60→  }\n    61→\n    62→  /**\n    63→   * Navigates to a new location.\n    64→   * @param href - The URL to navigate to.\n    65→   * @param opts - The options for the navigation.\n    66→   */\n    67→  const navigate = (href: string, opts: { replace?: boolean } = {}) => {\n    68→    liveSocket.historyRedirect(new Event(\"click\"), href, opts.replace ? \"replace\" : \"push\", null, null)\n    69→  }\n    70→\n    71→  return {\n    72→    patch,\n    73→    navigate,\n    74→  }\n    75→}\n    76→\n    77→export interface UseLiveUploadReturn {\n    78→  /** Reactive list of current entries coming from the server patch */\n    79→  entries: Ref<UploadEntry[]>\n    80→  /** Opens the native file-picker dialog */\n    81→  showFilePicker: () => void\n    82→  /** Manually enqueue external files (e.g. drag-drop) */\n    83→  addFiles: (files: (File | Blob)[] | DataTransfer) => void\n    84→  /** Submit *all* currently queued files to LiveView (no args) */\n    85→  submit: () => void\n    86→  /** Cancel a single entry by ref or every entry when omitted */\n    87→  cancel: (ref?: string) => void\n    88→  /** Clear local queue and reset hidden input (post-upload cleanup) */\n    89→  clear: () => void\n    90→  /** Overall progress 0-100 derived from entries */\n    91→  progress: Ref<number>\n    92→  /** The underlying hidden <input type=file> */\n    93→  inputEl: Ref<HTMLInputElement | null>\n    94→  /** Whether the selected files are valid */\n    95→  valid: ComputedRef<boolean>\n    96→}\n    97→\n    98→/**\n    99→ * A composable for Phoenix LiveView file uploads.\n   100→ * Provides a Vue-friendly API for handling file uploads with LiveView.\n   101→ * @param uploadConfig - Reactive reference to the upload configuration from LiveView\n   102→ * @param options - The options for the upload. Mostly names of events to use for phx-change and phx-submit.\n   103→ * @returns An object with upload methods and reactive state\n   104→ */\n   105→export const useLiveUpload = (\n   106→  uploadConfig: MaybeRefOrGetter<UploadConfig>,\n   107→  options: UploadOptions\n   108→): UseLiveUploadReturn => {\n   109→  const live = useLiveVite()\n   110→  const inputEl = ref<HTMLInputElement | null>(null)\n   111→\n   112→  // Create and manage the hidden file input element with Phoenix upload attributes\n   113→  onMounted(() => {\n   114→    if (!inputEl.value) {\n   115→      // Create a form to wrap the input, with phx-change=\"validate\"\n   116→      const uploadConfigValue = toValue(uploadConfig)\n   117→      const form = document.createElement(\"form\")\n   118→      if (options.changeEvent) form.setAttribute(\"phx-change\", options.changeEvent)\n   119→      form.setAttribute(\"phx-submit\", options.submitEvent)\n   120→      form.style.display = \"none\"\n   121→\n   122→      const input = document.createElement(\"input\")\n   123→      input.type = \"file\"\n   124→      input.id = uploadConfigValue.ref\n   125→      input.name = uploadConfigValue.name\n   126→\n   127→      // Phoenix LiveView upload attributes - these are critical for Phoenix to find and manage the input\n   128→      input.setAttribute(\"data-phx-hook\", \"Phoenix.LiveFileUpload\")\n   129→      input.setAttribute(\"data-phx-update\", \"ignore\")\n   130→      input.setAttribute(\"data-phx-upload-ref\", uploadConfigValue.ref)\n   131→      form.appendChild(input)\n   132→\n   133→      // Set accept attribute if specified\n   134→      if (uploadConfigValue.accept && typeof uploadConfigValue.accept === \"string\") {\n   135→        input.accept = uploadConfigValue.accept\n   136→      }\n   137→\n   138→      // Set auto_upload attribute if specified\n   139→      if (uploadConfigValue.auto_upload) {\n   140→        input.setAttribute(\"data-phx-auto-upload\", \"true\")\n   141→      }\n   142→\n   143→      // Set multiple attribute based on max_entries\n   144→      if (uploadConfigValue.max_entries > 1) {\n   145→        input.multiple = true\n   146→      }\n   147→\n   148→      // Update entry refs attributes based on current entries\n   149→      const updateEntryRefs = () => {\n   150→        const config = toValue(uploadConfig)\n   151→        const joinEntries = (entries: UploadEntry[]) => entries.map(e => e.ref).join(\",\")\n   152→\n   153→        input.setAttribute(\"data-phx-active-refs\", joinEntries(config.entries))\n   154→        input.setAttribute(\"data-phx-done-refs\", joinEntries(config.entries.filter(e => e.done)))\n   155→        input.setAttribute(\"data-phx-preflighted-refs\", joinEntries(config.entries.filter(e => e.preflighted)))\n   156→      }\n   157→\n   158→      const unwatchConfig = watchEffect(() => updateEntryRefs())\n   159→\n   160→      // Store unwatch function for cleanup\n   161→      ;(input as any).__unwatchConfig = unwatchConfig\n   162→\n   163→      // Append to the LiveView element so Phoenix can find it\n   164→      // Phoenix searches for upload inputs within the LiveView element\n   165→      live.el.appendChild(form)\n   166→      inputEl.value = input\n   167→    }\n   168→  })\n   169→\n   170→  // Clean up the input element when component unmounts\n   171→  onUnmounted(() => {\n   172→    if (inputEl.value) {\n   173→      // Clean up the watcher\n   174→      ;(inputEl.value as any).__unwatchConfig?.()\n   175→      inputEl.value.form?.remove()\n   176→      inputEl.value.remove()\n   177→      inputEl.value = null\n   178→    }\n   179→  })\n   180→\n   181→  // Reactive entries from the upload config\n   182→  const entries = computed(() => {\n   183→    const uploadConfigValue = toValue(uploadConfig)\n   184→    return uploadConfigValue.entries || []\n   185→  })\n   186→\n   187→  // Calculate overall progress\n   188→  const progress = computed(() => {\n   189→    const allEntries = entries.value\n   190→    if (allEntries.length === 0) return 0\n   191→\n   192→    const totalProgress = allEntries.reduce((sum: number, entry) => sum + (entry.progress || 0), 0)\n   193→    return Math.round(totalProgress / allEntries.length)\n   194→  })\n   195→\n   196→  // Open the native file picker dialog\n   197→  const showFilePicker = () => {\n   198→    if (inputEl.value) {\n   199→      inputEl.value.click()\n   200→    }\n   201→  }\n   202→\n   203→  // Manually add files (e.g., from drag-and-drop or DataTransfer)\n   204→  const addFiles = (input: (File | Blob)[] | DataTransfer) => {\n   205→    if (!inputEl.value) return\n   206→\n   207→    if (input instanceof DataTransfer) {\n   208→      inputEl.value.files = input.files\n   209→    } else if (Array.isArray(input)) {\n   210→      const dataTransfer = new DataTransfer()\n   211→      input.forEach(f => dataTransfer.items.add(f as File))\n   212→      inputEl.value.files = dataTransfer.files\n   213→    }\n   214→\n   215→    // Dispatch change event to trigger Phoenix LiveView upload handling\n   216→    // This mimics what happens when files are selected through the native file picker\n   217→    // Use setTimeout to ensure Phoenix has had a chance to initialize the upload system\n   218→    setTimeout(() => {\n   219→      if (inputEl.value) {\n   220→        inputEl.value.dispatchEvent(new Event(\"change\", { bubbles: true, cancelable: true }))\n   221→      }\n   222→    }, 0)\n   223→  }\n   224→\n   225→  // Submit all queued files (for non-auto uploads)\n   226→  const submit = () => {\n   227→    // For auto-upload configs, this is essentially a no-op since Phoenix handles it automatically\n   228→    // For manual uploads, we could trigger a form submission or push an event\n   229→    // But Phoenix's upload system handles this automatically when files are selected\n   230→    if (inputEl.value) {\n   231→      // Phoenix will handle the upload automatically based on the auto_upload setting\n   232→      // We could push a manual upload event here if needed\n   233→      inputEl.value.form?.dispatchEvent(new Event(\"submit\", { bubbles: true, cancelable: true }))\n   234→    }\n   235→  }\n   236→\n   237→  // Cancel upload entries\n   238→  const cancel = (ref?: string) => {\n   239→    if (ref) {\n   240→      // Cancel specific entry\n   241→      live.pushEvent(\"cancel-upload\", { ref })\n   242→    } else {\n   243→      // Cancel all entries\n   244→      entries.value.forEach(entry => {\n   245→        live.pushEvent(\"cancel-upload\", { ref: entry.ref })\n   246→      })\n   247→    }\n   248→  }\n   249→\n   250→  // Clear the input and reset state\n   251→  const clear = () => {\n   252→    if (inputEl.value) {\n   253→      inputEl.value.value = \"\"\n   254→    }\n   255→  }\n   256→\n   257→  const valid = computed(() => {\n   258→    const uploadConfigValue = toValue(uploadConfig)\n   259→    return Object.keys(uploadConfigValue.errors).length === 0\n   260→  })\n   261→\n   262→  return {\n   263→    entries,\n   264→    showFilePicker,\n   265→    addFiles,\n   266→    submit,\n   267→    cancel,\n   268→    clear,\n   269→    progress,\n   270→    inputEl,\n   271→    valid,\n   272→  }\n   273→}\n   274→\n   275→export interface UseEventReplyOptions<T> {\n   276→  /** Default value to initialize data with */\n   277→  defaultValue?: T\n   278→  /** Function to transform reply data before storing it */\n   279→  updateData?: (reply: T, currentData: T | null) => T\n   280→}\n   281→\n   282→export interface UseEventReplyReturn<T, P> {\n   283→  /** Reactive data returned from the event reply */\n   284→  data: Ref<T | null>\n   285→  /** Whether an event is currently executing */\n   286→  isLoading: Ref<boolean>\n   287→  /** Execute the event with optional parameters */\n   288→  execute: (params?: P) => Promise<T>\n   289→  /** Cancel the current event execution */\n   290→  cancel: () => void\n   291→}\n   292→\n   293→/**\n   294→ * A composable for handling LiveView events with replies.\n   295→ * Provides a reactive way to execute events and handle their responses.\n   296→ * @param eventName - The name of the event to send to LiveView\n   297→ * @param options - Configuration options including defaultValue and updateData function\n   298→ * @returns An object with reactive state and control functions\n   299→ */\n   300→export const useEventReply = <T = any, P extends Record<string, any> | void = Record<string, any>>(\n   301→  eventName: string,\n   302→  options?: UseEventReplyOptions<T>\n   303→): UseEventReplyReturn<T, P> => {\n   304→  const live = useLiveVite()\n   305→\n   306→  const data = ref<T | null>(options?.defaultValue ?? null) as Ref<T | null>\n   307→  const isLoading = ref(false)\n   308→  \n   309→  let executionToken = 0\n   310→  let pendingReject: ((reason?: any) => void) | null = null\n   311→\n   312→  const execute = (params?: P): Promise<T> => {\n   313→    if (isLoading.value) {\n   314→      console.warn(`Event \"${eventName}\" is already executing. Call cancel() first if you want to start a new execution.`)\n   315→      return Promise.reject(new Error(`Event \"${eventName}\" is already executing`))\n   316→    }\n   317→\n   318→    // Set loading state\n   319→    isLoading.value = true\n   320→    \n   321→    // Create a unique token for this execution\n   322→    const currentToken = ++executionToken\n   323→    \n   324→    return new Promise<T>((resolve, reject) => {\n   325→      // Store reject function so we can call it on cancel\n   326→      pendingReject = reject\n   327→\n   328→      live.pushEvent(eventName, params, (reply: T) => {\n   329→        // Only update state if this is still the current execution\n   330→        if (currentToken === executionToken) {\n   331→          // Use updateData function if provided, otherwise just set the reply\n   332→          data.value = options?.updateData ? options.updateData(reply, data.value) : reply\n   333→          isLoading.value = false\n   334→          pendingReject = null // Clear pending reject since we're resolving\n   335→          resolve(reply)\n   336→        }\n   337→        // If tokens don't match, this execution was cancelled - ignore the result\n   338→      })\n   339→    })\n   340→  }\n   341→\n   342→  const cancel = () => {\n   343→    // Reject the pending promise if there is one\n   344→    if (pendingReject) {\n   345→      pendingReject(new Error(`Event \"${eventName}\" was cancelled`))\n   346→      pendingReject = null\n   347→    }\n   348→\n   349→    // Increment token to invalidate any pending callbacks\n   350→    executionToken++\n   351→    isLoading.value = false\n   352→  }\n   353→\n   354→  return {\n   355→    data,\n   356→    isLoading,\n   357→    execute,\n   358→    cancel,\n   359→  }\n   360→}\n   361→\n   362→export interface UseLiveConnectionReturn {\n   363→  /** Reactive connection state: \"connecting\" | \"open\" | \"closing\" | \"closed\" */\n   364→  connectionState: Ref<string>\n   365→  /** Whether the socket is currently connected */\n   366→  isConnected: ComputedRef<boolean>\n   367→}\n   368→\n   369→/**\n   370→ * A composable for monitoring LiveView WebSocket connectivity status.\n   371→ * Provides reactive connection state and convenience methods.\n   372→ * @returns An object with reactive connection state and computed connection status\n   373→ */\n   374→export const useLiveConnection = (): UseLiveConnectionReturn => {\n   375→  const live = useLiveVite()\n   376→  const liveSocket = live.liveSocket\n   377→  if (!liveSocket) throw new Error(\"LiveSocket not initialized\")\n   378→  \n   379→  const socket = liveSocket.socket\n   380→  if (!socket) throw new Error(\"Socket not available\")\n   381→\n   382→  // Initialize with current connection state\n   383→  const connectionState = ref(socket.connectionState())\n   384→  \n   385→  // Computed convenience property\n   386→  const isConnected = computed(() => connectionState.value === \"open\")\n   387→\n   388→  let openRef: string | null = null\n   389→  let closeRef: string | null = null\n   390→  let errorRef: string | null = null\n   391→\n   392→  onMounted(() => {\n   393→    // Register connection event listeners\n   394→    openRef = socket.onOpen(() => {\n   395→      connectionState.value = \"open\"\n   396→    })\n   397→    \n   398→    closeRef = socket.onClose(() => {\n   399→      connectionState.value = \"closed\"\n   400→    })\n   401→    \n   402→    errorRef = socket.onError(() => {\n   403→      // Update state to reflect current socket state after error\n   404→      connectionState.value = socket.connectionState()\n   405→    })\n   406→  })\n   407→\n   408→  onUnmounted(() => {\n   409→    // Clean up event listeners\n   410→    const refs = [openRef, closeRef, errorRef].filter(ref => ref !== null) as string[]\n   411→    if (refs.length > 0) {\n   412→      socket.off(refs)\n   413→    }\n   414→  })\n   415→\n   416→  return {\n   417→    connectionState,\n   418→    isConnected,\n   419→  }\n   420→}\n   421→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"aef57bc1-a1d6-4ff6-aae1-abea1eae50ab","uuid":"2a89dfc6-9645-4e4c-a272-46cfe6531b10","tool_use_result":{"type":"text","file":{"filePath":"/home/andre/Documents/scratch/live_vue/assets/use.ts","content":"import { inject, onMounted, onUnmounted, ref, computed, watchEffect, toValue, type ComputedRef, type Ref } from \"vue\"\nimport type { MaybeRefOrGetter } from \"vue\"\nimport type { LiveHook, UploadConfig, UploadEntry, UploadOptions } from \"./types.js\"\n\nexport const liveInjectKey = \"_live_vite\"\n\n/**\n * Returns the LiveVite instance.\n * Can be used to access the LiveVite instance from within a LiveVite component.\n * It allows to e.g. push events to the LiveView.\n */\nexport const useLiveVite = (): LiveHook => {\n  const live = inject<LiveHook>(liveInjectKey)\n  if (!live) throw new Error(\"LiveVite not provided. Are you using this inside a LiveVite component?\")\n  return live\n}\n\n/**\n * Registers a callback to be called when an event is received from the server.\n * It automatically removes the callback when the component is unmounted.\n * @param event - The event name.\n * @param callback - The callback to call when the event is received.\n */\nexport function useLiveEvent<T>(event: string, callback: (data: T) => void) {\n  let callbackRef: ReturnType<LiveHook[\"handleEvent\"]> | null = null\n  onMounted(() => {\n    const live = useLiveVite()\n    callbackRef = live.handleEvent(event, callback)\n  })\n  onUnmounted(() => {\n    const live = useLiveVite()\n    if (callbackRef) live.removeHandleEvent(callbackRef)\n    callbackRef = null\n  })\n}\n\n/**\n * A composable for navigation.\n * It uses the LiveSocket instance to navigate to a new location.\n * Works in the same way as the `live_patch` and `live_redirect` functions in LiveView.\n * @returns An object with `patch` and `navigate` functions.\n */\nexport const useLiveNavigation = () => {\n  const live = useLiveVite()\n  const liveSocket = live.liveSocket\n  if (!liveSocket) throw new Error(\"LiveSocket not initialized\")\n\n  /**\n   * Patches the current LiveView.\n   * @param hrefOrQueryParams - The URL or query params to navigate to.\n   * @param opts - The options for the navigation.\n   */\n  const patch = (hrefOrQueryParams: string | Record<string, string>, opts: { replace?: boolean } = {}) => {\n    let href = typeof hrefOrQueryParams === \"string\" ? hrefOrQueryParams : window.location.pathname\n    if (typeof hrefOrQueryParams === \"object\") {\n      const queryParams = new URLSearchParams(hrefOrQueryParams)\n      href = `${href}?${queryParams.toString()}`\n    }\n    liveSocket.pushHistoryPatch(new Event(\"click\"), href, opts.replace ? \"replace\" : \"push\", null)\n  }\n\n  /**\n   * Navigates to a new location.\n   * @param href - The URL to navigate to.\n   * @param opts - The options for the navigation.\n   */\n  const navigate = (href: string, opts: { replace?: boolean } = {}) => {\n    liveSocket.historyRedirect(new Event(\"click\"), href, opts.replace ? \"replace\" : \"push\", null, null)\n  }\n\n  return {\n    patch,\n    navigate,\n  }\n}\n\nexport interface UseLiveUploadReturn {\n  /** Reactive list of current entries coming from the server patch */\n  entries: Ref<UploadEntry[]>\n  /** Opens the native file-picker dialog */\n  showFilePicker: () => void\n  /** Manually enqueue external files (e.g. drag-drop) */\n  addFiles: (files: (File | Blob)[] | DataTransfer) => void\n  /** Submit *all* currently queued files to LiveView (no args) */\n  submit: () => void\n  /** Cancel a single entry by ref or every entry when omitted */\n  cancel: (ref?: string) => void\n  /** Clear local queue and reset hidden input (post-upload cleanup) */\n  clear: () => void\n  /** Overall progress 0-100 derived from entries */\n  progress: Ref<number>\n  /** The underlying hidden <input type=file> */\n  inputEl: Ref<HTMLInputElement | null>\n  /** Whether the selected files are valid */\n  valid: ComputedRef<boolean>\n}\n\n/**\n * A composable for Phoenix LiveView file uploads.\n * Provides a Vue-friendly API for handling file uploads with LiveView.\n * @param uploadConfig - Reactive reference to the upload configuration from LiveView\n * @param options - The options for the upload. Mostly names of events to use for phx-change and phx-submit.\n * @returns An object with upload methods and reactive state\n */\nexport const useLiveUpload = (\n  uploadConfig: MaybeRefOrGetter<UploadConfig>,\n  options: UploadOptions\n): UseLiveUploadReturn => {\n  const live = useLiveVite()\n  const inputEl = ref<HTMLInputElement | null>(null)\n\n  // Create and manage the hidden file input element with Phoenix upload attributes\n  onMounted(() => {\n    if (!inputEl.value) {\n      // Create a form to wrap the input, with phx-change=\"validate\"\n      const uploadConfigValue = toValue(uploadConfig)\n      const form = document.createElement(\"form\")\n      if (options.changeEvent) form.setAttribute(\"phx-change\", options.changeEvent)\n      form.setAttribute(\"phx-submit\", options.submitEvent)\n      form.style.display = \"none\"\n\n      const input = document.createElement(\"input\")\n      input.type = \"file\"\n      input.id = uploadConfigValue.ref\n      input.name = uploadConfigValue.name\n\n      // Phoenix LiveView upload attributes - these are critical for Phoenix to find and manage the input\n      input.setAttribute(\"data-phx-hook\", \"Phoenix.LiveFileUpload\")\n      input.setAttribute(\"data-phx-update\", \"ignore\")\n      input.setAttribute(\"data-phx-upload-ref\", uploadConfigValue.ref)\n      form.appendChild(input)\n\n      // Set accept attribute if specified\n      if (uploadConfigValue.accept && typeof uploadConfigValue.accept === \"string\") {\n        input.accept = uploadConfigValue.accept\n      }\n\n      // Set auto_upload attribute if specified\n      if (uploadConfigValue.auto_upload) {\n        input.setAttribute(\"data-phx-auto-upload\", \"true\")\n      }\n\n      // Set multiple attribute based on max_entries\n      if (uploadConfigValue.max_entries > 1) {\n        input.multiple = true\n      }\n\n      // Update entry refs attributes based on current entries\n      const updateEntryRefs = () => {\n        const config = toValue(uploadConfig)\n        const joinEntries = (entries: UploadEntry[]) => entries.map(e => e.ref).join(\",\")\n\n        input.setAttribute(\"data-phx-active-refs\", joinEntries(config.entries))\n        input.setAttribute(\"data-phx-done-refs\", joinEntries(config.entries.filter(e => e.done)))\n        input.setAttribute(\"data-phx-preflighted-refs\", joinEntries(config.entries.filter(e => e.preflighted)))\n      }\n\n      const unwatchConfig = watchEffect(() => updateEntryRefs())\n\n      // Store unwatch function for cleanup\n      ;(input as any).__unwatchConfig = unwatchConfig\n\n      // Append to the LiveView element so Phoenix can find it\n      // Phoenix searches for upload inputs within the LiveView element\n      live.el.appendChild(form)\n      inputEl.value = input\n    }\n  })\n\n  // Clean up the input element when component unmounts\n  onUnmounted(() => {\n    if (inputEl.value) {\n      // Clean up the watcher\n      ;(inputEl.value as any).__unwatchConfig?.()\n      inputEl.value.form?.remove()\n      inputEl.value.remove()\n      inputEl.value = null\n    }\n  })\n\n  // Reactive entries from the upload config\n  const entries = computed(() => {\n    const uploadConfigValue = toValue(uploadConfig)\n    return uploadConfigValue.entries || []\n  })\n\n  // Calculate overall progress\n  const progress = computed(() => {\n    const allEntries = entries.value\n    if (allEntries.length === 0) return 0\n\n    const totalProgress = allEntries.reduce((sum: number, entry) => sum + (entry.progress || 0), 0)\n    return Math.round(totalProgress / allEntries.length)\n  })\n\n  // Open the native file picker dialog\n  const showFilePicker = () => {\n    if (inputEl.value) {\n      inputEl.value.click()\n    }\n  }\n\n  // Manually add files (e.g., from drag-and-drop or DataTransfer)\n  const addFiles = (input: (File | Blob)[] | DataTransfer) => {\n    if (!inputEl.value) return\n\n    if (input instanceof DataTransfer) {\n      inputEl.value.files = input.files\n    } else if (Array.isArray(input)) {\n      const dataTransfer = new DataTransfer()\n      input.forEach(f => dataTransfer.items.add(f as File))\n      inputEl.value.files = dataTransfer.files\n    }\n\n    // Dispatch change event to trigger Phoenix LiveView upload handling\n    // This mimics what happens when files are selected through the native file picker\n    // Use setTimeout to ensure Phoenix has had a chance to initialize the upload system\n    setTimeout(() => {\n      if (inputEl.value) {\n        inputEl.value.dispatchEvent(new Event(\"change\", { bubbles: true, cancelable: true }))\n      }\n    }, 0)\n  }\n\n  // Submit all queued files (for non-auto uploads)\n  const submit = () => {\n    // For auto-upload configs, this is essentially a no-op since Phoenix handles it automatically\n    // For manual uploads, we could trigger a form submission or push an event\n    // But Phoenix's upload system handles this automatically when files are selected\n    if (inputEl.value) {\n      // Phoenix will handle the upload automatically based on the auto_upload setting\n      // We could push a manual upload event here if needed\n      inputEl.value.form?.dispatchEvent(new Event(\"submit\", { bubbles: true, cancelable: true }))\n    }\n  }\n\n  // Cancel upload entries\n  const cancel = (ref?: string) => {\n    if (ref) {\n      // Cancel specific entry\n      live.pushEvent(\"cancel-upload\", { ref })\n    } else {\n      // Cancel all entries\n      entries.value.forEach(entry => {\n        live.pushEvent(\"cancel-upload\", { ref: entry.ref })\n      })\n    }\n  }\n\n  // Clear the input and reset state\n  const clear = () => {\n    if (inputEl.value) {\n      inputEl.value.value = \"\"\n    }\n  }\n\n  const valid = computed(() => {\n    const uploadConfigValue = toValue(uploadConfig)\n    return Object.keys(uploadConfigValue.errors).length === 0\n  })\n\n  return {\n    entries,\n    showFilePicker,\n    addFiles,\n    submit,\n    cancel,\n    clear,\n    progress,\n    inputEl,\n    valid,\n  }\n}\n\nexport interface UseEventReplyOptions<T> {\n  /** Default value to initialize data with */\n  defaultValue?: T\n  /** Function to transform reply data before storing it */\n  updateData?: (reply: T, currentData: T | null) => T\n}\n\nexport interface UseEventReplyReturn<T, P> {\n  /** Reactive data returned from the event reply */\n  data: Ref<T | null>\n  /** Whether an event is currently executing */\n  isLoading: Ref<boolean>\n  /** Execute the event with optional parameters */\n  execute: (params?: P) => Promise<T>\n  /** Cancel the current event execution */\n  cancel: () => void\n}\n\n/**\n * A composable for handling LiveView events with replies.\n * Provides a reactive way to execute events and handle their responses.\n * @param eventName - The name of the event to send to LiveView\n * @param options - Configuration options including defaultValue and updateData function\n * @returns An object with reactive state and control functions\n */\nexport const useEventReply = <T = any, P extends Record<string, any> | void = Record<string, any>>(\n  eventName: string,\n  options?: UseEventReplyOptions<T>\n): UseEventReplyReturn<T, P> => {\n  const live = useLiveVite()\n\n  const data = ref<T | null>(options?.defaultValue ?? null) as Ref<T | null>\n  const isLoading = ref(false)\n  \n  let executionToken = 0\n  let pendingReject: ((reason?: any) => void) | null = null\n\n  const execute = (params?: P): Promise<T> => {\n    if (isLoading.value) {\n      console.warn(`Event \"${eventName}\" is already executing. Call cancel() first if you want to start a new execution.`)\n      return Promise.reject(new Error(`Event \"${eventName}\" is already executing`))\n    }\n\n    // Set loading state\n    isLoading.value = true\n    \n    // Create a unique token for this execution\n    const currentToken = ++executionToken\n    \n    return new Promise<T>((resolve, reject) => {\n      // Store reject function so we can call it on cancel\n      pendingReject = reject\n\n      live.pushEvent(eventName, params, (reply: T) => {\n        // Only update state if this is still the current execution\n        if (currentToken === executionToken) {\n          // Use updateData function if provided, otherwise just set the reply\n          data.value = options?.updateData ? options.updateData(reply, data.value) : reply\n          isLoading.value = false\n          pendingReject = null // Clear pending reject since we're resolving\n          resolve(reply)\n        }\n        // If tokens don't match, this execution was cancelled - ignore the result\n      })\n    })\n  }\n\n  const cancel = () => {\n    // Reject the pending promise if there is one\n    if (pendingReject) {\n      pendingReject(new Error(`Event \"${eventName}\" was cancelled`))\n      pendingReject = null\n    }\n\n    // Increment token to invalidate any pending callbacks\n    executionToken++\n    isLoading.value = false\n  }\n\n  return {\n    data,\n    isLoading,\n    execute,\n    cancel,\n  }\n}\n\nexport interface UseLiveConnectionReturn {\n  /** Reactive connection state: \"connecting\" | \"open\" | \"closing\" | \"closed\" */\n  connectionState: Ref<string>\n  /** Whether the socket is currently connected */\n  isConnected: ComputedRef<boolean>\n}\n\n/**\n * A composable for monitoring LiveView WebSocket connectivity status.\n * Provides reactive connection state and convenience methods.\n * @returns An object with reactive connection state and computed connection status\n */\nexport const useLiveConnection = (): UseLiveConnectionReturn => {\n  const live = useLiveVite()\n  const liveSocket = live.liveSocket\n  if (!liveSocket) throw new Error(\"LiveSocket not initialized\")\n  \n  const socket = liveSocket.socket\n  if (!socket) throw new Error(\"Socket not available\")\n\n  // Initialize with current connection state\n  const connectionState = ref(socket.connectionState())\n  \n  // Computed convenience property\n  const isConnected = computed(() => connectionState.value === \"open\")\n\n  let openRef: string | null = null\n  let closeRef: string | null = null\n  let errorRef: string | null = null\n\n  onMounted(() => {\n    // Register connection event listeners\n    openRef = socket.onOpen(() => {\n      connectionState.value = \"open\"\n    })\n    \n    closeRef = socket.onClose(() => {\n      connectionState.value = \"closed\"\n    })\n    \n    errorRef = socket.onError(() => {\n      // Update state to reflect current socket state after error\n      connectionState.value = socket.connectionState()\n    })\n  })\n\n  onUnmounted(() => {\n    // Clean up event listeners\n    const refs = [openRef, closeRef, errorRef].filter(ref => ref !== null) as string[]\n    if (refs.length > 0) {\n      socket.off(refs)\n    }\n  })\n\n  return {\n    connectionState,\n    isConnected,\n  }\n}\n","numLines":421,"startLine":1,"totalLines":421}}}
