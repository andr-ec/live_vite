 })\n   468→\n   469→    it(\"should handle onChange updates\", () => {\n   470→      const formData = createFormData()\n   471→      const { form } = mountForm(formData)\n   472→      const nameField = form.field(\"name\")\n   473→\n   474→      const mockEvent = { target: { value: \"New Name\" } }\n   475→      act(() => {\n   476→        nameField.inputProps.onChange(mockEvent)\n   477→      })\n   478→\n   479→      expect(form.field(\"name\").value).toBe(\"New Name\")\n   480→      expect(form.field(\"name\").inputProps.value).toBe(\"New Name\")\n   481→    })\n   482→\n   483→    it(\"should handle blur event\", () => {\n   484→      const formData = createFormData()\n   485→      const { form } = mountForm(formData)\n   486→\n   487→      expect(form.field(\"name\").isTouched).toBe(false)\n   488→\n   489→      act(() => {\n   490→        form.field(\"name\").inputProps.onBlur()\n   491→      })\n   492→\n   493→      expect(form.field(\"name\").isTouched).toBe(true)\n   494→    })\n   495→\n   496→    it(\"should set aria-invalid when field has errors\", () => {\n   497→      const formData = createFormWithErrors()\n   498→      const { form } = mountForm(formData)\n   499→\n   500→      expect(form.field(\"name\").inputProps[\"aria-invalid\"]).toBe(true)\n   501→      expect(form.field(\"email\").inputProps[\"aria-invalid\"]).toBe(true)\n   502→      expect(form.field(\"age\").inputProps[\"aria-invalid\"]).toBe(false)\n   503→    })\n   504→\n   505→    it(\"should set aria-describedby when field has errors\", () => {\n   506→      const formData = createFormWithErrors()\n   507→      const { form } = mountForm(formData)\n   508→\n   509→      expect(form.field(\"name\").inputProps[\"aria-describedby\"]).toBe(\"name-error\")\n   510→      expect(form.field(\"age\").inputProps[\"aria-describedby\"]).toBeUndefined()\n   511→\n   512→      const bioField = form.field(\"profile.bio\")\n   513→      expect(bioField.inputProps[\"aria-describedby\"]).toBe(\"profile_bio-error\")\n   514→    })\n   515→\n   516→    it(\"should work with array fields\", () => {\n   517→      const formData = createFormData()\n   518→      const { form } = mountForm(formData)\n   519→      const skillsArray = form.fieldArray(\"profile.skills\")\n   520→      const firstSkillField = skillsArray.field(0)\n   521→\n   522→      const props = firstSkillField.inputProps\n   523→\n   524→      expect(props.value).toBe(\"JavaScript\")\n   525→      expect(props.name).toBe(\"profile.skills[0]\")\n   526→      expect(props.id).toBe(\"profile_skills_0\")\n   527→      expect(props[\"aria-invalid\"]).toBe(false)\n   528→    })\n   529→\n   530→    it(\"should allow chaining with sub-fields\", () => {\n   531→      const formData = createFormData()\n   532→      const { form } = mountForm(formData)\n   533→      const profileField = form.field(\"profile\")\n   534→      const bioField = profileField.field(\"bio\")\n   535→\n   536→      const props = bioField.inputProps\n   537→\n   538→      expect(props.value).toBe(\"Software developer\")\n   539→      expect(props.name).toBe(\"profile.bio\")\n   540→      expect(props.id).toBe(\"profile_bio\")\n   541→    })\n   542→  })\n   543→\n   544→  describe(\"form-level dirty tracking\", () => {\n   545→    it(\"should track form as dirty when any field changes\", () => {\n   546→      const formData = createFormData()\n   547→      const { form } = mountForm(formData)\n   548→\n   549→      expect(form.isDirty).toBe(false)\n   550→\n   551→      act(() => {\n   552→        form.field(\"name\").setValue(\"Jane Doe\")\n   553→      })\n   554→\n   555→      expect(form.isDirty).toBe(true)\n   556→    })\n   557→\n   558→    it(\"should track form as dirty when nested field changes\", () => {\n   559→      const formData = createFormData()\n   560→      const { form } = mountForm(formData)\n   561→\n   562→      expect(form.isDirty).toBe(false)\n   563→\n   564→      act(() => {\n   565→        form.field(\"profile