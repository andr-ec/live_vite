eld.isValid as boolean,\n   329→          ...(field.errors.length > 0 ? { \"aria-describedby\": `${fieldId}-error` } : {}),\n   330→        }\n   331→\n   332→        if (isMultiCheckbox) {\n   333→          return {\n   334→            ...baseProps,\n   335→            value: options.value,\n   336→            checked: ((field.value as any[]) || []).includes(options.value),\n   337→            onChange: (event: any) => {\n   338→              const target = event.target as HTMLInputElement\n   339→              const currentArray = [...((field.value as any[]) || [])]\n   340→              const idx = currentArray.indexOf(options.value)\n   341→              if (target.checked && idx === -1) {\n   342→                currentArray.push(options.value)\n   343→              } else if (!target.checked && idx !== -1) {\n   344→                currentArray.splice(idx, 1)\n   345→              }\n   346→              field.setValue(currentArray as any)\n   347→            },\n   348→          }\n   349→        } else if (options.type === \"checkbox\") {\n   350→          const optionsValue = options.value !== undefined ? options.value : true\n   351→          return {\n   352→            ...baseProps,\n   353→            value: options.value,\n   354→            checked: field.value === optionsValue,\n   355→            onChange: (event: any) => {\n   356→              const target = event.target as HTMLInputElement\n   357→              field.setValue((target.checked ? optionsValue : null) as any)\n   358→            },\n   359→          }\n   360→        } else {\n   361→          return {\n   362→            ...baseProps,\n   363→            value: field.value,\n   364→            onChange: (event: any) => {\n   365→              const target = event.target as HTMLInputElement\n   366→              field.setValue(target.value as any)\n   367→            },\n   368→          }\n   369→        }\n   370→      },\n   371→\n   372→      field(key: any, opts?: FieldOptions) {\n   373→        const subPath = path ? `${path}.${String(key)}` : String(key)\n   374→        return createFormField(subPath, opts) as any\n   375→      },\n   376→\n   377→      fieldArray(key: any) {\n   378→        const subPath = path ? `${path}.${String(key)}` : String(key)\n   379→        return createFormFieldArray(subPath) as any\n   380→      },\n   381→    }\n   382→\n   383→    // Store options for cache comparison\n   384→    ;(field as any)._options = options\n   385→    fieldsForPath.push(field)\n   386→\n   387→    return field\n   388→  }\n   389→\n   390→  function createFormFieldArray<V>(path: string): ReactFormFieldArray<V> {\n   391→    if (store.fieldArrayCache.has(path)) {\n   392→      return store.fieldArrayCache.get(path) as ReactFormFieldArray<V>\n   393→    }\n   394→\n   395→    const baseField = createFormField<V[]>(path)\n   396→    const keys = parsePath(path)\n   397→\n   398→    const updateArray = (newArray: V[]) => {\n   399→      setValueByPath(store.currentValues, keys, newArray)\n   400→      debouncedSendChanges()\n   401→      rerender()\n   402→      return Promise.resolve()\n   403→    }\n   404→\n   405→    const fieldArray: ReactFormFieldArray<V> = {\n   406→      get value() { return baseField.value },\n   407→      get errors() { return baseField.errors },\n   408→      get errorMessage() { return baseField.errorMessage },\n   409→      get isValid() { return baseField.isValid },\n   410→      get isDirty() { return baseField.isDirty },\n   411→      get isTouched() { return baseField.isTouched },\n   412→      setValue: baseField.setValue,\n   413→      blur: baseField.blur,\n   414→      get inputProps() { return baseField.inputProps },\n   415→\n   416→      add(item?: Partial<V>) {\n   417→        const currentArray = baseField.value || []\n   418→        return updateArray([...currentArray, item as V])\n   419→      },\n   420→\n   421→      remove(index: number) {\n   422→        const currentArray = baseField.va