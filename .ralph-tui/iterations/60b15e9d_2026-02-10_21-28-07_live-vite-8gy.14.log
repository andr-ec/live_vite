{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QW3yS9yPHS5PwCusigyhF4","type":"tool_result","content":"     1→import {\n     2→  createContext,\n     3→  useContext,\n     4→  useEffect,\n     5→  useRef,\n     6→  useState,\n     7→} from \"react\"\n     8→import { useLive } from \"./useReact.js\"\n     9→import {\n    10→  parsePath,\n    11→  getValueByPath,\n    12→  setValueByPath,\n    13→  sanitizeId,\n    14→} from \"./utils.js\"\n    15→import type { Form, FormErrors, FormOptions, FieldOptions } from \"./useLiveForm.js\"\n    16→\n    17→// Deep clone utility (framework-agnostic)\n    18→function deepClone<T>(obj: T): T {\n    19→  if (typeof structuredClone === \"function\") {\n    20→    return structuredClone(obj)\n    21→  }\n    22→  return JSON.parse(JSON.stringify(obj))\n    23→}\n    24→\n    25→// Deep equality comparison\n    26→function deepEqual(a: any, b: any): boolean {\n    27→  if (a === b) return true\n    28→  if (a == null || b == null) return false\n    29→  if (typeof a !== \"object\" || typeof b !== \"object\") return false\n    30→\n    31→  const keysA = Object.keys(a).sort()\n    32→  const keysB = Object.keys(b).sort()\n    33→\n    34→  if (keysA.length !== keysB.length) return false\n    35→\n    36→  for (let i = 0; i < keysA.length; i++) {\n    37→    if (keysA[i] !== keysB[i]) return false\n    38→    if (!deepEqual(a[keysA[i]], b[keysB[i]])) return false\n    39→  }\n    40→\n    41→  return true\n    42→}\n    43→\n    44→// Helper to check if any errors exist in nested error structure\n    45→function hasAnyErrors(errors: any): boolean {\n    46→  if (Array.isArray(errors)) {\n    47→    if (errors.length === 0) return false\n    48→    if (typeof errors[0] === \"string\") return errors.length > 0\n    49→    return errors.some((item: any) => hasAnyErrors(item))\n    50→  }\n    51→  if (typeof errors === \"object\" && errors !== null) {\n    52→    return Object.values(errors).some((value: any) => hasAnyErrors(value))\n    53→  }\n    54→  return false\n    55→}\n    56→\n    57→// ─── React FormField interface (mirrors Vue but without Refs) ───\n    58→\n    59→export interface ReactFormField<T> {\n    60→  value: T\n    61→  errors: string[]\n    62→  errorMessage: string | undefined\n    63→  isValid: boolean\n    64→  isDirty: boolean\n    65→  isTouched: boolean\n    66→  setValue: (newValue: T) => void\n    67→  blur: () => void\n    68→\n    69→  inputProps: {\n    70→    value: any\n    71→    onChange: (event: any) => void\n    72→    onBlur: () => void\n    73→    name: string\n    74→    id: string\n    75→    type?: string\n    76→    checked?: boolean\n    77→    \"aria-invalid\": boolean\n    78→    \"aria-describedby\"?: string\n    79→  }\n    80→\n    81→  field<K extends keyof T>(\n    82→    key: K,\n    83→    options?: FieldOptions\n    84→  ): T[K] extends readonly (infer U)[] ? ReactFormFieldArray<U> : ReactFormField<T[K]>\n    85→\n    86→  fieldArray<K extends keyof T>(\n    87→    key: K\n    88→  ): T[K] extends readonly (infer U)[] ? ReactFormFieldArray<U> : never\n    89→}\n    90→\n    91→export interface ReactFormFieldArray<T> extends Omit<ReactFormField<T[]>, \"field\" | \"fieldArray\"> {\n    92→  add: (item?: Partial<T>) => Promise<any>\n    93→  remove: (index: number) => Promise<any>\n    94→  move: (from: number, to: number) => Promise<any>\n    95→  fields: ReactFormField<T>[]\n    96→\n    97→  field: <P extends string | number>(path: P, options?: FieldOptions) => ReactFormField<any>\n    98→  fieldArray: <P extends string | number>(path: P) => ReactFormFieldArray<any>\n    99→}\n   100→\n   101→export interface UseLiveFormReactReturn<T extends object> {\n   102→  isValid: boolean\n   103→  isDirty: boolean\n   104→  isTouched: boolean\n   105→  isValidating: boolean\n   106→  submitCount: number\n   107→  initialValues: Readonly<T>\n   108→\n   109→  field<P extends string>(path: P, options?: FieldOptions): ReactFormField<any>\n   110→  fieldArray<P extends string>(path: P): ReactFormFieldArray<any>\n   111→\n   112→  submit: () => Promise<any>\n   113→  reset: () => void\n   114→}\n   115→\n   116→// ─── React Context for form injection into children ───\n   117→\n   118→export const LiveFormContext = createContext<{\n   119→  field: (path: string, options?: FieldOptions) => ReactFormField<any>\n   120→  fieldArray: (path: string) => ReactFormFieldArray<any>\n   121→} | null>(null)\n   122→\n   123→// ─── Main hook ───\n   124→\n   125→export function useLiveForm<T extends object>(\n   126→  form: Form<T>,\n   127→  options: FormOptions = {}\n   128→): UseLiveFormReactReturn<T> {\n   129→  const {\n   130→    changeEvent = null,\n   131→    submitEvent = \"submit\",\n   132→    debounceInMiliseconds = 300,\n   133→    prepareData = (data: any) => data,\n   134→  } = options\n   135→\n   136→  // Get LiveView hook — may not be available (e.g. tests without LiveContext)\n   137→  let live: ReturnType<typeof useLive> | null = null\n   138→  try {\n   139→    live = useLive()\n   140→  } catch {\n   141→    // Not inside a LiveVite context — form still works for local state\n   142→  }\n   143→\n   144→  // Version counter to trigger re-renders when mutable refs change\n   145→  const [, setVersion] = useState(0)\n   146→  const rerender = () => setVersion(v => v + 1)\n   147→\n   148→  // ─── Mutable state stored in refs ───\n   149→\n   150→  // Use a single \"store\" ref to hold all mutable form state.\n   151→  // This avoids stale closures and ensures field getters always\n   152→  // see the latest state without needing useCallback dependencies.\n   153→  const storeRef = useRef<{\n   154→    initialValues: T\n   155→    currentValues: T\n   156→    currentErrors: FormErrors<T>\n   157→    touchedFields: Set<string>\n   158→    submitCount: number\n   159→    debounceTimer: ReturnType<typeof setTimeout> | null\n   160→    isValidating: boolean\n   161→    fieldCache: Map<str