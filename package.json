{
  "name": "live_vite",
  "version": "1.0.0",
  "description": "E2E reactivity for Vue, React, and Phoenix LiveView",
  "license": "MIT",
  "author": "Jakub Skałecki <jakub@skalecki.dev>",
  "type": "module",
  "scripts": {
    "format": "npx prettier --write assets",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "e2e:install": "npx playwright install --with-deps chromium",
    "e2e:server": "MIX_ENV=e2e mix run test/e2e/test_helper.exs",
    "e2e:build": "npx vite build --config test/e2e/vite.config.js",
    "e2e:test": "npx vite build --config test/e2e/vite.config.js && npx playwright test --config test/e2e/playwright.config.js",
    "e2e:test:headed": "npx vite build --config test/e2e/vite.config.js && npx playwright test --config test/e2e/playwright.config.js --headed",
    "e2e:test:debug": "npx vite build --config test/e2e/vite.config.js && npx playwright test --config test/e2e/playwright.config.js --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^22.9.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/ui": "^3.2.4",
    "jsdom": "^26.1.0",
    "phoenix": "file:deps/phoenix",
    "phoenix_html": "file:deps/phoenix_html",
    "phoenix_live_view": "file:deps/phoenix_live_view",
    "prettier": "2.8.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^3.2.4",
    "vue": "^3.5.10"
  },
  "main": "assets/index.ts",
  "types": "assets/index.ts",
  "exports": {
    "./vitePlugin": {
      "import": "./assets/vitePlugin.js"
    },
    "./server": {
      "import": "./assets/server.ts",
      "types": "./assets/server.ts"
    },
    "./renderers/vue": {
      "import": "./assets/renderers/vue.ts",
      "types": "./assets/renderers/vue.ts"
    },
    "./renderers/react": {
      "import": "./assets/renderers/react.ts",
      "types": "./assets/renderers/react.ts"
    },
    "./renderer": {
      "import": "./assets/renderer.ts",
      "types": "./assets/renderer.ts"
    },
    ".": {
      "import": "./assets/index.ts",
      "types": "./assets/index.ts"
    }
  },
  "keywords": [
    "phoenix",
    "liveview",
    "vue",
    "react",
    "elixir",
    "ssr",
    "vite"
  ],
  "peerDependencies": {
    "vue": "^3.3.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Valian/live_vite.git"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "package.json",
    "assets"
  ],
  "overrides": {
    "nanoid": "^3.3.8",
    "rollup": "^4.22.4"
  }
}
